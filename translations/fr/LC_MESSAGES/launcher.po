msgstr "Palonnier : lacet"

msgctxt "LauncherWindow"
msgid "Rudder roll"
msgstr "Palonnier : roulis"

msgctxt "LauncherWindow"
msgid "Rumble"
msgstr "Vibrations"

msgctxt "LauncherWindow"
msgid "Mouse/arrows: steer · Right-drag: roll/throttle"
msgstr "Souris/flèches : direction · Glisser avec bouton droit : roulis/gaz"

msgctxt "LauncherWindow"
msgid "Close this window to cancel."
msgstr "Fermez cette fenêtre pour annuler."

msgctxt "LauncherWindow"
