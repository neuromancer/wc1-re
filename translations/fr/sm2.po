#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/5"
msgid "wc1:f2b21b1c0960640e"
msgstr "Un destin approprié pour un lâche!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/6"
msgid "wc1:ce5e621b9af8fae6"
msgstr "Donc le singe veut se battre!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/7"
msgid "wc1:2bf80d1d205dbc16"
msgstr "Mon fils me vengera!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/8"
msgid "wc1:bc73ab47aabd4ec2"
msgstr "Vous serez bientôt nos esclaves!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/9"
msgid "wc1:583059077153030c"
msgstr "Nous nous battrons de nouveau!"
