msgid "wc1:37fabce2e76ba66b $C $C"
msgstr "Escadron Iota sera $C et Maniac, avec $C en tant que chef."

msgctxt "sm2/BRIEFING.002/packet/36/scene/0/record/14"
msgid "wc1:60c036d3741fd217 $C $N"
msgstr "Escadron Iota sera $C. Vous serez seul, $N."

msgctxt "sm2/BRIEFING.002/packet/36/scene/0/record/15"
msgid "wc1:7b4f71a98cb15fe8"
msgstr "Vous volerez vers vos points de navigations."

msgctxt "sm2/BRIEFING.002/packet/36/scene/0/record/16"
msgid "wc1:3ae46095375770ea"
msgstr "...pour détruire tous les vaisseaux capitaux kilrathis que vous rencontrerez."

msgctxt "sm2/BRIEFING.002/packet/36/scene/0/record/17"
msgid "wc1:8071fa06609fa662"
msgstr "Chaque minute compte en ce moment, pilotes. Ne vous trompez pas là-haut."

msgctxt "sm2/BRIEFING.002/packet/36/scene/0/record/18"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

