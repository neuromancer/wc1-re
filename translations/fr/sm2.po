#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/0"
msgid "wc1:ec4b552fe4f39460"
msgstr "Crève, gueule de singe!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/1"
msgid "wc1:7774b3d10e026ebe"
msgstr "Tu ne survivras pas à ce combat!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/2"
msgid "wc1:505fd1102c40a863"
msgstr "C'est tout ce que les singes peuvent envoyer?"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/3"
msgid "wc1:fd386d54098a6965"
msgstr "Tu te bats comme un lâche!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/4"
msgid "wc1:4db446447ec45caf"
