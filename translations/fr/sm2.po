msgid "wc1:d528c64a1db57064"
msgstr "Avec l'énorme flotte kilrathi derrière nous, nous ne pouvons pas prendre le temps de faire un détour."

msgctxt "sm2/BRIEFING.002/packet/36/scene/0/record/8"
msgid "wc1:649468d127a9c6d1"
msgstr "Votre mission est de dégager ces vaisseaux de \n notre chemin."

msgctxt "sm2/BRIEFING.002/packet/36/scene/0/record/9"
msgid "wc1:ea68867990012de8"
msgstr "Vous allez devoir faire vite, pilotes. Parce que chaque minute que nous restons ici---"

