msgctxt "sm2/BRIEFING.002/packet/0/scene/0/record/0"
msgid "wc1:72ef82d5c83b4082 $C"
msgstr "Adieu, $C. Vous nous manquerez."

msgctxt "sm2/BRIEFING.002/packet/0/scene/1/record/1"
msgid "wc1:f142c49819505c5f $R $N"
msgstr "Nous sommes réunis ici pour rendre hommage à l'un des nôtres, $R $N."

msgctxt "sm2/BRIEFING.002/packet/0/scene/1/record/2"
msgid "wc1:155b178efef3e20c"
msgstr "C'est toujours triste de perdre un pilote..."

msgctxt "sm2/BRIEFING.002/packet/0/scene/1/record/3"
msgid "wc1:6db617fa97e249c0 $C"
msgstr "... mais c'est d'autant plus difficile quand il est aussi jeune que $C."

msgctxt "sm2/BRIEFING.002/packet/0/scene/1/record/4"
msgid "wc1:6b808ca940f02412"
msgstr "Il est mort sans pouvoir prouver sa valeur."

msgctxt "sm2/BRIEFING.002/packet/0/scene/2/record/1"
msgid "wc1:f142c49819505c5f $R $N"
msgstr "Nous sommes réunis ici pour rendre hommage à l'un des nôtres, $R $N."

msgctxt "sm2/BRIEFING.002/packet/0/scene/2/record/2"
msgid "wc1:b62b95084840c1af $C"
msgstr "En quelques missions seulement, $C a commencé à renverser le cours de cette opération."

msgctxt "sm2/BRIEFING.002/packet/0/scene/2/record/3"
msgid "wc1:4309a18f20f2cf64"
msgstr "Dommage que sa contribution soit écourtée."

msgctxt "sm2/BRIEFING.002/packet/0/scene/2/record/4"
msgid "wc1:8b5faebb4dd01574 $C"
msgstr "Qui peut dire ce que $C aurait pu accomplir pour la Confédération?"

msgctxt "sm2/BRIEFING.002/packet/0/scene/3/record/1"
msgid "wc1:f142c49819505c5f $R $N"
msgstr "Nous sommes réunis ici pour rendre hommage à l'un des nôtres, $R $N."

msgctxt "sm2/BRIEFING.002/packet/0/scene/3/record/2"
msgid "wc1:b9c68a9d9783f37d $C"
msgstr "Sans l'ombre d'un doute, $C était l'un des meilleurs pilotes de la Confédération."

msgctxt "sm2/BRIEFING.002/packet/0/scene/3/record/3"
msgid "wc1:c1d18609c7fb06b2"
msgstr "Petit à petit, il a guidé les forces de la Confédération vers la victoire."

msgctxt "sm2/BRIEFING.002/packet/0/scene/3/record/4"
msgid "wc1:f1f57c396a8d287b"
msgstr "Maintenant, alors que nous poursuivons notre guerre contre les Kilrathis, nous disons adieu à un véritable héros."

msgctxt "sm2/BRIEFING.002/packet/0/scene/4/record/1"
msgid "wc1:f142c49819505c5f $R $N"
msgstr "Nous sommes réunis ici pour rendre hommage à l'un des nôtres, $R $N."

msgctxt "sm2/BRIEFING.002/packet/0/scene/4/record/2"
msgid "wc1:e10a2dd5cc077922"
msgstr "Ces dernières batailles ont été difficiles pour nous tous..."

msgctxt "sm2/BRIEFING.002/packet/0/scene/4/record/3"
msgid "wc1:2021573cd8caabbc $C"
msgstr "...mais personne ne s'est battu aussi bien pour nos objectifs que $C."

msgctxt "sm2/BRIEFING.002/packet/0/scene/4/record/4"
msgid "wc1:7ae4cac3cef6dfaf"
msgstr "Jusqu'au sacrifice ultime pour la Confédération."

msgctxt "sm2/BRIEFING.002/packet/0/scene/5/record/1"
msgid "wc1:3d6f6f9c5ae5673c"
msgstr "Adieu, Spirit ... Tes conseils avisés vont me manquer."

msgctxt "sm2/BRIEFING.002/packet/0/scene/5/record/2"
msgid "wc1:e1dfaf9ce90cfec3"
msgstr "Je leverai mon verre à ta mémoire, Hunter. Adieu."

msgctxt "sm2/BRIEFING.002/packet/0/scene/5/record/3"
msgid "wc1:699d26086ca87d38"
msgstr "Tu étais un bon pilote, Jazz. Tu vas me manquer en tant qu'ailier."

msgctxt "sm2/BRIEFING.002/packet/0/scene/5/record/4"
msgid "wc1:db9559af8a769177"
msgstr "Adieu, Iceman. J'aurais le batard qui t'a eu."

msgctxt "sm2/BRIEFING.002/packet/0/scene/5/record/5"
msgid "wc1:ef8b9b1a5bb72612"
msgstr "Adieu, Angel. Je combattrai les Kilrathis comme tu l'as fait, de tout mon coeur."

msgctxt "sm2/BRIEFING.002/packet/0/scene/5/record/6"
msgid "wc1:c111f931f1db6edb"
msgstr "Adieu, Doomsday. Je suis désolé que tes predictions se soient réalisées."

msgctxt "sm2/BRIEFING.002/packet/0/scene/5/record/7"
msgid "wc1:e2e4c2688b8e276d"
msgstr "Adieu, Maniac. Je pense que tu as ce que tu mérite."

msgctxt "sm2/BRIEFING.002/packet/0/scene/5/record/8"
msgid "wc1:d17d1553dcaf9eee"
msgstr "Adieu, Knight. je me souviendrai toujours de toi."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/0"
msgid "wc1:3473027d14887606"
msgstr "Nous sommes réunis ici pour rendre nos derniers hommages à un bon ami..."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/1"
msgid "wc1:b81037e0cc8a316c"
msgstr "...et l'un des principaux défenseurs de la Confédération terrienne."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/3"
msgid "wc1:65a08d6c18f3c36f"
msgstr "Le lieutenant Mariko Tanaka n'a jamais eu de discours bruyant ou colèrique..."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/4"
msgid "wc1:0ac55e6c0e203a1e"
msgstr "...mais ses actions étaient plus fortes que ses paroles."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/5"
msgid "wc1:4ca7702f7b641132"
msgstr "Ses compétences et son dévouement à la cause confédérée nous manquera à tous."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/6"
msgid "wc1:bc56d4d002a3a375"
msgstr "Le capitaine Ian St. John n'a jamais laissé la fatigue prendre le dessus."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/7"
msgid "wc1:4af56a25b70cf6a7"
msgstr "Son attitude et sa passion du devoir étaient sans égales."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/8"
msgid "wc1:7228ba22532c96f6"
msgstr "Maintenant qu'il est parti, nous devrions tous nous efforcer de trouver en nous..."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/9"
msgid "wc1:5f2ab3407b4df0fd"
msgstr "...la force de caractère qu'Hunter possedait."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/10"
msgid "wc1:8c3c5b69d2b58b98"
msgstr "Nous disons maintenant au revoir à l'un de nos nouveaux pilotes, le lieutenant Zach Colson."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/11"
msgid "wc1:9d580ed9d451c8de"
msgstr "Nous avons à peine eu la chance de connaître ce pilote courageux et talentueux---"

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/12"
msgid "wc1:fd7091ffa7cb203c"
msgstr "---un jeune homme qui aurait pu apporter de nombreuses contributions à notre effort de guerre---"

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/13"
msgid "wc1:e310400e5ad14d89"
msgstr "---mais nous nous souviendrons de lui alors que nous continuons le combat contre les Kilrathis."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/14"
msgid "wc1:761db983d7d82092"
msgstr "Le major Michael 'Iceman' Casey, était l'un des meilleurs à avoir jamais piloté un chasseur stellaire."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/15"
msgid "wc1:f0123eaf103bf7d7"
msgstr "Son approche taciturne était alimentée par une volonté de gagner..."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/16"
msgid "wc1:62fd030736dcec34"
msgstr "...quoi qu'il en soit. Il est mort comme il a vécu..."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/17"
msgid "wc1:ee883b8b802961b9"
msgstr "...se battre contre l'ennemi pour préserver la vie de ses semblables."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/18"
msgid "wc1:620a5cdbae3b6c11"
msgstr "Je suis triste de constater la mort d'un de nos guerriers les plus dévoués..."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/19"
msgid "wc1:3fe07573438fd9e6"
msgstr "...notre amie, le capitaine Jeanette Devereaux."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/20"
msgid "wc1:1501c3a0be2d96a2"
msgstr "Elle a tout donné pour combattre les Kilrathis."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/21"
msgid "wc1:113dfe0a119513fd"
msgstr "Maintenant, elle a fait le sacrifice ultime pour la Confédération."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/22"
msgid "wc1:da2dd3452950239c"
msgstr "...Le lieutenant Etienne Montclair, que nous connaissions tous sous le surnom de Doomsday."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/23"
msgid "wc1:495760ccf1a155ab"
msgstr "était l'un de nos meilleurs jeunes pilotes, et..."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/24"
msgid "wc1:e520dd901529fc15"
msgstr "...malgré sa vision peu optimiste de la vie et de cette guerre..."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/25"
msgid "wc1:1b32f9b76f3bd68d"
msgstr "...c'était un bon ami pour nous. Il va nous manquer."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/26"
msgid "wc1:82de49dbd8352580"
msgstr "Le sous-lieutenant Todd Marshall était l'un de nos plus jeunes pilotes..."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/27"
msgid "wc1:6b52d24509c5e98d"
msgstr "...et peut-être le plus incompris de notre escadron."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/28"
msgid "wc1:f6586508fa330417"
msgstr "Bien qu'il ait souvent parlé de son désir de mourir au combat..."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/29"
msgid "wc1:cfc2849573eb1d3b"
msgstr "...sa mort est vraiment une perte pour nous. Adieu, Maniac."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/30"
msgid "wc1:be08f592cfdf5033"
msgstr "Nous devons maintenant dire au revoir au capitaine Joseph Khumalo."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/31"
msgid "wc1:ded4b0b316c09f87"
msgstr "Knight était toujours prêt à apporter son soutien et son assistance..."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/32"
msgid "wc1:d9d2bc1c953ef15b"
msgstr "...dans le cockpit ou à bord du vaisseau."

msgctxt "sm2/BRIEFING.002/packet/0/scene/6/record/33"
msgid "wc1:aa1888b5d954fb23"
msgstr "Son attitude solide comme le roc était une force pour nous tous."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/0"
msgid "wc1:437206dca1292c99 $T $D"
msgstr "Bureau du colonel Halcyon.\n$T, $D."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/2"
msgid "wc1:1476cbe2ac7b8543 $N"
msgstr "$N. Entrez, j'ai besoin de vous parler."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/3"
msgid "wc1:5c218468f6cb5eef"
msgstr "Oui Monsieur?"

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/4"
msgid "wc1:93ee3520ac61d9e1"
msgstr "J'ai lu les rapports de vos performances."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/5"
msgid "wc1:471825e86f61b228 $C"
msgstr "Vous êtes un pilote exceptionnel, $C. Et par vos victoires..."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/6"
msgid "wc1:715543300b19c78a $R"
msgstr "Vous êtes promu $R, avec effet immediat."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/7"
msgid "wc1:c73ff960b5965f89 $R $N"
msgstr "Félicitations, $R $N. Continuez votre bon travail."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/8"
msgid "wc1:4b397ceb86bc43b9"
msgstr "Merci Monsieur!"

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/9"
msgid "wc1:9cdfb9172d5bc1a4"
msgstr "Bien. Autre chose dont je dois vous parler..."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/10"
msgid "wc1:0e5a017c129cd29f"
msgstr "Ce vaisseau que vous venez de perdre coûte plus de cent millions de crédits."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/11"
msgid "wc1:fcb157d1598cb669"
msgstr "Nous devrons attendre notre retour à Vega avant que le griffe du tigre reçoive du matériel."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/12"
msgid "wc1:dfa02530bbb454c8"
msgstr "Je sais, monsieur. Mais je ne pouvais rien faire d'autre...."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/13"
msgid "wc1:7157254c2e22f5c9"
msgstr "Si vous n'avez pas d'autre choix que d'éjecter, alors d'accord..."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/14"
msgid "wc1:5f77d4969177e4c6"
msgstr "...Mais si vous pouvez ramener votre appareil, même presque détruit faites-le."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/15"
msgid "wc1:590237a8a7405b3b"
msgstr "Vous êtes sur le point de recevoir le Golden Sun pour avoir éjecté et survecu..."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/16"
msgid "wc1:c240eb61ff313196"
msgstr "On ne peut en obtenir qu'un pour toute une carrière."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/17"
msgid "wc1:8382dfd19f3a8193"
msgstr "Après celà, l'éjection n'est qu'un gaspillage de chasseur pour la Confédération."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/18"
msgid "wc1:6dc7de882a71b1b5"
msgstr "Je ne l'oublierai pas, monsieur."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/19"
msgid "wc1:4a3619ee96d83ad5 $R"
msgstr "J'y compte bien, $R."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/20"
msgid "wc1:0a74ac80c7bb418c $C"
msgstr "Juste un instant, $C. J'ai encore une chose à vous dire."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/21"
msgid "wc1:cf83b4d83c030971"
msgstr "Nous devons changer certaines affectations de pilotes."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/22"
msgid "wc1:a7abca757a39f484"
msgstr "A compter de maintenant, vous serez réaffecté."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/23"
msgid "wc1:b1c953ca974cb4cb"
msgstr "Vous volerez à nouveau sur les Hornets avec les Killer Bees."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/24"
msgid "wc1:aa74cc25d6bed1f2"
msgstr "Vous piloterez un vaisseau spécial dans le cadre d'une mission d'infiltration. J'ai peur de ne pas pouvoir en dire plus pour le moment."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/25"
msgid "wc1:3692a2706dd86866"
msgstr "J'ai besoin de vous dans l'escadron Star Slayer, sur le chasseur lourd de classe Raptor."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/26"
msgid "wc1:ccd652fcc96fea5b"
msgstr "Je vous veux sur des Rapiers, dans l'escadron Black Lion."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/27"
msgid "wc1:008eb568c4e6167c"
msgstr "Je vois, monsieur. je ferai de mon mieux."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/28"
msgid "wc1:c3b1b0f41e653549"
msgstr "Je suis curieux, monsieur... pourquoi?"

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/29"
msgid "wc1:610974a9640796d2"
msgstr "Chacun de nos chasseurs est conçu pour un type spécifique de mission de combat."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/30"
msgid "wc1:b97f41d7dee902d0"
msgstr "C'est le facteur principal dans l'affectation des pilotes pour différentes missions."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/31"
msgid "wc1:715202d5c4a1c9c3"
msgstr "Je comprends, monsieur. Je ferai de mon mieux, quel que soit l'appareil auquel je suis affecté."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/32"
msgid "wc1:248c7cf8ec3a56ca"
msgstr "Je suis content de l'entendre, pilote."

msgctxt "sm2/BRIEFING.002/packet/1/scene/0/record/33"
msgid "wc1:284f77f0aac40b8c $R"
msgstr "C'est tout, $R. Rompez."

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/0"
msgid "wc1:ffb83f54560ea7b3 $D"
msgstr "Pont du hangar.\n18:00 heures, $D."

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/1"
msgid "wc1:0853cfb625c78750"
msgstr "Pour son excellence dans le combat contre l'ennemi kilrathi..."

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/2"
msgid "wc1:27a87fd8f631df6d"
msgstr "En considération de son valeureux service envers l'humanité..."

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/3"
msgid "wc1:f37fcb0e1975a7d7"
msgstr "Guidant les forces de la Confédération contre l'empire kilrahi..."

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/4"
msgid "wc1:af50475959b03684"
msgstr "Jouant un rôle décisif dans la défense de nos alliés Firekkans..."

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/5"
msgid "wc1:fb27b84580e54808"
msgstr "Et menant nos forces à la victoire sur les Kilrathis dans le secteur d'Antares..."

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/6"
msgid "wc1:ec0f5d2552c7c61a"
msgstr "Pour avoir sacrifié son vaisseau et mis sa vie en danger..."

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/7"
msgid "wc1:96cc940c31a3870b"
msgstr "Au combat avec l'ennemi kilrathi..."

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/8"
msgid "wc1:299ae904159779d5 $E"
msgstr "...Le $E,"

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/9"
msgid "wc1:4de621c46bea12f2 $A $R $N"
msgstr "La Confédération terrienne remet la $A au $R $N."

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/10"
msgid "wc1:083ebdbad07c4fcb"
msgstr "Votre courage est un exemple pour la Confédération."

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/11"
msgid "wc1:8a89983527bdcfc2"
msgstr "Vous êtes l'un des plus grands héros de l'humanité."

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/12"
msgid "wc1:6f9b780188e9a285"
msgstr "Votre dévouement honore toute la Confédération."

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/13"
msgid "wc1:4f2e111b74fe1821 $C"
msgstr "Bon travail, $C.\nFelicitations."

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/14"
msgid "wc1:4b3985eb86bc5304"
msgstr "Merci Monsieur."

msgctxt "sm2/BRIEFING.002/packet/2/scene/0/record/15"
msgid "wc1:c9a08a788fed9788"
msgstr "Rempli de fierté, vous êtes applaudis par vos coequipiers."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/0"
msgid "wc1:7548acc0fad899a9 $T $D"
msgstr "Briefing de mission, $T, $D.\nsystème Firekka, Secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/1"
msgid "wc1:2379f684b7f3f3e8"
msgstr "J'espère que tout le monde a apprecié le voyage jusqu'à présent...."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/2"
msgid "wc1:90d4e869aa471c08"
msgstr "...parce qu'il va y avoir encore du travail."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/3"
msgid "wc1:928f663f1f2037c5"
msgstr "Nous avons reçu des rapports d'un convoi kilrathi se deplaçant à travers un système à proximité."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/4"
msgid "wc1:56ff78013681fef9"
msgstr "Nous ne pouvons pas nous permettre de compromettre la conférence du traité sur la planète---"

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/5"
msgid "wc1:63f1e22704fa7fc5"
msgstr "---alors on va patrouiller et surveiller ce convoi. Et j'aurai aussi besoin de certains d'entre vous---"

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/6"
msgid "wc1:f8fc3b484766d654"
msgstr "---pour escorter les vaisseaux du corps diplomatique à Firekka, là où ils sont nécessaires pour la conférence."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/7"
msgid "wc1:4b707f7c7b765353"
msgstr "Qu'en est-il de nos permes, monsieur?"

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/8"
msgid "wc1:5ceff6b9e95084cb"
msgstr "Nous vous accorderons des permissions afin que vous ayez toujours du temps libre."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/9"
msgid "wc1:ff5a5d922d301e5f"
msgstr "Voici vos affectations..."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/10"
msgid "wc1:b7d535ca2b89120f $C"
msgstr "$C, sera l'escadron Alpha, avec Iceman comme ailier."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/11"
msgid "wc1:9de1b34f934325ba $C"
msgstr "$C, sera l'escadron Alpha."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/12"
msgid "wc1:eb5f9d805bee8018"
msgstr "Vous piloterez un Hornet, un vaisseau rapide et maniable. Escortez le TCS Perez de Cuellar du Tigre à Nav 2..."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/13"
msgid "wc1:c204afd8ce5cf98b"
msgstr "De là, le vaisseau diplomatique effectuera un saut vers Firekka."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/14"
msgid "wc1:15d062edf3a50112"
msgstr "Nous avons détecté des traces en haute énergie sur la route vers Nav 2."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/15"
msgid "wc1:cabf12768dc441db"
msgstr "Après que le Perez de Cuellar ait sauté vers Firekka, enquêtez sur le signal inconnu entre Nav 2 et le Tigre."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/16"
msgid "wc1:c669dd9a05588804"
msgstr "Le colonel Halcyon affecte les autres pilotes à leurs tâches."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/17"
msgid "wc1:d40097e0d4941305"
msgstr "N'oubliez pas que si vous rencontrez des Kilrathis errants, vous devez engager l'ennemi."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/18"
msgid "wc1:fadc25a8c34d7ae6"
msgstr "Mais si vous voyez un signe indiquant que le convoi s'est detourné vers ce système, retournez immediatement au Tigre."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/19"
msgid "wc1:6e8196d1a5f31b79"
msgstr "Le QG a signalé de nouveau Dralthi Mark II dans le secteur Vega---"

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/20"
msgid "wc1:7400e3c93a79e9fb"
msgstr "---il a des cannons mass et de meilleurs boucliers. Le QG voudrait des données vidéos sur ces nouveaux chasseurs."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/21"
msgid "wc1:a21c838b15297cea"
msgstr "Donc, si vous voyez l'un de ces nouveaux Dralthis, approchez-vous et votre caméra vidéo obtiendra ces données pour nous."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/22"
msgid "wc1:9f02271d1df1780c"
msgstr "Autre chose que je voulais mentionner..."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/23"
msgid "wc1:fe8d1d796439fbe6"
msgstr "Hunter a fait un atterrissage de casse cou hier."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/24"
msgid "wc1:24a8b5cecfe391d4"
msgstr "Il a réussi à casser l'un des canons laser de son vaisseau, trois antennes et à terrifier l'équipage du poste de contrôle."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/25"
msgid "wc1:526d82b4786c486f"
msgstr "Pilotes, nous utilisons l'ACLS --- notre système d'atterrissage automatique --- pour de très bonnes raisons."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/26"
msgid "wc1:844100d2627888ba"
msgstr "Le prochain pilote qui tentera un atterrissage à commande manuelle nettoiera les ponts pendant une semaine."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/27"
msgid "wc1:263021577134d478"
msgstr "Est-ce que c'est compris?"

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/28"
msgid "wc1:21f8b4af94972f3c"
msgstr "très bien, pilotes. Préparez-vous au lancement."

msgctxt "sm2/BRIEFING.002/packet/4/scene/0/record/29"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Rompez."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/0"
msgid "wc1:519f3b77a856f152 $T $D"
msgstr "Débriefing de la mission: $T, $D.\nsystème Firekka, Secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/1"
msgid "wc1:ac694b669834b48d $C"
msgstr "j'espère que vous avez de bonnes nouvelles, $C..."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/2"
msgid "wc1:2ad3ed6107fad621"
msgstr "...parce que nous avons besoin de données vidéos pour localiser et stopper ce convoi."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/3"
msgid "wc1:daca946118c8ad63"
msgstr "Je ne sais pas pourquoi un convoi ennemi est dans ce système, mais on s'en débarrassera, c'est certain."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/4"
msgid "wc1:e8e59fa04c506e5f $R"
msgstr "Votre rapport, $R?"

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/5"
msgid "wc1:a65913267890a28d"
msgstr "Nous avons escorté le Perez de Cuellar jusqu'à son saut. Ils est en route pour Firekka maintenant."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/6"
msgid "wc1:85119d0cfba15cfe"
msgstr "J'ai escorté le Perez de Cuellar jusqu'à son saut. Ils est en route pour Firekka maintenant."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/7"
msgid "wc1:eec9c6c9c478d186"
msgstr "Nous avons perdu le Perez de Cuellar. Je suis désolé, monsieur... nous avons fait de notre mieux."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/8"
msgid "wc1:dff8f9721cd97774"
msgstr "J'ai perdu le Perez de Cuellar. Je suis désolé, monsieur... j'ai fait de mon mieux."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/9"
msgid "wc1:44fe99f0d15d8af8"
msgstr "Nous avons détruit un Ralari entre Nav 2 et le Tigre. Ce convoi est définitivement en train de pourrir dans ce système, monsieur."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/10"
msgid "wc1:ace86889d7e641e3"
msgstr "J'ai détruit le Ralari entre Nav 2 et le Tigre. Ce convoi est définitivement en train de pourrir dans ce système, monsieur."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/11"
msgid "wc1:35152707313c3df7"
msgstr "Et nous ne pouvions pas stopper le Ralari entre le Tigre et Nav 2. Ce convoi est en train de traverser ce système, monsieur."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/12"
msgid "wc1:9e1acce97e0268f8"
msgstr "Et je n'ai pas pu stopper le Ralari entre le Tigre et Nav 2. Ce convoi est en train de traverser ce système, monsieur."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/13"
msgid "wc1:fc1fef6525e3ce13"
msgstr "J'ai été désolé d'apprendre la mort d'Iceman."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/14"
msgid "wc1:99500a348e5c8dae"
msgstr "Il est mort au champ d'honneur, combattant les ennemis de l'humanité."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/15"
msgid "wc1:879b0f3952d7530c $C $K"
msgstr "$C, votre enregistreur montre que vous avez $K."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/16"
msgid "wc1:45440e0f280ce212 $C"
msgstr "$C, vous n'avez rien eu. Pas de tué."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/17"
msgid "wc1:008e6e7fb57b8a59 $L"
msgstr "Iceman a eu $L lui."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/18"
msgid "wc1:eb43f3a7d15edc7b"
msgstr "Iceman n'a abattu aucun de ces chats."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/19"
msgid "wc1:5dcb0d74d50fce45"
msgstr "Et puis nous l'avons perdu."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/20"
msgid "wc1:a7989758caf4add5"
msgstr "très bien. J'envoie vos disques enregistreurs de vol au pont---"

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/21"
msgid "wc1:727734e861be883e"
msgstr "---avec un peu de chance, nous en apprendrons plus sur ce convoi grâce à vos informations."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/22"
msgid "wc1:7a0098a3a12b537e $C"
msgstr "$C, après votre douche, je dois vous voir dans mon bureau."

msgctxt "sm2/BRIEFING.002/packet/4/scene/1/record/23"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Rompez."

msgctxt "sm2/BRIEFING.002/packet/4/scene/2/record/0"
msgid "wc1:8e04ae05d8bb516a $C"
msgstr "Hey, $C!  Il y a de nouvelles rumeurs ?"

msgctxt "sm2/BRIEFING.002/packet/4/scene/2/record/1"
msgid "wc1:20df3107120949fe"
msgstr "J'ai entendu dire que les dirigeants Firekka signeraient le traité dans quelques jours."

msgctxt "sm2/BRIEFING.002/packet/4/scene/2/record/2"
msgid "wc1:618dc7efdb2143b2"
msgstr "Peux-tu le croire? Une nouvelle planète rejoint la Confédération---"

msgctxt "sm2/BRIEFING.002/packet/4/scene/2/record/3"
msgid "wc1:c5a0b942fe18dce6"
msgstr "---Et nous voila, participant à l'histoire."

msgctxt "sm2/BRIEFING.002/packet/4/scene/2/record/4"
msgid "wc1:f9b15ae134ae254e"
msgstr "Je dois partir à la surface dans quelques jours... Je devrais être sur la planète pour la signature du traité."

msgctxt "sm2/BRIEFING.002/packet/4/scene/2/record/5"
msgid "wc1:d58396007ca50b1a"
msgstr "C'est une chance pour toi. Je serai ici, versant des boissons en regardant ça sur la vidlink."

msgctxt "sm2/BRIEFING.002/packet/4/scene/2/record/6"
msgid "wc1:c9747edd9e917c0b"
msgstr "Je dois dire cependant, que ces Firekkas ont l'air vraiment bizarres. Ca me rappelle une perruche que j'avais il y a quelques années."

msgctxt "sm2/BRIEFING.002/packet/4/scene/2/record/7"
msgid "wc1:0a25f58af856b39b"
msgstr "Sauf que MA perruche n'était pas très intelligente, et qu'elle ne mesurait pas 1,80 mètre non plus."

msgctxt "sm2/BRIEFING.002/packet/4/scene/3/record/0"
msgid "wc1:67cf8ed1cb908ba1 $C"
msgstr "$C!  Rejoins-nous pour boire un verre, mon pote!"

msgctxt "sm2/BRIEFING.002/packet/4/scene/3/record/1"
msgid "wc1:ee9738ca59480ca3 $C"
msgstr "$C!  Rejoins-moi pour boire un verre, mon pote!"

msgctxt "sm2/BRIEFING.002/packet/4/scene/3/record/2"
msgid "wc1:1022f85b16dabf1e"
msgstr "C'est super d'avoir une vraie pause, spécialement après l'opération Thor Hammer."

msgctxt "sm2/BRIEFING.002/packet/4/scene/3/record/3"
msgid "wc1:7936075ee81ea943"
msgstr "J'étais certain que nous ne survivrions pas à cette mission."

msgctxt "sm2/BRIEFING.002/packet/4/scene/3/record/4"
msgid "wc1:5de43cf19d6c396e"
msgstr "Je suis content d'avoir eu tort, au moins cette fois."

msgctxt "sm2/BRIEFING.002/packet/4/scene/3/record/5"
msgid "wc1:24c3cdeafe53c10d"
msgstr "Et maintenant, nous allons passer un mois comme garde d'honneur pour le corps diplomatique de la Confédération."

msgctxt "sm2/BRIEFING.002/packet/4/scene/3/record/6"
msgid "wc1:1b6cd8495dfae857"
msgstr "Yeah, ce sera une tâche facile... jouer à la nourrice d'un groupe de diplomates et d'extraterrestres."

msgctxt "sm2/BRIEFING.002/packet/4/scene/3/record/7"
msgid "wc1:9570dd1c7f0842e8"
msgstr "J'ai hâte de voir les Firekkas. Je n'ai jamais rencontré de non-humain auparavant."

msgctxt "sm2/BRIEFING.002/packet/4/scene/3/record/8"
msgid "wc1:cb7f820b36398f4e"
msgstr "Eh bien, tu le verras bientôt, mon pote. Ils semblent être de bonnes personnes... intelligents et honnêtes, très amicaux avec les étrangers."

msgctxt "sm2/BRIEFING.002/packet/4/scene/3/record/9"
msgid "wc1:dff5f318f87197ac"
msgstr "Ils ont de la chance que leur planète soit si loin des routes commerciales, sinon les Kilrathis les auraient asservis à coup sûr."

msgctxt "sm2/BRIEFING.002/packet/4/scene/3/record/10"
msgid "wc1:83e7a8414f0cb97f"
msgstr "Mais il y a si peu de points de saut dans ce secteur, nous avons été les premiers à les trouver."

msgctxt "sm2/BRIEFING.002/packet/4/scene/3/record/11"
msgid "wc1:3e83db8bb578ca81"
msgstr "Ce qui est une aubaine pour nos nouveaux compagnons à plumes, hey?"

msgctxt "sm2/BRIEFING.002/packet/4/scene/4/record/0"
msgid "wc1:21b0c42f64a9dc6d"
msgstr "Je te défie à une partie de Eight-Ball!"

msgctxt "sm2/BRIEFING.002/packet/4/scene/4/record/1"
msgid "wc1:8b74393d39a095be"
msgstr "Pas question, je ne joue pas avec toi. Tu triches."

msgctxt "sm2/BRIEFING.002/packet/4/scene/4/record/2"
msgid "wc1:fc98f3517e7e0693"
msgstr "Oh, allez! Je vais te donner trois balles."

msgctxt "sm2/BRIEFING.002/packet/4/scene/4/record/3"
msgid "wc1:9acc9e3c78dcd578"
msgstr "Mais tout ce que j'ai c'est cinq dollars!"

msgctxt "sm2/BRIEFING.002/packet/4/scene/4/record/4"
msgid "wc1:31dcae45622a55a7"
msgstr "tes cinq dollars te rapporteront peut être vingt."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/0"
msgid "wc1:7548acc0fad899a9 $T $D"
msgstr "Briefing de mission, $T, $D.\nsystème Firekka, Secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/1"
msgid "wc1:5dee6532dfac33a9"
msgstr "très bien, pilotes, commencons. La première nouvelle est que---"

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/2"
msgid "wc1:40adfa3c0f61a0ff"
msgstr "---le Scimitar a été officiellement retiré en tant que chasseur de la Confédération."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/3"
msgid "wc1:efba762f3f59c44d"
msgstr "Bien. J'ai toujours détesté cet escargot. Lent, immanoeuvrable, un tas de féraille---"

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/4"
msgid "wc1:ed00e12c8ea2b669"
msgstr "Autre nouvelle : la plupart d'entre vous n'ont rencontré aucun problème lors de la dernière patrouille...."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/5"
msgid "wc1:37b5387499dd96d8"
msgstr "...mais certains d'entre vous ont rencontré des vaisseaux d'un convoi kilrathi..."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/6"
msgid "wc1:acd78499ddd17bc6"
msgstr "...y compris des pilotes Kilrathis très coriaces."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/7"
msgid "wc1:15d7978a1c374e9c"
msgstr "L'intelligence pense qu'il pourrait s'agir de DRAKHAI, L'élite des combattants ennemis."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/8"
msgid "wc1:0e4a47d0b88d3f38"
msgstr "Mais ce que nous ne comprenons pas, c'est pourquoi ils sont là, et pourquoi un convoi se trouve dans ce secteur sans importance.."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/9"
msgid "wc1:1b698d89b3000264"
msgstr "Après avoir examiné vos données de vol, L'intelligence n'est pas certain que nous ayons trouvé tout le convoi."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/10"
msgid "wc1:84c09da39b979fae"
msgstr "Votre mission aujourd'hui est de patrouiller dans le système et de traquer ce convoi."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/11"
msgid "wc1:861a8009984935fd"
msgstr "Si vous rencontrez ce convoi, ne l'engagez pas. Obtenez des données vidéo sur eux et revenez au Tigre.."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/12"
msgid "wc1:086f005449e39adc"
msgstr "Si vous êtes suffisamment proche d'eux, vos caméras s'allumeront automatiquement et obtiendront les données dont nous avons besoin."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/13"
msgid "wc1:43f8a50916efd07e"
msgstr "Vous piloterez à nouveau des Hornets, donc si vous rencontrez des problèmes, vous serez dans un vaisseau rapide pour revenir ici."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/14"
msgid "wc1:cbdebfc72f9fbc06 $C"
msgstr "Affectations d'escadrons... L'escadron Kappa sera $C et Iceman."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/15"
msgid "wc1:16e0cc55743658a2 $C"
msgstr "Affectations d'escadrons...$C, tu es l'escadron Kappa."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/16"
msgid "wc1:7ca904065f4bfdff"
msgstr "Vous patrouillerez à travers les champs d'astéroïdes a \n Nav 1---"

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/17"
msgid "wc1:598368fa3efd185b"
msgstr "Continuez par le point de Nav 2, puis revenez ici."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/18"
msgid "wc1:afd1ba194b1eb8a4"
msgstr "Le colonel briefe les autres escadrons."

msgctxt "sm2/BRIEFING.002/packet/5/scene/0/record/19"
msgid "wc1:88027fa1c1bea455"
msgstr "Préparez-vous pour un lancement immédiat, pilotes. Rompez."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/1"
msgid "wc1:0584955ee5c10a24 $C"
msgstr "Rien à signaler, $C?"

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/2"
msgid "wc1:1386e79a5b8525ad"
msgstr "Rencontre avec plusieurs Krants au point Nav 1.."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/5"
msgid "wc1:5c302eb2bb21c255"
msgstr "La vraie surprise était à Nav 2."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/6"
msgid "wc1:6eb79cb3e2965377"
msgstr "Trois Fralthis, monsieur, et plus de chasseurs kilrathis que je ne pouvais en compter."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/7"
msgid "wc1:fb39ef1889cec7c9"
msgstr "J'ai pu viser un Fralthi. Leur emplacement exact devrait être dans mon enregistreur de vol."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/8"
msgid "wc1:7d0fa42ddb72c6b4"
msgstr "Mais je n'ai eu aucun des vaisseaux capitaux ennemis, monsieur."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/9"
msgid "wc1:cabbb8ad584f3675 $R"
msgstr "Vous n'avez pas reçu l'ordre de les détruire, $R. Vous avez bien fait de retourner au Tigre."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/10"
msgid "wc1:cd38855867677c51"
msgstr "Maintenant, nous pouvons envoyer un escadron complet et nous assurer que ces vaisseaux seront stoppés."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/12"
msgid "wc1:e2f8dfee09c25db5"
msgstr "Ensuite, j'ai engagé le Fralthi, monsieur, et---"

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/13"
msgid "wc1:7ed48b4d65e76fa0"
msgstr "Vous avez fait QUOI, pilote ? On vous a ordonné de revenir si vous aperceviez le convoi!"

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/14"
msgid "wc1:6e9aa2d948bff8f7"
msgstr "Realisez-vous que vous avez risqué la vie de tout le monde sur ce vaisseau?"

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/15"
msgid "wc1:d0ed5fc34469ef32"
msgstr "Si vous aviez été tué, en attaquant ces vaisseaux---"

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/16"
msgid "wc1:ec0f6ba383246147"
msgstr "---ces trois Fralthis auraient pu lancer une attaque surprise sur le Tigre, et probablement le détruire."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/17"
msgid "wc1:54219b8a8c3c0ffd $C"
msgstr "Vous êtes courageux, $C, et je suis très impressionné par vos talents de pilote..."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/18"
msgid "wc1:fb0a297fb7652765"
msgstr "Mais la prochaine fois, je m'attendrai a ce que vous obéissiez aux ordres. Entendu?"

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/19"
msgid "wc1:192b8bf32bc0e6b8"
msgstr "Entendu, monsieur."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/20"
msgid "wc1:e386c62caed974c0 $K"
msgstr "De votre enregistreur de vol, je vois que vous avez $K chats..."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/21"
msgid "wc1:5da81755960b931c"
msgstr "Et vous n'avez tué aucun appareil ennemi."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/22"
msgid "wc1:9797b11227451208 $L"
msgstr "... et Iceman s'est occupé de $L chats."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/23"
msgid "wc1:59537277e60c3071"
msgstr "...et Iceman a zéro."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/24"
msgid "wc1:0d8ed203fbc7f08b"
msgstr "Putain nous l'avons perdu. Un gachis de bon pilote."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/25"
msgid "wc1:48e6220199b9c22a $N"
msgstr "Reposez-vous, $N. Vous êtes en congé pour quelques heures."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/26"
msgid "wc1:4c387ea4ef6ec753"
msgstr "Mais j'aurai besoin de vous parler dans mon bureau plus tard."

msgctxt "sm2/BRIEFING.002/packet/5/scene/1/record/27"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Rompez."

msgctxt "sm2/BRIEFING.002/packet/5/scene/2/record/0"
msgid "wc1:3629d32fa98ce023 $C"
msgstr "Prends un verre, $C ! Nous avons quelque chose à fêter!"

msgctxt "sm2/BRIEFING.002/packet/5/scene/2/record/1"
msgid "wc1:9e30f2cd479c0938"
msgstr "Je viens d'apprendre des nouvelles du Major Chapman sur l'Austin---"

msgctxt "sm2/BRIEFING.002/packet/5/scene/2/record/2"
msgid "wc1:eca3ae63774d1e56"
msgstr "La flotte confédérée a chassé la force de frappe kilrathi de Vega Prime!"

msgctxt "sm2/BRIEFING.002/packet/5/scene/2/record/3"
msgid "wc1:29bcaae3e82ef897"
msgstr "C'était un peu bizarre, en fait... il n'y a pas eu de bataille majeure ou de chose comme ça..."

msgctxt "sm2/BRIEFING.002/packet/5/scene/2/record/4"
msgid "wc1:08ee2745556f9748"
msgstr "...les chats viennent de fermer boutique et ils sont partis."

msgctxt "sm2/BRIEFING.002/packet/5/scene/2/record/5"
msgid "wc1:946c6a6c885aa569"
msgstr "Peut être qu'ils avaient un autre endroit où ils voulaient aller, Sam."

msgctxt "sm2/BRIEFING.002/packet/5/scene/2/record/6"
msgid "wc1:a5ff09dacfcbbbdd"
msgstr "Tu n'y crois pas non plus, n'est-ce pas? Mais malgré tout, ils se sont enfuis. C'est une victoire pour nous."

msgctxt "sm2/BRIEFING.002/packet/5/scene/3/record/0"
msgid "wc1:b8350cb3bdd43928 $C"
msgstr "$C!  T'as entendu ce qui s'est passé lors de cette dernière patrouille?"

msgctxt "sm2/BRIEFING.002/packet/5/scene/3/record/1"
msgid "wc1:9f4d818d143a9cce"
msgstr "Presque tous les pilotes ont rencontré des vaisseaux de guerre ennemis."

msgctxt "sm2/BRIEFING.002/packet/5/scene/3/record/2"
msgid "wc1:bcda4fdffcc2c027"
msgstr "Et un officier de l'intelligence dit qu'il pourrait y avoir plus de Kilrathis dans cette zone."

msgctxt "sm2/BRIEFING.002/packet/5/scene/3/record/3"
msgid "wc1:60ceb10b1942d8bf"
msgstr "Heureusement, nous ne sommes pas seuls dans ce secteur. Si nous avons besoin de plus de pilotes de combat---"

msgctxt "sm2/BRIEFING.002/packet/5/scene/3/record/4"
msgid "wc1:2fcca9ad2529a09c"
msgstr "---ils transféreront du personnel de l'Austin."

msgctxt "sm2/BRIEFING.002/packet/5/scene/3/record/5"
msgid "wc1:9467968f78ed348b"
msgstr "J'espère vraiment que nous n'aurons pas besoin de ces autres pilotes---"

msgctxt "sm2/BRIEFING.002/packet/5/scene/3/record/6"
msgid "wc1:c002f53dd025ef1e"
msgstr "Mais cela pourrait être une excellente occasion de comparer nos tactiques avec eux, non?"

msgctxt "sm2/BRIEFING.002/packet/5/scene/4/record/0"
msgid "wc1:7a2cb07f2927d259 $C"
msgstr "$C!  On parlait justement de toi, Angel et moi."

msgctxt "sm2/BRIEFING.002/packet/5/scene/4/record/1"
msgid "wc1:2758ab7eebbdb7d5"
msgstr "Elle dit que tu vas sur la planète pour une permission, après notre prochaine mission."

msgctxt "sm2/BRIEFING.002/packet/5/scene/4/record/2"
msgid "wc1:4165a578e84dfcdb $C"
msgstr "$C!  J'ai entendu dire que tu vas sur la planète pour une permission, après notre prochaine mission."

msgctxt "sm2/BRIEFING.002/packet/5/scene/4/record/3"
msgid "wc1:11b1f5abd9abc70f"
msgstr "Ce sera très excitant... J'aimerais pouvoir venir avec toi."

msgctxt "sm2/BRIEFING.002/packet/5/scene/4/record/4"
msgid "wc1:271a5694f820ef2a"
msgstr "Tu as pu obtenir une perme, Spirit?"

msgctxt "sm2/BRIEFING.002/packet/5/scene/4/record/5"
msgid "wc1:c4b6ccbab5c221f8"
msgstr "Pas dans les prochains jours, mon ami. Mais j'espère que tu nous parlera de ton voyage à ton retour."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/0"
msgid "wc1:7548acc0fad899a9 $T $D"
msgstr "Briefing de mission, $T, $D.\nsystème Firekka, Secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/1"
msgid "wc1:d585b393b3e3a512"
msgstr "Pilotes, une situation dangereuse se développe ici."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/2"
msgid "wc1:fbeb95deb33dac3e"
msgstr "L'intelligence a analysé les données des enregistreurs de vol de vos dernières missions---"

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/3"
msgid "wc1:9b50f3d91ae1c1ab"
msgstr "---et nous savons que nous n'avons plus à faire à un 'convoi égaré'."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/4"
msgid "wc1:3ad184ec458f2500"
msgstr "Mais a une flotte de combat kilrathi qui se dirige vers cette planète."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/5"
msgid "wc1:e023b24a50ce6a8d"
msgstr "Le renseignement pense qu'il s'agit d'une petite force de frappe, bien plus petite que la flotte qui a attaqué la colonie Goddard...."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/6"
msgid "wc1:85e6582d8e99f2eb"
msgstr "...Mais nous ne le savons pas avec certitude, et nous ignorons également pourquoi ils viennent ici.."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/7"
msgid "wc1:e73a4f4f1efd95e8"
msgstr "Le système Firekka n'a aucune valeur stratégique où logistique."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/8"
msgid "wc1:1d2c202c32178ecb"
msgstr "Les chats veulent quelque chose que nous ignorons, que nous ne comprenons pas.---"

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/9"
msgid "wc1:9f8ce52ce1b64dbc"
msgstr "---nous allons vous envoyer là-bas pour découvrir ce que c'est."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/10"
msgid "wc1:2d9a8e8d8bf89888"
msgstr "Vous effectuerez des patrouilles et engagerez l'ennemi si possible. Mais revenez si l'opposition est écrasante."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/11"
msgid "wc1:4c012496320349b7"
msgstr "Sous AUCUNE condition, vous ne devez vous engager dans un combat dans l'atmosphère planètaire."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/12"
msgid "wc1:acdf91d6cc75a16d"
msgstr "Nos chasseurs ne sont pas équipés pour la surface. Si un missile ennemi vous accroche---"

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/13"
msgid "wc1:bf28746a34a80418"
msgstr "---le différentiel de pression fera exploser votre vaisseau."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/14"
msgid "wc1:284f6cc9cdaa2b8e"
msgstr "Okay, voici les affectations d'escadrons...."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/15"
msgid "wc1:8ffb66a2b9048cec"
msgstr "Le colonel donne des ordres spécifiques à chaque escadron, puis à vous..."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/16"
msgid "wc1:0ae59b1a92fab759 $C $C"
msgstr "Epsilon sera $C et Knight. $C est le chef d'escadron."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/17"
msgid "wc1:6d49f562cafba1a0 $C"
msgstr "Epsilon sera $C."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/18"
msgid "wc1:69f4278d92a8fbc1"
msgstr "Vous suivrez votre route programmée sur Navcomp..."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/19"
msgid "wc1:5acf96dfe97c30e3"
msgstr "Patrouillez à Nav 1 et continuez à travers les astéroïdes jusqu'à Nav 2 et 3."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/20"
msgid "wc1:b9ea560fbdc13ab9"
msgstr "Évitez si l'opposition est écrasante, mais engagez l'ennemi si vous le pouvez. Puis, retournez au Tigre."

msgctxt "sm2/BRIEFING.002/packet/8/scene/0/record/21"
msgid "wc1:3caaecac63457631"
msgstr "C'est tout, pilotes. Rompez."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/0"
msgid "wc1:5fc2e419c521b100 $T $D"
msgstr "Débriefing de la mission, $T, $D.\nsystème Firekka, Secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/1"
msgid "wc1:e8e59fa04c506e5f $R"
msgstr "Votre rapport, $R?"

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/2"
msgid "wc1:776bede21fe650e6 $C"
msgstr "Les officiers de la passerelle m'ont parlé de Khumalo, $C."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/3"
msgid "wc1:cfb0d365f772d2b7"
msgstr "Qu'avez-vous rencontré là-bas?"

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/4"
msgid "wc1:c2b02be8c3e04659"
msgstr "Nous avons rencontré une sorte de porte-astronef kilrathi à Nav 2, mais nous n'avons pas pu l'avoir."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/5"
msgid "wc1:cd2f9dd097610ec5"
msgstr "Je suis tombé sur une sorte de porte-astronef kilrathi à Nav 2, mais je n'ai pas pu l'avoir."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/6"
msgid "wc1:bcf733c8fca13284 $C"
msgstr "C'était probablement le nouveau porte-astronef Snakeir, $C. Le QG l'a signalé près d'Ardai."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/7"
msgid "wc1:93c14512e545b34c"
msgstr "Nous avons rencontré une sorte de porte-astronef kilrathi à Nav 2. Il est détruit, monsieur."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/8"
msgid "wc1:3cedea38a274944f"
msgstr "Je suis tombé sur une sorte de porte-astronef kilrathi à Nav 2. Il est détruit, monsieur."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/9"
msgid "wc1:69a8637f1e307b8f $C"
msgstr "Bien. C'était probablement le nouveau porte-astronef Snakeir, $C. Le QG l'a signalé près d'Ardai."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/10"
msgid "wc1:fd81a9c43a842481"
msgstr "Certains de nos pilotes ont également rencontré un autre nouveau chasseur kilrathi, que le QG appelle le Hhriss expérimental."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/11"
msgid "wc1:6f7bfd505ddae7a2"
msgstr "Je pense que les Hhriss faisaient partie de l'escorte du Snakeir, monsieur. Ils sont très forts."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/12"
msgid "wc1:9ff859376b3be030"
msgstr "Et Knight...?"

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/13"
msgid "wc1:ed28cc61ffc7aa9b"
msgstr "J'ai essayé de le sauver, monsieur. Mais je ne pouvais pas---"

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/14"
msgid "wc1:c583f3d8f90a8123 $C"
msgstr "Je sais, $C. Ça fait mal chaque fois qu'un pilote meurt. Mais c'est la réalite de la guerre, fiston."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/15"
msgid "wc1:5c41ada5b71f6203 $C $K"
msgstr "$C, vous avez descendu $K bandits."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/16"
msgid "wc1:a591876762ae4ecd $C"
msgstr "très bien. $C, vous n'avez fait aucun mort. Pas terrible, fiston."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/17"
msgid "wc1:a0810d844c87b1d1 $L"
msgstr "Et Knight a eu $L Kilrathi."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/18"
msgid "wc1:834c3df82c50cc44"
msgstr "Knight n'a tué aucun chasseur ennemi cette fois."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/19"
msgid "wc1:b5a68cff7ec0ac20"
msgstr "Et puis les chats l'ont tué."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/20"
msgid "wc1:8d155c2b6d89b37e $R"
msgstr "Okay. Reposez-vous avant votre prochaine mission, $R."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/21"
msgid "wc1:5254dd903727230c $C"
msgstr "Et $C, Je dois vous voir dans mon bureau plus tard."

msgctxt "sm2/BRIEFING.002/packet/8/scene/1/record/22"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Rompez."

msgctxt "sm2/BRIEFING.002/packet/8/scene/2/record/0"
msgid "wc1:cbf20c0d0e3fe8e8 $C"
msgstr "$C, laisse-moi te servir un verre. Angel m'a raconté que---"

msgctxt "sm2/BRIEFING.002/packet/8/scene/2/record/1"
msgid "wc1:86e2f1af13734cdb"
msgstr "---beaucoup de pilotes se sont frottés aux Kilrathis hier..."

msgctxt "sm2/BRIEFING.002/packet/8/scene/2/record/2"
msgid "wc1:583451f10bf8517b"
msgstr "...y compris certains de ces Drakhais, la garde imperiale kilrathi."

msgctxt "sm2/BRIEFING.002/packet/8/scene/2/record/3"
msgid "wc1:9aeead3848718c8b"
msgstr "Les officiers de la passerelle pensent qu'ils font partis du convoi."

msgctxt "sm2/BRIEFING.002/packet/8/scene/2/record/4"
msgid "wc1:0c635ce7dfee98b7"
msgstr "Je me souviens quand j'étais pilote..."

msgctxt "sm2/BRIEFING.002/packet/8/scene/2/record/5"
msgid "wc1:e605a1a7044528ba"
msgstr "...ces maudits chats ne faisaient rien sans une bonne raison."

msgctxt "sm2/BRIEFING.002/packet/8/scene/2/record/6"
msgid "wc1:f25bd830311ed54f"
msgstr "Et il n'y a aucune raison pour qu'ils volent par ici. Nous sommes au milieu de nulle part."

msgctxt "sm2/BRIEFING.002/packet/8/scene/2/record/7"
msgid "wc1:a377766b3b828fa5"
msgstr "Il n'y a rien ici, rien du tout..."

msgctxt "sm2/BRIEFING.002/packet/8/scene/2/record/8"
msgid "wc1:3ad97ed501f393fb"
msgstr "...sauf nous, n'est ce pas?"

msgctxt "sm2/BRIEFING.002/packet/8/scene/3/record/0"
msgid "wc1:2fadc12bba899e8c $C"
msgstr "$C, Je suis curieux... qu'as-tu pensé de Firekka?"

msgctxt "sm2/BRIEFING.002/packet/8/scene/3/record/1"
msgid "wc1:2c2f28b91d384a09"
msgstr "C'est un endroit intéressant. Cependant il m'a fallu quelques jours pour m'habituer à la gravité inférieure."

msgctxt "sm2/BRIEFING.002/packet/8/scene/3/record/2"
msgid "wc1:1dcc9076cda66c19"
msgstr "Le capitaine Larrhi était mon guide --- il a été l'un des premiers Firekka à quitter sa planète."

msgctxt "sm2/BRIEFING.002/packet/8/scene/3/record/3"
msgid "wc1:0872996f61ea9d01"
msgstr "Il pilote des transports Confed maintenant. J'espère qu'il passera à la formation de pilote de combat."

msgctxt "sm2/BRIEFING.002/packet/8/scene/3/record/4"
msgid "wc1:f802aff65234a067"
msgstr "J'aimerais le rencontrer. Peut-être quand j'aurais un vrai congé...."

msgctxt "sm2/BRIEFING.002/packet/8/scene/3/record/5"
msgid "wc1:479d8c4095a57b26"
msgstr "...Je vais amener ma femme et ma fille ici pour des vacances."

msgctxt "sm2/BRIEFING.002/packet/8/scene/3/record/6"
msgid "wc1:a879bf385fdfbf2f"
msgstr "C'est une excellente idée, Kien."

msgctxt "sm2/BRIEFING.002/packet/8/scene/4/record/0"
msgid "wc1:5de87d48f48ece5f"
msgstr "Je suis content que tu aies passé une bonne perme, mon garçon."

msgctxt "sm2/BRIEFING.002/packet/8/scene/4/record/1"
msgid "wc1:4f69fbe123446c43"
msgstr "Je pensais que je volerais là-bas pour un petit séjour, mais ils ont annulé tous les congés."

msgctxt "sm2/BRIEFING.002/packet/8/scene/4/record/2"
msgid "wc1:3882c716fb159790"
msgstr "J'aime visiter les planètes. C'est ce que je ferai, quand je prendrai ma retraite le mois prochain."

msgctxt "sm2/BRIEFING.002/packet/8/scene/4/record/3"
msgid "wc1:eb3c793410c36a66"
msgstr "J'achèterai un petit vaisseau pour passer mes journées à voler de planète en planète."

msgctxt "sm2/BRIEFING.002/packet/8/scene/4/record/4"
msgid "wc1:b4c8bf2066fd7431"
msgstr "Je vais devoir mettre toute ma bourse pour le faire. mais au moins je serai encore en train de piloter."

msgctxt "sm2/BRIEFING.002/packet/8/scene/4/record/5"
msgid "wc1:437649c7dca6fcbd"
msgstr "Je pense que c'est une bonne idée, James. C'est probablement ce que je ferais quand je serai à la retraite."

msgctxt "sm2/BRIEFING.002/packet/8/scene/4/record/6"
msgid "wc1:921b436f1887f16b $C"
msgstr "Oh, mais t'as encore quelques années avant que celà n'arrive, $C."

msgctxt "sm2/BRIEFING.002/packet/8/scene/4/record/7"
msgid "wc1:96236d036fd92b4b"
msgstr "Je parie que tu auras une longue carrière devant toi..."

msgctxt "sm2/BRIEFING.002/packet/8/scene/4/record/8"
msgid "wc1:5c6dfac0ce4c4d2d"
msgstr "...une très longue carrière même. Retiens ce que je te dis, mon garçon."

msgctxt "sm2/BRIEFING.002/packet/8/scene/4/record/9"
msgid "wc1:8eaf03fa37f534b6"
msgstr "Quant à moi, si piloter mon propre vaisseau ne me suffit pas---"

msgctxt "sm2/BRIEFING.002/packet/8/scene/4/record/10"
msgid "wc1:36875a46d2538d51"
msgstr "---Je suis sûr que je trouverais un autre moyen de garder un peu d'excitation dans ma vie."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/0"
msgid "wc1:7548acc0fad899a9 $T $D"
msgstr "Briefing de mission, $T, $D.\nsystème Firekka, Secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/1"
msgid "wc1:294a46725406fcb4"
msgstr "Pilotes, nous avons de très mauvaises nouvelles."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/2"
msgid "wc1:a306ae8dc71e7930"
msgstr "Nous avons reçu la confirmation du haut commandement confédéré..."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/3"
msgid "wc1:7465f234faaaee43"
msgstr "...que les Kilrathis retirent leurs flottes des autres secteurs..."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/4"
msgid "wc1:faeb31ea4bfb14c4"
msgstr "...et TOUS ces vaisseaux sont en route pour ici."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/5"
msgid "wc1:f4ab9f31d25fca59"
msgstr "La Conféd se hâte déjà pour nous envoyer des renforts."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/6"
msgid "wc1:ad58e0d864439f2f"
msgstr "Mais celà prendra du temps, et le temps est la seule chose que nous n'avons PAS."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/7"
msgid "wc1:1cd0516ec4703cd9"
msgstr "Notre première priorité est la sécurité des diplomates sur Firekka. Nous devons les évacuer de la planète."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/8"
msgid "wc1:26a464eee34715f0"
msgstr "Alors je vous envoie protèger leurs vaisseaux pendant qu'ils sautent hors du système."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/9"
msgid "wc1:a017a98b0135f405"
msgstr "Voici vos affectations d'escadrons..."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/10"
msgid "wc1:254ca2f76f91a63a"
msgstr "Il donne ses ordres pour chaque escadron, puis..."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/11"
msgid "wc1:53478a06a93f75e5 $C"
msgstr "$C et Knight sont l'escadron Epsilon."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/12"
msgid "wc1:318ee49d0298ba20 $C"
msgstr "Escadron Epsilon -- $C, vous serez seul."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/13"
msgid "wc1:9c55f319ef3dfab7"
msgstr "Volez directement vers vos points de rendez-vous avec les vaisseaux du corps diplomatique."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/14"
msgid "wc1:756b1769a858dde1"
msgstr "Votre priorité absolue sont ces vaisseaux diplomatiques. Vous protègerez le TCS U Thant alors qu'il saute à Nav 2..."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/15"
msgid "wc1:275fb0c0594dc058"
msgstr "...et le TCS Trygvie Lie lors de son saut à Nav 3."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/16"
msgid "wc1:af47e01f854775d2"
msgstr "Si vous êtes attaqué par un Kilrathi, ripostez et tuez-le."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/17"
msgid "wc1:7818f4f8912a3ad4"
msgstr "Une fois que les officiers du corps diplomatique seront en securité, nous examinerons nos autres options."

msgctxt "sm2/BRIEFING.002/packet/9/scene/0/record/18"
msgid "wc1:8842e46c5d2e68b9"
msgstr "Rompez, pilotes."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/1"
msgid "wc1:0cd725ea9f16d1d9"
msgstr "Je suis content que vous soyez revenus tous les deux."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/2"
msgid "wc1:8bb55da8dc398e09"
msgstr "J'ai de mauvaises nouvelles pour vous, pilotes... nous avons perdu Bossman aujourd'hui."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/3"
msgid "wc1:4de4a240e2614be9 $R"
msgstr "Je suis content de vous revoir vivant, $R."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/4"
msgid "wc1:0526fd05bc355793"
msgstr "J'ai perdu Knight, monsieur. je ne pouvais tout simplement pas---"

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/5"
msgid "wc1:c583f3d8f90a8123 $C"
msgstr "Je sais, $C. Ca fait mal a chaque fois qu'un pilote meurt. Mais c'est la réalité de la guerre, fiston."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/6"
msgid "wc1:b283f248ec4ee286 $C"
msgstr "En plus de mauvaises nouvelles, $C... nous avons perdu Bossman aujourd'hui."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/7"
msgid "wc1:83c29dce00413ca8"
msgstr "Lui et Angel ont été pris en embuscade par plusieurs escadrons de gardes impériaux kilrathis. Ils n'ont pas eu de chance."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/8"
msgid "wc1:8f9200da1bfc4c6f"
msgstr "Est-ce qu'Angel va bien, monsieur?"

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/9"
msgid "wc1:ba4c767b5c594fb1"
msgstr "Elle n'a pas été gravement blessée. Ils la laisseront sortir de l'infirmerie dans quelques heures."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/10"
msgid "wc1:86800b717ce501e3"
msgstr "Nous reporterons les funerailles jusqu'à ce que la femme de Bossman puissent y assister."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/11"
msgid "wc1:32b3cdcae68e9a0d"
msgstr "Et je viens de terminer une conférence vidlink avec le TCS Austin. Ils se retirent pour une position plus défendable."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/12"
msgid "wc1:424d3e1ec4d3a334"
msgstr "Mais nous emprunterons quelques-uns de leurs pilotes de combat pour les prochains jours."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/13"
msgid "wc1:7d46aba4f51f95f9 $C"
msgstr "très bien, $C, j'écoute votre rapport."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/14"
msgid "wc1:f9fbb55eb16b26c6"
msgstr "Je suis parti à la rencontre des vaisseaux du corps diplomatique aux points de rendez-vous."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/15"
msgid "wc1:aab843a666750afb"
msgstr "Nous sommes partis à la rencontre des vaisseaux du corps diplomatique aux points de rendez-vous."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/16"
msgid "wc1:bc424c5a3b3ed5cb"
msgstr "Les Kilrathis attendaient pour nous intercepter, Colonel."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/17"
msgid "wc1:fdcc6aefc8fdf0f6"
msgstr "Les deux vaisseaux ont survecu, monsieur. Ils sont en route vers le QG de la Conféd maintenant."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/18"
msgid "wc1:f5ac109a2ebf3674 $C"
msgstr "Bon travail, $C ! Je savais que vous ne nous décevriez pas."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/20"
msgid "wc1:45a9cf0abaa20e86"
msgstr "Je n'ai pas pu sauver le TCS U Thant et le Trygvie Lie. Je suis désolé monsieur."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/22"
msgid "wc1:0ec72af2236fbb50"
msgstr "Nous avons perdu l'un des vaisseaux du corps diplomatique. Je suis désolé monsieur."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/23"
msgid "wc1:e08399e9781f1a88"
msgstr "Mais l'autre vaisseau a survécu. Ils devraient être en route vers le QG de la Conféd maintenant."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/24"
msgid "wc1:0ec72af2236fbb50"
msgstr "J'ai perdu l'un des vaisseaux du corps diplomatique. Je suis désolé monsieur."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/25"
msgid "wc1:e08399e9781f1a88"
msgstr "Mais l'autre vaisseau a survécu. Ils devraient être en route vers le QG de la Conféd maintenant."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/26"
msgid "wc1:c9da39996a6da14c"
msgstr "Je sais que vous avez fait de votre mieux... mais certaines des personnes les plus importantes de la Confédération étaient sur ces vaisseaux."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/27"
msgid "wc1:2943b18221d36052 $R"
msgstr "Nous en discuterons plus tard, $R."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/28"
msgid "wc1:51f8c9c8442c49a0 $C $K"
msgstr "Pour mémoire, $C, tu as tué $K Kilrathis."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/29"
msgid "wc1:8baedcaf5d83d969 $C"
msgstr "Pour mémoire, $C, vous n'avez aucun tué."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/30"
msgid "wc1:8c257217ee449b33 $L"
msgstr "Knight a eu $L."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/31"
msgid "wc1:8c08eab7ac8d3316"
msgstr "Knight n'a tué aucun chat lors de cette mission."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/32"
msgid "wc1:23725c79be537700 $C"
msgstr "$C, J'aurai besoin de vous voir dans mon bureau dès que possible."

msgctxt "sm2/BRIEFING.002/packet/9/scene/1/record/33"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Rompez."

msgctxt "sm2/BRIEFING.002/packet/9/scene/2/record/0"
msgid "wc1:98d4fd2c1f36f8cd $C"
msgstr "Hey, $C. J'ai entendu dire que tu avais eu un vol difficile."

msgctxt "sm2/BRIEFING.002/packet/9/scene/2/record/1"
msgid "wc1:398d0ee212aaf476"
msgstr "Rien que je ne puisse gérer, Sam."

msgctxt "sm2/BRIEFING.002/packet/9/scene/2/record/2"
msgid "wc1:24af43c414845078"
msgstr "Heureux de l'entendre. Ecoute, je regardais Jerry Rivers sur le réseau Galaxy News---"

msgctxt "sm2/BRIEFING.002/packet/9/scene/2/record/3"
msgid "wc1:3c49360cbd5a8b24"
msgstr "Mauvaise idée, Sam. Ce spectacle va t'abrutir."

msgctxt "sm2/BRIEFING.002/packet/9/scene/2/record/4"
msgid "wc1:83dc06d1af80912c"
msgstr "Eh bien, c'était à propos du secteur Deneb. Un autre retrait de la flotte kilrathi."

msgctxt "sm2/BRIEFING.002/packet/9/scene/2/record/5"
msgid "wc1:65ab2c356d25f467"
msgstr "Tous les vaisseaux de ces fumiers viennent de partir, sans aucune raison."

msgctxt "sm2/BRIEFING.002/packet/9/scene/2/record/6"
msgid "wc1:61375349f615c5f7"
msgstr "Je suis un peu inquiet à ce sujet... ça n'a aucun sens, non?"

msgctxt "sm2/BRIEFING.002/packet/9/scene/3/record/0"
msgid "wc1:85ae16e54bde50ed $C"
msgstr "Bonjour, $C."

msgctxt "sm2/BRIEFING.002/packet/9/scene/3/record/1"
msgid "wc1:5cbc0901bcd97e74"
msgstr "Je viens de rendre une visite à Maniac à l'infirmerie."

msgctxt "sm2/BRIEFING.002/packet/9/scene/3/record/2"
msgid "wc1:0e52d38b59091511"
msgstr "Il veut retourner au service actif, mais les médecins ne veulent pas."

msgctxt "sm2/BRIEFING.002/packet/9/scene/3/record/3"
msgid "wc1:202b037aa3661815"
msgstr "Bien. J'espère que je ne volerai plus jamais une autre mission avec lui."

msgctxt "sm2/BRIEFING.002/packet/9/scene/3/record/4"
msgid "wc1:fa6b4ee0e3c68d3b $C"
msgstr "Les autres pilotes sur ce vaisseau pensent comme toi, $C!"

msgctxt "sm2/BRIEFING.002/packet/9/scene/3/record/5"
msgid "wc1:5c341ca7c2815cae"
msgstr "T'ai-je dit que le colonel Halcyon m'a convoqué dans son bureau hier?"

msgctxt "sm2/BRIEFING.002/packet/9/scene/3/record/6"
msgid "wc1:f9a4ff27ff446941"
msgstr "Il s'avére que le QG de la Confédération pense que je serais un bon instructeur de vol."

msgctxt "sm2/BRIEFING.002/packet/9/scene/3/record/7"
msgid "wc1:7149785d810c15b1"
msgstr "Mais je ne me vois pas quitter le combat pour diriger un escadron d'entrainement."

msgctxt "sm2/BRIEFING.002/packet/9/scene/3/record/8"
msgid "wc1:2d3487b55a3358aa $C"
msgstr "C'est plus important, $C --- ce que nous faisons ici sur le griffe du tigre."

msgctxt "sm2/BRIEFING.002/packet/9/scene/3/record/9"
msgid "wc1:6e6116b81c5631b1"
msgstr "Former la prochaine génération de pilotes de chasse... c'est important aussi, Joseph."

msgctxt "sm2/BRIEFING.002/packet/9/scene/3/record/10"
msgid "wc1:ed0bc54c822080b6"
msgstr "Je sais. J'ai quelques jours pour y réflechir... Je te ferai savoir ce que je déciderais."

msgctxt "sm2/BRIEFING.002/packet/9/scene/4/record/0"
msgid "wc1:d4ee5f46d4842337 $C"
msgstr "Bonjour, $C. J'espère que tu as eu un bon vol. Je viens de rentrer---"

msgctxt "sm2/BRIEFING.002/packet/9/scene/4/record/1"
msgid "wc1:a11774c7661c74b4"
msgstr "---d'escorte d'un vaisseau de recherche, le TCS Tsiolkovsky, jusqu'à leur système."

msgctxt "sm2/BRIEFING.002/packet/9/scene/4/record/2"
msgid "wc1:3d71c2edc0d4cd0d"
msgstr "Et j'ai reçu le rapport final de la station Epsilon."

msgctxt "sm2/BRIEFING.002/packet/9/scene/4/record/3"
msgid "wc1:3052a8134f501460"
msgstr "Ils ont confirmé que mon fiancé a été capturé par les Kilrathis."

msgctxt "sm2/BRIEFING.002/packet/9/scene/4/record/4"
msgid "wc1:7977db5124e4a4cd"
msgstr "Je suis désolé, Mariko. J'aimerais qu'il y ait quelque chose que je puisse faire."

msgctxt "sm2/BRIEFING.002/packet/9/scene/4/record/5"
msgid "wc1:fafee5507041e948"
msgstr "Je pensais qu'il pouvait être sauvé, qu'il y avait une chance---"

msgctxt "sm2/BRIEFING.002/packet/9/scene/4/record/6"
msgid "wc1:282795f005d023f3"
msgstr "---mais je ne peux plus me mentir."

msgctxt "sm2/BRIEFING.002/packet/9/scene/4/record/7"
msgid "wc1:7a291f376b95da2d"
msgstr "Je n'ai jamais vraiment détesté les Kilrathis, même s'ils ont causé la mort de mon pére..."

msgctxt "sm2/BRIEFING.002/packet/9/scene/4/record/8"
msgid "wc1:6a8edf7a338be0b8"
msgstr "...mais maintenant."

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/0"
msgid "wc1:7548acc0fad899a9 $T $D"
msgstr "Briefing de mission, $T, $D.\nsystème Firekka, Secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/1"
msgid "wc1:93554e7461a64edb"
msgstr "Pilotes, nous avons eu de l'inhabituel. Le QG a reçu une transmission vidlink codée---"

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/2"
msgid "wc1:5a02e6ef3dc5bd53"
msgstr "---d'un commandant kilrathi dans la flotte de combat qui approche."

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/3"
msgid "wc1:b708328a43b17cbf"
msgstr "Le capitaine Ralgha et ses officiers supérieurs demandent asile à la Confédération."

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/4"
msgid "wc1:a61ebbf1b2f59371"
msgstr "Et ils aménent un Fralthi et vingt vaisseaux de combat kilrathis avec eux."

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/5"
msgid "wc1:0d59291d8eb8d056"
msgstr "Votre mission est simple. Assurez-vous que ces officiers et vaisseaux arrivent ici intacts."

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/6"
msgid "wc1:929cfed4e0ae945d"
msgstr "Les pilotes du TCS Austin ont déjà rendez-vous avec le Fralthi volé."

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/7"
msgid "wc1:b95be3c6f2926e17"
msgstr "Il y a donc un équipage humain à bord, juste au cas où les chats changeraient d'avis."

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/8"
msgid "wc1:4e4d83dfb5e62158"
msgstr "La plupart d'entre vous escorteront les chasseurs kilrathis---"

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/9"
msgid "wc1:d25d57a8e734bac1"
msgstr "---mais j'ai besoin de quelqu'un pour ramener le Fralthi."

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/10"
msgid "wc1:981e907ecb7a89b8"
msgstr "Je sais que je peux le faire, colonel."

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/11"
msgid "wc1:2148e7ee7ff4bd49 $C"
msgstr "D'accord, $C. Vous et Spirit piloterez en tant qu'escadron Omicron."

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/12"
msgid "wc1:d53d97fa39359690 $C"
msgstr "D'accord, $C, mais vous êtes seul cette fois pour l'escadron Omicron."

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/13"
msgid "wc1:c3c835dba424b98c"
msgstr "Voici votre plan de vol---"

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/14"
msgid "wc1:bc30ab575010ffc4"
msgstr "Dirigez-vous vers le point de rendez-vous à Nav 1---"

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/15"
msgid "wc1:6cda03cf7736596f"
msgstr "---vérifier votre itinéraire pour les chasseurs ennemis. Les Kilrathis ne savent pas que Ralgha déserte---"

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/16"
msgid "wc1:9657a9a14d31968e"
msgstr "Mais nous ne pouvons prendre aucun risque. Vous rencontrerez le Fralthi à Nav 1 et l'escorterez ici."

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/17"
msgid "wc1:68dd426436692796"
msgstr "Le colonel affecte rapidement les autres pilotes."

msgctxt "sm2/BRIEFING.002/packet/12/scene/0/record/18"
msgid "wc1:3f4ebd0f8b3ac441"
msgstr "Bonne chance, pilotes. Rompez."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/1"
msgid "wc1:8e791295a93e9908"
msgstr "Content de vous revoir tous les deux."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/2"
msgid "wc1:26d923ee2ae87570 $C"
msgstr "Content de vous voir de retour, $C."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/3"
msgid "wc1:d30c9c7c36951798"
msgstr "Et Spirit...?"

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/4"
msgid "wc1:dabdb5dd9c2c5d76"
msgstr "J'ai essayé de la sauver, monsieur. Mais je ne pouvais pas---"

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/5"
msgid "wc1:a424eac3a268ead6 $N"
msgstr "Je sais, $N. Mais elle est morte en combattant les Kilrathis... une mort honorable."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/6"
msgid "wc1:7d46aba4f51f95f9 $C"
msgstr "très bien, $C, j'écoute votre rapport."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/7"
msgid "wc1:722094d504f14150"
msgstr "Je me suis dirigé vers le Fralthi capturé. Les Kilrathis devaient savoir ce que Ralgha prévoyait---"

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/8"
msgid "wc1:5ad51eaa1f3a1342"
msgstr "---car il y avait un comité d'accueil qui l'attendait."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/9"
msgid "wc1:33d83a311c3ba50b"
msgstr "Mais j'ai ramené le Fralthi, monsieur. Il devrait accoster maintenant."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/10"
msgid "wc1:5566e6a9361e127a"
msgstr "Excellent ! Nous transmettrons un message sur une fréquence codée que nous savons que les chats ont piratée---"

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/11"
msgid "wc1:8dbca46c35adddb4"
msgstr "---disant que le Fralthi a été détruit dans un champ de mines. Avec un peu de chance, ils n'essaieront pas de le reprendre."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/12"
msgid "wc1:2045950a68190778"
msgstr "Je n'ai pas pu sauver le Fralthi, monsieur. L'opposition était tout simplement trop féroce."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/13"
msgid "wc1:b89116f8375debb8 $C"
msgstr "Votre incompétence nous a couté un vaisseau, $C, avec l'équipage humain et kilrathi."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/14"
msgid "wc1:6309d925ae0c0d5e"
msgstr "Au moins, le capitaine Ralgha a réussi a s'éjecter et les autres pilotes ont amené les chasseurs capturés---"

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/15"
msgid "wc1:1e9a05fbfb5e0b36"
msgstr "---donc cette mission n'est pas un échec total ."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/16"
msgid "wc1:d6158d406dc376ce $R"
msgstr "Je vois sur votre enregistreur de vol que vous avez eu un Fralthi ennemi. Pas mal, $R."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/17"
msgid "wc1:81ad00eb2040f181 $C $K"
msgstr "$C, votre journal montre $K."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/18"
msgid "wc1:9f81636ab175d49d $C"
msgstr "Pas de tué, $C ? Que faisiez-vous là-bas?"

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/19"
msgid "wc1:8d405afbce56d635 $L"
msgstr "Spirit a eu $L Kilrathi."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/20"
msgid "wc1:41c2930db98296c3"
msgstr "Et Spirit n'a tué aucun chat."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/21"
msgid "wc1:e87b78b6986e86ff"
msgstr "Je m'excuse pour mon échec, colonel."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/22"
msgid "wc1:9bce828764d85898"
msgstr "Et puis nous l'avons perdue. Merde, le Tigre ne peut pas se permettre de perdre des pilotes en ce moment."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/23"
msgid "wc1:86576b572eca9e08 $R"
msgstr "Je dois vous parlez dans mon bureau plus tard, $R."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/24"
msgid "wc1:a57d9ac4be45932a $C"
msgstr "Vous avez quelques heures avant votre prochaine mission, $C. Reposez-vous, fiston."

msgctxt "sm2/BRIEFING.002/packet/12/scene/1/record/25"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Rompez."

msgctxt "sm2/BRIEFING.002/packet/12/scene/2/record/0"
msgid "wc1:ceb586ef035a7782 $C"
msgstr "Bonjour, $C. Les boissons sont pour la maison aujourd'hui."

msgctxt "sm2/BRIEFING.002/packet/12/scene/2/record/1"
msgid "wc1:a8614f86910d4c53"
msgstr "Un toast à Bossman, l'un des derniers grands pilotes."

msgctxt "sm2/BRIEFING.002/packet/12/scene/2/record/2"
msgid "wc1:774585a1ed7cbb6a"
msgstr "Je suis content de ne pas être à la place du colonel Halcyon..."

msgctxt "sm2/BRIEFING.002/packet/12/scene/2/record/3"
msgid "wc1:e8d2bdef2a16ce83"
msgstr "...expliquer à une femme avec un jeune bébé..."

msgctxt "sm2/BRIEFING.002/packet/12/scene/2/record/4"
msgid "wc1:ec4e6cd880e20dfa"
msgstr "...qu'elle est veuve?"

msgctxt "sm2/BRIEFING.002/packet/12/scene/2/record/5"
msgid "wc1:e16fd6882eddf929 $C"
msgstr "Tu devrais peut-être aller parler à Angel, $C."

msgctxt "sm2/BRIEFING.002/packet/12/scene/2/record/6"
msgid "wc1:2b0a4766356c647c"
msgstr "Je ne pense pas qu'elle gère ça très bien."

msgctxt "sm2/BRIEFING.002/packet/12/scene/2/record/7"
msgid "wc1:28edc63000df852e"
msgstr "C'est juste que j'ai vu trop de pilotes mourir dans cette guerre..."

msgctxt "sm2/BRIEFING.002/packet/12/scene/2/record/8"
msgid "wc1:1fbb6cb6ea5b860f"
msgstr "...ça me fait moins mal que les autres."

msgctxt "sm2/BRIEFING.002/packet/12/scene/3/record/0"
msgid "wc1:3b968cf645ca0208 $C"
msgstr "Pardonne-moi, $C, mais je ne souhaite pas te parler maintenant."

msgctxt "sm2/BRIEFING.002/packet/12/scene/3/record/2"
msgid "wc1:0dc9e873afe6809d"
msgstr "Non. Bossman est mort aujourd'hui, il était dans mon escadron."

msgctxt "sm2/BRIEFING.002/packet/12/scene/3/record/3"
msgid "wc1:6fbaf933f79190bc"
msgstr "Il n'y a rien que tu puisses dire pour changer ça."

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/0"
msgid "wc1:3cfd2d07c83c99b1"
msgstr "Assieds-toi, mon garçon. Je veux que tu parles à Jeannette---"

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/1"
msgid "wc1:d1d3a1e7aacb8149"
msgstr "Il n'y a rien que vous puissez me dire maintenant."

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/2"
msgid "wc1:b2ace4469fac7d50"
msgstr "Bossman est mort, et c'est de ma faute."

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/3"
msgid "wc1:f5484e5dc4466756"
msgstr "Ecoute-moi, jeune fille. Nous connaissons tous les risques quand nous volons là-haut."

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/4"
msgid "wc1:cd3d340fb662e65b"
msgstr "Crois-moi, tu ne pouvais rien faire. Toi et lui, contre tous ces Kilrathis?"

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/5"
msgid "wc1:f738014b276780f3"
msgstr "Nous avons eu de la chance de n'avoir perdu que Bossman."

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/6"
msgid "wc1:75b37e8f4c5f1e46"
msgstr "Je suis désolé, mon ami, mais je ne te crois pas."

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/7"
msgid "wc1:c51a4f1e06f47cbf"
msgstr "Angel, tu es l'une des meilleures pilotes de la Confédération."

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/8"
msgid "wc1:4a965a0cd2e33b59"
msgstr "Mais Paladin à raison. Parfois on ne peut pas gagner."

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/9"
msgid "wc1:f167af5bbabf11b5"
msgstr "Mais j'aurais dû le sauver, et je ne l'ai pas fait."

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/10"
msgid "wc1:76fc511d33487961"
msgstr "J'ai essayé de ne pas me soucier de Bossman, de toi, et des autres dans cet escadron---"

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/11"
msgid "wc1:84912bedcc0d1a4f"
msgstr "---sachant que n'importe lequel d'entre vous pourrait être tué à tout moment---"

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/12"
msgid "wc1:14df1e62f3a7ac28"
msgstr "Mais nous savons tous qu'il est impossible de ne pas s'en soucier."

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/13"
msgid "wc1:e2b69cf79265a0c2"
msgstr "S'il vous plait, je souhaite être seule maintenant."

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/14"
msgid "wc1:da530050b5bf02fd"
msgstr "Assieds-toi, mon garcon. Je ne sais pas si tu as entendu---"

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/15"
msgid "wc1:4f992d0be84fc2b5"
msgstr "---Bossman a été tué il y a quelques heures, contre les Kilrathis."

msgctxt "sm2/BRIEFING.002/packet/12/scene/4/record/16"
msgid "wc1:9cd411fc7aa5398a"
msgstr "Je n'ai pas eu la chance de lui dire au revoir."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/0"
msgid "wc1:7548acc0fad899a9 $T $D"
msgstr "Briefing de mission, $T, $D.\nsystème Firekka, Secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/1"
msgid "wc1:ad315fd3436025c0"
msgstr "D'accord, tout le monde. Je pense que vous réalisez a quel point notre situation est gràve ici---"

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/2"
msgid "wc1:109a919fcf7b8dcd"
msgstr "---et ça devient de pire en pire."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/3"
msgid "wc1:41eb122a4c0495a2"
msgstr "Nous avons reçu des rapports sur deux flottes de combat kilrathis supplémentaires..."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/4"
msgid "wc1:be38190b47f906f7"
msgstr "...qui ont traversé la frontière de Tau Ceti et sont en route ici."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/5"
msgid "wc1:0f72fe4e5dd61fc0"
msgstr "Et j'ai là quelque-chose à vous lire. C'est une transcription d'un message vidlink..."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/6"
msgid "wc1:ae78d1c11b1b0bb9"
msgstr "...nous l'avons reçu de la flotte kilrathi en approche il y a deux heures."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/7"
msgid "wc1:95b6f94ce0936b47"
msgstr "'Guerriers humains, écoutez-moi maintenant. Vous êtes---'"

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/8"
msgid "wc1:113793d4317d9ceb"
msgstr "'---sur la terre sainte du Seigneur Sivar. Si vous restez, les Fils de Kilrah vous tueront.'"

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/9"
msgid "wc1:da502a2696eb5e0a"
msgstr "'Nous devons préparer la Voie du Seigneur Sivar, et aucun incroyant ne peut rester ici en vie.'"

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/10"
msgid "wc1:31358d65b8880f7d"
msgstr "'Mais parce que vous êtes de braves guerriers, je vous accorderai ceci:"

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/11"
msgid "wc1:10121e10be01fba7"
msgstr "'Vous avez une rotation planètaire pour quitter ce système.'"

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/12"
msgid "wc1:1612d9474d386e3f"
msgstr "'Partez d'ici maintenant, et aucun mal ne vous arrivera---'"

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/13"
msgid "wc1:d0b4aeb007b138d0"
msgstr "'---jusqu'à ce que nous nous retrouvions dans un combat honorable.'"

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/14"
msgid "wc1:cfffd895c5c950fc"
msgstr "'Ainsi parle le Prince Thrakhath, Héritier de Kilrah.'"

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/15"
msgid "wc1:047f5bddb014a4e5"
msgstr "Nous savons que ce prince Thrakhath est le petit-fils de l'empereur kilrathi, et peut-être leur meilleur pilote de chasse."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/16"
msgid "wc1:d04cbe4d791cb40f"
msgstr "Et nous savons que Sivar est un dieu de la guerre kilrathi. c'est pourquoi nous avons utilisé ce nom pour le cuirassé qui a attaqué Goddard."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/17"
msgid "wc1:90de01ca6a7bf1ef"
msgstr "Mais nous ne savons pas ce que pourrait être cette 'Voie du Seigneur Sivar'."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/18"
msgid "wc1:03e5cb53290bf47c"
msgstr "Pilotes, on va rester ici, même si c'est évident---"

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/19"
msgid "wc1:78e266c6678e84eb"
msgstr "---qu'il n'y a pas grand-chose que nous puissions faire contre une flotte de cette taille."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/20"
msgid "wc1:9261e7770593abb4"
msgstr "Notre premiere étape consistera à 'se retirer' dans un système stellaire proche."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/21"
msgid "wc1:49a1e7e01db81636"
msgstr "Avec de la chance, les Kilrathis croiront que nous avons quitté le secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/22"
msgid "wc1:74bd77dbd2756db5"
msgstr "Et puis on attendra les nouveaux ordres du QG de la Conféd."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/23"
msgid "wc1:e0adba080e208717"
msgstr "Votre mission est de dégager la route."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/24"
msgid "wc1:1e51257a5d5346cc"
msgstr "Je ne veux pas d'héroïsme là-bas. Juste des pilotes compétents."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/25"
msgid "wc1:54792b610dd87adc"
msgstr "Il y a de fortes chances que vous rencontriez la premiere flotte d'attaque kilrathi se déplaçant dans ce système."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/26"
msgid "wc1:4460a3296003e03f"
msgstr "Si vous le pouvez, engagez-les et détruisez-les."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/27"
msgid "wc1:12a95c695122af02"
msgstr "L'Austin quitte déjà cette zone. Nous le retrouverons plus tard."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/28"
msgid "wc1:1780c82cfe5e6a4b"
msgstr "Avec de la chance, nous pourrons infliger de sérieux dégâts à ce prince Thrakhath et sa flotte."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/29"
msgid "wc1:11ca60a6a6884c5b"
msgstr "Que deviens Firekka, monsieur?"

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/30"
msgid "wc1:40df8fe6916bb9bc $C"
msgstr "Nous allons commencer une évacuation majeure, $C, dès que d'autres vaisseaux de la Conféd arriveront."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/31"
msgid "wc1:346148864e74eed0"
msgstr "Voici vos affectations d'escadrons..."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/32"
msgid "wc1:47cb8eaef053238d"
msgstr "Paladin et Hunter seront l'ecadron Alpha. Suivez la route de Nav, pilotes."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/33"
msgid "wc1:7f6f05aaad2398d9 $C $C"
msgstr "$C, vous et Spirit êtes l'escadron Beta. $C sera le chef."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/34"
msgid "wc1:bb6eaf586d24b03f $C"
msgstr "$C, vous volerez seul en tant qu'escadron Beta."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/35"
msgid "wc1:2c68967473275fec"
msgstr "Le commandant affecte d'autres escadrons, puis lit la mission de Beta:"

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/36"
msgid "wc1:cc25c7e7573ce86b"
msgstr "Nous avons détecté plusieurs transports d'évacuation firekka quittant le système, dirigés par le capitaine Larrhi."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/37"
msgid "wc1:2275370e10deaa98"
msgstr "Un transport se dirige vers le point de saut Nav 3. Protégez ce vaisseau."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/38"
msgid "wc1:3fe68ca458e8413a"
msgstr "Et puis patrouillez le reste de vos points de navigation en détruisant les ennemis."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/39"
msgid "wc1:87a655b9643e6bbb"
msgstr "Nous ne savons pas quels vaisseaux kilrathis sont là-bas, pilotes, alors soyez prudents."

msgctxt "sm2/BRIEFING.002/packet/13/scene/0/record/40"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/1"
msgid "wc1:e6f7a75530a7a062 $R"
msgstr "Content de vous revoir, $R."

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/2"
msgid "wc1:6604885ae3107669"
msgstr "J'ai perdu Spirit, monsieur. je ne pouvais tout simplement pas---"

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/3"
msgid "wc1:a424eac3a268ead6 $N"
msgstr "Je sais, $N. Mais elle est morte en combattant les Kilrathis... une mort honorable."

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/4"
msgid "wc1:4a3f04ef1765dc5f"
msgstr "Avez-vous quelque chose à signaler?"

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/5"
msgid "wc1:0e8f4089a022191b"
msgstr "Oui Monsieur. L'un des transports Firekka était attaqué à Nav 2---"

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/6"
msgid "wc1:d4dc33d0c2eb9d68"
msgstr "---les Kilrathis ont essayé de l'intercepter, mais ils n'ont eu aucune chance."

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/7"
msgid "wc1:d49e796ca83de88f"
msgstr "Le transport a sauté hors du système, monsieur."

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/8"
msgid "wc1:3cb83514eee3c0cf"
msgstr "---les Kilrathis l'ont intercepté et détruit. Impossible de les arrêter, monsieur."

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/9"
msgid "wc1:b10fa8f0fa32bddc"
msgstr "Un escadron de Grathas attaquait l'Austin en sortant du système, monsieur."

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/10"
msgid "wc1:af48850cace110c8"
msgstr "Mais il a sauté hors du système avant que les Kilrathis lui ai infligé de réels dégâts."

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/11"
msgid "wc1:6e34ca94e307f8bc $K $C"
msgstr "D'après l'enregistreur de vol, je vois que vous avez eu $K, $C."

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/12"
msgid "wc1:77aed8708811be69 $C"
msgstr "$C, vous n'avez pas eu de chats cette fois. Vous êtes généralement meilleur que ça, fiston."

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/13"
msgid "wc1:6ad2f449499fb112 $L"
msgstr "Et Spirit a $L."

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/14"
msgid "wc1:63b4c8ba70a76d1a"
msgstr "Spirit n'a eu aucun Kilrathi."

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/15"
msgid "wc1:bdb069652188000d"
msgstr "Et puis nous l'avons perdue. Merde, le Tigre ne peut pas se permettre de perdre des pilotes."

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/16"
msgid "wc1:2a66bea935198fbe $C"
msgstr "$C, J'aurai besoin de vous voir dans mon bureau plus tard."

msgctxt "sm2/BRIEFING.002/packet/13/scene/1/record/17"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm2/BRIEFING.002/packet/13/scene/2/record/0"
msgid "wc1:938e81584d3dca19 $C"
msgstr "Laisse-moi verser ta boisson habituelle $C. Ecoute, il y avait quelques officiers de pont ici---"

msgctxt "sm2/BRIEFING.002/packet/13/scene/2/record/1"
msgid "wc1:702d7b17570f41f5"
msgstr "---ils parlaient de la façon dont nous devrions nous retirer du système Firekka."

msgctxt "sm2/BRIEFING.002/packet/13/scene/2/record/2"
msgid "wc1:e96575fccfec37ff"
msgstr "Je pense qu'ils ont raison... s'empêtrer avec toute une flotte de combat serait difficile, même pour le Griffe du Tigre."

msgctxt "sm2/BRIEFING.002/packet/13/scene/2/record/3"
msgid "wc1:8fa8e65802e020d8"
msgstr "Et ces officiers parlaient aussi de qui serait transferé du Tigre, et qui resterait ici."

msgctxt "sm2/BRIEFING.002/packet/13/scene/2/record/4"
msgid "wc1:88ae34be8cf98dfc"
msgstr "Et la plus grande rumeur de toutes est que---"

msgctxt "sm2/BRIEFING.002/packet/13/scene/2/record/5"
msgid "wc1:8449d5e732c5c50f"
msgstr "---Le colonel Halcyon doit être promu et transferé à l'intelligence."

msgctxt "sm2/BRIEFING.002/packet/13/scene/2/record/6"
msgid "wc1:b717ab10f8cd6523"
msgstr "Je me demande qui sera en charge de notre escadron de chasse alors?"

msgctxt "sm2/BRIEFING.002/packet/13/scene/2/record/7"
msgid "wc1:67ae8418d05b5f40 $C"
msgstr "Eh bien, laisse-moi te servir un autre verre maintenant, $C."

msgctxt "sm2/BRIEFING.002/packet/13/scene/3/record/0"
msgid "wc1:8f611eba51e6d378 $C"
msgstr "Bonjour, $C."

msgctxt "sm2/BRIEFING.002/packet/13/scene/3/record/1"
msgid "wc1:cedaf4c5ce0f486a"
msgstr "J'ai écrit une lettre à la femme de Bossman."

msgctxt "sm2/BRIEFING.002/packet/13/scene/3/record/2"
msgid "wc1:0d6635327313a59b"
msgstr "Je veux qu'elle comprenne ce qui s'est passé."

msgctxt "sm2/BRIEFING.002/packet/13/scene/3/record/3"
msgid "wc1:f82cc9c0a093394d"
msgstr "Angel...ce n'était pas ta faute. Tu dois comprendre ça."

msgctxt "sm2/BRIEFING.002/packet/13/scene/3/record/4"
msgid "wc1:43fd6855ec70b737"
msgstr "Je comprends, mon ami.  Mais c'est très dur à accepter."

msgctxt "sm2/BRIEFING.002/packet/13/scene/3/record/5"
msgid "wc1:95e2686e58822f7f"
msgstr "Je me suis toujours considerée comme différente de toi et des autres---"

msgctxt "sm2/BRIEFING.002/packet/13/scene/3/record/6"
msgid "wc1:50eb7a0df814a18d"
msgstr "---je ne me souciais de rien\n sauf de moi-même, et à perfectionner mes compétences---"

msgctxt "sm2/BRIEFING.002/packet/13/scene/3/record/7"
msgid "wc1:bd1d11fc540ae79f"
msgstr "---Je ne voulais jamais être blessée, je ne voulais pas ressentir de douleur ou de peur. Mais j'avais tellement tort, non?"

msgctxt "sm2/BRIEFING.002/packet/13/scene/3/record/8"
msgid "wc1:5ac94e363a704e9a $C"
msgstr "Si tu veux, $C... assieds-toi avec moi pendant un moment."

msgctxt "sm2/BRIEFING.002/packet/13/scene/3/record/9"
msgid "wc1:d2bc43c1b7641879"
msgstr "J'ai besoin de ta compagnie maintenant."

msgctxt "sm2/BRIEFING.002/packet/13/scene/4/record/0"
msgid "wc1:728d9e633de05971 $C"
msgstr "Hey, $C!  Ils m'ont finalement laissé sortir de l'infirmerie!"

msgctxt "sm2/BRIEFING.002/packet/13/scene/4/record/1"
msgid "wc1:d0f081fe81e8916d"
msgstr "J'espère que nous ferons une mission ensemble---"

msgctxt "sm2/BRIEFING.002/packet/13/scene/4/record/2"
msgid "wc1:bb31ac0c5d9b23f2"
msgstr "---mais je dois être de retour à l'infirmerie dans une heure."

msgctxt "sm2/BRIEFING.002/packet/13/scene/4/record/3"
msgid "wc1:754400fc8f6b9d69"
msgstr "Je suis sûr qu'ils me renverront bientôt au service actif---"

msgctxt "sm2/BRIEFING.002/packet/13/scene/4/record/4"
msgid "wc1:f8b1b277c064787c"
msgstr "---et nous volerons encore ensemble alors, d'accord?"

msgctxt "sm2/BRIEFING.002/packet/13/scene/4/record/5"
msgid "wc1:5c40b96c364d63f1 $C"
msgstr "Je sais à quel point tu veux toujours être mon ailier, $C---"

msgctxt "sm2/BRIEFING.002/packet/13/scene/4/record/6"
msgid "wc1:a3b5bb9c3b7f6aa8"
msgstr "---et je sais que nous allons faire quelque chose d'important."

msgctxt "sm2/BRIEFING.002/packet/13/scene/4/record/7"
msgid "wc1:d752b75e7816c201"
msgstr "je ne sais pas encore ce que c'est---"

msgctxt "sm2/BRIEFING.002/packet/13/scene/4/record/8"
msgid "wc1:3991c0292d665169"
msgstr "---mais je suis sûr que nous éliminerons beaucoup de boules de poils avant qu'ils ne nous tuent."

msgctxt "sm2/BRIEFING.002/packet/13/scene/4/record/9"
msgid "wc1:2c002bec96cca4d4"
msgstr "Ce ne serait pas genial?"

msgctxt "sm2/BRIEFING.002/packet/13/scene/4/record/10"
msgid "wc1:647831dc70d3030c"
msgstr "Eh bien, je suppose que je vais prendre un verre de plus avant de retourner à l'infirmerie."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/0"
msgid "wc1:71c2019deff97ffb $T $D"
msgstr "Briefing de mission, $T, $D.\nsystème Corsair, Secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/1"
msgid "wc1:b6bb80bdcb4efe12"
msgstr "Tout d'abord, j'aimerais souhaiter la bienvenue aux deux pilotes du TCS Austin qui voleront avec nous...Jazz et Doomsday."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/2"
msgid "wc1:e5fc6dc3acbd9f29"
msgstr "Autres nouvelles...Hunter a volé l'un de nos Dralthis capturés et à fait une virée jusqu'à l'Austin."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/3"
msgid "wc1:86c56b71473dac98"
msgstr "Il est arrivé juste à temps pour sauver l'Austin d'un escadron de Hhriss."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/4"
msgid "wc1:59a22897af6e5de2"
msgstr "J'allais commencer une procédure pour la cour martiale, mais le QG pense que c'est un héros."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/5"
msgid "wc1:ff40835a3c038b75"
msgstr "Et la petite aventure d'Hunter a donné matière à réflexion aux officiers de pont---"

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/6"
msgid "wc1:62958d314b2ff034"
msgstr "Nous devons ramener la plupart de ces Dralthis capturés au QG de la Conféd... pour POUVOIR les utiliser en combat."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/7"
msgid "wc1:42d558a1277abae7"
msgstr "Ainsi, à partir de cette mission, certains d'entre vous piloteront des chasseurs kilrathis pour des missions spéciales."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/8"
msgid "wc1:a5d8da3736583bab"
msgstr "Vous vous attendez à ce que nous allions au combat dans l'une de ces crêpes volantes, monsieur?"

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/9"
msgid "wc1:c76a2d4efede89ff"
msgstr "Affectations d'escadrons individuelles..."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/10"
msgid "wc1:12c4e19c40bec319 $C"
msgstr "$C, vous serez l'escadron Beta. Jazz, vous serez son ailier."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/11"
msgid "wc1:adeb99c84e434c55"
msgstr "Aucun problème, Colonel."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/12"
msgid "wc1:2aea8168285ce0c2 $C"
msgstr "$C, vous serez l'escadron Beta."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/13"
msgid "wc1:f5c333044a822737"
msgstr "très bien. Nous avons un peu de temps avant que les autres flottes de combat kilrathis n'arrivent---"

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/14"
msgid "wc1:4ae521cf87160936"
msgstr "---et nous en ferons bon usage. Nous n'avons toujours aucune idée pourquoi---"

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/15"
msgid "wc1:3a86002a8f76282f"
msgstr "---les Kilrathis viennent vers ce système. Nous avons besoin de plus de données."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/16"
msgid "wc1:1e2a6c65f6be9525"
msgstr "Et c'est votre mission... infiltrez-vous derrière les lignes ennemies et obtenez ces informations."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/17"
msgid "wc1:39801c44dfdfc83c"
msgstr "Nous avons equipé ces chasseurs d'ordinateurs de communication qui simuleront un pilote kilrathi."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/18"
msgid "wc1:51b4f17d4564bfaf"
msgstr "Lorsque vous passerez aux points de navigation, la simulation informatique commencera à transmettre---"

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/19"
msgid "wc1:4131d7fa2a7344f2"
msgstr "---et contactera tous les vaisseaux capitaux pour avoir certaines informations."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/20"
msgid "wc1:c0ae0d6d316a34f8"
msgstr "Une fois que l'ordinateur a acquis les données---"

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/21"
msgid "wc1:fdc86b485f061822"
msgstr "---alors partez vite de là. Nous ne savons pas combien de temps ces ordinateurs peuvent tromper les Kilrathis."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/22"
msgid "wc1:bf9f18bce941b13b"
msgstr "Nous pensons qu'il y a plusieurs vaisseaux capitaux sur la route de Nav 1."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/23"
msgid "wc1:de1011e1515df33b"
msgstr "Vous volerez jusqu'à ce point de navigation, transmettez aux vaisseaux capitaux, puis foutez le camp de là."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/24"
msgid "wc1:c97aae084f7cf4f8"
msgstr "L'idée est d'infiltrer et s'enfuir, et de revenir AVEC ces informations."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/25"
msgid "wc1:e5e807dff0283a9c"
msgstr "Le colonel continue avec les autres affectations d'escadrons."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/26"
msgid "wc1:920b4e0fdbe369cb"
msgstr "Les techniciens ont réaménagé ces vaisseaux Kilrathis avec des mécanismes de contrôles humains---"

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/27"
msgid "wc1:35d01187a7646e42"
msgstr "---et ajouté nos propres systèmes de ciblage. Mais nous ne savons toujours pas comment ils voleront au combat---"

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/28"
msgid "wc1:3d6f81fdd018eab2"
msgstr "---alors surveillez vos arrières. Et rappelez-vous... les techniciens ont commencé à installer des siéges éjectables dans le Dralthi---"

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/29"
msgid "wc1:8e57e98492684a43"
msgstr "---mais se sont heurtés à des difficultés techniques insolubles. Vous ne pourrez pas vous éjecter d'un Dralthi."

msgctxt "sm2/BRIEFING.002/packet/16/scene/0/record/30"
msgid "wc1:65fc400ca8022ad1"
msgstr "C'est tout, pilotes. Rompez."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/2"
msgid "wc1:6621a928abd33c0a"
msgstr "Je ne pouvais pas m'approcher suffisamment des vaisseaux capitaux pour les cibler. Je suis désolé monsieur."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/4"
msgid "wc1:545faf694e18a1bf"
msgstr "J'ai pu me rapprocher et cibler deux porte-astronefs Snakeir à Nav 1, monsieur."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/5"
msgid "wc1:e6e2d59b825259b3 $C"
msgstr "Excellent, $C!  Nous transmettrons immédiatement ces données à l'intelligence."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/6"
msgid "wc1:4dc5b62639e7477f"
msgstr "Et j'ai réussi à détruire les deux transporteurs."

#. wc1-re: shortened to fit the subtitle area.
msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/7"
msgid "wc1:902adea2207d17ab $C"
msgstr "Ce n'était pas votre mission, $C... mais c'est un coup dur pour le moral ennemi. Bon travail."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/9"
msgid "wc1:889f5a709957551a"
msgstr "Puis nous avons attaqué les transporteurs, et j'ai réussi à détruire l'un d'eux."

#. wc1-re: shortened to fit the subtitle area.
msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/10"
msgid "wc1:902adea2207d17ab $C"
msgstr "Ce n'était pas votre mission, $C... mais c'est un coup dur pour le moral ennemi. Bon travail."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/11"
msgid "wc1:889f5a709957551a"
msgstr "Puis j'ai attaque les transporteurs, et j'ai réussi à détruire l'un d'eux."

#. wc1-re: shortened to fit the subtitle area.
msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/12"
msgid "wc1:902adea2207d17ab $C"
msgstr "Ce n'était pas votre mission, $C... mais c'est un coup dur pour le moral ennemi. Bon travail."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/13"
msgid "wc1:15e10b955cb2fa50"
msgstr "Piloter le chasseur kilrathi n'a pas très bien fonctionné pour nous."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/14"
msgid "wc1:e6db4395d35fa446"
msgstr "Piloter le chasseur kilrathi n'a pas très bien fonctionné pour moi."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/15"
msgid "wc1:2a381bb6d9a71665"
msgstr "Nous avons été pris en embuscade par plusieurs chasseurs ennemis. C'était un dur combat, monsieur."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/16"
msgid "wc1:aeb0e449a6f87a10"
msgstr "J'ai été pris en embuscade par plusieurs chasseurs ennemis. C'était un dur combat, monsieur."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/17"
msgid "wc1:bcf84c476c7b9853 $C $K"
msgstr "$C, votre enregistreur de vol indique que vous avez eu $K."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/18"
msgid "wc1:59862cae8a3c3232"
msgstr "L'enregistreur indique que vous avez zéro, pas de tué."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/19"
msgid "wc1:4d07ba4579386d1f $L"
msgstr "Jazz a eu $L."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/20"
msgid "wc1:17ed8ca6d8bc260b"
msgstr "Jazz n'a rien eu."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/21"
msgid "wc1:59db44189751e21c"
msgstr "Et puis nous l'avons perdu, qu'ils soient tous maudits."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/22"
msgid "wc1:709c7e8896eecca3"
msgstr "très bien. Nous avons transmis un message indiquant que nous avons heurté des astéroïdes."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/23"
msgid "wc1:b1f97fcd4d2bf92b"
msgstr "Avec un peu de chance, les Kilrathis croiront que nous avons été détruit."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/24"
msgid "wc1:617fb432dcd0aa37 $N"
msgstr "Reposez-vous, $N."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/25"
msgid "wc1:55928a1e3aa589c2"
msgstr "Et j'aurai besoin de vous voir plus tard, dans mon bureau."

msgctxt "sm2/BRIEFING.002/packet/16/scene/1/record/26"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Rompez."

msgctxt "sm2/BRIEFING.002/packet/16/scene/2/record/0"
msgid "wc1:986c6adfe5db4f6e $R"
msgstr "Salut $R. Je viens d'entendre parler de ces transfuges kilrathis."

msgctxt "sm2/BRIEFING.002/packet/16/scene/2/record/1"
msgid "wc1:fab0c4b410e74621"
msgstr "Difficile de croire que certains de ces chats seraient vraiment de notre côté."

msgctxt "sm2/BRIEFING.002/packet/16/scene/2/record/2"
msgid "wc1:1533206d7dae57a2"
msgstr "Ils ont amené ce capitaine Ralgha et ses officiers ici, il y a quelques heures."

msgctxt "sm2/BRIEFING.002/packet/16/scene/2/record/3"
msgid "wc1:611fa77c99bf2650"
msgstr "Et je n'arretais pas de penser... c'est le même genre de gars qui a ordonné l'attaque de Goddard."

msgctxt "sm2/BRIEFING.002/packet/16/scene/2/record/4"
msgid "wc1:ea838f35cf185b99"
msgstr "Il commandait un Fralthi... qui sait combien d'entre nous il a tué?"

msgctxt "sm2/BRIEFING.002/packet/16/scene/2/record/5"
msgid "wc1:6db7cbc4f32bf768"
msgstr "Il aurait pu assassiner des milliers de nos soldats, éliminer des dizaines de nos vaisseaux."

msgctxt "sm2/BRIEFING.002/packet/16/scene/2/record/6"
msgid "wc1:a61792b94c4847a2"
msgstr "Et le voici, nous demandant de le protèger de l'empire kilrathi."

msgctxt "sm2/BRIEFING.002/packet/16/scene/2/record/7"
msgid "wc1:6266aec5cea2dc25"
msgstr "Putain, nous savons déjà ce dont on a besoin de lui. On pourrait le jeter par le sas---"

msgctxt "sm2/BRIEFING.002/packet/16/scene/2/record/8"
msgid "wc1:24b6161ad9ddef07"
msgstr "---personne n'en saurait rien, n'est-ce pas?"

msgctxt "sm2/BRIEFING.002/packet/16/scene/2/record/9"
msgid "wc1:ef7ee8f228d7f679"
msgstr "Qu'ils envoient tous ces boules de poils au QG de la Conféd."

msgctxt "sm2/BRIEFING.002/packet/16/scene/2/record/10"
msgid "wc1:977241fadcdc2323"
msgstr "Ca nous debarrasserait, si tu veux mon avis."

msgctxt "sm2/BRIEFING.002/packet/16/scene/3/record/0"
msgid "wc1:4148db36e3145b10 $R $N"
msgstr "Alors tu es le $R $N ? J'ai entendu dire que tu étais un vrai as, le meilleur sur le Griffe du Tigre"

#. wc1-re: restore campaign substitution tokens from the original record.
msgctxt "sm2/BRIEFING.002/packet/16/scene/3/record/1"
msgid "wc1:7bafccfd48290a99 $C"
msgstr "$C, voici le lieutenant Zach Colson."

msgctxt "sm2/BRIEFING.002/packet/16/scene/3/record/2"
msgid "wc1:c31b182f4d514fa4"
msgstr "Appele-moi Jazz. Je suis pilote de combat sur le TCS Austin, et pianiste de jazz en plus."

msgctxt "sm2/BRIEFING.002/packet/16/scene/3/record/3"
msgid "wc1:b5f1f924773aec6a"
msgstr "Mais ce que j'aimerais vraiment, c'est être transféré sur un vaisseau comme le Griffe du Tigre."

msgctxt "sm2/BRIEFING.002/packet/16/scene/3/record/4"
msgid "wc1:672b7fd5847105aa"
msgstr "J'imagine déjà ce que je pourrais faire si j'étais en poste ici. Ce serait génial."

msgctxt "sm2/BRIEFING.002/packet/16/scene/3/record/5"
msgid "wc1:af7a27f8b222f62e"
msgstr "Vous avez certainement besoin d'un piano dans votre salle de jeux. Tout comme sur l'Austin."

msgctxt "sm2/BRIEFING.002/packet/16/scene/3/record/6"
msgid "wc1:03730146e0c5d4f4"
msgstr "J'y joue habituellement plusieurs soirs par semaine. Tu devrais venir et écouter."

msgctxt "sm2/BRIEFING.002/packet/16/scene/3/record/7"
msgid "wc1:75ce95c19ce570cc"
msgstr "Merci Jazz. j'y penserais."

msgctxt "sm2/BRIEFING.002/packet/16/scene/4/record/0"
msgid "wc1:b9df3f6f350acbc1 $C"
msgstr "Bonjour, $C. Assieds-toi et rejoins-nous."

msgctxt "sm2/BRIEFING.002/packet/16/scene/4/record/1"
msgid "wc1:305337f7a5aa51c0"
msgstr "On parlait justement de ta dernière campagne, la mission Goddard."

msgctxt "sm2/BRIEFING.002/packet/16/scene/4/record/2"
msgid "wc1:59ac30b93af2c0cc"
msgstr "L'opération Thor Hammer.  C'était une mission très difficile."

msgctxt "sm2/BRIEFING.002/packet/16/scene/4/record/3"
msgid "wc1:d8639a27037e92ad"
msgstr "J'etais certain qu'on n'y survivrait pas."

msgctxt "sm2/BRIEFING.002/packet/16/scene/4/record/4"
msgid "wc1:3ea11086bbad66b0"
msgstr "Mais nous avons réussi notre mission secrète, envers et contre tout."

msgctxt "sm2/BRIEFING.002/packet/16/scene/4/record/5"
msgid "wc1:3c0a1f198d44cb25"
msgstr "Cependant, c'est dommage que tu n'aies rien pu faire pour les gens sur Goddard."

msgctxt "sm2/BRIEFING.002/packet/16/scene/4/record/6"
msgid "wc1:24f984101a70c90b"
msgstr "Nous sommes arrivés trop tard pour les aider. Mais nous les avons vengés."

msgctxt "sm2/BRIEFING.002/packet/16/scene/4/record/7"
msgid "wc1:9ce36ca09634b4b9"
msgstr "Aucune de ces racailles kilrathis ayant détruit Goddard n'a survécu."

msgctxt "sm2/BRIEFING.002/packet/16/scene/4/record/8"
msgid "wc1:d680411d1df52624"
msgstr "Il y a donc une justice."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/0"
msgid "wc1:71c2019deff97ffb $T $D"
msgstr "Briefing de mission, $T, $D.\nsystème Corsair, Secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/1"
msgid "wc1:2dfea70f8d03f712"
msgstr "Pilotes, nous avons eu de la chance jusqu'à présent, nous avons évité toute confrontation majeure avec les Kilrathis---"

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/2"
msgid "wc1:1fb2774bb23307f9"
msgstr "---parce que les chats étaient occupés avec cette affaire de 'Sivar'."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/3"
msgid "wc1:8823107aea3bf8b5"
msgstr "Et maintenant nous savons ce que c'est, et pourquoi cette 'Voie du Seigneur Sivar' est si importante."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/4"
msgid "wc1:b6b8a802e3bb176f"
msgstr "Le capitaine Ralgha et ses officiers nous ont fourni une description détaillée---"

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/5"
msgid "wc1:c480b5cb3ea5e18a"
msgstr "---de la cérémonie militaro-religieuse kilrathi connue sous le nom de Voie de Sivar."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/6"
msgid "wc1:54d4bf98219bdd11"
msgstr "Les Kilrathis croient qu'ils doivent chanter les louanges de leur dieu de guerre---"

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/7"
msgid "wc1:1b00ce898948be8c"
msgstr "---une fois par an, sur une planète choisie par les prêtresses de Sivar."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/8"
msgid "wc1:1166990af681552b"
msgstr "S'ils ne le font pas, le dieu de la guerre ne favorisera pas les guerriers de Kilrah au combat---"

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/9"
msgid "wc1:3ad2fe7a9b7a677c"
msgstr "---et leurs ennemis sont déstinés à les anéantir."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/10"
msgid "wc1:7dfa4c0ac4a2c5f9"
msgstr "Firekka est la planète qu'ils ont choisie pour la cérèmonie de cette année."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/11"
msgid "wc1:acca14be5eab5064"
msgstr "Et c'est pourquoi tous les vaisseaux disponibles des flottes kilrathis arriveront bientôt ici."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/12"
msgid "wc1:3e78b7b032a2297e"
msgstr "Il y a plus. Les Kilrathis croient que la cérèmonie ne peut pas être entachée---"

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/13"
msgid "wc1:1ea39999f1c50668"
msgstr "---par la présence d'incroyants. A moins que nous fassions quelque chose pour les sauver---"

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/14"
msgid "wc1:2532111ba26ace92"
msgstr "---Sinon les Firekkas seront convertis de force au culte de Sivar."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/15"
msgid "wc1:5a26749c04077bed"
msgstr "Et les Kilrathis assassineront tous les Firekkans qui refuseront de se soumettre.."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/16"
msgid "wc1:ca9b984b7b94f4f4"
msgstr "Une planète de plusieurs millions d'êtres intelligents. nous ne pouvons pas permettre que cela arrive.."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/17"
msgid "wc1:fb3dfa602c2a5e47"
msgstr "Sur la base des informations de Ralgha, le QG de la Conféd a un plan qui pourrait sauver les Firekkas---"

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/18"
msgid "wc1:2f8646d6c795b5a2"
msgstr "---et porter un coup en démoralisant les Kilrathis en même temps."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/19"
msgid "wc1:75bab1bbd24a0cd0"
msgstr "Etes-vous certain que nous pouvons faire confiance aux informations de ce renégat, monsieur?"

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/20"
msgid "wc1:3761e4e73f400dda"
msgstr "Ralgha s'est porté volontaire pour un interrogatoire biochimique, Hunter. Nous savons qu'il ne ment pas."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/21"
msgid "wc1:bebfc3d3ccebc521"
msgstr "Notre plan est de perturber la cérèmonie de Sivar. Deux bataillons de marines arriveront bientôt pour nous aider."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/22"
msgid "wc1:09d6ce35a4c87863"
msgstr "Les pilotes du Tigre les escorteront, puis les marines atterriront sur la planète."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/23"
msgid "wc1:f0b2b9074d62e3a5"
msgstr "Avec les guerriers Firekkas, ils lanceront un assaut contre les prêtresses-guerrieres Sivar."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/24"
msgid "wc1:63cea406fa536d79"
msgstr "Si nous pouvons réussir cette mission, pilotes, cela pourrait avoir des répercussions majeures sur la machine de guerre kilrathi.."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/25"
msgid "wc1:4b8caa5a26da4ffa"
msgstr "Mais d'abord, nous avons besoin de plus d'informations. J'envoie certains d'entre vous dans les chasseurs kilrathis---"

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/26"
msgid "wc1:99911922e73fcce0"
msgstr "---retour au système Firekka, où vous intercepterez les communications militaires kilrathis."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/27"
msgid "wc1:d7e4c37253e7b542"
msgstr "A partir de ces données, nous calculerons l'endroit et l'heure le plus sûr pour que les marines atterrissent sur la planète."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/28"
msgid "wc1:22c5c1906bd9d1d4 $C"
msgstr "Escadron Mu sera $C et Jazz."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/29"
msgid "wc1:1ea9dacc575a0842 $C"
msgstr "$C, vous êtes tout seul cette fois."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/30"
msgid "wc1:0a8608caa34de86d"
msgstr "Voici votre mission...."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/31"
msgid "wc1:ac9aec5c31c5cf67"
msgstr "Restez vigilant lorsque vous suivez ce parcours --- vous rencontrerez probablement des patrouilles kilrathis."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/32"
msgid "wc1:b9b3e61e02b608cd"
msgstr "S'ils realisent que vous êtes humains, attaquez. Sinon, ne perdez pas votre couverture."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/33"
msgid "wc1:a522aee583800285"
msgstr "Allez à Nav 1, l'ordinateur de communication commencera automatiquement à intercepter les données. Puis retour via Nav 2."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/34"
msgid "wc1:139438a7e7f67413"
msgstr "Le colonel lit rapidement les autres affectations d'escadrons."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/35"
msgid "wc1:cba290f613e48941"
msgstr "Soyez tous prudent --- nous ne savons pas s'ils croient que tous les chasseurs capturés ont été détruits."

msgctxt "sm2/BRIEFING.002/packet/17/scene/0/record/36"
msgid "wc1:8842e46c5d2e68b9"
msgstr "Rompez, pilotes."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/1"
msgid "wc1:63586f988bd647fa $C"
msgstr "Bienvenue, $C. Est-ce que vous et Jazz avez rencontré des difficultés?"

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/2"
msgid "wc1:6f3531855b70b1aa"
msgstr "Rien que nous ne puissions gérer, Colonel."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/3"
msgid "wc1:e731a95530d91c0f $C"
msgstr "Content de vous revoir, $C."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/4"
msgid "wc1:1a86f9a6c7d4c8e0 $R $N"
msgstr "J'aimerais entendre votre rapport, $R $N."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/5"
msgid "wc1:4fff6d81b6b2a621"
msgstr "Impossible d'atteindre Nav 1 pour intercepter ces communications ennemies, monsieur."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/6"
msgid "wc1:1ff980468022b944"
msgstr "Nous avons réussi à atteindre Nav 1 sans trop de difficulté, monsieur."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/7"
msgid "wc1:d9bceec7db8572af"
msgstr "J'ai réussi à atteindre Nav 1 sans trop de difficulté, monsieur."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/8"
msgid "wc1:3b3c812e062886e0"
msgstr "Mais des Rapiers pilotés par les Kilrathis et quelques Dralthis nous attendaient."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/9"
msgid "wc1:f69a592ddf788996"
msgstr "Mais des Rapiers pilotés par les kilrathis et quelques Dralthis m'attendait."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/10"
msgid "wc1:ec596e0748fdc09b"
msgstr "Ces Rapiers étaient probablement le dernier escadron du Johann... c'était très dur, monsieur."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/11"
msgid "wc1:411d044802708ac1"
msgstr "J'espère juste que l'intercepteur de communication ne s'est pas cassé quand je pilotais à vitesse maxi."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/12"
msgid "wc1:59c26d44b70abd46"
msgstr "Il y avait un autre escadron ennemi qui nous attendait à Nav 2."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/13"
msgid "wc1:1ee53ee854330bcc"
msgstr "Il y avait un autre escadron ennemi qui m'attendait à Nav 2."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/16"
msgid "wc1:97d81f9e99dbaebb"
msgstr "Et je ne pense pas que nous devrions utiliser à nouveau ces chasseurs, monsieur---"

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/17"
msgid "wc1:40847525b0271c5f"
msgstr "---l'ennemi utilise un autre code de reconnaissance---"

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/18"
msgid "wc1:fef6d7934766f876"
msgstr "---et ils nous ont évidemment reconnus comme des pilotes terriens."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/19"
msgid "wc1:8f30a5a78e8e1326"
msgstr "---et ils m'ont évidemment reconnus comme pilote terrien."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/20"
msgid "wc1:39a7e59de71949ed"
msgstr "Je dirai ça à l'intelligence... peut-être qu'on peut intercepter et utiliser ces codes de reconnaissance."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/21"
msgid "wc1:f0ab1dd0fa104a00 $K $C"
msgstr "Vous avez $K, $C."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/22"
msgid "wc1:d4db1393aeb63ef2 $R"
msgstr "Votre enregistreur de vol ne montre aucun mort, $R."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/23"
msgid "wc1:20531c2ab7a730f0 $L"
msgstr "Jazz a $L."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/24"
msgid "wc1:2460529776cbac91"
msgstr "Jazz n'a pas grillé de Kilrathi."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/25"
msgid "wc1:97bc40f8eb133b7e"
msgstr "Il a tenu l'ennemi loin de moi, colonel. C'est plus le important."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/26"
msgid "wc1:59db44189751e21c"
msgstr "Puis nous l'avons perdu, qu'ils soient tous maudits."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/27"
msgid "wc1:a5182b65bc07f2d8"
msgstr "très bien. Détendez-vous un moment, tous les deux."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/28"
msgid "wc1:65ae72655dfc52c0 $C"
msgstr "très bien. Détendez-vous pendant un moment, $C."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/29"
msgid "wc1:c3fc5b67aa94e6f2 $C"
msgstr "Et je veux vous voir dans mon bureau plus tard, $C."

msgctxt "sm2/BRIEFING.002/packet/17/scene/1/record/30"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm2/BRIEFING.002/packet/17/scene/2/record/0"
msgid "wc1:ea004ceef074c384 $C"
msgstr "Bonjour, $C. Qu'est ce que je peux te servir?"

msgctxt "sm2/BRIEFING.002/packet/17/scene/2/record/1"
msgid "wc1:25b1a4244255921b"
msgstr "Juste ma boisson habituelle, Sam."

msgctxt "sm2/BRIEFING.002/packet/17/scene/2/record/2"
msgid "wc1:2b7874cd6d927449 $C"
msgstr "Aucun problème. $C... Je me sens vraiment mal à l'aise à propos d'une chose---"

msgctxt "sm2/BRIEFING.002/packet/17/scene/2/record/3"
msgid "wc1:51bbafd9adbd12fd"
msgstr "Nous nous sommes cachés dans le système Corsair contre toutes ces flottes kilrathis..."

msgctxt "sm2/BRIEFING.002/packet/17/scene/2/record/4"
msgid "wc1:50198f23e265c0ce"
msgstr "...et nous avons eu de la chance ; ces chats semblent croire que nous avons quitté la région..."

msgctxt "sm2/BRIEFING.002/packet/17/scene/2/record/5"
msgid "wc1:d1da665795e1574e"
msgstr "...mais que se passera-t-il si notre chance tourne?"

msgctxt "sm2/BRIEFING.002/packet/17/scene/2/record/6"
msgid "wc1:b1a13a30e79d8825 $R"
msgstr "Cinq flottes contre le Tigre ? Ca devient chaud, $R."

msgctxt "sm2/BRIEFING.002/packet/17/scene/3/record/0"
msgid "wc1:eead3003ea3baa62 $C"
msgstr "Ecoute, $C... Je parlais justement au Dr Khalsa de ces renégats kilrathis."

msgctxt "sm2/BRIEFING.002/packet/17/scene/3/record/1"
msgid "wc1:f8dcfcc7a7fed0e5"
msgstr "Ils ont interrogé le capitaine Ralgha avec de la neo-scopalamine, et ils ont appris des choses interessantes."

msgctxt "sm2/BRIEFING.002/packet/17/scene/3/record/2"
msgid "wc1:97209dff0aa79517"
msgstr "Il ne pouvait pas dire quoi, bien sûr, juste que cela nous aiderait contre l'ennemi."

msgctxt "sm2/BRIEFING.002/packet/17/scene/3/record/3"
msgid "wc1:e61a581835cce552"
msgstr "Je suis un peu inquiet, cependant. Je veux dire, ce gars pourrait être un agent Kilrathi---"

msgctxt "sm2/BRIEFING.002/packet/17/scene/3/record/4"
msgid "wc1:aface01f2230ab4d"
msgstr "---formés contre les interrogatoires chimiques. Et s'il mentait?"

msgctxt "sm2/BRIEFING.002/packet/17/scene/3/record/5"
msgid "wc1:a159eb4f8be727b2"
msgstr "Si nous entrons dans une bataille avec de mauvaises données tactiques, ce sera fini pour nous."

msgctxt "sm2/BRIEFING.002/packet/17/scene/3/record/6"
msgid "wc1:65a234bc6bc56933"
msgstr "même si nous avons de bonnes données, nous sommes en difficulté. Toutes ces flottes contre le Griffe du Tigre?"

msgctxt "sm2/BRIEFING.002/packet/17/scene/3/record/7"
msgid "wc1:6f0520e6570539f1"
msgstr "La mission Goddard était contre UNE seule flotte de combat, et c'était presque impossible."

msgctxt "sm2/BRIEFING.002/packet/17/scene/3/record/8"
msgid "wc1:b5572b5d0774c565"
msgstr "Comme le dit Shotglass, ca va être chaud."

msgctxt "sm2/BRIEFING.002/packet/17/scene/3/record/9"
msgid "wc1:ff32890b062d7a4d"
msgstr "Nous devrions être en sécurité ici dans le système Corsair. Mais si nous revenons à Firekka..."

msgctxt "sm2/BRIEFING.002/packet/17/scene/4/record/0"
msgid "wc1:fbcc06bcfa0f60c1 $C"
msgstr "$C. Je viens de voir le colonel Halcyon dans le couloir, il y a quelques minutes."

msgctxt "sm2/BRIEFING.002/packet/17/scene/4/record/1"
msgid "wc1:d25737a4281112a1"
msgstr "Il parlait avec Ralgha, le capitaine kilrathi."

msgctxt "sm2/BRIEFING.002/packet/17/scene/4/record/2"
msgid "wc1:48d71b5207fa2752"
msgstr "Sais-tu que je n'avais jamais vu de Kilrathi auparavant?"

msgctxt "sm2/BRIEFING.002/packet/17/scene/4/record/3"
msgid "wc1:a268a832ec406d60"
msgstr "Je pensais que je le détesterais, à cause de ce que son peuple nous a fait."

msgctxt "sm2/BRIEFING.002/packet/17/scene/4/record/4"
msgid "wc1:f141709b3d3bbb26"
msgstr "Mais je n'ai rien ressenti du tout. Ni haine, ni quoi que ce soit d'autre."

msgctxt "sm2/BRIEFING.002/packet/17/scene/4/record/5"
msgid "wc1:79848f4c26fb1ca5"
msgstr "Rien du tout."

msgctxt "sm2/BRIEFING.002/packet/17/scene/4/record/6"
msgid "wc1:d7efc1a5b9996ed4"
msgstr "Parfois j'ai l'impression qu'on se bat depuis toujours, que cette guerre ne sera jamais finie."

msgctxt "sm2/BRIEFING.002/packet/17/scene/4/record/7"
msgid "wc1:769235172e81e09a"
msgstr "Les Kilrathis ont commencé cette guerre, Spirit. Mais je sais que nous y mettrons fin, un jour."

msgctxt "sm2/BRIEFING.002/packet/17/scene/4/record/8"
msgid "wc1:ed3f2d60c9ff2d75"
msgstr "J'espère bien, mon ami. je l'espère vraiment."

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/0"
msgid "wc1:9dd695230d7031de $T $D"
msgstr "Briefing de mission, $T, $D.\nPres du système Firekka, secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/1"
msgid "wc1:37598b6d98b81d13"
msgstr "très bien, pilotes. Nous avons gardé nos distances avec le système Firekka---"

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/2"
msgid "wc1:3a1be21e91df881b"
msgstr "---attendant le bon moment pour commencer notre assaut."

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/3"
msgid "wc1:2482e51a5a47daef"
msgstr "Le temps est venu."

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/4"
msgid "wc1:013905e46a9024d4"
msgstr "Aujourd'hui vous allez escorter les transports de marines---"

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/5"
msgid "wc1:4121dbf2e825751b"
msgstr "---puis nous lancerons l'assaut contre les troupes kilrathis sur Firekka."

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/6"
msgid "wc1:6c53ba8820f9ffb1"
msgstr "En raison du risque de fuite de communication dans cette opération---"

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/7"
msgid "wc1:4073b524487e6b58"
msgstr "---les convois de Marines n'ont pas transmis leur position exacte."

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/8"
msgid "wc1:17c0cd1432fe8b08"
msgstr "Mais un Drayman s'est déjà amarré au Griffe Du Tigre---"

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/9"
msgid "wc1:e9b8652e3f74a476"
msgstr "---nous avons donc une bonne idée de l'endroit où ces transports arriveront."

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/10"
msgid "wc1:ef474955faa7769c"
msgstr "Vous volerez sur Hornets... des chasseurs rapides et maniables. Suivez votre route de navigation et détruisez les vaisseaux ennemis."

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/11"
msgid "wc1:e4c0de017fd84498"
msgstr "Ne ratez pas cette mission, pilotes. Toute l'opération dépend---"

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/12"
msgid "wc1:4e3ffd9a15c7a6d1"
msgstr "---de l'arrivée en toute sécurité de ces Marines et des armes qu'ils apportent aux guerriers Firekka."

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/13"
msgid "wc1:346148864e74eed0"
msgstr "Affectations d'escadron..."

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/14"
msgid "wc1:e12f7770ffc1dffd"
msgstr "Vous écoutez jusqu'à ce que le colonel vous appelle:"

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/15"
msgid "wc1:054d4b99d7abd6c4 $C $C"
msgstr "Escadron Psi sera $C et Doomsday, avec $C comme chef."

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/16"
msgid "wc1:834caa439697729c $C $R"
msgstr "Escadron Psi sera $C. Bonne chance, $R."

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/17"
msgid "wc1:87752a3fd3c7c186"
msgstr "Le colonel affecte les autres escadrons."

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/18"
msgid "wc1:4d005fbfd2848c8b"
msgstr "C'est tout, pilotes. Allez et trouvez ces transports."

msgctxt "sm2/BRIEFING.002/packet/20/scene/0/record/19"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Rompez."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/1"
msgid "wc1:3cfe7e6322c1f2b7 $C"
msgstr "très bien, $C. Votre Rapport."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/2"
msgid "wc1:45b0ba625b618c42"
msgstr "Les deux transports ont fait un saut vers le système Firekka, monsieur. Pas de problème."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/3"
msgid "wc1:e4b741dd5708dfa8 $C"
msgstr "Excellent, $C ! Je savais que vous ne nous décevrez pas."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/5"
msgid "wc1:c6dcd610e11a9fec"
msgstr "Je n'ai pu sauver aucun des transports, monsieur."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/7"
msgid "wc1:078d653e972f03eb"
msgstr "Nous avons pu protéger l'un des transports, monsieur."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/8"
msgid "wc1:864b8e02cbf39dde"
msgstr "Mais on a rien pu faire pour l'autre vaisseau."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/9"
msgid "wc1:078d653e972f03eb"
msgstr "J'ai pu protéger l'un des transports, monsieur."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/10"
msgid "wc1:864b8e02cbf39dde"
msgstr "Mais j'ai rien pu faire pour l'autre vaisseau."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/11"
msgid "wc1:6591919afa936088 $C"
msgstr "Nous avons perdu beaucoup de bons soldats aujourd'hui à cause de vous, $C."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/12"
msgid "wc1:0d5ff2e2548f8cfa $K $R"
msgstr "Je vois que vous en avez eu $K, $R."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/13"
msgid "wc1:ee757288ae8383b0 $R"
msgstr "Je vois que vous êtes revenu sans mort, $R."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/14"
msgid "wc1:2199e56646a4cb2a $L"
msgstr "Et Doomsday a $L. Bon travail."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/15"
msgid "wc1:06e73e28b10d1d5b"
msgstr "Doomsday n'a rien eu."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/16"
msgid "wc1:0a8c17a83cff8e97"
msgstr "Désolé, monsieur. Je fais génèralement mieux que ça."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/17"
msgid "wc1:42d0786fe36a40c5"
msgstr "Et les chats l'ont tué. Merde, l'Austin et le Griffe du Tigre ne peuvent pas se permettre de perdre des pilotes."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/18"
msgid "wc1:f09f59f8f54ac235 $R"
msgstr "Autre chose, $R. J'ai envoyé Angel et Sorcerer pour escorter le TCS General Powell, l'un des transports de marines."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/19"
msgid "wc1:5f731ed7d1fa549a $R"
msgstr "Autre chose, $R. J'ai envoyé un escadron pour escorter le TCS General Powell, l'un des transports de marines."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/20"
msgid "wc1:d20984affcb57576"
msgstr "Ce Drayman n'est jamais arrivé au point de saut. Avez-vous vu quelque chose pendant votre patrouille?"

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/21"
msgid "wc1:dadac96f0459d233"
msgstr "Non, monsieur, je n'ai rien vu."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/22"
msgid "wc1:2a66bea935198fbe $C"
msgstr "$C, J'aurai besoin de vous voir dans mon bureau plus tard."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/23"
msgid "wc1:8842e46c5d2e68b9"
msgstr "Rompez, pilotes."

msgctxt "sm2/BRIEFING.002/packet/20/scene/1/record/24"
msgid "wc1:5df5792370c68735"
msgstr "Vous pouvez disposer, pilote."

msgctxt "sm2/BRIEFING.002/packet/20/scene/2/record/0"
msgid "wc1:bb195250d0f14be8 $C"
msgstr "T'as entendu la dernière, $C ? Ils ont attrapé Maniac sur le pont d'envol---"

msgctxt "sm2/BRIEFING.002/packet/20/scene/2/record/1"
msgid "wc1:ebb92e22364387b4"
msgstr "---ne portant que son pyjama, et essayant de se faufiler à bord d'un Raptor."

msgctxt "sm2/BRIEFING.002/packet/20/scene/2/record/2"
msgid "wc1:fd397b0aa3c54f1a"
msgstr "Les MPs l'ont ramené à l'infirmerie. Il donnait des coups de pied et criait tout le long."

msgctxt "sm2/BRIEFING.002/packet/20/scene/2/record/3"
msgid "wc1:1dca145309ea998a"
msgstr "Merde, mais ce type est fou."

msgctxt "sm2/BRIEFING.002/packet/20/scene/2/record/4"
msgid "wc1:0a71a5a5772da6c5 $R"
msgstr "Au moins tu n'auras plus à voler avec lui, $R."

msgctxt "sm2/BRIEFING.002/packet/20/scene/3/record/0"
msgid "wc1:758f9061a32ad4e2"
msgstr "Bonjour compagnon. Prends un siége et rejoins nous?"

msgctxt "sm2/BRIEFING.002/packet/20/scene/3/record/1"
msgid "wc1:30edc8617c7b7ab8"
msgstr "Bonjour compagnon. joins-toi à moi?"

msgctxt "sm2/BRIEFING.002/packet/20/scene/3/record/2"
msgid "wc1:08a500dd2d1b42c7"
msgstr "Je pensais juste à mon frére ainé, Dennis."

msgctxt "sm2/BRIEFING.002/packet/20/scene/3/record/3"
msgid "wc1:55857414ede1d749"
msgstr "Major Dennis St.John, des Marines de la Confédération terrienne."

msgctxt "sm2/BRIEFING.002/packet/20/scene/3/record/4"
msgid "wc1:c1fc1f5f4afb6867"
msgstr "Il était si fier de commander son premier poste, une base marine sur une petite colonie reculée quelque part."

msgctxt "sm2/BRIEFING.002/packet/20/scene/3/record/5"
msgid "wc1:57e5d4a17d9f8f05"
msgstr "Les Kilrathis sont arrivés. Quand ils sont partis, il n'y avait aucun survivant."

msgctxt "sm2/BRIEFING.002/packet/20/scene/3/record/6"
msgid "wc1:e01e15650a4f68dd"
msgstr "Et je t'ai dit que j'avais une soeur cadette, mon pote ? Elle aura dix-huit ans dans deux mois."

msgctxt "sm2/BRIEFING.002/packet/20/scene/3/record/7"
msgid "wc1:32babd8b3e544f43"
msgstr "Sheila s'est déjà portée volontaire pour les marines."

msgctxt "sm2/BRIEFING.002/packet/20/scene/4/record/0"
msgid "wc1:1525e565338c03d5 $C"
msgstr "Bonjour, $C.  Je suis le Lt. Etienne 'Doomsday' Montclair."

msgctxt "sm2/BRIEFING.002/packet/20/scene/4/record/1"
msgid "wc1:c0f6c936e0cb6547"
msgstr "Doomsday, Je voudrais te demander---"

msgctxt "sm2/BRIEFING.002/packet/20/scene/4/record/2"
msgid "wc1:190db4d7ca4580fb"
msgstr "Oui, je vois que tu es curieux. Ce que tu vois, ce sont les marques d'un guerrier maori."

msgctxt "sm2/BRIEFING.002/packet/20/scene/4/record/3"
msgid "wc1:451d8ee0089f3633 $C"
msgstr "Laisse-moi te dire, $C... J'ai réflèchi à notre position ici dans le système Firekka."

msgctxt "sm2/BRIEFING.002/packet/20/scene/4/record/4"
msgid "wc1:8c100c0bf404dd57"
msgstr "Même si nous devons battre en retraite, je doute que nous survivons."

msgctxt "sm2/BRIEFING.002/packet/20/scene/4/record/5"
msgid "wc1:e017dd09fa3d58fd"
msgstr "C'est sans aucun doute la pire situation tactique que je n'aie jamais vue."

msgctxt "sm2/BRIEFING.002/packet/20/scene/4/record/6"
msgid "wc1:a9138a9f45413082"
msgstr "A bord de l'Austin, beaucoup de gens rient de mes prédictions."

msgctxt "sm2/BRIEFING.002/packet/20/scene/4/record/7"
msgid "wc1:7f3a270bf835a02c"
msgstr "Malgré ma certitude que nous finirons par être vaincus par les Kilrathis---"

msgctxt "sm2/BRIEFING.002/packet/20/scene/4/record/8"
msgid "wc1:e9b267a23182911a"
msgstr "---Nous avons réussi à survivre jusqu'à présent. Mais cette fois, je suis certain qu'il n'y a aucune échappatoire pour nous.."

msgctxt "sm2/BRIEFING.002/packet/20/scene/4/record/9"
msgid "wc1:56e7f751c1f14c74"
msgstr "Nous n'abandonnerons pas facilement, Doomsday. Peut-être seras-tu surpris par la fin de cette mission."

msgctxt "sm2/BRIEFING.002/packet/20/scene/4/record/10"
msgid "wc1:244cc5a4427057de $C"
msgstr "Peut-être $C, ou peut-être pas."

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/0"
msgid "wc1:9dd695230d7031de $T $D"
msgstr "Briefing de mission, $T, $D.\nPrès du système Firekka, secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/1"
msgid "wc1:7258380690469829"
msgstr "Pilotes, nous avons une urgence ici. Certains d'entre vous ont peut-être entendu dire que le general Powell---"

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/2"
msgid "wc1:c6c44d7213f217f8"
msgstr "---n'est jamais arrivé à son point de rendez-vous. Nous pensions l'avoir perdu... un Drayman avec 150 marines et 25 équipiers."

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/3"
msgid "wc1:75fbb6b211bbf64f"
msgstr "Mais nous avons reçu cette communication d'urgence il y a dix minutes:"

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/4"
msgid "wc1:77b37d04d19a0344"
msgstr "'Ici le major Kristi Marks de la compagnie Zebra. Les Kilrathis ont capturé le Powell il y a huit heures.'"

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/5"
msgid "wc1:758d034d74b22ec5"
msgstr "'Nous nous sommes échappés de la soute et tentons de reprendre le vaisseau.'"

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/6"
msgid "wc1:4370659d81fd9e1a"
msgstr "'Nous avons subi de lourdes pertes et avons besoin d'une aide immédiate.  Nos coordonnées actuelles sont:"

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/7"
msgid "wc1:42f01b82c44ae418"
msgstr "'160123, 153763, 898324, norme terrienne. Veuillez envoyer de l'aide dès que possible. Je répète, veuillez envoyer---'"

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/8"
msgid "wc1:65670f9b7998901e"
msgstr "Le message a été coupé. Et nous n'avons reçu aucune autre communication depuis."

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/9"
msgid "wc1:1d263d5fc443cf18"
msgstr "Nous pensons que les chats vont essayer de sortir le Powell du système..."

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/10"
msgid "wc1:2fcd094fe6925d93"
msgstr "...et nous avons calculé plusieurs parcours entre les dernières coordonnées du Powell et les points de saut les plus proches."

#. wc1-re: shortened to fit the subtitle area.
msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/11"
msgid "wc1:d1f4e5c7fdf34dc6"
msgstr "Suivez votre route jusqu'au Powell. S'il fait un saut, passez au prochain point Nav et poursuivez-le."

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/12"
msgid "wc1:df18344cabd0ba4b"
msgstr "Lorsque vous trouverez le Powell, escortez-le immediatement jusqu'au Griffe du Tigre."

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/13"
msgid "wc1:7cdf5ec4ed7cc4c5"
msgstr "Quoi que vous fassiez, n'attaquez PAS le Drayman. Nous ne pouvons pas risquer de perdre ce vaisseau."

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/14"
msgid "wc1:36aca61efe4fdd00"
msgstr "Mais s'il y a des combattants kilrathis qui l'escortent... ne laissez aucun d'entre eux s'echapper, pilotes."

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/15"
msgid "wc1:26f636a103b677c6"
msgstr "Affectations d'escadrons:"

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/16"
msgid "wc1:683f778990acb303"
msgstr "Le commandant énumère les autres escadrons, puis s'adresse à vous:"

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/17"
msgid "wc1:43fbc4535007339d $C"
msgstr "$C, vous et Doomsday êtes à nouveau l'escadron Theta. "

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/18"
msgid "wc1:213f46a10de5be8a $C"
msgstr "$C, vous êtes l'escadron Theta."

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/19"
msgid "wc1:253bf95dc99a4608"
msgstr "Vous piloterez à nouveau un Dralthi...L'intelligence pense avoir déchiffré les codes de reconnaissance kilrathis---"

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/20"
msgid "wc1:2dc9d6115759e24e"
msgstr "---donc avec de la chance, vous pourrez vous approcher du Drayman avant que les chats ne réalisent que vous êtes des Terriens."

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/21"
msgid "wc1:f38dcca193b9d064"
msgstr "Attendez de voir les Kilrathis tirer sur le Drayman avant de faire sauter votre couverture."

msgctxt "sm2/BRIEFING.002/packet/21/scene/0/record/22"
msgid "wc1:e5601595df2e1bce"
msgstr "C'est tout, pilotes. Vous décollez dans quatre minutes. Rompez."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/0"
msgid "wc1:806a5fba8707d926 $T $D"
msgstr "Débriefing -- $T, $D."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/1"
msgid "wc1:9fb43817fa653ff8 $C"
msgstr "Votre rapport, $C."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/2"
msgid "wc1:7108ca812c795fe1"
msgstr "Je pense que les Kilrathis n'ont pas réalisé que nous allions sauver le Drayman."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/3"
msgid "wc1:e682fc2b11e78380"
msgstr "Nos Marines avaient apparemment repris le vaisseau..."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/4"
msgid "wc1:ed48432acd45ba81"
msgstr "Et les chats essayaient de détruire ce transport..."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/5"
msgid "wc1:911ce17158535415"
msgstr "Mais j'ai ramené le Powell, monsieur."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/6"
msgid "wc1:4b832a16b8ddbdc1"
msgstr "Je ne pouvais pas ramener le Powell, monsieur."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/7"
msgid "wc1:dae763ca80a6eea9"
msgstr "Tous ces soldats sont perdu, à cause de vous."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/8"
msgid "wc1:07c54be9c5f06278"
msgstr "Je suis désolé monsieur. j'ai fait du mieux que j'ai pu."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/9"
msgid "wc1:bfda2c258294bafa $K"
msgstr "Votre enregistreur de vol indique $K."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/10"
msgid "wc1:243c7d33c321f01e $R"
msgstr "Aucun Kilrathi tué, $R.  Que faisiez-vous là-bas?"

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/11"
msgid "wc1:91fdd2f40a5e8146 $L"
msgstr "Doomsday a $L."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/12"
msgid "wc1:3fd2e5ea6777d3b2"
msgstr "Doomsday a zéro."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/13"
msgid "wc1:b5a68cff7ec0ac20"
msgstr "Et puis les chats l'ont tué."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/14"
msgid "wc1:ce912e6f950e10a8"
msgstr "Merde, l'Austin et le Griffe du Tigre ne peuvent pas se permettre de perdre des pilotes!"

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/15"
msgid "wc1:357ed8be31aa3c3e"
msgstr "Le major Marks m'a demandé de vous transmettre ses remerciements pour le sauvetage. Elle est a l'infirmerie avec les marines blessés."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/16"
msgid "wc1:1c7601c4cdcab7ad"
msgstr "Vous voudrez peut-être la voir avant que la compagnie Zebra ne parte pour Firekka."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/17"
msgid "wc1:13aff7e14ad665ed $C"
msgstr "$C, Je dois vous voir dans mon bureau plus tard."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/18"
msgid "wc1:6d9e7038a0798a50"
msgstr "Disposez, pilotes."

msgctxt "sm2/BRIEFING.002/packet/21/scene/1/record/19"
msgid "wc1:5df5792370c68735"
msgstr "Disposez, pilote."

msgctxt "sm2/BRIEFING.002/packet/21/scene/2/record/0"
msgid "wc1:db95cff528c56f30 $C"
msgstr "Le bar est fermé, $C ! Il y a une urgence sur le pont!"

msgctxt "sm2/BRIEFING.002/packet/21/scene/2/record/1"
msgid "wc1:71c25bfcfdccd8e1"
msgstr "Je ne sais pas ce que c'est, mais je sais que l'un des transports de marines a disparu."

msgctxt "sm2/BRIEFING.002/packet/21/scene/2/record/2"
msgid "wc1:2c16f0b7648c14b9 $R"
msgstr "Tu ferais mieux d'aller au Briefing tout de suite, $R!"

msgctxt "sm2/BRIEFING.002/packet/24/scene/0/record/0"
msgid "wc1:71c2019deff97ffb $T $D"
msgstr "Briefing de mission, $T, $D.\nsystème Corsair, Secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/24/scene/0/record/1"
msgid "wc1:f7513223010338f1"
msgstr "Pilotes, la bonne nouvelle : quatre navettes d'assaut de Marines ont réussi un atterrissage sur Firekka."

msgctxt "sm2/BRIEFING.002/packet/24/scene/0/record/2"
msgid "wc1:7d2efab33d5e805a"
msgstr "Ils ont quitté leurs vaisseaux submergés par l'ennemi, et planifient maintenant l'attaque avec les chefs Firekkas."

msgctxt "sm2/BRIEFING.002/packet/24/scene/0/record/3"
msgid "wc1:4009f2ec9e326a6d"
msgstr "La mauvaise nouvelle : nous avons détecté plusieurs escadrons de chasseurs kilrathis en approche du Griffe du Tigre."

msgctxt "sm2/BRIEFING.002/packet/24/scene/0/record/4"
msgid "wc1:1c051a88e48e5c11"
msgstr "Un escadron de patrouille ennemie a dû suivre nos transports jusqu'à ce système."

msgctxt "sm2/BRIEFING.002/packet/24/scene/0/record/5"
msgid "wc1:11e237ae26164fa7"
msgstr "Nous devons les détruire, pilotes, avant qu'ils ne puissent confirmer notre position dans ce système."

msgctxt "sm2/BRIEFING.002/packet/24/scene/0/record/6"
msgid "wc1:499ea5b204a55f83"
msgstr "Nous lançons tous les escadrons immédiatement. Dégagez cette zone de tous les combattants---"

msgctxt "sm2/BRIEFING.002/packet/24/scene/0/record/7"
msgid "wc1:7cd4490f01fd3aab"
msgstr "---puis patrouillez les points de navigation, éliminez tous les vaisseaux capitaux ennemis."

msgctxt "sm2/BRIEFING.002/packet/24/scene/0/record/8"
msgid "wc1:5ebe44f1437c9d05"
msgstr "Vous attendez que le colonel affecte les autres escadrons."

msgctxt "sm2/BRIEFING.002/packet/24/scene/0/record/9"
msgid "wc1:2dde68c033737f07 $C $C"
msgstr "Escadron Sigma sera $C et Hunter, avec $C comme chef."

msgctxt "sm2/BRIEFING.002/packet/24/scene/0/record/10"
msgid "wc1:a8235c4650e4186f $C"
msgstr "Escadron Sigma sera $C, vous serez seul."

msgctxt "sm2/BRIEFING.002/packet/24/scene/0/record/11"
msgid "wc1:6278c4393ee05991"
msgstr "Allez et arretez ces combattants, pilotes Rompez."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/1"
msgid "wc1:f1bac6b41eb04a0f $C"
msgstr "Bienvenue, $C. J'écoute votre rapport."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/2"
msgid "wc1:a36042bb2d6f67ec"
msgstr "J'ai perdu Hunter, monsieur. J'ai éssayé de le sauver, mais..."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/3"
msgid "wc1:f10c81db129347e4 $N"
msgstr "Je sais que vous avez fait de votre mieux, $N. Dites-moi ce qui s'est passé."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/4"
msgid "wc1:a875a26fde4076f2"
msgstr "Les combattants étaient coriaces, monsieur. Après m'être battu avec eux, je ne pouvais pas poursuivre la flotte d'attaque."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/5"
msgid "wc1:534fe67b2dc4344e $C"
msgstr "Ce n'est pas suffisant, $C ! J'attends beaucoup mieux de vous, monsieur."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/7"
msgid "wc1:7a6bc4173a5ff5a1"
msgstr "On est allés sur cette flotte d'attaque, monsieur."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/8"
msgid "wc1:5e08a3649301157a"
msgstr "Je suis allé sur cette flotte d'attaque, monsieur."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/9"
msgid "wc1:f68500f23106cab9"
msgstr "Le Ralari à Nav 2 fait parti de l'histoire."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/10"
msgid "wc1:f05095ebbf34325c"
msgstr "Le Snakeir n'était pas un problème. Il est en poussière."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/11"
msgid "wc1:d9a93572bce9d90e $K $C"
msgstr "Votre total de victime est de $K, $C."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/12"
msgid "wc1:76433969c65cb7e6"
msgstr "Vous n'avez pas eu un seul vaisseau. Pourquoi est-ce que je continue à vous envoyer?"

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/13"
msgid "wc1:f4debf740ec11522 $L"
msgstr "Hunter a $L."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/14"
msgid "wc1:9f565eb897f67b75"
msgstr "Hunter n'a rien eu."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/15"
msgid "wc1:b3487062bc204b0c"
msgstr "Et puis les Kilrathis l'ont abattu, qu'ils soient tous maudits."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/16"
msgid "wc1:2a66bea935198fbe $C"
msgstr "$C, J'aurai besoin de vous voir dans mon bureau plus tard."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/17"
msgid "wc1:5df5792370c68735"
msgstr "Vous pouvez disposez, pilote."

msgctxt "sm2/BRIEFING.002/packet/24/scene/1/record/18"
msgid "wc1:8842e46c5d2e68b9"
msgstr "Disposez, pilotes."

msgctxt "sm2/BRIEFING.002/packet/24/scene/2/record/0"
msgid "wc1:712c6f46fb20b3c1 $R"
msgstr "je viens d'apprendre une mauvaise nouvelle, $R..."

msgctxt "sm2/BRIEFING.002/packet/24/scene/2/record/1"
msgid "wc1:dc58990ff122ca2a"
msgstr "Il se peut qu'aucun renfort n'arrive ici."

msgctxt "sm2/BRIEFING.002/packet/24/scene/2/record/2"
msgid "wc1:9d6284b83505c060"
msgstr "Je suppose que le QG pense que nous sommes submergés, et il ne veulent plus risquer de vaisseaux."

msgctxt "sm2/BRIEFING.002/packet/24/scene/2/record/3"
msgid "wc1:c6775a9359219c5c"
msgstr "Tout ce que je sais avec certitude, c'est que l'Austin se retire."

msgctxt "sm2/BRIEFING.002/packet/24/scene/2/record/4"
msgid "wc1:cc2d55ee4cfdeb80"
msgstr "Et j'espère que nous les suivrons, dès que les marines seront hors de la planète."

msgctxt "sm2/BRIEFING.002/packet/24/scene/2/record/5"
msgid "wc1:f647e1f17b794106"
msgstr "Il y a une énorme flotte ennemie pres de Firekka. Tôt ou tard, ils nous trouveront ici."

msgctxt "sm2/BRIEFING.002/packet/24/scene/2/record/6"
msgid "wc1:a2b233aa4834b484"
msgstr "Et alors? Nous ne pourrons pas gagner."

msgctxt "sm2/BRIEFING.002/packet/24/scene/2/record/7"
msgid "wc1:7784b78fb79fe65a"
msgstr "Eh bien, laisse-moi te servir un verre. Je n'arrête pas de penser à ce vieux dicton chinois...."

msgctxt "sm2/BRIEFING.002/packet/24/scene/2/record/8"
msgid "wc1:1215ca9ab92db494"
msgstr "...Et je me demande s'il y aura un jour une fin à tous ces moments."

msgctxt "sm2/BRIEFING.002/packet/24/scene/3/record/0"
msgid "wc1:009d299eb2e212de"
msgstr "Eh bien, Maestro, je suppose que c'est un Au revoir."

msgctxt "sm2/BRIEFING.002/packet/24/scene/3/record/1"
msgid "wc1:9f74ff534297dbb7"
msgstr "Je suis content d'avoir eu la chance de servir à bord du Griffe du Tigre."

msgctxt "sm2/BRIEFING.002/packet/24/scene/3/record/2"
msgid "wc1:654c472fbcad4db2"
msgstr "J'ai beaucoup appris ici. Et j'ai beaucoup réfléchi---"

msgctxt "sm2/BRIEFING.002/packet/24/scene/3/record/3"
msgid "wc1:df66366490f0c24e"
msgstr "---à propos de ce que je vais faire quand je serai de retour sur l'Austin."

msgctxt "sm2/BRIEFING.002/packet/24/scene/3/record/4"
msgid "wc1:d0faa0de459cf0c6"
msgstr "Je pense que mon experience ici va changer toute ma carrière."

msgctxt "sm2/BRIEFING.002/packet/24/scene/3/record/5"
msgid "wc1:01a759d035e5ad13"
msgstr "Heureux de l'entendre, Jazz. Et j'espère qu'on se reverra."

msgctxt "sm2/BRIEFING.002/packet/24/scene/3/record/6"
msgid "wc1:79220ada55a21023 $C"
msgstr "je parierais là-dessus, $C."

msgctxt "sm2/BRIEFING.002/packet/24/scene/4/record/0"
msgid "wc1:d0734751fa8abaef $R"
msgstr "Bonjour, $R. Je ne sais pas si tu l'as entendu..."

msgctxt "sm2/BRIEFING.002/packet/24/scene/4/record/1"
msgid "wc1:473a90cf2311e169"
msgstr "...Jazz et moi retournons sur l'Austin."

msgctxt "sm2/BRIEFING.002/packet/24/scene/4/record/2"
msgid "wc1:5d98b63a94f4ccca $C"
msgstr "Ce fut un plaisir de servir avec toi, $C."

msgctxt "sm2/BRIEFING.002/packet/24/scene/4/record/3"
msgid "wc1:f702ed9a41f6100c"
msgstr "Tu es un bon ailier, Etienne. J'espère que nous volerons à nouveau ensemble contre les Kilrathis, un jour."

msgctxt "sm2/BRIEFING.002/packet/24/scene/4/record/4"
msgid "wc1:d07dde4b23945510"
msgstr "Peut-être. Si les Kilrathis ne nous tuent pas d'abord. Ou que nos vaisseaux ne s'autodétruisent pas."

msgctxt "sm2/BRIEFING.002/packet/24/scene/4/record/5"
msgid "wc1:570f6403cd5a6550"
msgstr "Ou qu'on ne nous affecte pas à des tâches de bureau."

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/0"
msgid "wc1:71c2019deff97ffb $T $D"
msgstr "Briefing de mission, $T, $D.\nsystème Corsair, Secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/1"
msgid "wc1:b8f81068aa9f7f48"
msgstr "Très bien, pilotes, nous sommes sur le fil du rasoir maintenant."

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/2"
msgid "wc1:20a24a03a852a1e7"
msgstr "Nos marines sont en position et prêts à lancer leur assaut."

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/3"
msgid "wc1:7b0774fd93117070"
msgstr "Et les Kilrathis envoient des troupes au sol pour les arrêter."

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/4"
msgid "wc1:f480373ce749e0fd"
msgstr "Votre mission est d'intercepter et de détruire ces vaisseaux de troupes."

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/5"
msgid "wc1:b3d7543d58bd6918"
msgstr "Si nous échouons pilotes, les troupes ennemies atterriront sur la planète---"

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/6"
msgid "wc1:787701252a028cea"
msgstr "---il est probable qu'aucun de nos marines ne survivra."

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/7"
msgid "wc1:c1ad40fb059d8b0e"
msgstr "Alors ne laissez AUCUN des vaisseaux de troupes kilrathis vous échapper. Entendu?"

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/8"
msgid "wc1:9f3c965e26e7d71d $C"
msgstr "$C!  Vous êtes à nouveau avec Hunter, en tant qu'escadron Mu."

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/9"
msgid "wc1:25f698b944efbd9f $C"
msgstr "$C!  vous êtes escadron Mu."

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/10"
msgid "wc1:055453c42c1c584e"
msgstr "Naviguez jusqu'à Nav 1. C'est la que vous trouverez probablement le premier vaisseau de troupe ennemi."

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/11"
msgid "wc1:23efaf7ae02ed722"
msgstr "Assurez-vous qu'il ne s'échappe pas en sautant. Si c'est le cas, suivez-le jusqu'au prochain point de navigation et détruisez-le."

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/12"
msgid "wc1:241c4f832c3973be"
msgstr "Verifiez le champ d'astéroïdes à Nav 2, puis rentrez."

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/13"
msgid "wc1:ec698419b9e10881"
msgstr "Le Colonel affecte rapidement les autres escadrons."

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/14"
msgid "wc1:310cfacc4ae7bf09"
msgstr "très bien, pilotes. Preparez-vous pour un lancement immédiat."

msgctxt "sm2/BRIEFING.002/packet/25/scene/0/record/15"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Rompez."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/1"
msgid "wc1:139e317698d5f904"
msgstr "Les autres escadrons ont rencontré un grand nombre de vaisseaux de troupes kilrathis---"

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/2"
msgid "wc1:c8877a8ac0d066ad"
msgstr "Certains de ces vaisseaux de classe Dorkir ont échappé à nos chasseurs, mais pas beaucoup."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/3"
msgid "wc1:846130851e281c70 $C"
msgstr "J'écoute votre rapport, $C."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/4"
msgid "wc1:74be4803f0b2f85f"
msgstr "Il y avait beaucoup d'appareils ennemis qui étaient sur ma route, monsieur."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/5"
msgid "wc1:ead16bd1d4af858a"
msgstr "J'ai rencontré deux transporteurs de troupes Dorkir entre Nav 1 et 2. Ils sont tous les deux détruits."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/6"
msgid "wc1:0172b9b7afe6f964 $C"
msgstr "Bon travail, $C ! je suis très impressionné."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/8"
msgid "wc1:efb913afb634939d"
msgstr "Je ne pouvais détruire aucun des transporteurs de troupes Dorkir."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/9"
msgid "wc1:9be106056782c518"
msgstr "Pourquoi est-ce que je continue a vous envoyer en mission ? Votre incompétence nous met tous en danger."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/10"
msgid "wc1:114dba80406afde1"
msgstr "Il y avait deux transporteurs de troupes Dorkir entre Nav 1 et 2. L'un d'eux s'est échappé."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/11"
msgid "wc1:b5b49da54f69ca2b"
msgstr "Mais l'autre vaisseau a été détruit, monsieur."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/12"
msgid "wc1:114dba80406afde1"
msgstr "Il y avait deux transporteurs de troupes Dorkir entre Nav 1 et 2. L'un d'eux s'est échappé."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/13"
msgid "wc1:b5b49da54f69ca2b"
msgstr "Mais l'autre vaisseau a été détruit, monsieur."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/14"
msgid "wc1:6677ab26afb9acf6"
msgstr "Realisez-vous que votre échec dans cette mission a peut-être condamné nos troupes sur Firekka, pilote?"

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/15"
msgid "wc1:f0bdd39d861dacbb $K $C"
msgstr "L'enregistreur vous attribue de $K, $C."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/16"
msgid "wc1:ec6e7e0e96ee1099 $C"
msgstr "Vous êtes revenu sans une seule cible, $C. Que diable faisiez-vous là-bas, monsieur?"

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/17"
msgid "wc1:f8ddb05f1f594635 $L"
msgstr "Je vois qu'Hunter a $L."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/18"
msgid "wc1:18feb568ed14869a"
msgstr "Je vois que Hunter n'a rien."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/19"
msgid "wc1:5dcb0d74d50fce45"
msgstr "Et puis nous l'avons perdu."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/20"
msgid "wc1:b9b7c01cc8f1383e $R"
msgstr "C'est tout, $R. Reposez-vous avant votre prochaine mission."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/21"
msgid "wc1:3f85b2fbc0614d74"
msgstr "Et j'aurai besoin de vous voir dans mon bureau plus tard."

msgctxt "sm2/BRIEFING.002/packet/25/scene/1/record/22"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Rompez."

msgctxt "sm2/BRIEFING.002/packet/25/scene/2/record/0"
msgid "wc1:18fc84140780d490 $R"
msgstr "Désolé, $R, je ne peux rien te servir. tu arrives après huit heures."

msgctxt "sm2/BRIEFING.002/packet/25/scene/2/record/1"
msgid "wc1:42ebd5e87cbbb4eb"
msgstr "Cependant j'ai du vrai thé britannique, que je garde ici pour le colonel Roberts."

msgctxt "sm2/BRIEFING.002/packet/25/scene/2/record/2"
msgid "wc1:a9c2525116570af8"
msgstr "Merci Sam, je vais essayer ça. As-tu des nouvelles fraîches?"

msgctxt "sm2/BRIEFING.002/packet/25/scene/2/record/3"
msgid "wc1:52155ae0fae9cd78"
msgstr "Pas vraiment. La plupart des officiers de pont ne parlent pas beaucoup."

msgctxt "sm2/BRIEFING.002/packet/25/scene/2/record/4"
msgid "wc1:1f768df713438125"
msgstr "Je pense que tout le monde attend de savoir ce qui est arrivé aux marines sur Firekka."

msgctxt "sm2/BRIEFING.002/packet/25/scene/2/record/5"
msgid "wc1:2b08cd695ca86e81"
msgstr "Nous le saurons très bientôt, je pense."

msgctxt "sm2/BRIEFING.002/packet/25/scene/3/record/0"
msgid "wc1:f68173d26d6ac915 $R"
msgstr "$R!  Tu as l'air de bien tenir le coup."

msgctxt "sm2/BRIEFING.002/packet/25/scene/3/record/1"
msgid "wc1:262050cbb6b8b0b9"
msgstr "Je n'arrête pas de penser à nos marines. Au moins nous sommes ici en sécurité---"

msgctxt "sm2/BRIEFING.002/packet/25/scene/3/record/2"
msgid "wc1:97c4fa7a934b3aaa"
msgstr "---de toutes ces flottes de combat kilrathis. Ces marines sont plus à plaindre."

msgctxt "sm2/BRIEFING.002/packet/25/scene/3/record/3"
msgid "wc1:12360042b69f12c0"
msgstr "Et je continue de penser à ce travail d'instructeur de vol."

msgctxt "sm2/BRIEFING.002/packet/25/scene/3/record/4"
msgid "wc1:c50a65ebc988d3a4"
msgstr "Ça peut être bien, pour une fois, de ne pas être en plein milieu d'une zone de combat.."

msgctxt "sm2/BRIEFING.002/packet/25/scene/3/record/5"
msgid "wc1:153b2ae078495e53"
msgstr "Mais j'ai pris ma decision. Je vais rester ici, à bord du Griffe du Tigre."

msgctxt "sm2/BRIEFING.002/packet/25/scene/3/record/6"
msgid "wc1:1512f78a7963e88d"
msgstr "Je pense que tu aurais été un excellent instructeur, Joseph."

msgctxt "sm2/BRIEFING.002/packet/25/scene/3/record/7"
msgid "wc1:3bedda5135a960b7"
msgstr "Mais je suis content que tu restes avec nous."

msgctxt "sm2/BRIEFING.002/packet/25/scene/3/record/8"
msgid "wc1:848954b8f18901ed $C"
msgstr "Merci, $C."

msgctxt "sm2/BRIEFING.002/packet/25/scene/4/record/0"
msgid "wc1:47e7ba0cf41f86bb $C"
msgstr "$C. Je viens de lire le rapport du Major Baker du Secteur Vega."

msgctxt "sm2/BRIEFING.002/packet/25/scene/4/record/1"
msgid "wc1:b208baaad9b1a187"
msgstr "Apparemment, ils ont capturé deux traîtres humains sur le TCS Winterrowd."

msgctxt "sm2/BRIEFING.002/packet/25/scene/4/record/2"
msgid "wc1:aef3f965ceef5898"
msgstr "Deux des nôtres, donnant des informations militaires vitales aux Kilrathis."

msgctxt "sm2/BRIEFING.002/packet/25/scene/4/record/3"
msgid "wc1:c4015123fe0c4b03"
msgstr "Maintenant, ils pensent qu'il pourrait y avoir un vaste réseau de traîtres humains..."

msgctxt "sm2/BRIEFING.002/packet/25/scene/4/record/4"
msgid "wc1:bb9f627e1d62bb56"
msgstr "...et ils l'appellent la 'Société des Mandarins.'"

msgctxt "sm2/BRIEFING.002/packet/25/scene/4/record/5"
msgid "wc1:4dd3a7dee1a12d96"
msgstr "Je suis juste content que nous n'ayons aucun signe de traître ici sur le Griffe du Tigre."

msgctxt "sm2/BRIEFING.002/packet/25/scene/4/record/6"
msgid "wc1:d31858300bdae67d"
msgstr "Parce que s'il y en avait ici, je les tuerais moi-même."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/0"
msgid "wc1:71c2019deff97ffb $T $D"
msgstr "Briefing de mission, $T, $D.\nsystème Corsair, Secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/1"
msgid "wc1:fdc71b69d80e614c"
msgstr "Pilotes, nous avons reçu la confirmation des marines sur Firekka."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/2"
msgid "wc1:61569e17b681cfd2"
msgstr "Ils ont réussi à perturber la cérèmonie Sivar, mais ont subi de lourdes pertes dans leur mission."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/3"
msgid "wc1:9b9e0165cca4b64b"
msgstr "Et les Kilrathis patrouillent dans la zone pour s'assurer qu'ils ne s'échappent pas de Firekka."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/4"
msgid "wc1:67fdfbdd9cf8621b"
msgstr "Quatre vaisseaux de marines ont déjà été détruits en tentant de quitter la planète."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/5"
msgid "wc1:33d367bf4eb44a3b"
msgstr "Nous avons reçu un autre communiqué de ce Prince Thrakhath..."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/6"
msgid "wc1:714ce256c108d9ec"
msgstr "L'intelligence est très perplexe à propos de ce message vidéo---"

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/7"
msgid "wc1:34cf3927f87ee3a7"
msgstr "---signifiant que les Kilrathis savent exactement où nous sommes. Mais ils ne tirent pas."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/8"
msgid "wc1:bd6d20f803b6d5ab"
msgstr "Et ce que dit le prince Thrakhath est encore plus intéressant..."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/9"
msgid "wc1:fc74e026b491ecd5"
msgstr "'Guerriers humains, écoutez-moi maintenant. Vous avez prouvé que vous êtes courageux---'"

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/10"
msgid "wc1:6a9bbc2ea4eba574"
msgstr "'---étonnamment courageux, pour de simples singes. Gràce à cette bravoure---'"

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/11"
msgid "wc1:f7469fe44568a728"
msgstr "'---Je vous accorderez un quart de tour planètaire pour quitter ce secteur.'"

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/12"
msgid "wc1:bd68ecc3e9f9c459"
msgstr "'Mais vos soldats sont à nous. Nous les écraserons comme les singes qu'ils sont.'"

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/13"
msgid "wc1:cfffd895c5c950fc"
msgstr "'Ainsi parle le Prince Thrakhath, Héritier de Kilrah.'"

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/14"
msgid "wc1:585d76c9ee9607eb"
msgstr "La conclusion de l'intelligence est que, puisque la cérèmonie a été interrompue---"

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/15"
msgid "wc1:5ac4d00f33e1f204"
msgstr "---Thrakhath craint une mutinerie parmi ses troupes s'il ordonne une attaque générale."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/16"
msgid "wc1:82982b7d48d8bf0e"
msgstr "Si ses soldats croient qu'ils sont destinés à mourir au combat, ils ne voudront pas se battre."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/17"
msgid "wc1:475c5a19832d6833"
msgstr "Bien sûr, Thrakhath commencera probablement à tirer sur les troupes qui désobéissent à ses ordres..."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/18"
msgid "wc1:0e0ec47c614e51f0"
msgstr "Mais pour l'instant, nous avons le temps d'agir avant que toutes ses flottes de combat ne convergent vers nous."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/19"
msgid "wc1:4ed6f5e99a0316ef"
msgstr "Au cas où vous vous poseriez la question, pilotes, le renseignement suggère que nous battions en retraite.."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/20"
msgid "wc1:8a8d86bc8d7ebaed"
msgstr "Et nous le ferons, après avoir sauvé nos transports. Votre travail consiste à trouver et à aider ces vaisseaux."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/21"
msgid "wc1:4056bfb27f2c204b $C"
msgstr "$C, vous êtes seul cette fois."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/22"
msgid "wc1:98e172c954785f9f $N"
msgstr "Affectations d'escadrons... $N et Deveraux seront escadron Omicron."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/23"
msgid "wc1:fc843d56c0d255ff"
msgstr "Les transports essaieront de semer leurs poursuivants kilrathis, nous ne savons donc pas exactement où vous les trouverez."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/24"
msgid "wc1:a53e08d807b6c51d"
msgstr "Mais nous avons établi plusieurs trajectoires de vol possibles vers différents points de saut."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/25"
msgid "wc1:248dcbe06e656a18 $C"
msgstr "$C, vous volerez vers Nav 1, détruisant tous les vaisseaux ennemis que vous rencontrerez..."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/26"
msgid "wc1:04cc68b84a74483d"
msgstr "...puis revenez immediatement au Griffe du Tigre."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/27"
msgid "wc1:5059b4e7e031cac1"
msgstr "Vous écoutez le colonel lire les autres missions des escadrons."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/28"
msgid "wc1:81d7a82f7a461d2b"
msgstr "Nous nous attendons à une attaque majeure kilrathi dès que Thrakhath ralliera ses troupes."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/29"
msgid "wc1:1118080361b85a99"
msgstr "Alors revenez ici aussi vite que possible pour défendre le Tigre."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/30"
msgid "wc1:ff3a0df41818293f"
msgstr "Parce que si ce transporteur est détruit, vous aurez une longue route à faire jusqu'au secteur Vega."

msgctxt "sm2/BRIEFING.002/packet/28/scene/0/record/31"
msgid "wc1:fb004ce2220212b6"
msgstr "Vous décollerez dans cinq minutes, pilotes.  Rompez."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/1"
msgid "wc1:846130851e281c70 $C"
msgstr "J'écoute votre rapport, $C."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/2"
msgid "wc1:e3794cb3b4f09763 $C"
msgstr "J'ai entendu parler d'Angel. Dites-moi ce qui s'est passé, $C."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/3"
msgid "wc1:d2d736d93467f8af"
msgstr "Je n'ai pas pu aider le Drayman, monsieur. Trop de combattants ennemis."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/4"
msgid "wc1:74e1ec712f18823a"
msgstr "Après votre lancement, nous avons reçu un appel de dêtresse venant de Nav 1."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/5"
msgid "wc1:5ce358b575c7c44a"
msgstr "Un de nos transports était poursuivi, essayant d'échapper à un escadron de Krants."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/6"
msgid "wc1:6be4d3164f92719d"
msgstr "Ils ont dit que deux autres transports avaient quitté la planète avec eux, mais n'avaient pas survécu."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/7"
msgid "wc1:6ffe256af04aa9b1"
msgstr "Au point de saut, ils ont coupé toute alimentation et ont essayé de passer devant les patrouilles kilrathis."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/8"
msgid "wc1:269ac2c4afe26597"
msgstr "Ils ont dit qu'ils avaient decompressé les couloirs et laissé leurs propres morts flotter dans l'espace---"

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/9"
msgid "wc1:b4a6dcf3e27ee9d8"
msgstr "---de sorte que l'equipe de débarquement Kilrathi pensent qu'il n'y ait pas de survivants. Mais les chats ont vu la ruse."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/10"
msgid "wc1:c786e2b9803f0c69"
msgstr "Lorsque nous avons reçu leur message vidlink, ils étaient attaqués."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/11"
msgid "wc1:cd237f226209a622"
msgstr "Les Kilrathis essayaient de détruire le vaisseau, mais j'ai ramené le Drayman intact, monsieur."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/12"
msgid "wc1:53306742a6041746 $C"
msgstr "Je suis impressionné par la façon dont vous avez géré cette situation, $C. Bon travail."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/13"
msgid "wc1:89d15e2d0293a3c4 $C"
msgstr "Mais je ne pouvais pas empecher l'ennemi de détruire le Drayman, $C."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/14"
msgid "wc1:f77f9c4df5bccf61"
msgstr "Je sais que vous avez fait de votre mieux, pilote. Mais ce n'était pas assez, pas cette fois."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/15"
msgid "wc1:b7a02d791be15829 $K"
msgstr "Pour info, vous avez $K."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/16"
msgid "wc1:9511c077986088c6 $R"
msgstr "Y compris un Ralari. Pas mal, $R."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/17"
msgid "wc1:a199941ccbef0a20 $R"
msgstr "vous n'avez rien eu $R..."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/18"
msgid "wc1:a503dd91268ff147 $L"
msgstr "Angel a $L."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/19"
msgid "wc1:ee65595696ae9e7f"
msgstr "Angel n'a eu aucun Kilrathi."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/20"
msgid "wc1:395a6774bfea242a"
msgstr "Et puis nous l'avons perdue."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/21"
msgid "wc1:ef141bd939a983e4 $C"
msgstr "$C, Je veux vous voir dans mon bureau plus tard."

msgctxt "sm2/BRIEFING.002/packet/28/scene/1/record/22"
msgid "wc1:0117447067b73d22 $N"
msgstr "C'est tout, $N.  Rompez."

msgctxt "sm2/BRIEFING.002/packet/28/scene/2/record/0"
msgid "wc1:7a8190d133a6278c $C"
msgstr "Tu connais la bonne nouvelle, $C ? Nos marines ont anéanti la cérèmonie kilrathi sur Firekka!"

msgctxt "sm2/BRIEFING.002/packet/28/scene/2/record/1"
msgid "wc1:db5961f964773196"
msgstr "Et t'as entendu parler de la promotion d'Angel au grade de Major?"

msgctxt "sm2/BRIEFING.002/packet/28/scene/2/record/2"
msgid "wc1:2b02e4674f55e4a8"
msgstr "Bien sûr, nous sommes toujours coincés ici avec toutes ces fichues flottes kilrathis..."

msgctxt "sm2/BRIEFING.002/packet/28/scene/2/record/3"
msgid "wc1:2a1d4cfbdbc8798b"
msgstr "...mais on doit fêter ca!"

msgctxt "sm2/BRIEFING.002/packet/28/scene/3/record/0"
msgid "wc1:cdd33ceb7f671191 $C"
msgstr "Bonjour, $C.  J'espère que tu vas bien."

msgctxt "sm2/BRIEFING.002/packet/28/scene/3/record/1"
msgid "wc1:fea9abe508c3fd64"
msgstr "Je vais bien, Angel. Mais personne ne t'a vu ces derniers jours, sauf aux briefings."

msgctxt "sm2/BRIEFING.002/packet/28/scene/3/record/2"
msgid "wc1:a479bf84bd2c801d"
msgstr "Je sais. Ce n'était pas que je t'évitais toi et les autres---"

msgctxt "sm2/BRIEFING.002/packet/28/scene/3/record/3"
msgid "wc1:60e607fc1ed45b65"
msgstr "---mais j'avais besoin d'être seule. Pour prendre une décision."

msgctxt "sm2/BRIEFING.002/packet/28/scene/3/record/4"
msgid "wc1:27f67ebb6c91ff33"
msgstr "Le colonel Zaritsky m'a demandé de prendre le commandement de l'escadron de chasse de l'Austin."

msgctxt "sm2/BRIEFING.002/packet/28/scene/3/record/5"
msgid "wc1:b6a27a77ede177e3"
msgstr "Je serai promue major et transferée a l'Austin lors de notre prochain rendez-vous."

msgctxt "sm2/BRIEFING.002/packet/28/scene/3/record/6"
msgid "wc1:58f181aa7e4ddaf5"
msgstr "C'est une excellente nouvelle, Angel. je suis vraiment content pour toi."

msgctxt "sm2/BRIEFING.002/packet/28/scene/3/record/7"
msgid "wc1:84a16b9e41c488e8"
msgstr "Merci, mon ami. Merci."

msgctxt "sm2/BRIEFING.002/packet/28/scene/4/record/0"
msgid "wc1:bc23e46a76e105c9 $C"
msgstr "$C.  Je parlais avec Hunter quelques \n heures avant."

msgctxt "sm2/BRIEFING.002/packet/28/scene/4/record/1"
msgid "wc1:a9615f616b26db9d"
msgstr "Il est toujours très bouleversé par la \n mort de son frère."

msgctxt "sm2/BRIEFING.002/packet/28/scene/4/record/2"
msgid "wc1:755e70d074fbf320 $C"
msgstr "$C.  Je me souviens de la dernière fois que j'ai vu mon fiancé, sur la Station Epsilon."

msgctxt "sm2/BRIEFING.002/packet/28/scene/4/record/3"
msgid "wc1:3987feb74de8151a"
msgstr "Beaucoup d'entre nous ont subi de terribles pertes. Mais je ne peux pas m'empêcher de penser que---"

msgctxt "sm2/BRIEFING.002/packet/28/scene/4/record/4"
msgid "wc1:9ee50c9fd175fc87"
msgstr "---ce que nous faisons ici est important. Plus important que n'importe quoi d'autre."

msgctxt "sm2/BRIEFING.002/packet/28/scene/4/record/5"
msgid "wc1:854b79e9ab3de451"
msgstr "J'ai à l'idée que toute guerre est mauvaise, le coût de la vie est trop élevé."

msgctxt "sm2/BRIEFING.002/packet/28/scene/4/record/6"
msgid "wc1:9dc5a7c3ff155b5d $C"
msgstr "Mais peut-être y a-t-il des guerres qui doivent être faites, $C."

msgctxt "sm2/BRIEFING.002/packet/28/scene/4/record/7"
msgid "wc1:384bebdae1738522"
msgstr "Et je pense que cette guerre contre les Kilrathis en fait partie."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/0"
msgid "wc1:936de729bf7a9fb2 $T $D"
msgstr "Briefing de mission, $T, $D. Départ du système Corsair, Secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/1"
msgid "wc1:c09a01e2b6f784a0"
msgstr "Ecoutez bien, tout le monde, car nous n'avons pas beaucoup de temps."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/2"
msgid "wc1:17992ec387dd084c"
msgstr "Comme vous l'avez probablement deviné, nous quittons cette zone aussi vite que possible."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/3"
msgid "wc1:6bd15ddc825eeab1"
msgstr "Les flottes de combat kilrathis manoeuvrent vers notre position dans le système Corsair."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/4"
msgid "wc1:156b0aec4cba5502"
msgstr "Les Kilrathis ne peuvent pas rester plus longtemps dans cette zone, même pour poursuivre le Griffe du Tigre---"

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/5"
msgid "wc1:a92ab3fd93da9e7d"
msgstr "---parce que la Confédération progresse à travers les positions abandonnées des Kilrathis des autres secteurs."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/6"
msgid "wc1:1691a5065a8680d1"
msgstr "Ils devront donc retirer leurs forces de ce système pour bientôt."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/7"
msgid "wc1:2b8f9a41b5e77201"
msgstr "Mais en attendant, ils vont probablement riposter contre les Firekkas pour avoir perturbé leur cérèmonie religieuse."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/8"
msgid "wc1:3a9b3b1f9f6053f2"
msgstr "Ce qui pourrait inclure un génocide. Ou les Firekkas seront transportés hors du système en tant qu'esclave."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/9"
msgid "wc1:85c6137b89be68ab"
msgstr "Et nous allons essayer une tactique très dangereuse pour empêcher celà."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/10"
msgid "wc1:608e08b6d7d97a0f"
msgstr "Notre objectif est d'infliger le plus de dégâts possible aux Kilrathis lors de notre retraite du système."

#. wc1-re: shortened to fit the subtitle area.
msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/11"
msgid "wc1:2dbf0b37712f7440"
msgstr "En détruisant assez de vaisseaux, nous les empêcherons de rester près de Firekka ET de défendre leurs frontières."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/12"
msgid "wc1:2886194bc2bf8946"
msgstr "Notre plan... le Griffe du Tigre fera plusieurs sauts pour attirer les vaisseaux \n capitaux kilrathis---"

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/13"
msgid "wc1:fb5e4f2071111b61"
msgstr "---dans les points d'embuscade. Votre mission est d'en détruire autant que vous le pouvez."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/14"
msgid "wc1:551ae580167b1463"
msgstr "Pilotes, je ne peux pas vous ordonner de partir en mission suicide---"

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/15"
msgid "wc1:4d4bd00b3f623a99"
msgstr "---mais quand vous volez là-bas, gardez celà à l'esprit:"

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/16"
msgid "wc1:8a2e53e940c704d1"
msgstr "Il y a plusieurs millions de vies en jeu sur Firekka."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/17"
msgid "wc1:9bfc6138774ebef7"
msgstr "Ils ne nous ressemblent peut-être pas, mais ils sont nos alliés."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/18"
msgid "wc1:c462a9f88a290fcc"
msgstr "Pensez à celà, pilotes, et prenez votre propre décision."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/19"
msgid "wc1:fd8f077746cb926d $C"
msgstr "$C! Vous faites à nouveau équipe avec Angel, en tant qu'escadron Omega."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/20"
msgid "wc1:af8e55c76998a3a6 $C"
msgstr "$C!  Vous êtes l'escadron Omega."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/21"
msgid "wc1:e2865b384681b9b5"
msgstr "Suivez votre parcours de navigation. Vous rejoindrez le Tigre au point de rendez-vous."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/22"
msgid "wc1:32ad57d556f64e84"
msgstr "Le colonel termine rapidement les affectations d'escadrons."

msgctxt "sm2/BRIEFING.002/packet/29/scene/0/record/23"
msgid "wc1:fb004ce2220212b6"
msgstr "Vous décollerez dans cinq minutes, pilotes. Rompez."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/1"
msgid "wc1:e8b29fa04c2514c6 $C"
msgstr "Votre rapport, $C?"

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/2"
msgid "wc1:2a36d8a2cde9d29f"
msgstr "Nous ne pouvions éliminer aucun des vaisseaux capitaux ennemis, monsieur."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/3"
msgid "wc1:824b7633b7a8fc4c"
msgstr "Je n'ai pu éliminer aucun des vaisseaux capitaux ennemis, monsieur."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/5"
msgid "wc1:aed327ba83b8844b"
msgstr "Le Dorkir appartient à l'histoire."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/6"
msgid "wc1:6f5ba50b53409fc7"
msgstr "Je n'ai pas pu éliminer le Dorkir."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/7"
msgid "wc1:06d11bce95c1b724"
msgstr "Le Fralthi n'était pas un problème. C'est réglé, monsieur."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/8"
msgid "wc1:8ea3addeb8ae8eb1"
msgstr "Je ne pouvais pas détruire le Fralthi, monsieur."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/9"
msgid "wc1:f898f6b1bb58c82f $C"
msgstr "Excellent, $C!  Je savais que vous ne nous laisseriez pas tomber."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/10"
msgid "wc1:408d59522400be3b $K $C"
msgstr "L'enregistreur montre que vous avez $K, $C."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/11"
msgid "wc1:3f5f819450dea50a $C"
msgstr "$C, l'enregistreur de vol indique zéro. Pas bien ca fils."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/12"
msgid "wc1:f144b37c7e01f4ba $L"
msgstr "Angel a $L."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/13"
msgid "wc1:dff2afb1331fbffa"
msgstr "Angel n'a rien eu."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/14"
msgid "wc1:395a6774bfea242a"
msgstr "Et nous l'avons perdue."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/15"
msgid "wc1:e47064b193d841e8 $N"
msgstr "$N...Je ne vais pas vous mentir pilotes. Alors je vais vous dire la vérité..."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/16"
msgid "wc1:212978f5db122705"
msgstr "Nous sommes en infériorité numerique et en armement ici. Si nous restons, la seule façon dont ça va se terminer---"

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/17"
msgid "wc1:70b41d31ae2a8781"
msgstr "---sera la destruction du Griffe du Tigre."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/18"
msgid "wc1:cade3e87c99621cc"
msgstr "Nous allons donc nous retirer immediatement. Il n'y a rien d'autre que nous puissions faire pour Firekka---"

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/19"
msgid "wc1:9b315b8242d7c563"
msgstr "---sauf infliger autant de dégâts que possible aux Kilrathis, en partant du système."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/20"
msgid "wc1:3c7c020e6f643cb8 $C"
msgstr "Mais $C, vous ainsi que les autres pilotes... avez accompli votre devoir au delà de tout."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/21"
msgid "wc1:728df4d02d48e12e"
msgstr "Vous êtes le meilleur pilote que je n'ai jamais vu."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/22"
msgid "wc1:a8605d6e0fd9e722"
msgstr "Si nous survivons et retournons au QG de la Conféd, je ferais en sorte que vous soyez récompensé pour celà."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/23"
msgid "wc1:403a2750fd146f7d"
msgstr "Je suis sûr que vous avez entendu dire que je serais transferé au Commandement de l'intelligence. Quand cela arrivera---"

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/24"
msgid "wc1:522da87212af8c2e $C"
msgstr "---Je veux que vous, $C, preniez le commandement de l'escadron de chasseurs du Griffe du Tigre."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/25"
msgid "wc1:503ab8cf831c96d3"
msgstr "Vous avez fait preuve d'ingéniosité, de compétence et d'un talent presque surhumain dans ces campagnes..."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/26"
msgid "wc1:9d3006ad9d84da60"
msgstr "...et je pense que vous serez un commandant d'escadron exceptionnel."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/27"
msgid "wc1:04b6bf5071161ae3"
msgstr "Mais nous n'en sommes pas encore là, pour le moment."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/28"
msgid "wc1:b4870bb6eeef6337"
msgstr "Vous êtes toujours en service actif. Reposez-vous, puis présentez-vous au Briefing."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/29"
msgid "wc1:3b646bd6e9c1e3ed $C"
msgstr "Et passez à mon bureau plus tard, $C."

msgctxt "sm2/BRIEFING.002/packet/29/scene/1/record/30"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Rompez."

msgctxt "sm2/BRIEFING.002/packet/29/scene/2/record/0"
msgid "wc1:1618db526b50c70d $R $N"
msgstr "Content de te voir, $R $N. Tu prends comme d'habitude."

msgctxt "sm2/BRIEFING.002/packet/29/scene/2/record/1"
msgid "wc1:13822b828529d1c6"
msgstr "J'ai entendu dire que Maniac était de nouveau en service actif."

msgctxt "sm2/BRIEFING.002/packet/29/scene/2/record/2"
msgid "wc1:d37fc8e28f3d185f $C"
msgstr "Laisse-moi te dire, $C, je n'arrive pas à croire qu'ils le laissent sortir de l'infirmerie."

msgctxt "sm2/BRIEFING.002/packet/29/scene/2/record/3"
msgid "wc1:4bb2e8b43a35b4d6"
msgstr "Je suppose que le colonel pense que nous avons besoin de tout le monde sur le pont en ce moment."

msgctxt "sm2/BRIEFING.002/packet/29/scene/2/record/4"
msgid "wc1:55b97b00356db755"
msgstr "Ils feraient mieux de ne pas l'affecter comme MON ailier."

msgctxt "sm2/BRIEFING.002/packet/29/scene/2/record/5"
msgid "wc1:07416d628303682b"
msgstr "Moi, j'espère juste quitter bientôt ce secteur---"

msgctxt "sm2/BRIEFING.002/packet/29/scene/2/record/6"
msgid "wc1:77d217783a2a0759"
msgstr "---Parce que les chances que nous partions d'ici vivants deviennent vraiment minces."

msgctxt "sm2/BRIEFING.002/packet/29/scene/3/record/0"
msgid "wc1:13945e54bfc16ffa"
msgstr "Assieds-toi, mon pote, prend un verre!"

msgctxt "sm2/BRIEFING.002/packet/29/scene/3/record/1"
msgid "wc1:7b25d1423db27476"
msgstr "Je ne sais pas si t'as entendu ou non, Maniac est de nouveau en service."

msgctxt "sm2/BRIEFING.002/packet/29/scene/3/record/2"
msgid "wc1:ebc8990eb1e1a988"
msgstr "Et ils m'ont mis avec ce clown comme ailier..."

msgctxt "sm2/BRIEFING.002/packet/29/scene/3/record/3"
msgid "wc1:0374da1001315991"
msgstr "Qu'as tu fait, Hunter?"

msgctxt "sm2/BRIEFING.002/packet/29/scene/3/record/4"
msgid "wc1:088f0e1507040f36"
msgstr "Rien, vraiment. Juste une petite blague..."

msgctxt "sm2/BRIEFING.002/packet/29/scene/3/record/5"
msgid "wc1:f48b25d72fea53b0"
msgstr "J'ai reprogrammé les capteurs de son vaisseau pour qu'il pense être attaqué par un millier de Kilrathis."

msgctxt "sm2/BRIEFING.002/packet/29/scene/3/record/6"
msgid "wc1:5431e1eb1a040c15"
msgstr "Heureusement, le colonel avait désactivé l'autodestruction sur le vaisseau de Maniac..."

msgctxt "sm2/BRIEFING.002/packet/29/scene/3/record/7"
msgid "wc1:3bd371bcf7d29fce"
msgstr "...Ou le gamin aurait fini au champ d'honneur."

msgctxt "sm2/BRIEFING.002/packet/29/scene/3/record/8"
msgid "wc1:af352869e22f4916"
msgstr "Je ne peux pas croire qu'ils le laissent voler \n de nouveau. Il est fou."

msgctxt "sm2/BRIEFING.002/packet/29/scene/3/record/9"
msgid "wc1:ee57e0bda2e41eb5"
msgstr "Je pense que nous sommes tous un peu fous, mon pote. Peut-être que tu devrais l'être aussi---"

msgctxt "sm2/BRIEFING.002/packet/29/scene/3/record/10"
msgid "wc1:4113a54548b713e1"
msgstr "---pour éviter de devenir complètement dingue dans une guerre comme celle-ci."

msgctxt "sm2/BRIEFING.002/packet/29/scene/4/record/0"
msgid "wc1:76d66369bc0c82c3 $N"
msgstr "Confedhicom m'a envoyé un message vidlink il y a deux heures, $N..."

msgctxt "sm2/BRIEFING.002/packet/29/scene/4/record/1"
msgid "wc1:faf36260939971ef"
msgstr "...le TCS Jerusalem a intercepté un vaisseau d'esclaves..."

msgctxt "sm2/BRIEFING.002/packet/29/scene/4/record/2"
msgid "wc1:82d633d1ed5b473a"
msgstr "...et une de mes filles était à bord."

msgctxt "sm2/BRIEFING.002/packet/29/scene/4/record/3"
msgid "wc1:5fa8ac46ac1bae2d"
msgstr "Julia n'est pas... elle-même en ce moment---"

msgctxt "sm2/BRIEFING.002/packet/29/scene/4/record/4"
msgid "wc1:1766acf143ee3f67"
msgstr "---elle ne peut pas parler ou prendre soin d'elle---"

msgctxt "sm2/BRIEFING.002/packet/29/scene/4/record/5"
msgid "wc1:7bee413a1556fd1b"
msgstr "---mais je la verrai dès que nous serons de retour à Vega."

msgctxt "sm2/BRIEFING.002/packet/29/scene/4/record/6"
msgid "wc1:f65ba36e49b9c1c2 $C"
msgstr "Cela fait six longues années que je ne l'ai vu, $C---"

msgctxt "sm2/BRIEFING.002/packet/29/scene/4/record/7"
msgid "wc1:f9e7913cefcd04c0"
msgstr "---mais je vais enfin revoir ma petite fille."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/0"
msgid "wc1:65035cb922d258d9 $T $D"
msgstr "Briefing de mission, $T, $D.\n système Charon, Secteur Antares."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/1"
msgid "wc1:c704a3d8e79f7ffd"
msgstr "Pilotes, on se dirige vers la frontière du Secteur Vega."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/2"
msgid "wc1:21c72571ac5b0173"
msgstr "Il n'y a rien d'autre que nous puissions faire ici... nous ne pouvons pas gagner contre ces flottes."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/3"
msgid "wc1:fa251e1f83f573b9"
msgstr "Et il est peut-être déja trop tard pour fuir. Les Kilrathis sont juste derrière nous---"

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/4"
msgid "wc1:5a33f6ecb9f3942c"
msgstr "---et vont nous poursuivent jusqu'à la frontière."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/5"
msgid "wc1:b57e653380d9c59b"
msgstr "Mais notre principal problème n'est pas la flotte kilrathi derrière nous---"

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/6"
msgid "wc1:01acc4dfb7f927ba"
msgstr "---mais une petite flotte d'attaque stationnée à la frontière de Vega."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/7"
msgid "wc1:d528c64a1db57064"
msgstr "Avec l'enorme flotte kilrathi à notre poursuite, nous ne pouvons pas prendre le temps de faire un détour."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/8"
msgid "wc1:649468d127a9c6d1"
msgstr "Votre mission est de dégager ces vaisseaux de  \n notre chemin."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/9"
msgid "wc1:ea68867990012de8"
msgstr "Vous allez devoir faire vite, pilotes. Parce que chaque minute que nous perdons ici---"

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/10"
msgid "wc1:45f52025070755f0"
msgstr "---signifie que les flottes de combat kilrathis se rapprochent de nous."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/11"
msgid "wc1:ff5a5d922d301e5f"
msgstr "Voici vos affectations..."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/12"
msgid "wc1:e12f8370ffc1f461"
msgstr "Vous écoutez jusqu'à ce que le colonel vous appelle."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/13"
msgid "wc1:37fabce2e76ba66b $C $C"
msgstr "Escadron Iota pour $C et Maniac, avec $C comme chef."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/14"
msgid "wc1:60c036d3741fd217 $C $N"
msgstr "Escadron Iota pour $C. Vous serez seul sur cette mission, $N."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/15"
msgid "wc1:7b4f71a98cb15fe8"
msgstr "Vous volerez vers chacun de vos points de navigation."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/16"
msgid "wc1:3ae46095375770ea"
msgstr "...détruisez tous les vaisseaux capitaux kilrathis que vous rencontrez."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/17"
msgid "wc1:8071fa06609fa662"
msgstr "Chaque minute compte en ce moment, pilotes. Ne faites pas d'erreur là-bas."

msgctxt "sm2/BRIEFING.002/packet/32/scene/0/record/18"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/1"
msgid "wc1:0584955ee5c10a24 $C"
msgstr "Rien a signaler, $C?"

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/2"
msgid "wc1:efbca331e97b9f44"
msgstr "J'ai détruit deux Ralaris à Nav 2."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/3"
msgid "wc1:0318dc234f182e43 $R"
msgstr "très impressionnant, $R!"

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/5"
msgid "wc1:6ff03e88fe138794"
msgstr "J'ai attaqué deux Ralari à Nav 2. L'un est en flamme, monsieur."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/6"
msgid "wc1:97d8571b5c7958d3"
msgstr "Bon travail, fiston."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/7"
msgid "wc1:6ff03e88fe138794"
msgstr "J'ai attaqué deux Ralari à Nav 2. L'un est en flamme, monsieur."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/8"
msgid "wc1:97d8571b5c7958d3"
msgstr "Bon travail, fiston."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/9"
msgid "wc1:832fffe534bc4840"
msgstr "Le transporteur Snakeir à Nav 3 est en miette, monsieur."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/10"
msgid "wc1:35ed1be3aec575ec"
msgstr "Je n'ai pu détruire aucun vaisseau capital ennemi, monsieur."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/11"
msgid "wc1:91e62efebf3f67a7"
msgstr "Je ne suis PAS impressionné, pilote."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/12"
msgid "wc1:298ee462b30c569e $C $K"
msgstr "$C, je vois que vous avez eu $K bandits..."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/13"
msgid "wc1:9874f921438ade76 $C"
msgstr "$C, Je vois que vous n'avez pas eu de chats..."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/14"
msgid "wc1:aba5ffe9982f428d $L"
msgstr "Maniac a $L."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/15"
msgid "wc1:b816f1824de7989e"
msgstr "Maniac n'a rien eu."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/16"
msgid "wc1:149acc5d8e024588 $N"
msgstr "Et Marshall n'est pas revenu de celle-ci. Au moins vous avez survecu, $N."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/17"
msgid "wc1:f282bf2dfdb8d5b1 $C"
msgstr "Vous êtes toujours en service actif, $C, alors restez vigilant."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/18"
msgid "wc1:823b57b71bd5c3eb"
msgstr "Et j'ai besoin de vous voir dans mon bureau plus tard."

msgctxt "sm2/BRIEFING.002/packet/32/scene/1/record/19"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm2/BRIEFING.002/packet/32/scene/2/record/0"
msgid "wc1:dea3a52164a5989d $C"
msgstr "T'as entendu, $C ? Nous partons d'ici."

msgctxt "sm2/BRIEFING.002/packet/32/scene/2/record/1"
msgid "wc1:7d71f400df570e31"
msgstr "Je vais te dire, je n'ai jamais été aussi content de fuir.."

msgctxt "sm2/BRIEFING.002/packet/32/scene/2/record/2"
msgid "wc1:d18b737cb0c6306d"
msgstr "Mais cette fois, je le suis. Au moins on aura une chance de s'en sortir vivant."

msgctxt "sm2/BRIEFING.002/packet/32/scene/3/record/0"
msgid "wc1:f26f7f48d2da246c $C"
msgstr "Bonjour, $C. Prends une chaise, assieds-toi."

msgctxt "sm2/BRIEFING.002/packet/32/scene/3/record/1"
msgid "wc1:baddf99932a9b019"
msgstr "Tu as probablement entendu dire que nous nous retirons de ce secteur."

msgctxt "sm2/BRIEFING.002/packet/32/scene/3/record/2"
msgid "wc1:824e9fe831babd16"
msgstr "Je suppose qu'il n'y a rien d'autre à faire ici."

msgctxt "sm2/BRIEFING.002/packet/32/scene/3/record/3"
msgid "wc1:69ed965ba5bcd825"
msgstr "J'espère juste que ces Firekkas pourront se battre seuls contre les Kilrathis."

msgctxt "sm2/BRIEFING.002/packet/32/scene/3/record/4"
msgid "wc1:ea9a20f20ac5bc99"
msgstr "Mais je ne pense pas qu'ils aient beaucoup de chance que ça arrive."

msgctxt "sm2/BRIEFING.002/packet/32/scene/4/record/0"
msgid "wc1:9947336c18a4490f $C"
msgstr "Hey, $C.  Tu sais que je suis de retour en service?"

msgctxt "sm2/BRIEFING.002/packet/32/scene/4/record/1"
msgid "wc1:c05151db241009fa"
msgstr "Et je vais être ton ailier !\n N'est-ce pas génial?"

msgctxt "sm2/BRIEFING.002/packet/32/scene/4/record/2"
msgid "wc1:3d3d085ce395c8d8"
msgstr "C'est vraiment... génial, Maniac."

msgctxt "sm2/BRIEFING.002/packet/32/scene/4/record/3"
msgid "wc1:8164ab3e9f3986f8 $N"
msgstr "J'étais sûr que tu serais content, $N."

msgctxt "sm2/BRIEFING.002/packet/32/scene/4/record/4"
msgid "wc1:32a963d8820b52be"
msgstr "Ecoute, j'ai eu cette idée d'une arme géniale que nous pouvons utiliser contre les boules de poils."

msgctxt "sm2/BRIEFING.002/packet/32/scene/4/record/5"
msgid "wc1:de0c743bba53ea5d"
msgstr "Nous pouvons ajouter à nos missiles une double charge d'explosifs ESK-5..."

msgctxt "sm2/BRIEFING.002/packet/32/scene/4/record/6"
msgid "wc1:48e51999a517355b"
msgstr "ESK-5?  Mais si on fait ça, ils vont exploser A L'INTERIEUR de notre vaisseau lors de la première maneuvre en force G!"

msgctxt "sm2/BRIEFING.002/packet/32/scene/4/record/7"
msgid "wc1:338dfde10a42b92f"
msgstr "Yeah, mais tu exploserais tout à une centaine de clics à la ronde!"

msgctxt "sm2/BRIEFING.002/packet/32/scene/4/record/8"
msgid "wc1:a0163d600796599c"
msgstr "Tout à une centaine de clics, y compris nous-même!"

msgctxt "sm2/BRIEFING.002/packet/33/scene/0/record/0"
msgid "wc1:5da1e62df6227114 $T $D"
msgstr "Briefing de mission, $T, $D. \n Zone Frontalière, Secteur Vega."

msgctxt "sm2/BRIEFING.002/packet/33/scene/0/record/1"
msgid "wc1:2ea8c05983bb8b82"
msgstr "Pilotes, il y a plusieurs vagues de chasseurs ennemis en approche sur le Griffe du Tigre."

msgctxt "sm2/BRIEFING.002/packet/33/scene/0/record/2"
msgid "wc1:79dc188fec80e1bc"
msgstr "Nous sommes presque de l'autre côté de la frontière... mais nous n'y arriverons que si vous arrêtez ces chasseurs."

#. wc1-re: shortened to fit the subtitle area.
msgctxt "sm2/BRIEFING.002/packet/33/scene/0/record/3"
msgid "wc1:2b0100df43b25a89"
msgstr "Nous lancerons les chasseurs par vagues... éliminez les chasseurs ennemis de la zone, puis atterrissez aussitôt."

msgctxt "sm2/BRIEFING.002/packet/33/scene/0/record/4"
msgid "wc1:ec61d493a1cb9a12"
msgstr "Nous avons détecté un Snakeir, trois Fralthis et quatre Ralaris sur une trajectoire d'interception."

msgctxt "sm2/BRIEFING.002/packet/33/scene/0/record/5"
msgid "wc1:253c48fc5f713c2c"
msgstr "Alors ne vous éloignez pas trop du Tigre... nous DEVONS nous échapper avant que cette force de frappe n'arrive."

msgctxt "sm2/BRIEFING.002/packet/33/scene/0/record/6"
msgid "wc1:c2453dbb48a5f674"
msgstr "Et si nous devons vous laisser derrière pendant notre hypersaut, nous le ferons."

msgctxt "sm2/BRIEFING.002/packet/33/scene/0/record/7"
msgid "wc1:6dafc5bb826080b6 $N"
msgstr "Affectations d'escadrons... $N et Marshall seront l'escadron Upsilon."

msgctxt "sm2/BRIEFING.002/packet/33/scene/0/record/8"
msgid "wc1:90a9dbe4bd88b9df $N"
msgstr "$N, vous êtes l'escadron Upsilon. Vous n'aurez pas d'ailier."

msgctxt "sm2/BRIEFING.002/packet/33/scene/0/record/9"
msgid "wc1:4baabb5175fd3f75"
msgstr "Le colonel affecte rapidement les autres escadrons."

msgctxt "sm2/BRIEFING.002/packet/33/scene/0/record/10"
msgid "wc1:e31d64fb497de3dc"
msgstr "Preparez-vous a décoller immediatement, pilotes. Rompez."

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/1"
msgid "wc1:42428a3fc26de1b5 $C"
msgstr "J'ai le nombre de votre enregistreur de vol, $C..."

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/2"
msgid "wc1:7e67b32f5bd1345d $K"
msgstr "je vois que vous avez $K Kilrathis."

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/3"
msgid "wc1:e10c6db1d9073aee $N"
msgstr "Je vois que vous n'avez abattu aucun appareil ennemi, $N."

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/4"
msgid "wc1:93e15b544c158271 $L"
msgstr "Maniac en a eu $L."

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/5"
msgid "wc1:2924f909ee2aa3b4"
msgstr "Maniac n'a rien eu."

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/6"
msgid "wc1:f42916c3610f5ef9 $N"
msgstr "Et il ne reviendra pas. Au moins vous avez survécu, $N."

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/7"
msgid "wc1:11ca60a6a6884c5b"
msgstr "Que devient Firekka, monsieur?"

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/8"
msgid "wc1:6318b62d4b9e6945 $C"
msgstr "Il n'y a aucun moyen de savoir ce qui se passe là-bas, $C."

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/9"
msgid "wc1:68a87da371e7783a"
msgstr "Avec de la chance, les Firekkas retiendront les forces kilrathis---"

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/10"
msgid "wc1:adc94fe6c6f123b9"
msgstr "---jusqu'à ce que les chats retournent sur le front de guerre---"

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/11"
msgid "wc1:03c963043ea90278"
msgstr "---mais nous ne saurons peut-être jamais ce qui se passe."

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/12"
msgid "wc1:40a1fb1ac7a75e37"
msgstr "J'espère que nous pourrons faire quelque chose de plus pour eux, monsieur."

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/13"
msgid "wc1:7a30d3eccb5b2b4a"
msgstr "Je sais, fiston. Nous avons fait au mieux..."

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/14"
msgid "wc1:b29168e71dc93a09"
msgstr "...mais maintenant tout dépend des Firekkas."

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/15"
msgid "wc1:2a66bea935198fbe $C"
msgstr "$C, J'aurai besoin de vous voir dans mon bureau plus tard."

msgctxt "sm2/BRIEFING.002/packet/33/scene/1/record/16"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm2/BRIEFING.002/packet/33/scene/2/record/0"
msgid "wc1:bbcf99ca796da6c8 $R"
msgstr "$R!  Tu ferais mieux d'aller au Briefing tout de suite!"

