msgctxt "sm2/BRIEFING.002/packet/36/scene/1/record/16"
msgid "wc1:149acc5d8e024588 $N"
msgstr "Et Marshall ne reviendra pas. Au moins vous avez survécu, $N."

msgctxt "sm2/BRIEFING.002/packet/36/scene/1/record/17"
msgid "wc1:f282bf2dfdb8d5b1 $C"
msgstr "Vous êtes toujours en service actif, $C, alors restez vigilant."

msgctxt "sm2/BRIEFING.002/packet/36/scene/1/record/18"
msgid "wc1:823b57b71bd5c3eb"
msgstr "Et j'ai besoin de vous voir dans mon bureau plus tard."

msgctxt "sm2/BRIEFING.002/packet/36/scene/1/record/19"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm2/BRIEFING.002/packet/36/scene/2/record/0"
msgid "wc1:dea3a52164a5989d $C"
msgstr "T'as entendu, $C ? Nous partons d'ici."

msgctxt "sm2/BRIEFING.002/packet/36/scene/2/record/1"
msgid "wc1:7d71f400df570e31"
msgstr "Je vais te dire, je n'ai jamais été content de fuir en avant."

msgctxt "sm2/BRIEFING.002/packet/36/scene/2/record/2"
msgid "wc1:d18b737cb0c6306d"
msgstr "Mais cette fois, je le suis. Au moins on aura une chance de s'en sortir vivant."

msgctxt "sm2/BRIEFING.002/packet/36/scene/3/record/0"
msgid "wc1:f26f7f48d2da246c $C"
msgstr "Bonjour, $C. Prends une chaise, assieds-toi."

msgctxt "sm2/BRIEFING.002/packet/36/scene/3/record/1"
msgid "wc1:baddf99932a9b019"
msgstr "T'as probablement entendu dire que nous nous retirons de ce secteur."

msgctxt "sm2/BRIEFING.002/packet/36/scene/3/record/2"
msgid "wc1:824e9fe831babd16"
msgstr "Je suppose qu'il n'y a rien d'autre à faire ici."

msgctxt "sm2/BRIEFING.002/packet/36/scene/3/record/3"
msgid "wc1:69ed965ba5bcd825"
msgstr "J'espère juste que ces Firekkas pourront se battre seuls contre les Kilrathis."

msgctxt "sm2/BRIEFING.002/packet/36/scene/3/record/4"
msgid "wc1:ea9a20f20ac5bc99"
msgstr "Mais je ne pense pas qu'il y ait beaucoup de chance que ça arrive."

msgctxt "sm2/BRIEFING.002/packet/36/scene/4/record/0"
msgid "wc1:9947336c18a4490f $C"
msgstr "Hey, $C.  Tu sais que je suis de retour en service?"

msgctxt "sm2/BRIEFING.002/packet/36/scene/4/record/1"
msgid "wc1:c05151db241009fa"
msgstr "Et je vais être ton ailier !\n N'est-ce pas genial?"

msgctxt "sm2/BRIEFING.002/packet/36/scene/4/record/2"
msgid "wc1:3d3d085ce395c8d8"
msgstr "C'est vraiment... formidable, Maniac."

msgctxt "sm2/BRIEFING.002/packet/36/scene/4/record/3"
msgid "wc1:8164ab3e9f3986f8 $N"
msgstr "J'étais sûr que tu serais content, $N."

msgctxt "sm2/BRIEFING.002/packet/36/scene/4/record/4"
msgid "wc1:32a963d8820b52be"
msgstr "Ecoute, j'ai eu cette idée d'une arme géniale que nous pouvons utiliser contre les boules de poils."

msgctxt "sm2/BRIEFING.002/packet/36/scene/4/record/5"
msgid "wc1:de0c743bba53ea5d"
msgstr "Nous pouvons ajouter à nos missiles une double charge d'explosifs ESK-5..."

msgctxt "sm2/BRIEFING.002/packet/36/scene/4/record/6"
msgid "wc1:48e51999a517355b"
msgstr "ESK-5?  Mais si on fait ca, ils vont explosé A L'INTERIEUR de notre vaisseau lors de la première maneuvre en force G!"

msgctxt "sm2/BRIEFING.002/packet/36/scene/4/record/7"
msgid "wc1:338dfde10a42b92f"
msgstr "Yeah, mais tu exploserais tout à une centaine de clics à la ronde!"

msgctxt "sm2/BRIEFING.002/packet/36/scene/4/record/8"
msgid "wc1:a0163d600796599c"
msgstr "Tout à une centaine de clics, y compris nous-même!"

msgctxt "sm2/BRIEFING.002/packet/37/scene/0/record/0"
msgid "wc1:5da1e62df6227114 $T $D"
msgstr "Briefing de mission, $T, $D. \n Zone Frontalière, Secteur Vega."

msgctxt "sm2/BRIEFING.002/packet/37/scene/0/record/1"
msgid "wc1:2ea8c05983bb8b82"
msgstr "Pilotes, il y a plusieurs vagues de chasseurs ennemis en approche sur le Griffe du Tigre."

msgctxt "sm2/BRIEFING.002/packet/37/scene/0/record/2"
msgid "wc1:79dc188fec80e1bc"
msgstr "Nous sommes presque de l'autre coté de la frontière... mais nous n'y arriverons que si vous arrêtez ces chasseurs."

msgctxt "sm2/BRIEFING.002/packet/37/scene/0/record/3"
msgid "wc1:2b0100df43b25a89"
msgstr "Nous lancerons des vagues de chasseurs les uns après les autres... dégagez la zone des ennemis, puis atterrissez immédiatement."

msgctxt "sm2/BRIEFING.002/packet/37/scene/0/record/4"
msgid "wc1:ec61d493a1cb9a12"
msgstr "Nous avons détecté un Snakeir, trois Fralthis et quatre Ralaris sur une trajectoire d'interception."

msgctxt "sm2/BRIEFING.002/packet/37/scene/0/record/5"
msgid "wc1:253c48fc5f713c2c"
msgstr "Alors ne vous éloignez pas trop du Tigre... nous DEVONS nous échapper avant que cette force de frappe n'arrive."

msgctxt "sm2/BRIEFING.002/packet/37/scene/0/record/6"
msgid "wc1:c2453dbb48a5f674"
msgstr "Et si nous devons vous laisser derrière quand nous passeront en hypersaut, nous le ferons."

msgctxt "sm2/BRIEFING.002/packet/37/scene/0/record/7"
msgid "wc1:6dafc5bb826080b6 $N"
msgstr "Affectations d'escadrons... $N et Marshall seront l'escadron Upsilon."

msgctxt "sm2/BRIEFING.002/packet/37/scene/0/record/8"
msgid "wc1:90a9dbe4bd88b9df $N"
msgstr "$N, vous êtes l'escadron Upsilon. Je ne peux pas vous donner un ailier."

msgctxt "sm2/BRIEFING.002/packet/37/scene/0/record/9"
msgid "wc1:4baabb5175fd3f75"
msgstr "Le colonel affecte rapidement les autres escadrons."

msgctxt "sm2/BRIEFING.002/packet/37/scene/0/record/10"
msgid "wc1:e31d64fb497de3dc"
msgstr "Preparez-vous à décoller immediatement, pilotes. Rompez."

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/1"
msgid "wc1:42428a3fc26de1b5 $C"
msgstr "J'ai le nombre de votre enregistreur de vol, $C..."

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/2"
msgid "wc1:7e67b32f5bd1345d $K"
msgstr "Je vois que vous avez abattu $K."

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/3"
msgid "wc1:e10c6db1d9073aee $N"
msgstr "Je vois que vous n'avez abattu aucun ennemi, $N."

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/4"
msgid "wc1:93e15b544c158271 $L"
msgstr "Maniac a $L."

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/5"
msgid "wc1:2924f909ee2aa3b4"
msgstr "Maniac n'a rien eu."

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/6"
msgid "wc1:f42916c3610f5ef9 $N"
msgstr "Et il ne reviendra pas. Au moins vous avez survécu, $N."

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/7"
msgid "wc1:11ca60a6a6884c5b"
msgstr "Que devient Firekka, monsieur?"

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/8"
msgid "wc1:6318b62d4b9e6945 $C"
msgstr "Il n'y a aucun moyen de savoir ce qui se passe là-bas, $C."

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/9"
msgid "wc1:68a87da371e7783a"
msgstr "Avec de la chance, les Firekkas pourrons retenir les forces kilrathis---"

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/10"
msgid "wc1:adc94fe6c6f123b9"
msgstr "---jusqu'à ce que les chats retournent sur le front de guerre---"

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/11"
msgid "wc1:03c963043ea90278"
msgstr "---mais nous ne saurons peut-être jamais ce qui se passe."

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/12"
msgid "wc1:40a1fb1ac7a75e37"
msgstr "J'espère que nous pourrons faire quelque chose de plus pour eux, monsieur."

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/13"
msgid "wc1:7a30d3eccb5b2b4a"
msgstr "Je sais, fiston. Nous avons fait au mieux..."

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/14"
msgid "wc1:b29168e71dc93a09"
msgstr "...mais maintenant tout dépend des Firekkas."

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/15"
msgid "wc1:2a66bea935198fbe $C"
msgstr "$C, J'aurai besoin de vous voir dans mon bureau plus tard."

msgctxt "sm2/BRIEFING.002/packet/37/scene/1/record/16"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm2/BRIEFING.002/packet/37/scene/2/record/0"
msgid "wc1:bbcf99ca796da6c8 $R"
msgstr "$R!  Tu ferais mieux d'aller au Briefing tout de suite!"

