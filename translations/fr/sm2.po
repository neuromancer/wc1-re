#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/12/record/5"
msgid "wc1:2cd6f7e6f1651eb6"
msgstr "J'ai détruit un chasseur ennemi!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/12/record/6"
msgid "wc1:cf5360964ed54b2f $R $N"
msgstr "Heureux de vous avoir avec nous $R $N."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/12/record/7"
msgid "wc1:27621f6ff8b6856c $C"
msgstr "J'ai fini le combat $C!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/12/record/8"
msgid "wc1:504f95e45ec2f088 $C"
msgstr "$C vous avez l'autorisation."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/12/record/9"
msgid "wc1:22e9ff73ab041fae $C"
msgstr "Négatif $C. Atterrisage interdit."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/12/record/10"
msgid "wc1:63399c33ee4c5ea9"
