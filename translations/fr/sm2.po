msgid "wc1:042c29839d51917d $C"
msgstr "Signal ennemi $C!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/3"
msgid "wc1:af93af2a2a2cf76e"
msgstr "Irons-nous après eux mon ami?"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/4"
msgid "wc1:cdaeaea268ae05fc $C"
msgstr "Aide-moi $C!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/5"
msgid "wc1:4ad573740719b234"
msgstr "Chasseur ennemi abattu!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/6"
msgid "wc1:6fa666865b5c19c8"
msgstr "Excellent mon ami!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/7"
msgid "wc1:adff40f21d9075cf $C $R"
msgstr "$C! Je perds le controle---$R AIDE MOI!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/8"
msgid "wc1:fb466533c0ffdfd2 $N"
msgstr "$N on doit se replier!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/9"
msgid "wc1:505e562cc3b971ba $C"
msgstr "Je dois revenir au Tigre maintenant $C."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/10"
msgid "wc1:cbb0480a92a5eccb $C"
msgstr "$C! Attention mon ami!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/0"
msgid "wc1:6cb804d0e138c8e2 $N"
msgstr "Affirmatif $N. Mais ça ne changera pas grand chose..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/1"
msgid "wc1:e7caffad241bf6a2 $N"
msgstr "Negatif $N."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/2"
msgid "wc1:f3fcc609e1fd5eeb $R"
msgstr "Ennemi en vue $R. Nous sommes dans la merde..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/3"
msgid "wc1:e8b68c1d3316f8b0"
msgstr "J'en réchapperai sûrement pas..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/4"
msgid "wc1:f192d8989bd8e144 $C"
msgstr "$C je vais sûrement mourir dans quelques secondes..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/5"
msgid "wc1:25cd7158ba68d5c2"
msgstr "Appareil ennemi détruit! Mais nous perdrons sûrement ce combat..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/6"
msgid "wc1:469d0db4c63f1316 $C"
msgstr "Bon tir $C! Peut-être qu'on survivra finalement..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/7"
msgid "wc1:8f7c0b7a386f8e63"
msgstr "Je savais que cela arriverais..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/8"
msgid "wc1:278453f4633237ea"
msgstr "Tu sais qu'on va mourir si on reste ici?"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/9"
msgid "wc1:06fae539c9cf260e $C"
msgstr "Au revoir $C. J'espère que t'en réchapperas."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/10"
msgid "wc1:78cb4b67da29bb00"
msgstr "Je déteste quand tu fais ca."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/0"
msgid "wc1:d30af8eef0f22370"
msgstr "Quoi?"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/1"
msgid "wc1:d30af8eef0f22370"
msgstr "Quoi?"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/2"
msgid "wc1:950589424c7591bc"
msgstr "A fond!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/3"
msgid "wc1:d93667e4c9cff0df"
msgstr "Va apres eux, espèce de lâche!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/4"
msgid "wc1:df18153e006093d6 $C"
msgstr "Je suis dans la merde $C! Aide-moi merde!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/5"
msgid "wc1:862592ddc935f272"
msgstr "Regarde ce feu d'artifice!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/6"
msgid "wc1:5e55200c88932832"
msgstr "T'as volé ma cible batârd!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/7"
msgid "wc1:203576b7d92cb4e6"
msgstr "Non! Je n'veux pas mourir!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/8"
msgid "wc1:21e9ee4f840ed1aa"
msgstr "Filons d'ici mec!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/9"
msgid "wc1:7bed4a7965dd0ce5"
msgstr "Game over, mec!  J'me tire!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/10"
msgid "wc1:21834a75d101e1cb"
msgstr "Je te tuerais batârd!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/0"
msgid "wc1:b81f8f96e6195585 $R"
msgstr "Affirmatif $R."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/1"
msgid "wc1:e7f3ffad243efbb6 $R"
msgstr "Negatif $R."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/2"
msgid "wc1:68ec3963871bc85e $R"
msgstr "Ennemi en vue $R."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/3"
msgid "wc1:210c5af338b9d004"
msgstr "Permission d'engager commandant?"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/4"
msgid "wc1:2b057016a9c17288 $C"
msgstr "$C aide moi!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/5"
msgid "wc1:63997f7307048607 $C"
msgstr "Un de moins $C!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/6"
msgid "wc1:2d356e6b505ca4e6 $R"
msgstr "Bon tir $R!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/7"
msgid "wc1:d8171a5ef8381933 $R"
msgstr "$R!  Je ne peux pas les tenir-- peux--"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/8"
msgid "wc1:358c7e4d730deca2"
msgstr "Je conseille une retraite commandant."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/9"
msgid "wc1:6fe1b7c7cd8ca96b"
msgstr "J'interromps la poursuite et je rentre."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/10"
msgid "wc1:b7a5ad9445d04904 $R $N"
msgstr "Attention $R $N!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/8/record/0"
msgid "wc1:262ede328f6a6402"
msgstr "La garde imperiale te tuera!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/8/record/1"
msgid "wc1:5e8ac9b33c5218a9"
msgstr "Je ferai mes griffes sur ton cadavre!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/8/record/2"
msgid "wc1:387d878f7ef8f47d"
msgstr "Nous vous exterminerons tous humains!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/8/record/3"
msgid "wc1:07e1fc294685610f"
msgstr "Tu mouras de la main d'un garde imperial!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/8/record/4"
msgid "wc1:387d878f7ef8f47d"
msgstr "Nous vous tuerons tous humains!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/8/record/5"
msgid "wc1:ba5b54973ea96cf6"
msgstr "Tu va mourir maintenant singe!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/8/record/6"
msgid "wc1:95c95199fac3271a"
msgstr "Seul un singe peut avoir une telle chance!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/8/record/8"
msgid "wc1:660e4a1073f6e4a2"
msgstr "Kilrah reigne en maitre absolu!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/8/record/9"
msgid "wc1:f28c765380722f7b"
msgstr "On se retrouvera."

