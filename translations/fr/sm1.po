msgctxt "sm1/BRIEFING.001/packet/0/scene/0/record/0"
msgid "wc1:72ef82d5c83b4082 $C"
msgstr "Adieu, $C. Vous nous manquerez."

msgctxt "sm1/BRIEFING.001/packet/0/scene/1/record/1"
msgid "wc1:f142c49819505c5f $R $N"
msgstr "Nous sommes réunis ici pour rendre hommage à l'un des nôtres, $R $N."

msgctxt "sm1/BRIEFING.001/packet/0/scene/1/record/2"
msgid "wc1:155b178efef3e20c"
msgstr "C'est toujours triste de perdre un pilote..."

msgctxt "sm1/BRIEFING.001/packet/0/scene/1/record/3"
msgid "wc1:6db617fa97e249c0 $C"
msgstr "... mais c'est d'autant plus difficile quand il est aussi jeune que $C."

msgctxt "sm1/BRIEFING.001/packet/0/scene/1/record/4"
msgid "wc1:6b808ca940f02412"
msgstr "Il est mort sans pouvoir prouver sa valeur."

msgctxt "sm1/BRIEFING.001/packet/0/scene/2/record/1"
msgid "wc1:f142c49819505c5f $R $N"
msgstr "Nous sommes réunis ici pour rendre hommage à l'un des nôtres, $R $N."

msgctxt "sm1/BRIEFING.001/packet/0/scene/2/record/2"
msgid "wc1:5a3e1bd43236e343 $C"
msgstr "En quelques missions seulement, $C a commencé à renverser le cours de cette opération."

msgctxt "sm1/BRIEFING.001/packet/0/scene/2/record/3"
msgid "wc1:4309a18f20f2cf64"
msgstr "Dommage que sa contribution soit écourtée."

msgctxt "sm1/BRIEFING.001/packet/0/scene/2/record/4"
msgid "wc1:8b5faebb4dd01574 $C"
msgstr "Qui peut dire ce que $C aurait pu accomplir pour la Confédération?"

msgctxt "sm1/BRIEFING.001/packet/0/scene/3/record/1"
msgid "wc1:f142c49819505c5f $R $N"
msgstr "Nous sommes réunis ici pour rendre hommage à l'un des nôtres, $R $N."

msgctxt "sm1/BRIEFING.001/packet/0/scene/3/record/2"
msgid "wc1:b9c68a9d9783f37d $C"
msgstr "Sans l'ombre d'un doute, $C était l'un des meilleurs pilotes de la Confédération."

msgctxt "sm1/BRIEFING.001/packet/0/scene/3/record/3"
msgid "wc1:c1d18609c7fb06b2"
msgstr "Petit à petit, il a guidé les forces de la Confédération vers la victoire."

msgctxt "sm1/BRIEFING.001/packet/0/scene/3/record/4"
msgid "wc1:a503fb50b0f8390f"
msgstr "Maintenant, alors que nous touchons à la victoire, nous disons adieu à un vrai heros."

msgctxt "sm1/BRIEFING.001/packet/0/scene/4/record/1"
msgid "wc1:f142c49819505c5f $R $N"
msgstr "Nous sommes réunis ici pour rendre hommage à l'un des nôtres, $R $N."

msgctxt "sm1/BRIEFING.001/packet/0/scene/4/record/2"
msgid "wc1:248bc5d697d6a212"
msgstr "Comme nous le savons tous, cette opération a été longue et difficile."

msgctxt "sm1/BRIEFING.001/packet/0/scene/4/record/3"
msgid "wc1:5c0dbeb6b76e8c79 $C"
msgstr "Personne ne s'est battu plus difficilement pour atteindre nos objectifs que $C."

msgctxt "sm1/BRIEFING.001/packet/0/scene/4/record/4"
msgid "wc1:7ae4cac3cef6dfaf"
msgstr "Maintenant, il a fait le sacrifice ultime pour la Confédération."

msgctxt "sm1/BRIEFING.001/packet/0/scene/5/record/0"
msgid "wc1:3d6f6f9c5ae5673c"
msgstr "Au revoir, Spirit ... Ta douce voix et tes conseils vont me manquer."

msgctxt "sm1/BRIEFING.001/packet/0/scene/5/record/1"
msgid "wc1:e1dfaf9ce90cfec3"
msgstr "Je lèverai un verre à ta mémoire, Hunter. Au revoir."

msgctxt "sm1/BRIEFING.001/packet/0/scene/5/record/2"
msgid "wc1:fc03bcf5bfb65107"
msgstr "Je vais essayer de suivre ton exemple de leader, Bossman. Au revoir."

msgctxt "sm1/BRIEFING.001/packet/0/scene/5/record/3"
msgid "wc1:db9559af8a769177"
msgstr "Au revoir, Iceman. J'aurai le batard qui t'a eu."

msgctxt "sm1/BRIEFING.001/packet/0/scene/5/record/4"
msgid "wc1:ef8b9b1a5bb72612"
msgstr "Au revoir, Angel. Je combattrai les Kilrathis comme tu l'as fait, de tout mon coeur."

msgctxt "sm1/BRIEFING.001/packet/0/scene/5/record/5"
msgid "wc1:dc1d706fa2b51c1e"
msgstr "Au revoir Paladin. Je n'oublierai jamais l'aide que tu m'as apportée."

msgctxt "sm1/BRIEFING.001/packet/0/scene/5/record/6"
msgid "wc1:e2e4c2688b8e276d"
msgstr "Au revoir, Maniac. Je suppose que tu as ce que tu mérites."

msgctxt "sm1/BRIEFING.001/packet/0/scene/5/record/7"
msgid "wc1:d17d1553dcaf9eee"
msgstr "Adieu, Knight. je me souviendrai toujours de toi."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/0"
msgid "wc1:3473027d14887606"
msgstr "Nous sommes réunis ici pour rendre nos derniers hommages à un bon ami..."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/1"
msgid "wc1:b81037e0cc8a316c"
msgstr "...et l'un des principaux défenseurs de la Confédération terrienne."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/2"
msgid "wc1:2671c9856754f4d6"
msgstr "Le lieutenant Mariko Tanaka n'a jamais eu de discours bruyant ou colèrique..."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/3"
msgid "wc1:0ac55e6c0e203a1e"
msgstr "...mais ses actions parlaient plus que ses paroles."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/4"
msgid "wc1:4ca7702f7b641132"
msgstr "Ses compétences et son dévouement à la cause confédérée nous manquera a tous."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/5"
msgid "wc1:bc56d4d002a3a375"
msgstr "Le capitaine Ian St. John n'a jamais laissé la bataille l'épuiser."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/6"
msgid "wc1:4af56a25b70cf6a7"
msgstr "Son attitude fougueuse et sa passion du devoir étaient sans égales."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/7"
msgid "wc1:7228ba22532c96f6"
msgstr "Maintenant qu'il est parti, vous devriez tous vous efforcer de trouver en vous..."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/8"
msgid "wc1:35f28bbaac7a39fb"
msgstr "...la force de caractère que possedait le capitaine St. John."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/9"
msgid "wc1:16af0c26d893de1b"
msgstr "Malheureusement, nous devons rendre un dernier hommage à un vétéran chevronné..."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/10"
msgid "wc1:b9123ffe93633d23"
msgstr "...Major Kien Chen, que nous connaissions tous sous le nom de Bossman."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/11"
msgid "wc1:162f5b5919abf446"
msgstr "En ces temps d'incertitude, le major Chen était toujours prêt à aider..."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/12"
msgid "wc1:ef687cf77e59eb12"
msgstr "...tous ceux qui en avaient besoin. Il va nous manquer."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/13"
msgid "wc1:761db983d7d82092"
msgstr "Iceman, major Michael Casey, était l'un des meilleurs à avoir jamais piloté un chasseur stellaire."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/14"
msgid "wc1:f0123eaf103bf7d7"
msgstr "Son approche taciturne, ses fonctions étaient alimentées par une volonté de gagner..."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/15"
msgid "wc1:62fd030736dcec34"
msgstr "...quelles qu'en soient les chances. Il est mort comme il a vécu..."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/16"
msgid "wc1:ee883b8b802961b9"
msgstr "...lutter contre l'ennemi pour préserver la vie de ses semblables."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/17"
msgid "wc1:620a5cdbae3b6c11"
msgstr "Je suis attristé de constater la mort d'un de nos soldats les plus dévoués..."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/18"
msgid "wc1:3fe07573438fd9e6"
msgstr "...nôtre amie, le capitaine Jeanette Devereaux."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/19"
msgid "wc1:1501c3a0be2d96a2"
msgstr "A tout donné pour combattre les Kilrathis."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/20"
msgid "wc1:89717e0e248c9439"
msgstr "Elle a maintenant fait le sacrifice ultime pour la Confédération."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/21"
msgid "wc1:b5b9380f6967b4ed"
msgstr "Nous disons maintenant au revoir à notre camarade, le Major James Taggart."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/22"
msgid "wc1:3eee34d5871874aa"
msgstr "Ses connaissances ont sauvé de nombreuses vies et ont souvent déjoué l'ennemi."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/23"
msgid "wc1:552c1ddef2412fc4"
msgstr "Son talent et son amitié nous manqueront à tous..."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/24"
msgid "wc1:b407e4d53ffe7ceb"
msgstr "...alors que nous continuons le combat qu'il a commencé il y a des années."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/25"
msgid "wc1:82de49dbd8352580"
msgstr "Le sous-lieutenant Todd Marshall était l'un de nos plus jeunes pilotes..."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/26"
msgid "wc1:ba6c53689c27a8e7"
msgstr "...et peut-être le plus incompris dans ses méthodes."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/27"
msgid "wc1:f6586508fa330417"
msgstr "Bien qu'il ait souvent parlé de son désir de mourir au combat..."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/28"
msgid "wc1:c6fc056f8be793ba"
msgstr "...sa mort est vraiment une perte. Adieu, Lieutenant Marshall."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/29"
msgid "wc1:be08f592cfdf5033"
msgstr "Nous devons maintenant dire au revoir au capitaine Joseph Khumalo."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/30"
msgid "wc1:5daf7a7ca2f71859"
msgstr "Knight cherchait toujours à apporter son soutien et son assistance..."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/31"
msgid "wc1:d9d2bc1c953ef15b"
msgstr "...s'il était dans le cockpit ou à bord du vaisseau."

msgctxt "sm1/BRIEFING.001/packet/0/scene/6/record/32"
msgid "wc1:aa1888b5d954fb23"
msgstr "Son attitude solide comme le roc était un pilier et une force pour nous tous."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/0"
msgid "wc1:437206dca1292c99 $T $D"
msgstr "Bureau du colonel Halcyon.\n$T, $D."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/2"
msgid "wc1:1476cbe2ac7b8543 $N"
msgstr "$N. Entrez, j'ai besoin de vous parler."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/3"
msgid "wc1:5c218468f6cb5eef"
msgstr "Oui Monsieur?"

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/4"
msgid "wc1:8ab126832526236b"
msgstr "J'ai regardé les évaluations de vos performances."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/5"
msgid "wc1:9eb770bb7361a5f8"
msgstr "Après examen de votre dossier, j'ai de bonnes nouvelles..."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/6"
msgid "wc1:3852b6fa02a797c9"
msgstr "J'ai décidé de vous promouvoir, avec effet immédiat."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/7"
msgid "wc1:c73ff960b5965f89 $R $N"
msgstr "Félicitations, $R $N. Continuez votre bon travail."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/8"
msgid "wc1:6f967cba9e7e1ad1"
msgstr "Merci, monsieur. Je ferai de mon mieux."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/9"
msgid "wc1:3359fb38c67cae06"
msgstr "Bien. Maintenant autre chose dont je dois vous parler..."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/10"
msgid "wc1:0e5a017c129cd29f"
msgstr "Ce vaisseau que vous venez de perdre coûte plus de cent millions de crédits."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/11"
msgid "wc1:fcb157d1598cb669"
msgstr "Nous devrons attendre notre retour à Vega pour que le Griffe du Tigre reçoive du matériel."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/12"
msgid "wc1:dfa02530bbb454c8"
msgstr "Je sais, monsieur. Mais il n'y avait rien d'autre à faire...."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/13"
msgid "wc1:7157254c2e22f5c9"
msgstr "Si vous n'avez pas d'autre choix que d'éjecter, alors faites-le..."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/14"
msgid "wc1:5f77d4969177e4c6"
msgstr "...Mais n'abandonnez pas un chasseur que vous pouvez ramener à bon port."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/15"
msgid "wc1:590237a8a7405b3b"
msgstr "Vous allez recevoir le Golden Sun pour avoir survécu à l'éjection..."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/16"
msgid "wc1:c240eb61ff313196"
msgstr "Vous ne pouvez en obtenir qu'un par carrière."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/17"
msgid "wc1:8382dfd19f3a8193"
msgstr "Après celà, l'éjection n'est qu'un gaspillage de chasseur pour la Confédération."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/18"
msgid "wc1:6dc7de882a71b1b5"
msgstr "Je ne l'oublierai pas, monsieur."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/19"
msgid "wc1:4a3619ee96d83ad5 $R"
msgstr "Je compte dessus, $R."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/20"
msgid "wc1:0a74ac80c7bb418c $C"
msgstr "Juste un instant, $C. J'ai encore une chose à vous dire."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/21"
msgid "wc1:cf83b4d83c030971"
msgstr "Nous devons changer certaines affectations de pilotes."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/22"
msgid "wc1:a7abca757a39f484"
msgstr "A compter de maintenant, vous serez réaffecté."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/23"
msgid "wc1:b1c953ca974cb4cb"
msgstr "Vous volerez à nouveau sur un hornet avec les Killer Bees."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/24"
msgid "wc1:f400a9c399ab76f8"
msgstr "Vous serez dans un chasseur moyen de classe Scimitar, avec l'escadron Blue Devil."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/25"
msgid "wc1:3692a2706dd86866"
msgstr "J'ai besoin de vous dans l'escadron Star Slayer, un chasseur lourd de classe Raptor."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/26"
msgid "wc1:9de9b7aaae1ba27f"
msgstr "J'ai besoin de vous sur l'un des nouveaux Rapiers, dans l'escadron Black Lion."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/27"
msgid "wc1:008eb568c4e6167c"
msgstr "Je vois, monsieur. je ferai de mon mieux."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/28"
msgid "wc1:c3b1b0f41e653549"
msgstr "Je suis curieux, monsieur... pourquoi?"

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/29"
msgid "wc1:7db15279e18f2099 $C"
msgstr "Nous avons perdu des pilotes, $C et beaucoup de chasseurs."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/30"
msgid "wc1:e112c9a2d0d45d6d"
msgstr "Jusqu'à ce que nous ayons plus de chasseurs réparés et prêts au combat..."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/31"
msgid "wc1:e91285b6fd143e55"
msgstr "...Je dois réaffecter le personnel pour maintenir le nombre maximum d'escadrons actifs."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/32"
msgid "wc1:715202d5c4a1c9c3"
msgstr "Je comprends, monsieur. Je ferai de mon mieux, quel que soit le chasseur auquel je suis affecté."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/33"
msgid "wc1:3273db97eecbeed1"
msgstr "Bien, pilote. Je suis heureux de l'entendre."

msgctxt "sm1/BRIEFING.001/packet/1/scene/0/record/34"
msgid "wc1:284f77f0aac40b8c $R"
msgstr "Ce sera tout, $R. Rompez."

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/0"
msgid "wc1:ffb83f54560ea7b3 $D"
msgstr "Pont du hangar.\n18:00 heures, $D."

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/1"
msgid "wc1:0853cfb625c78750"
msgstr "Pour son excellence dans le combat avec l'ennemi kilrathi..."

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/2"
msgid "wc1:27a87fd8f631df6d"
msgstr "En considération de son valeureux service envers l'humanité..."

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/3"
msgid "wc1:f37fcb0e1975a7d7"
msgstr "Guidant les forces de la Confédération contre l'empire kilrahi..."

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/4"
msgid "wc1:4f5e55e4d0c63515"
msgstr "Jouant un rôle décisif dans l'opération Thor Hammer..."

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/5"
msgid "wc1:32f6cb99c08cf12a"
msgstr "Et commandant l'escadron qui a remporté la victoire décisive..."

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/6"
msgid "wc1:ec0f5d2552c7c61a"
msgstr "Pour avoir courageusement sacrifié son vaisseau et mis sa vie en danger..."

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/7"
msgid "wc1:96cc940c31a3870b"
msgstr "Au combat contre l'ennemi kilrathi..."

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/8"
msgid "wc1:299ae904159779d5 $E"
msgstr "...le $E,"

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/9"
msgid "wc1:4de621c46bea12f2 $A $R $N"
msgstr "La Confédération terrienne remet la $A au $R $N."

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/10"
msgid "wc1:083ebdbad07c4fcb"
msgstr "Votre courage est un exemple pour les meilleurs défenseurs de la Confédération."

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/11"
msgid "wc1:8a89983527bdcfc2"
msgstr "Vous êtes l'un des plus grands héros de l'humanité."

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/12"
msgid "wc1:6f9b780188e9a285"
msgstr "Votre dévouement honore toute la Confédération."

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/13"
msgid "wc1:4f2e111b74fe1821 $C"
msgstr "Bon travail, $C.\nToutes nos félicitations."

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/14"
msgid "wc1:4b3985eb86bc5304"
msgstr "Merci Monsieur."

msgctxt "sm1/BRIEFING.001/packet/2/scene/0/record/15"
msgid "wc1:c9a08a788fed9788"
msgstr "Rempli de fierté, vous êtes applaudis par vos coequipiers."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/0"
msgid "wc1:f79b618b9f8379a7 $T $D"
msgstr "Briefing de mission, $T, $D."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/1"
msgid "wc1:426eafb15184e206"
msgstr "Silence, tout le monde. Nous avons beaucoup de travail."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/2"
msgid "wc1:4fc401c9aa85276f"
msgstr "Comme vous l'avez peut-être remarqué, le Griffe du Tigre a fait plusieurs sauts aujourd'hui..."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/3"
msgid "wc1:c5f47a2b301a9c94"
msgstr "...car nous devons temporairement quitter le secteur Vega."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/4"
msgid "wc1:cdd6a4f382800bd4"
msgstr "Il y a plusieurs heures, nous avons reçu une communication d'urgence..."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/5"
msgid "wc1:5c98166d4ce4328d"
msgstr "... de la colonie Goddard dans le secteur Deneb."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/6"
msgid "wc1:5852b8496cb35b1f"
msgstr "Une flotte kilrathi a attaqué la colonie, en utilisant une sorte de nouvelle arme."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/7"
msgid "wc1:a5cc74a52a40a11d"
msgstr "Malheureusement, nous avons perdu les communications avec la colonie."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/8"
msgid "wc1:dd1c5e7a8639fa08"
msgstr "Maintenant, nous nous préparons à sauter vers Goddard."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/9"
msgid "wc1:1d80687248aa99db"
msgstr "Monsieur? Cela signifie-t-il que nous ne savons pas dans quel genre de merde nous sautons?"

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/10"
msgid "wc1:2deb9d368c5c3bec"
msgstr "Exact. Nous ne savons rien de la puissance de la flotte kilrathi..."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/11"
msgid "wc1:e043be52a09c456f"
msgstr "...et nous ne savons pas ce qui est arrivé à la colonie Goddard."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/12"
msgid "wc1:0a021d418cced9ef"
msgstr "Pour l'instant, PERSONNE ne doit en parler à l'équipage. Cependant, nous ne serons pas seuls..."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/13"
msgid "wc1:e382d3f19010a2dd"
msgstr "...car nous devons prendre rendez-vous avec le Hickok."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/14"
msgid "wc1:e9832e5c5ee84a74"
msgstr "C'est un transport de classe Dilligent chargé de matériel de secours d'urgence pour la colonie."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/15"
msgid "wc1:92f843cc8f955f4f"
msgstr "Nous avons également rendez-vous avec le Marciano, une corvette de classe Venture."

#. wc1-re: shortened to fit the subtitle area.
msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/16"
msgid "wc1:7c07f409e15175e3"
msgstr "Alpha patrouillera en Hornet... nous avons besoin de vous dans nos chasseurs les plus rapides."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/17"
msgid "wc1:6e4d4a4db8dd7187"
msgstr "Vous serez lancés immediatement lorsque nous arriverons dans le système Goddard."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/18"
msgid "wc1:23252b016d870d5f"
msgstr "S'il y a des chats dans le voisinage, éliminez-les."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/19"
msgid "wc1:9ab029efad2c6bcf"
msgstr "Ensuite, je veux que vous alliez à Nav 1 et que vous recherchiez toute activité kilrathi."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/20"
msgid "wc1:750ad4806c542e20"
msgstr "Après, dirigez-vous vers le point de Nav 2, où le Hickok se prépare à sauter vers Goddard... "

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/21"
msgid "wc1:f04bfeb62f9ee376"
msgstr "...apportez-lui un soutien s'il est attaqué par les Kilrathis."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/22"
msgid "wc1:e9e58072e6126dc7"
msgstr "Une fois qu'il a sauté, rendez-vous au point de Nav 3, où vous rencontrerez le Marciano."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/23"
msgid "wc1:f4fa65921ff60e92"
msgstr "Escortez la corvette jusqu'au Tigre, éliminez toute menace."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/24"
msgid "wc1:d5f055100cfa89af $C"
msgstr "$C, vous êtes le chef d'escadron, avec Hunter comme ailier."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/25"
msgid "wc1:225951e8a1cbe6d2 $C"
msgstr "$C, vous volerez en solo cette fois."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/26"
msgid "wc1:4c70e1f3bf2eca73"
msgstr "Le colonel passe aux autres affectations."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/27"
msgid "wc1:d95fa7bda6fdfca0"
msgstr "Votre attention revient sur lui alors qu'il conclut."

msgctxt "sm1/BRIEFING.001/packet/4/scene/0/record/28"
msgid "wc1:5be492e542130948"
msgstr "C'est tout. Mesdames et messieurs, préparez-vous pour le lancement."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/1"
msgid "wc1:1521401e270425c8"
msgstr "Vous devrez repartir dans quelques minutes, alors faisons vite."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/2"
msgid "wc1:e8b2b0a04c2531a9 $C"
msgstr "Votre rapport, $C."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/3"
msgid "wc1:2c849229b1c728df"
msgstr "Un tanker de classe Lumbari s'apprétait a sauter à Nav 1. Il est en poussière, monsieur."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/4"
msgid "wc1:245e6ec9289b812a"
msgstr "Un tanker de classe Lumbari s'apprêtait à sauter à Nav 1. Je n'ai pas pu l'arrêter, monsieur."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/5"
msgid "wc1:9bee6d68822db2ad"
msgstr "Et nous avons pu éloigner les Kilrathis du Hicock. Il se dirige vers la colonie maintenant."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/6"
msgid "wc1:7a49fea79c52fae2"
msgstr "Et j'ai pu éloigner les Kilrathis du Hicock. Il se dirige vers la colonie maintenant."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/7"
msgid "wc1:49511886029f3ae5"
msgstr "Et nous n'avons pas pu éloigner les Kilrathis du Hicock. Je suis désolé monsieur."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/8"
msgid "wc1:66c590c340bd4f36"
msgstr "Et je n'ai pas pu éloigner les Kilrathis du Hicock. Je suis désolé monsieur."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/9"
msgid "wc1:1d22dcf262639073"
msgstr "A Nav 3, nous avons protégé le Marciano d'un escadron de Krants."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/10"
msgid "wc1:87bcb1e9b962094c"
msgstr "A Nav 3, j'ai protégé le Marciano d'un escadron de Krants."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/11"
msgid "wc1:3dcaf63031378c1a"
msgstr "A Nav 3, nous n'avons pas pu empeêcher la perte du Marciano."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/12"
msgid "wc1:ba3460c235246ccf"
msgstr "A Nav 3, je n'ai pas pu empeêcher la perte du Marciano."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/13"
msgid "wc1:98fe9433f33f2c92"
msgstr "Et Hunter n'est pas revenu."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/14"
msgid "wc1:e9448c3f2de66941"
msgstr "C'est ma faute, monsieur. Je ne l'ai pas protégé comme il fallait."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/15"
msgid "wc1:b881f74c79ec2f80 $C"
msgstr "C'était votre travail de le protéger, $C. Cette fois-ci..."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/16"
msgid "wc1:b8a4c757112fb202"
msgstr "... vous avez échoué, et cela a coûté  plusieurs vies."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/17"
msgid "wc1:912c79b7e6bc27a4 $K $C"
msgstr "Pour les statistiques, votre enregistreur vous attribue de $K chats, $C..."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/18"
msgid "wc1:a895eeffce1a4100 $C"
msgstr "$C, vous êtes venu avec zero victoire. Il va falloir faire mieux que ça..."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/19"
msgid "wc1:1213efc0b3b424f1 $L"
msgstr "... et Hunter a $L."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/20"
msgid "wc1:b3462410f44ed34c"
msgstr "...et Hunter a zero."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/21"
msgid "wc1:33b6ff0415a868e4"
msgstr "De plus, nous l'avons perdu."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/22"
msgid "wc1:3d5b0525de1f56f8"
msgstr "Un gachis, d'un putain de bon pilote."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/23"
msgid "wc1:006833eb7967b50c"
msgstr "Très bien. Vous avez dix minutes, puis revenez au briefing."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/24"
msgid "wc1:512848a58c3df6c6 $C"
msgstr "Oh, dès que possible, $C, j'ai besoin de vous voir dans mon bureau."

msgctxt "sm1/BRIEFING.001/packet/4/scene/1/record/25"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/4/scene/2/record/0"
msgid "wc1:0732d9286aaeab00 $C"
msgstr "Salut, $C!"

msgctxt "sm1/BRIEFING.001/packet/4/scene/2/record/1"
msgid "wc1:01c48b5580286df2"
msgstr "Il se passe des choses par ici. Nous avons fait beaucoup de sauts."

msgctxt "sm1/BRIEFING.001/packet/4/scene/2/record/2"
msgid "wc1:043e8ce29425a962"
msgstr "BEAUCOUP trop de sauts. tu n'as pas besoin d'être un  génie..."

msgctxt "sm1/BRIEFING.001/packet/4/scene/2/record/3"
msgid "wc1:2c4f54d19342be36"
msgstr "...pour te rendre compte qu'il se passe quelque chose d'inhabituel."

msgctxt "sm1/BRIEFING.001/packet/4/scene/2/record/4"
msgid "wc1:48544dc7f6fd0113"
msgstr "Garde tes oreilles ouvertes et fais-moi savoir ce que tu entendras, d'accord?"

msgctxt "sm1/BRIEFING.001/packet/4/scene/3/record/0"
msgid "wc1:f435616a664e7148 $C"
msgstr "$C! Assieds-toi, prends un verre. Je pensais juste à une histoire que j'avais entendue---"

msgctxt "sm1/BRIEFING.001/packet/4/scene/3/record/1"
msgid "wc1:4ccbcc0c54d45ed3"
msgstr "---à propos du Gwenhyvar, un vaisseau de classe Exeter disparu il y a quelques années."

msgctxt "sm1/BRIEFING.001/packet/4/scene/3/record/2"
msgid "wc1:36befadccdc2f6c9"
msgstr "Tu ne crois pas vraiment à ce vieux conte de fée, n'est-ce pas?"

msgctxt "sm1/BRIEFING.001/packet/4/scene/3/record/3"
msgid "wc1:adc0c46b2261054a"
msgstr "Je ne pense pas que ce soit un conte de fée, Ice."

msgctxt "sm1/BRIEFING.001/packet/4/scene/3/record/4"
msgid "wc1:f20d69bc09eea221"
msgstr "Je n'ai jamais entendu cette histoire, Bossman. Qu'est-il arrivé au Gwenhyvar?"

msgctxt "sm1/BRIEFING.001/packet/4/scene/3/record/5"
msgid "wc1:1e71af2951486680"
msgstr "Soi-disant, les Kilrathis l'ont capturé intact, mis en cale sèche, avec tout son effectif de chasseurs et une partie de l'équipage..."

msgctxt "sm1/BRIEFING.001/packet/4/scene/3/record/6"
msgid "wc1:09b6dfcad779864b"
msgstr "...et ils l'ont utilisé pour tromper et détruire d'autres vaisseaux de la Confédération."

msgctxt "sm1/BRIEFING.001/packet/4/scene/3/record/7"
msgid "wc1:0af9547d300d1c7f"
msgstr "Personne ayant rencontré le Gwenhyvar n'a survécu pour raconter cette histoire."

msgctxt "sm1/BRIEFING.001/packet/4/scene/3/record/8"
msgid "wc1:635b185bc57a8a67"
msgstr "Je le croirai quand je le verrai."

msgctxt "sm1/BRIEFING.001/packet/4/scene/4/record/0"
msgid "wc1:ff41bc4bf9c6b117"
msgstr "Des choses étranges se passent."

msgctxt "sm1/BRIEFING.001/packet/4/scene/4/record/1"
msgid "wc1:131c4865e81e9fe1"
msgstr "J'étais sur le pont il y a quelques heures."

msgctxt "sm1/BRIEFING.001/packet/4/scene/4/record/2"
msgid "wc1:4fa5190e19656afe"
msgstr "Le Griffe du Tigre a reçu une transmission codée..."

msgctxt "sm1/BRIEFING.001/packet/4/scene/4/record/3"
msgid "wc1:8da7540f1c7295d2"
msgstr "...du haut commandement. Le colonel l'a lu..."

msgctxt "sm1/BRIEFING.001/packet/4/scene/4/record/4"
msgid "wc1:ad332b200a3c3c3f"
msgstr "... et a viré l'équipage non essentiel sur le pont."

msgctxt "sm1/BRIEFING.001/packet/4/scene/4/record/5"
msgid "wc1:4236781639569f1a"
msgstr "Depuis, on saute comme des fous."

msgctxt "sm1/BRIEFING.001/packet/4/scene/4/record/6"
msgid "wc1:94735e99637fc773"
msgstr "Nous saurons ce qui se passe bien assez tôt, Iceman."

msgctxt "sm1/BRIEFING.001/packet/4/scene/4/record/7"
msgid "wc1:1fa038f7310abfd1"
msgstr "Oui c'est vrai."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/0"
msgid "wc1:a9e978998564aab0 $T $D"
msgstr "Briefing de mission, $T, $D\nEn route vers la colonie Goddard."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/1"
msgid "wc1:c502c0210621a792"
msgstr "Très bien, nous n'avons pas beaucoup de temps."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/2"
msgid "wc1:f5c9a10c72132e16"
msgstr "On file à toute allure vers Goddard."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/3"
msgid "wc1:03c5fd33dac9ff69"
msgstr "Et les équipages font des réparations d'urgence sur les chasseurs endommagés."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/4"
msgid "wc1:513ba372f12db120"
msgstr "La télémetrie n'indique que plus aucun vaisseau capital kilrathi..."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/5"
msgid "wc1:fcd252ec8ccdb132"
msgstr "...ne reste dans le système Goddard, mais nous avons eu des rapports sur des vaisseaux plus petits."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/6"
msgid "wc1:6f488c39f7af99c7"
msgstr "Par conséquent, vous les Killer Bees irez les détruire."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/7"
msgid "wc1:321ad23cfeeddcef"
msgstr "Parcourez le système Goddard, engagez et détruisez tous les Kilrathis restants."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/8"
msgid "wc1:4c41ed7cc3aaa674"
msgstr "L'intelligence montre des bandits se dirigeant dans cette direction... des combattants laissés pour chasser les transports."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/9"
msgid "wc1:346ef37959383dd3 $C"
msgstr "Escadron Kappa pour $C. Vous commencerez par poursuivre ces chasseurs."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/10"
msgid "wc1:77af8cdef04bf848 $C"
msgstr "Escadron Kappa pour $C. Je compte sur vous pour poursuivre ces chasseurs.."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/11"
msgid "wc1:3c0750fccb994f4e"
msgstr "Une fois que vous aurez pris soin d'eux, vous dégagerez notre chemin vers la colonie."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/12"
msgid "wc1:fc1782af1b3b4a27"
msgstr "Voici la configuration..."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/13"
msgid "wc1:0808264ceb29cd96"
msgstr "...vous passerez à Nav 1, où les balayages à longue portée montrent quelque chose en mouvement. Supprimez-le."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/14"
msgid "wc1:71733dc41ef663cf"
msgstr "A Nav 2, vous trouverez un transporteur de troupes de classe Dorkir. Ils essaient peut-être de quitter le système. Ne le laissez pas partir."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/15"
msgid "wc1:775ff1cfd8666a24"
msgstr "Lorsque vous avez atteint ces objectifs, retournez au Tigre."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/16"
msgid "wc1:4be0b8dbd33cd539"
msgstr "Vient ensuite Maniac et Spirit sur escadron Beta..."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/17"
msgid "wc1:36c5271fb4ebedde"
msgstr "Le colonel informe les autres escadrons..."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/18"
msgid "wc1:feedfcaa1da240d7"
msgstr "N'oubliez pas qu'il y a un quart de million de colons en danger. Ne faites pas d'erreurs, pilotes."

msgctxt "sm1/BRIEFING.001/packet/5/scene/0/record/19"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Rompez."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/1"
msgid "wc1:00f6379edde0391c"
msgstr "Nos communications n'ont toujours pas réussi à atteindre Goddard... "

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/2"
msgid "wc1:fa1dbe319a52dfc3"
msgstr "... mais nos équipages de débarquement approchent maintenant de la colonie elle-même."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/3"
msgid "wc1:360e048984d339e7"
msgstr "Avec un peu de chance, nous saurons bientôt quelque chose."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/4"
msgid "wc1:7272220138ec927a"
msgstr "Très bien alors. Vous avez été vers Nav 1, et...?"

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/5"
msgid "wc1:9be3b906612f341f"
msgstr "C'est la que nous avons arreté le Lumbari, monsieur."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/6"
msgid "wc1:eb9c1e22060091a2"
msgstr "C'est la que j'ai arreté le Lumbari, monsieur."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/7"
msgid "wc1:938bafe54e01fe43"
msgstr "On n'a pas pu avoir le Lumbari, monsieur. J'espère que quelqu'un d'autre le descendra."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/8"
msgid "wc1:d23554699c0c6bce"
msgstr "Je n'ai pas pu avoir le Lumbari, monsieur. J'espère que quelqu'un d'autre le descendra."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/9"
msgid "wc1:5496d5df840e2765"
msgstr "Et à Nav 2, nous avons pu vaincre le Dorkir."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/10"
msgid "wc1:b75107e406a1a8dc"
msgstr "Et à Nav 2, j'ai pu vaincre le Dorkir."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/11"
msgid "wc1:aae2e6924ec62643"
msgstr "Nous n'avons pas pu détruire le Dorkir à Nav 2."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/12"
msgid "wc1:0be497c7eb36147e"
msgstr "J'ai été incapable de détruire le Dorkir à Nav 2."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/13"
msgid "wc1:af45e24c4c1a0dfa"
msgstr "Et je suis desolé de vous apprendre la mort de Hunter."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/14"
msgid "wc1:99500a348e5c8dae"
msgstr "Il est mort dans l'exercice de ses fonctions, combattant les ennemis de l'humanité."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/15"
msgid "wc1:12509543a7aaa1f6 $C $K"
msgstr "$C, votre enregistreur montre que vous avez abattu $K."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/16"
msgid "wc1:3a5c8835f6d3a430 $C"
msgstr "$C, vous n'avez aucun mort. Rien. Zéro. Pas terrible, fiston."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/17"
msgid "wc1:239cbbc4131a2623 $L"
msgstr "Hunter a $L lui."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/18"
msgid "wc1:dbbb91e357ab810e"
msgstr "Hunter n'a rien eu; Nul, très nul."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/19"
msgid "wc1:dfcd95855a4e1b21"
msgstr "Et puis il est mort."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/20"
msgid "wc1:41904b130043db81"
msgstr "Ok, maintenant, puisque nous ne connaissons pas le statut de Goddard..."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/21"
msgid "wc1:a9fa6e61e6bc26e7"
msgstr "... J'ai besoin que vous restiez en alerte. Vous êtes toujours en service."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/22"
msgid "wc1:7a0098a3a12b537e $C"
msgstr "$C, je dois vous voir dans mon bureau."

msgctxt "sm1/BRIEFING.001/packet/5/scene/1/record/23"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/5/scene/2/record/0"
msgid "wc1:9974578b129d7362 $R $C"
msgstr "Salut, $R $C ! Je ne peux rien t'offrir d'alcoolisé, désolé."

msgctxt "sm1/BRIEFING.001/packet/5/scene/2/record/1"
msgid "wc1:60fe220fbd09fb3d"
msgstr "J'ai entendu dire que tu volerais encore aujourd'hui."

msgctxt "sm1/BRIEFING.001/packet/5/scene/2/record/2"
msgid "wc1:f84087439ccef78a"
msgstr "La plupart des pilotes sont déjà dans la salle de briefing."

msgctxt "sm1/BRIEFING.001/packet/5/scene/2/record/3"
msgid "wc1:ae12f146ea567c05"
msgstr "Je sais qu'il n'y a toujours pas de communication avec Goddard."

msgctxt "sm1/BRIEFING.001/packet/5/scene/2/record/4"
msgid "wc1:a65a2589ef7d7d13"
msgstr "Mais j'espère que les Kilrathis n'ont anéanti que le satellite de communication, pas la colonie."

msgctxt "sm1/BRIEFING.001/packet/5/scene/2/record/5"
msgid "wc1:02ced1c55315e802"
msgstr "J'ai un cousin sur Goddard. Zach Siegler. C'est un pilote de navette."

msgctxt "sm1/BRIEFING.001/packet/5/scene/2/record/6"
msgid "wc1:69f9dcc1b5b45577"
msgstr "Et sa femme est ingénieure en chef. Si tu entends parler de l'un d'eux..."

msgctxt "sm1/BRIEFING.001/packet/5/scene/2/record/7"
msgid "wc1:9e695ee234c33085"
msgstr "Fais le moi savoir, j'essaierai de me renseigner aussi."

msgctxt "sm1/BRIEFING.001/packet/5/scene/2/record/8"
msgid "wc1:c317d3f82534730e $R"
msgstr "Mais tu ferais mieux d'aller au Briefing tout de suite, $R."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/0"
msgid "wc1:0bc826513c079ed9 $T $D"
msgstr "Briefing de mission, $T, $D : système Goddard."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/1"
msgid "wc1:aee5f28950473f67"
msgstr "Le commandant est inhabituellement silencieux."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/2"
msgid "wc1:332e8f341c97366d"
msgstr "Il étudie les papiers devant lui, puis parle doucement."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/3"
msgid "wc1:11ebc55e69516e19"
msgstr "Je suis désolé de devoir annoncer une mauvaise nouvelle."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/4"
msgid "wc1:2e0317669dcbe6e2"
msgstr "Le Griffe du Tigre est arrivé trop tard. La colonie Goddard a été détruite."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/5"
msgid "wc1:44cf19c03de4fd4d"
msgstr "Un quart de million de colons terriens ont été tués."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/6"
msgid "wc1:35cd75b52c86763a"
msgstr "La salle de briefing est complètement silencieuse."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/7"
msgid "wc1:a70f5b74e4c96a0e"
msgstr "Nous sommes toujours à la recherche de survivants, mais les chances sont minces."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/8"
msgid "wc1:fc56f19ee1dfe9f6"
msgstr "Mes condoléances à ceux d'entre vous qui avez des parents sur Goddard."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/9"
msgid "wc1:23ce9bc0ba4df7c2"
msgstr "Nous avons éssayé de reconstituer ce qui s'y est passé..."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/10"
msgid "wc1:2c507fdbcd571edc"
msgstr "...d'après les enregistrements de la boîte noire des données satellites..."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/11"
msgid "wc1:5f91295f8c289073"
msgstr "... les Kilrathis sont arrivés à la colonie il y a cinq heures."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/12"
msgid "wc1:3d9a6cb9a41e4f67"
msgstr "Avec une petite flotte... mais ils avaient une sorte de nouvelle arme."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/13"
msgid "wc1:47a18fc412c7887a"
msgstr "Il s'agit de la première utilisation d'une nouvelle technologie kilrathi."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/14"
msgid "wc1:88594e3bfc489862"
msgstr "Une sorte d'arme à énergie, quelque chose que les défenses de Goddard ne pouvaient rien."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/15"
msgid "wc1:fc842fcb7ae8c3c2"
msgstr "L'arme kilrathi a anéanti toute la colonie en un seul tir."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/16"
msgid "wc1:d1c690d51830da02"
msgstr "Selon les satellites de Goddard, il n'y a qu'une explosion enregistrée sur les écrans."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/17"
msgid "wc1:393556009df4bfbe"
msgstr "Nos systèmes de défense actuels ne peuvent pas contrer cette arme."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/18"
msgid "wc1:7f243b349cbfd145"
msgstr "Nous ne pouvons pas risquer que les Kilrathis détruisent une autre colonie..."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/19"
msgid "wc1:543edd47dd9f8ba0"
msgstr "Nous avons donc été en communication avec notre QG."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/20"
msgid "wc1:327ab5b2573f4b4e"
msgstr "Et nos ordres viennent d'arriver. Ecoutez attentivement."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/21"
msgid "wc1:9cf991786f1ac5eb"
msgstr "Nous devons poursuivre à vitesse maximum la flotte kilrathi."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/22"
msgid "wc1:684f3bcc9e2f6613"
msgstr "Et nous devons détruire cette nouvelle arme."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/23"
msgid "wc1:aeed846e1b3e331c"
msgstr "Cela signifie que nous allons SUIVRE leur flotte dans l'espace kilrathi..."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/24"
msgid "wc1:019ccf36c5490687"
msgstr "...faire profil bas aussi longtemps que possible. Ensuite, nous attaquerons leur flotte..."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/25"
msgid "wc1:3eb56f916afbf90d"
msgstr "...pour la detruire complètement. Puis foutre le camp de là."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/26"
msgid "wc1:748fba6d4b30a9cc"
msgstr "Nous allons rencontrer des problèmes techniques dans l'espace kilrathi."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/27"
msgid "wc1:856061aeb30ba725"
msgstr "Notre manque de cartes précises dans ce secteur risque de nous handicaper."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/28"
msgid "wc1:2dadd08c6bbfb9c8"
msgstr "Ne vous attendez pas à ce que les données des points de navigation, astéroïdes et champs de mines soient fiables.."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/29"
msgid "wc1:84affca123fa8c46"
msgstr "Vous devez effectuer vos missions avec intelligence. Suivez vos objectifs de vol à la lettre."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/30"
msgid "wc1:9dc913d7bd893e66"
msgstr "Voici les affectations de mission."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/31"
msgid "wc1:156d6ba2f2e34bca"
msgstr "Toutes les escadrons seront lancés pour escorter le Griffe du Tigre."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/32"
msgid "wc1:1b0938fcf4aea236"
msgstr "Ensuite, vous vous déploierez pour nettoyer les vaisseaux ennemis devant nous."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/33"
msgid "wc1:c76a2d4efede89ff"
msgstr "Affectations individuelles des escadrons..."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/34"
msgid "wc1:8ffb66a2b9048cec"
msgstr "Le colonel donne ses ordres spécifiques à chaque escadron, puis à vous..."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/35"
msgid "wc1:8f7995cda0ab5787 $C $C"
msgstr "Escadron Epsilon sera $C et Angel. $C est le chef."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/36"
msgid "wc1:6d49f562cafba1a0 $C"
msgstr "Escadron Epsilon sera $C."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/37"
msgid "wc1:4cfb48072aedc0e2 $R"
msgstr "Ce sont vos ordres, $R..."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/38"
msgid "wc1:5ee4a9e33ae4f8fd"
msgstr "Une fois que la zone autour du Griffe du Tigre dégagée, dirigez-vous vers Nav 1."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/39"
msgid "wc1:671f9f2a5db06964"
msgstr "Et quand cette région sera propre, retournez au Griffe du Tigre."

msgctxt "sm1/BRIEFING.001/packet/8/scene/0/record/40"
msgid "wc1:3f4ebd0f8b3ac441"
msgstr "Bonne chance, pilotes. Rompez."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/1"
msgid "wc1:77c831a908ac3a2f $R"
msgstr "Bon. Vous êtes tous les deux vivants. Qu'avez-vous à signaler, $R?"

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/2"
msgid "wc1:7e4d0bb46d2cd6ae"
msgstr "Bon sang, nous ne pouvons pas nous permettre des pertes humaines, pas sur cette mission."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/3"
msgid "wc1:21a1ef239b4165b1 $R"
msgstr "...et il fallait que ce soit Angel. Votre rapport, $R."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/4"
msgid "wc1:d0ff768d027d9120"
msgstr "Nous ne pouvions pas nous occuper du Fralthi à Nav 1, monsieur."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/5"
msgid "wc1:ecd83f87c375529f"
msgstr "Je ne pouvais pas m'occuper du Fralthi à Nav 1, monsieur."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/6"
msgid "wc1:2f8f199b555cfd54"
msgstr "Nous avons rencontré un Fralthi à Nav 1. Il ne reviendra pas, monsieur."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/7"
msgid "wc1:af05828ad1d94e01"
msgstr "J'ai rencontré un Fralthi à Nav 1. Il ne reviendra pas, monsieur."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/8"
msgid "wc1:d202a90a66bc6a1c"
msgstr "Et Angel...?"

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/9"
msgid "wc1:53d3215b2e20a1a1"
msgstr "J'aurais aimé avoir pu l'empêcher, monsieur."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/10"
msgid "wc1:619f8b3643242aa1 $R"
msgstr "Elle connaissait les risques. Rappelez-vous de ça, $R, lors de votre prochaine mission."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/11"
msgid "wc1:fb1bf86d981b686e $C $K"
msgstr "Très bien. $C, vous avez $K."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/12"
msgid "wc1:46241b3386b44cc5 $C"
msgstr "Tres bien. $C, Vous n'avez rien eu."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/13"
msgid "wc1:367f62da0aa532a6 $L"
msgstr "Angel a $L."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/14"
msgid "wc1:58caf35ba5df451f"
msgstr "Angel n'a grillé aucun chat cette fois."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/15"
msgid "wc1:395a6774bfea242a"
msgstr "Et puis nous l'avons perdue."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/16"
msgid "wc1:89385c8a1d7da7a1"
msgstr "Bien. Vous avez du temps pour vous reposer avant votre prochaine mission."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/17"
msgid "wc1:658c5f620e0f2be3 $C"
msgstr "$C, J'ai besoin de vous voir dans mon bureau."

msgctxt "sm1/BRIEFING.001/packet/8/scene/1/record/18"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/8/scene/2/record/0"
msgid "wc1:f01eab8f45ac21bc $C"
msgstr "$C, J'ai entendu de mauvaises nouvelles."

msgctxt "sm1/BRIEFING.001/packet/8/scene/2/record/1"
msgid "wc1:6cb3336cbe885d1e"
msgstr "Les équipes de recherche et de sauvetage sont de retour de la planète."

msgctxt "sm1/BRIEFING.001/packet/8/scene/2/record/2"
msgid "wc1:91fffb52de8be6c8"
msgstr "Ils étaient au sol que quelques heures, et maintenant ils ne parlent plus."

msgctxt "sm1/BRIEFING.001/packet/8/scene/2/record/3"
msgid "wc1:750b4bd61a1daa52"
msgstr "Je n'arrive pas avoir de réponse du pont..."

msgctxt "sm1/BRIEFING.001/packet/8/scene/2/record/4"
msgid "wc1:60c2fc0dba49e1ce"
msgstr "... rien sauf 'ferme-la et occupe-toi de ton bar'."

msgctxt "sm1/BRIEFING.001/packet/8/scene/2/record/5"
msgid "wc1:b96ed714f42e7d25"
msgstr "Le colonel Halcyon a l'air d'étre derrière tout ca."

msgctxt "sm1/BRIEFING.001/packet/8/scene/2/record/6"
msgid "wc1:75d2c4ff20b28823"
msgstr "Donc si tu as des nouvelles de ce qui se passe, dis-le moi."

msgctxt "sm1/BRIEFING.001/packet/8/scene/2/record/7"
msgid "wc1:f1c89640efd6cdfe $C"
msgstr "A plus tard, $C."

msgctxt "sm1/BRIEFING.001/packet/8/scene/3/record/0"
msgid "wc1:ba99efac48043686 $C"
msgstr "Bonjour, $C. C'était très tendu ce matin, non?"

msgctxt "sm1/BRIEFING.001/packet/8/scene/3/record/1"
msgid "wc1:8536b18b3af26a7c"
msgstr "Les autres escadrons se sont heurtés à une horde de Krants et de Salthis."

msgctxt "sm1/BRIEFING.001/packet/8/scene/3/record/2"
msgid "wc1:50bb01593732da04"
msgstr "Mon Dieu, quel combat!"

msgctxt "sm1/BRIEFING.001/packet/8/scene/3/record/3"
msgid "wc1:6bbd915e64d79bda"
msgstr "J'ai fait tellement de loopings, j'en ai encore le vertige."

msgctxt "sm1/BRIEFING.001/packet/8/scene/3/record/4"
msgid "wc1:432dcf4abc5f65e2 $N"
msgstr "$N, Je crois que nous serons coéquipiers aujourd'hui."

msgctxt "sm1/BRIEFING.001/packet/8/scene/3/record/5"
msgid "wc1:169bb2c19fcffe60 $C"
msgstr "Je te verrai plus tard au poste de pilotage, $C. Nous donnerons du fil à retordre aux chats, non?"

msgctxt "sm1/BRIEFING.001/packet/8/scene/4/record/0"
msgid "wc1:84e17dab5cb1d60d $C"
msgstr "$C, c'est tendu ici ces derniers temps."

msgctxt "sm1/BRIEFING.001/packet/8/scene/4/record/1"
msgid "wc1:7f45881e7e615339"
msgstr "Tous les hauts gradés ont le cul et les dents serrées."

msgctxt "sm1/BRIEFING.001/packet/8/scene/4/record/2"
msgid "wc1:fff3249472160475"
msgstr "Plus que d'habitude, a vrai dire."

msgctxt "sm1/BRIEFING.001/packet/8/scene/4/record/3"
msgid "wc1:860887509a61c2a2"
msgstr "J'ai été un peu tendu aussi. J'ai eu du mal à dormir la nuit."

msgctxt "sm1/BRIEFING.001/packet/8/scene/4/record/4"
msgid "wc1:63ec42f192b994cb"
msgstr "Je continue à faire ce rêve, encore et encore. Nous sommes en action contre ces fumiers..."

msgctxt "sm1/BRIEFING.001/packet/8/scene/4/record/5"
msgid "wc1:97db2d6cc096644e"
msgstr "Et devant nous se trouve le plus gros vaisseau kilrathi que je n'ai jamais vu."

msgctxt "sm1/BRIEFING.001/packet/8/scene/4/record/6"
msgid "wc1:8f6590640584af0d"
msgstr "Tous mes canons sont hs, sans missile, les boucliers a zéro..."

msgctxt "sm1/BRIEFING.001/packet/8/scene/4/record/7"
msgid "wc1:057e1de7429968b1"
msgstr "Et mes mains tremblent, alors que j'accélère à fond..."

msgctxt "sm1/BRIEFING.001/packet/8/scene/4/record/8"
msgid "wc1:2c185f790b6b299f"
msgstr "...parce que tout ce qu'il me reste c'est la boule au ventre."

msgctxt "sm1/BRIEFING.001/packet/8/scene/4/record/9"
msgid "wc1:158ac7092f0715ad"
msgstr "Alors je plonge, droit sur ses côtés... les missiles explosent comme des étoiles autour de moi..."

msgctxt "sm1/BRIEFING.001/packet/8/scene/4/record/10"
msgid "wc1:3319e036e2e255f8"
msgstr "Je m'écrase sur le vaisseau kilrathi---"

msgctxt "sm1/BRIEFING.001/packet/8/scene/4/record/11"
msgid "wc1:257e2481334b96fe"
msgstr "---Et puis je me réveille."

msgctxt "sm1/BRIEFING.001/packet/8/scene/4/record/12"
msgid "wc1:c807b69b94a95cc9"
msgstr "Je sais que c'est bizarre, mais je ne peux pas m'empêcher de penser à ce rêve..."

msgctxt "sm1/BRIEFING.001/packet/8/scene/4/record/13"
msgid "wc1:85c169e423428e4d"
msgstr "Je pense que nous sommes tous très stressés en ce moment, non ? Mais nous survivrons à ça, mon ami."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/0"
msgid "wc1:85c68ed6a839ecb5 $T $D"
msgstr "Briefing de mission, $T, $D : En route vers l'espace kilrathi."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/1"
msgid "wc1:7289f214b4cd0184"
msgstr "En ce moment, nous naviguons au coeur de l'espace kilrathi."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/2"
msgid "wc1:cee0ab3abb11a5a2"
msgstr "Et nous venons de recevoir un message codé du Haut Commandement."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/3"
msgid "wc1:f6ee3de7ef698579"
msgstr "Ils envoient un convoi à notre rencontre. Ils seront à la frontière..."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/4"
msgid "wc1:e3a077cc67c27858"
msgstr "...juste là où nous avons eu notre dernière bagarre avec les boules de poils."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/5"
msgid "wc1:fc772a8de4472c00"
msgstr "Alors j'envoie des escadrons pour le recupérer."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/6"
msgid "wc1:987bed2144c3307d"
msgstr "Allez à ce point de saut, détruisez tous les Kilrathis que vous rencontrez."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/7"
msgid "wc1:78af7d18bbed279c"
msgstr "Aux points de sauts désignés, vous rencontrerez le convoi Sleipnir..."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/8"
msgid "wc1:608794cdf3ef5314"
msgstr "...de classe Drayman transportant chacun une compagnie de marines."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/9"
msgid "wc1:681f0e9b5c9e93ec"
msgstr "Comme vous le savez peut-être, le Sleipner transporte les Reavers..."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/10"
msgid "wc1:a9ade943a4ea3ad7"
msgstr "...une division de marines d'élite, recrutés parmi les nations scandinaves de la Terre."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/11"
msgid "wc1:aa6295666b158c06"
msgstr "Nous avons besoin de leur aide, les gars."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/12"
msgid "wc1:92ffbac539eef866"
msgstr "Chaque escadron escortera un convoi jusqu'à un point de saut dans le territoire kilrathi."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/13"
msgid "wc1:c4fc099f2914f156"
msgstr "Apres le saut des Reavers, retournez au Griffe du Tigre."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/14"
msgid "wc1:059b911d0e04dad7"
msgstr "Si nous avons de la chance, cette mission nous apportera un avantage supplémentaire."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/15"
msgid "wc1:cba9bd106533a34b"
msgstr "Les Kilrathi pourraient interpréter cela comme une attaque frontalière de grande ampleur.---"

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/16"
msgid "wc1:ac9bf0a7c8552791"
msgstr "---sans réaliser que nous nous dirigeons dans leur espace."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/17"
msgid "wc1:19637643b94d6f6f"
msgstr "Ok, voici les Affectations individuelles des escadrons."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/18"
msgid "wc1:254ca2f76f91a63a"
msgstr "Chaque escadron reçoit ses ordres..."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/19"
msgid "wc1:7dd7b169dea47cb5 $C"
msgstr "Escadron Epsilon pour $C et Angel."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/20"
msgid "wc1:318ee49d0298ba20 $C"
msgstr "Escadron Epsilon -- $C, tu voles seul."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/21"
msgid "wc1:66be15c62a84e513"
msgstr "Vous volerez en ligne droite jusqu'au point de rendez-vous."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/22"
msgid "wc1:1b67b673c3ae1f4b"
msgstr "Si les Kilrathis s'éjectent, n'hésitez pas à les tuer."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/23"
msgid "wc1:dc513ce4fe11da63"
msgstr "Rendez-vous avec votre convoi à Nav 1."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/24"
msgid "wc1:353ed5b28cddc49c"
msgstr "Escortez-les jusqu'à Nav 2, juste de ce côté de la zone."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/25"
msgid "wc1:acc1cdfb448a55e2"
msgstr "Quand ils sauteront, rentrez à la maison."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/26"
msgid "wc1:2d364e4d6ddac4a9"
msgstr "Les Reavers ont leurs propres ordres. Ils ont aussi une mission secrète."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/27"
msgid "wc1:703e9b19fb3edd40"
msgstr "S'ils réussissent, nous les retrouverons plus tard."

msgctxt "sm1/BRIEFING.001/packet/9/scene/0/record/28"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/1"
msgid "wc1:8e791295a93e9908"
msgstr "Content de vous revoir tous les deux."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/2"
msgid "wc1:26d923ee2ae87570 $C"
msgstr "Content de vous voir de retour, $C."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/3"
msgid "wc1:c87963effe9a0925"
msgstr "Je suis désolé pour Angel."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/4"
msgid "wc1:6cc064cd30c813f8"
msgstr "J'aurais souhaité faire quelque chose de plus, monsieur."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/5"
msgid "wc1:cf50d20b15f1cba4 $R"
msgstr "Elle connaissait les risques. Rappelez-vous en, $R, la prochaine fois que vous effectuerez une mission."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/6"
msgid "wc1:8177634325089658"
msgstr "Ecoutez, pas mal de chasseurs ont été endommagés dans cette dernière mission."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/7"
msgid "wc1:56677454d85f3598"
msgstr "Alors ne soyez pas surpris si vous vous retrouvez à piloter un Scimitar."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/8"
msgid "wc1:31fba571dec41d25 $C"
msgstr "Passons en revue la mission. Votre rapport, $C."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/9"
msgid "wc1:e72b2361aedb5b18"
msgstr "Je suis parti à la rencontre du convoi Reaver au point de rendez-vous."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/10"
msgid "wc1:9be400fe8351c1b1"
msgstr "Nous sommes partis à la rencontre du convoi Reaver au point de rendez-vous."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/11"
msgid "wc1:c67fef990c844f38"
msgstr "C'était un dur combat, mon Colonel."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/12"
msgid "wc1:7b271897c5f0cdf1"
msgstr "Tout le convoi a survecu, monsieur."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/13"
msgid "wc1:3009a001a08bbb2e $C"
msgstr "Bon travail, $C."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/15"
msgid "wc1:22750a24da6bf8cd"
msgstr "Tout le convoi a été détruit. Je suis désolé, monsieur... j'ai fait de mon mieux."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/17"
msgid "wc1:8e082a11b532b81a"
msgstr "J'ai perdu l'un des transports. Je suis désolé, monsieur... j'ai fait de mon mieux."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/18"
msgid "wc1:fa3585f614903990"
msgstr "Mais au moins l'autre transport a survecu."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/19"
msgid "wc1:8e082a11b532b81a"
msgstr "J'ai perdu l'un des transports. Je suis désolé, monsieur... j'ai fait de mon mieux."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/20"
msgid "wc1:fa3585f614903990"
msgstr "Mais au moins l'autre transport a survecu."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/21"
msgid "wc1:09d5620141dde415 $R"
msgstr "Beaucoup de bons soldats sont morts aujourd'hui à cause de vous, $R."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/22"
msgid "wc1:2083cbc9d2a1aee9"
msgstr "Plus tard, quand j'aurai pris du temps pour me calmer, nous en reparlerons."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/23"
msgid "wc1:51f8c9c8442c49a0 $C $K"
msgstr "Pour mémoire, $C, tu as tué $K chats."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/24"
msgid "wc1:8baedcaf5d83d969 $C"
msgstr "Pour mémoire, $C, tu n'as eu aucun mort."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/25"
msgid "wc1:0813494ab32c2828 $L"
msgstr "Angel a $L."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/26"
msgid "wc1:6008f4e8034e490b"
msgstr "Angel n'en a tué aucun cette fois-ci."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/27"
msgid "wc1:968930f796bedbd0"
msgstr "Et j'aurai besoin de vous voir dans mon bureau immédiatement."

msgctxt "sm1/BRIEFING.001/packet/9/scene/1/record/28"
msgid "wc1:fd4f8b0a1926801e"
msgstr "C'est tout. Rompez."

msgctxt "sm1/BRIEFING.001/packet/9/scene/2/record/0"
msgid "wc1:3b9ecc9563bd2603 $C"
msgstr "Hey, $C. Content que tu sois revenu."

msgctxt "sm1/BRIEFING.001/packet/9/scene/2/record/1"
msgid "wc1:12f67d18f3180ab6"
msgstr "Tu voudras peut-être aller parler à Paladin et Knight."

msgctxt "sm1/BRIEFING.001/packet/9/scene/2/record/2"
msgid "wc1:524d9f14dd219c09"
msgstr "Je pense qu'ils sont tous deux un peu stressés sur les bords."

msgctxt "sm1/BRIEFING.001/packet/9/scene/2/record/3"
msgid "wc1:64bdfaa03044e55f"
msgstr "Fais-moi savoir si tu entends quelque chose à propos de Goddard, d'accord?"

msgctxt "sm1/BRIEFING.001/packet/9/scene/3/record/0"
msgid "wc1:85ae16e54bde50ed $C"
msgstr "Bonjour, $C."

msgctxt "sm1/BRIEFING.001/packet/9/scene/3/record/1"
msgid "wc1:c75b7e41b210b54a"
msgstr "Je ne sais pas pour toi, mais je commence a m'inquièter de cette affaire."

msgctxt "sm1/BRIEFING.001/packet/9/scene/3/record/2"
msgid "wc1:b946e2c50de226a8"
msgstr "Tu réalises que nous nous dirigeons aveuglement comme une chauve-souris dans l'espace ennemi inexploré?"

msgctxt "sm1/BRIEFING.001/packet/9/scene/3/record/3"
msgid "wc1:b125e126360dacca"
msgstr "A la poursuite d'une super-arme kilrathi dont nous ne savons rien?"

msgctxt "sm1/BRIEFING.001/packet/9/scene/3/record/4"
msgid "wc1:2d041ca44d2f3353 $R"
msgstr "C'est vrai, $R. Joe ici va être notre officier de moral a partir de maintenant."

msgctxt "sm1/BRIEFING.001/packet/9/scene/3/record/5"
msgid "wc1:f0df67ee01864dd5"
msgstr "Non, merci... Je préfère combattre les Kilrathis!"

msgctxt "sm1/BRIEFING.001/packet/9/scene/3/record/6"
msgid "wc1:b9977b604eb22779"
msgstr "Laisse-moi te confier quelques-unes de mes pensées."

msgctxt "sm1/BRIEFING.001/packet/9/scene/3/record/7"
msgid "wc1:d49168e169944299"
msgstr "J'ai regardé Maniac. Il dit qu'il fait des cauchemars..."

msgctxt "sm1/BRIEFING.001/packet/9/scene/3/record/8"
msgid "wc1:d94875a9f1e0656a"
msgstr "...et j'ai vu ses mains trembler à chaque fois qu'il montait dans le cockpit."

msgctxt "sm1/BRIEFING.001/packet/9/scene/3/record/9"
msgid "wc1:47591a718093f9fb"
msgstr "Je pense que Todd est en train de perdre la tête. Il a toujours été sur la corde raide."

msgctxt "sm1/BRIEFING.001/packet/9/scene/3/record/10"
msgid "wc1:efe44993d3e4670b"
msgstr "Je garderais un oeil sur lui, s'il est mon ailier."

msgctxt "sm1/BRIEFING.001/packet/9/scene/3/record/11"
msgid "wc1:ce0288f19c71027d"
msgstr "Sinon, son fou rire pourrait être la dernière chose qu'on entendra de lui."

msgctxt "sm1/BRIEFING.001/packet/9/scene/4/record/0"
msgid "wc1:4320d3e4352442c9"
msgstr "Assieds-toi, mon garçon, bois un verre. Il y a une question qui me trouble---"

msgctxt "sm1/BRIEFING.001/packet/9/scene/4/record/1"
msgid "wc1:d1d14ee47b52fa02"
msgstr "Les chats n'ont montré aucune pitié envers notre peuple. Mais si nous gagnons cette guerre, qu'allons-nous leur faire?"

msgctxt "sm1/BRIEFING.001/packet/9/scene/4/record/2"
msgid "wc1:8acdf9887c8bd4e9"
msgstr "Qu'est-ce que tu veux dire, James?"

msgctxt "sm1/BRIEFING.001/packet/9/scene/4/record/3"
msgid "wc1:1bee8beaa6ffb7bb"
msgstr "Génocide, mon garcon. Si nous ne les détruisons pas complètement, cette guerre ne finira jamais."

msgctxt "sm1/BRIEFING.001/packet/9/scene/4/record/4"
msgid "wc1:1d48ff340b672382"
msgstr "Et si nous les tuons tous, en quoi sommes-nous différents d'eux?"

msgctxt "sm1/BRIEFING.001/packet/9/scene/4/record/5"
msgid "wc1:991a929442e99c38"
msgstr "Si nous perdons cette guerre, je me fiche de ce qui se passera, parce que je ne serais pas en vie pour le voir---"

msgctxt "sm1/BRIEFING.001/packet/9/scene/4/record/6"
msgid "wc1:3e8b4ed769819d5e"
msgstr "...Mais et si nous gagnions?"

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/0"
msgid "wc1:26e82903be29ab9e $T $D"
msgstr "Briefing de mission, $T, $D : nom de code du système kilrathi 'Midgard.'"

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/1"
msgid "wc1:3d93da6d6c368a0d"
msgstr "Bonjour. Il y a eu quelques réaffectations d'équipage récents..."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/2"
msgid "wc1:54ef99767cd2d5b5"
msgstr "... et j'aimerais souhaiter la bienvenue à tous les nouveaux pilotes de l'escadron Blue Devil."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/3"
msgid "wc1:93ae9efc48aa8428"
msgstr "J'espère que vous aimez piloter les Scimitars. Sinon, je ne veux rien entendre."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/4"
msgid "wc1:e3a1494d176a10fa"
msgstr "Nous avons de vrais problèmes. Les Kilrathis ont capturés un vaisseau de la Confédération à Goddard..."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/5"
msgid "wc1:cee67db0266d7e1f"
msgstr "...le Falstaff, un transporteur de courrier de classe Drayman, qui transporte...."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/6"
msgid "wc1:562db0cebaa51f5f"
msgstr "...des informations vitales sur nos opérations contre les Kilrathis."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/7"
msgid "wc1:1b9903a56b069515"
msgstr "Spécifications de conceptions d'armes, mouvements de troupes, cartes tactiques... ces données pourraient paralyser notre mission."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/8"
msgid "wc1:71f0fd929a5341e4"
msgstr "Les chats connaissent certaines de nos mesures de sécurité..."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/9"
msgid "wc1:1d693df7e2720d05"
msgstr "...Tels que nos courriers piègés prêt à exploser en cas de falsification."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/10"
msgid "wc1:7fcc79028fd18c20"
msgstr "Il y a de bonnes chances qu'ils le ramènent à leur centre de commandement..."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/11"
msgid "wc1:d4e8bfa2aa48d26d"
msgstr "... afin que leurs propres techniciens puissent l'ouvrir sans détruire le vaisseau."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/12"
msgid "wc1:56e843121be585ec"
msgstr "La mission d'aujourd'hui est de détruire ce transport."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/13"
msgid "wc1:d2fff1f409857b13"
msgstr "Maintenant, nous allons nous détourner de la flotte que nous suivons."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/14"
msgid "wc1:321ac0266c020fdc"
msgstr "C'est pourquoi nous utiliserons un petit groupe de pilotes."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/15"
msgid "wc1:92f37be9df2c10c6"
msgstr "Avec de la chance, nous terminerons la mission avant qu'ils ne réalisent quoi que ce soit."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/16"
msgid "wc1:a61574b981813857"
msgstr "Deux escadrons de Blue Devils effectueront toute la mission."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/17"
msgid "wc1:d749ccc6f654c914"
msgstr "Voici les affectations individuelles des escadrons:"

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/18"
msgid "wc1:28320b963381af29 $C $C"
msgstr "$C, et Bossman êtes escadron Delta. $C est le chef."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/19"
msgid "wc1:265f34419e4b02a3 $C"
msgstr "$C, vous volerez seul en tant qu'escadron Delta."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/20"
msgid "wc1:8246a9bf21fa8cc0"
msgstr "Le commandant attribue d'autres escadrons, puis lit la mission de Delta:"

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/21"
msgid "wc1:da3d65134a5ec9f6"
msgstr "Dirigez-vous vers Nav 1 et détruisez toutes les patrouilles de Kilrathis que vous rencontrerez."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/22"
msgid "wc1:fd3c60e6046ab3ab"
msgstr "Une fois à Nav 1, votre objectif principal est de détruire le Falstaff."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/23"
msgid "wc1:8f71b7375e2566de"
msgstr "Ensuite, dirigez-vous à Nav 2. Nous y avons détecté un croiseur Ralari. Eliminez-le aussi."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/24"
msgid "wc1:79a39050438c6740 $C"
msgstr "Et gardez les yeux ouverts sur les patrouilles de chasse et les vaisseaux d'escorte, $C..."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/25"
msgid "wc1:384241c6aca072a8"
msgstr "...parce que les Kilrathis utiliseront tous les vaisseaux dont ils disposent pour garder le Falstaff intact."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/26"
msgid "wc1:3183aaed1efb1924"
msgstr "Une fois que nous aurons commencé, ils sauront que nous sommes ici. C'est notre seule chance de surprise."

msgctxt "sm1/BRIEFING.001/packet/12/scene/0/record/27"
msgid "wc1:08baaecc1bcb13c1"
msgstr "Bonne chance, pilotes. Rompez."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/1"
msgid "wc1:2806046ad5a04da2 $R"
msgstr "Bienvenue, $R. Bon vol, Bossman?"

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/2"
msgid "wc1:c30eb017234faf35"
msgstr "Pas mal monsieur."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/3"
msgid "wc1:8917f9cabdf98f2b"
msgstr "J'ai perdu Bossman, monsieur. je ne pouvais tout simplement pas---"

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/4"
msgid "wc1:e6dce131a3a7fa92 $N"
msgstr "Je sais, $N. Mais il est mort honorablement, en combattant les Kilrathis."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/5"
msgid "wc1:6b38d68a4477981f"
msgstr "Dites-moi ce qui s'est passé."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/6"
msgid "wc1:706ad7a36623459f"
msgstr "Oui Monsieur. Nous avons été à Nav 1..."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/7"
msgid "wc1:10d527e797a3bfa6"
msgstr "Oui Monsieur. J'ai été à Nav 1..."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/8"
msgid "wc1:aa0c07695468131f"
msgstr "...mais nous n'avons pas réussi à détruire le Drayman."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/9"
msgid "wc1:283112d630ec08d6"
msgstr "...mais je n'ai pas réussi à détruire le Drayman."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/10"
msgid "wc1:41d6cb8c5708542b"
msgstr "...ou nous avons engagé l'ennemi et détruit le Drayman."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/11"
msgid "wc1:8b29b90ac81b6ee8"
msgstr "...ou j'ai engagé l'ennemi et détruit le Drayman."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/12"
msgid "wc1:e63c126fe97b5048"
msgstr "Et nous avons rencontré le Ralari à Nav 2. C'était dur, mais il est en poussière, Colonel."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/13"
msgid "wc1:2a123c1d30854f1d"
msgstr "Et j'ai rencontré le Ralari à Nav 2. C'était dur, mais il est en poussière, Colonel."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/14"
msgid "wc1:7a35b73864a6a63b"
msgstr "Et nous ne pouvions pas arrêter le Ralari à Nav 2, monsieur. Cette mission était trop difficile."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/15"
msgid "wc1:58109d7d5692dc28"
msgstr "Et je n'ai pas pu arrêter le Ralari à Nav 2, monsieur. Cette mission était trop difficile."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/16"
msgid "wc1:6e34ca94e307f8bc $K $C"
msgstr "D'apres l'enregistreur de vol, je vois que vous avez eu des vaisseaux $K kilrathis, $C."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/17"
msgid "wc1:8e2076c04d206a7b $C"
msgstr "$C, vous n'avez pas eu de chats cette fois. Pas terrible, fiston."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/18"
msgid "wc1:4d4f38628c05127a $L"
msgstr "Et Bossman a $L."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/19"
msgid "wc1:a7be5dd705bfc5dd"
msgstr "Bossman n'a rien eu."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/20"
msgid "wc1:aab3a45cfa5c9e30"
msgstr "Et les chats l'ont tué. Merde, cet homme va me manquer."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/21"
msgid "wc1:bf0225276f182092 $R"
msgstr "J'ai vu beaucoup de soldats mourir, $R. Mais je ne m'y habitue jamais."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/22"
msgid "wc1:63a85b5e6f3e46c2 $R"
msgstr "Bon travail, $R. Votre réussite dans cette mission fera la difference dans cette opération."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/23"
msgid "wc1:85a0f04f57a60b03 $R"
msgstr "Je sais que vous avez fait de votre mieux, $R. Mais perdre ce transport... nous avons de vrais problèmes maintenant."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/24"
msgid "wc1:7c417715b475b55c $C"
msgstr "J'aurai besoin de vous voir dans mon bureau plus tard, $C."

msgctxt "sm1/BRIEFING.001/packet/12/scene/1/record/25"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/12/scene/2/record/0"
msgid "wc1:a89732fde2f480ea $C"
msgstr "Qu'est-ce que tu veux, $C ? Je vais te donner ta boisson habituelle."

msgctxt "sm1/BRIEFING.001/packet/12/scene/2/record/1"
msgid "wc1:25949b0639d31ab9"
msgstr "Scuttlebutt dit que les boules de poils ont un vaisseau terrien avec eux."

msgctxt "sm1/BRIEFING.001/packet/12/scene/2/record/2"
msgid "wc1:c403c9f87d2b9139"
msgstr "Je sais que les Kilrathis ne font jamais d'otages... mais peut-être que cette fois..."

msgctxt "sm1/BRIEFING.001/packet/12/scene/2/record/3"
msgid "wc1:9a838065b916e7c0"
msgstr "Non. C'est impossible ? Ils ne font pas de prisonniers déjà."

msgctxt "sm1/BRIEFING.001/packet/12/scene/2/record/4"
msgid "wc1:27d1a5131e699a2d"
msgstr "Mon cousin Zach et sa femme sont morts comme tous les autres à Goddard..."

msgctxt "sm1/BRIEFING.001/packet/12/scene/2/record/5"
msgid "wc1:3131be07dba01ae6"
msgstr "... et si les chats ont un vaisseau de la Confédération capturé..."

msgctxt "sm1/BRIEFING.001/packet/12/scene/2/record/6"
msgid "wc1:2d6ac7e96d250866"
msgstr "Tu peux être sur qu'il est rempli de nourriture pour chat ou quelque chose comme ça."

msgctxt "sm1/BRIEFING.001/packet/12/scene/3/record/0"
msgid "wc1:7cc2feed38adc51a $C"
msgstr "b'jour, $C. Je disais à Mariko comment tu as bien piloté contre les boules de poils."

msgctxt "sm1/BRIEFING.001/packet/12/scene/3/record/1"
msgid "wc1:f3058bc1c6c65a42"
msgstr "Hunter était en effet très élogieux de tes compétences de vol."

msgctxt "sm1/BRIEFING.001/packet/12/scene/3/record/2"
msgid "wc1:0ee6cf3c90a3262c"
msgstr "J'espère voler de nouveau avec toi un jour."

msgctxt "sm1/BRIEFING.001/packet/12/scene/3/record/3"
msgid "wc1:269d9d2978e94c94 $C"
msgstr "En parlant de voler avec $C --"

msgctxt "sm1/BRIEFING.001/packet/12/scene/3/record/4"
msgid "wc1:f18edc575b01d12a $N"
msgstr "$N, si tu es affecté avec Maniac, sois très prudent."

msgctxt "sm1/BRIEFING.001/packet/12/scene/3/record/5"
msgid "wc1:193e307ca3c59f76"
msgstr "Il a, ces derniers jours, la tête dans les nuages."

msgctxt "sm1/BRIEFING.001/packet/12/scene/3/record/6"
msgid "wc1:994e8272aa589b6c"
msgstr "Il dit qu'il va détruire l'arme secrète kilrathi tout seul."

msgctxt "sm1/BRIEFING.001/packet/12/scene/3/record/7"
msgid "wc1:1ccb9dc9e872cd5b"
msgstr "J'ai l'idée qu'il veut devenir kamikaze..."

msgctxt "sm1/BRIEFING.001/packet/12/scene/3/record/8"
msgid "wc1:f26d8883b417fc86"
msgstr "... contre les fils de pute de Kilrah."

msgctxt "sm1/BRIEFING.001/packet/12/scene/3/record/9"
msgid "wc1:7809afa3535c9997"
msgstr "Je ne veux pas te voir tuer à cause de lui. Attention, hein?"

msgctxt "sm1/BRIEFING.001/packet/12/scene/4/record/1"
msgid "wc1:0d388cc8016b0134"
msgstr "J'écoutais le journal télèvisé ce matin."

msgctxt "sm1/BRIEFING.001/packet/12/scene/4/record/2"
msgid "wc1:32a8f40fba8bdaac"
msgstr "Il semble qu'il y ait eu une attaque kilrathi sur la station Epsilon."

msgctxt "sm1/BRIEFING.001/packet/12/scene/4/record/3"
msgid "wc1:835f0cae500eb76a"
msgstr "Mon fiancé est en poste là-bas... Il est officier dans le corps medical."

msgctxt "sm1/BRIEFING.001/packet/12/scene/4/record/4"
msgid "wc1:afbb4e98a18937a3"
msgstr "Je ne le savais pas, Mariko."

msgctxt "sm1/BRIEFING.001/packet/12/scene/4/record/5"
msgid "wc1:e32737cb9ef4985e"
msgstr "Je parle rarement de lui. Il vaut mieux se concentrer sur notre travail ici."

msgctxt "sm1/BRIEFING.001/packet/12/scene/4/record/6"
msgid "wc1:49777ddb3da7c80a"
msgstr "Pour l'instant, nous devons maintenir le silence des communications, donc je ne peux pas savoir ce qui s'est passé."

msgctxt "sm1/BRIEFING.001/packet/12/scene/4/record/7"
msgid "wc1:24d3d51892f2168f"
msgstr "Mais bientôt quand nous retournerons dans l'espace terrien, je saurai."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/0"
msgid "wc1:26e82903be29ab9e $T $D"
msgstr "Briefing de mission, $T, $D : nom de code du système kilrathi 'Midgard'."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/1"
msgid "wc1:4b73804d253e7a3e"
msgstr "Le commandant vérifie ses notes, puis parle:"

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/2"
msgid "wc1:ca0b90ca2feacbb3"
msgstr "La mission d'hier, bien que cruciale, a averti les Kilrathis de notre présence."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/3"
msgid "wc1:f62c4f000413a091"
msgstr "Ils ne connaissent pas la taille de notre flotte, et ils ne peuvent pas être sûrs..."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/4"
msgid "wc1:d198ad81fb8574dd"
msgstr "... que nous les suivons réellement. Essayons de continuer ainsi."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/5"
msgid "wc1:227443b55e027104"
msgstr "Cependant, Lady Luck sera avec nous. Les Reavers opérant dans cette zone... "

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/6"
msgid "wc1:cd8d8ecc8f835fec"
msgstr "...ont capturé un chasseur de classe Dralthi intact."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/7"
msgid "wc1:3e0d98c5974500bd"
msgstr "Ils le ramènent au Tigre pour nos techniciens et nos gars du renseignement."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/8"
msgid "wc1:39a9ce1305ec748a"
msgstr "Il y a beaucoup de données kilrathis dans ce vaisseau, pilotes."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/9"
msgid "wc1:78f719636fc212b4"
msgstr "Ces données pourraient faire la différence pour nous. J'ai besoin de quelqu'un pour l'escorter."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/10"
msgid "wc1:981e907ecb7a89b8"
msgstr "Je peux le faire, Colonel."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/11"
msgid "wc1:96ed7f9b0cb51004 $C"
msgstr "Okay.  $C, vous êtes l'escadron Gamma. Choisissez votre ailier."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/12"
msgid "wc1:a6db9ae469b74b83"
msgstr "Je volerai encore avec Bossman, monsieur."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/13"
msgid "wc1:e2f39591a6966a23"
msgstr "Je pense que je peux gérer ça tout seul, monsieur."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/14"
msgid "wc1:f55c7abfabee29b5"
msgstr "Bien. Voici la configuration."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/15"
msgid "wc1:af3762762e8f7e80"
msgstr "Dirigez-vous vers le point de rendez-vous via Nav 1."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/16"
msgid "wc1:966b5f83568f9640"
msgstr "Nav 2 est votre véritable destination. Assurez-vous qu'il n'y a aucun danger pour notre chasseur Dralthi..."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/17"
msgid "wc1:e08dfb19ef654caa"
msgstr "...qui vous y retrouvera. Escortez-le ici."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/18"
msgid "wc1:be07bb40cfe8b592"
msgstr "Encore une chose. L'intelligence recommande d'éviter Nav 1 pour le retour."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/19"
msgid "wc1:2e6ce41a752bf86f"
msgstr "Vous devez revenir par Nav 3 et utiliser les asteroïdes pour vous couvrir."

msgctxt "sm1/BRIEFING.001/packet/13/scene/0/record/20"
msgid "wc1:84ce0c55d3b5214c $C"
msgstr "Bonne chance, $C. Escadron Rompez."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/1"
msgid "wc1:0cd725ea9f16d1d9"
msgstr "Je suis content que vous soyez tous les deux revenus."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/2"
msgid "wc1:d96f244c1f94f7f2 $C"
msgstr "C'était dur, monsieur. Mais $C est un bon chef d'escadron, bien meilleur qu'avant...."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/3"
msgid "wc1:4de4a240e2614be9 $R"
msgstr "Je suis content que vous soyez revenu vivant, $R."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/4"
msgid "wc1:7aa58ce0fcb3d591"
msgstr "J'ai perdu Bossman, monsieur. je ne pouvais tout simplement pas---"

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/5"
msgid "wc1:e6dce131a3a7fa92 $N"
msgstr "Je sais, $N. Mais il est mort honorablement, en combattant les Kilrathis."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/6"
msgid "wc1:846130851e281c70 $C"
msgstr "J'écoute votre rapport, $C."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/7"
msgid "wc1:d02b4d7392fe6011"
msgstr "Un Ralari attendait à Nav 1. Un destroyer de plus à la casse, monsieur."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/8"
msgid "wc1:ed84c5ee219229fe"
msgstr "Un Ralari attendait à Nav 1. Impossible d'avoir ce destroyer, monsieur."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/9"
msgid "wc1:493c415ae1591a24"
msgstr "Et nous avons pu entrer en contact avec le Dralthi capturé pour le conduire ici."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/10"
msgid "wc1:25f24db5264ce217"
msgstr "Et j'ai pu entrer en contact avec le Dralthi capturé pour le conduire ici."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/11"
msgid "wc1:c04d54c40fae9160"
msgstr "Et nous n'avons pas pu trouver le Dralthi capturé, Colonel."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/12"
msgid "wc1:f2b24bea5bf1877d"
msgstr "Et je n'ai pas pu trouver le Dralthi capturé, Colonel."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/13"
msgid "wc1:939ec2009894a41b $N"
msgstr "On avait besoin de ce Dralthi, $N, on en avait vraiment besoin."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/14"
msgid "wc1:22911a74272bd165"
msgstr "J'espère juste que nous pourrons accomplir notre mission sans ces données."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/15"
msgid "wc1:ffca6820aa4241e1 $C $K"
msgstr "En ce qui concerne votre score, $C, votre journal indique $K."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/16"
msgid "wc1:731fb783c0c287f9 $C"
msgstr "Quant aux nombres... tu as zéro, $C."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/17"
msgid "wc1:c5458a718ff85c0b $L"
msgstr "Et comme d'habitude, Bossman a $L kilrathis."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/18"
msgid "wc1:0c605262109ac723"
msgstr "Et Bossman a zéro."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/19"
msgid "wc1:38a728c6ae08b399"
msgstr "Puis nous l'avons perdu... il va beaucoup nous manquer."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/20"
msgid "wc1:a966dc9f87f351eb $R"
msgstr "$R...passer à mon bureau apres avoir fait une pause."

msgctxt "sm1/BRIEFING.001/packet/13/scene/1/record/21"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/13/scene/2/record/0"
msgid "wc1:ceb586ef035a7782 $C"
msgstr "Bonjour, $C. Les boissons sont pour la maison aujourd'hui."

msgctxt "sm1/BRIEFING.001/packet/13/scene/2/record/1"
msgid "wc1:cf1eeebae7d121c5"
msgstr "Je n'ai pas grand-chose a fêter, tu vois."

msgctxt "sm1/BRIEFING.001/packet/13/scene/2/record/2"
msgid "wc1:08a0872e8d1368f5"
msgstr "Je m'accrochais à ce faible espoir que mon cousin Zach avait réussi..."

msgctxt "sm1/BRIEFING.001/packet/13/scene/2/record/3"
msgid "wc1:85cbeb2615993f18"
msgstr "... que d'une manière ou d'une autre il était vivant, se cachant sur ce Drayman."

msgctxt "sm1/BRIEFING.001/packet/13/scene/2/record/4"
msgid "wc1:cb051e213a966946"
msgstr "Je savais que ce n'était pas vrai, mais je ne pouvais pas m'empêcher d'y penser."

msgctxt "sm1/BRIEFING.001/packet/13/scene/2/record/5"
msgid "wc1:e0598ec7d878dcb6"
msgstr "Ca me rendait fou, mais maintenant je connais la vérité."

msgctxt "sm1/BRIEFING.001/packet/13/scene/2/record/6"
msgid "wc1:c198174ba82c05b1"
msgstr "Tout est fini. Zach est mort."

msgctxt "sm1/BRIEFING.001/packet/13/scene/2/record/7"
msgid "wc1:3f3eb069b01827e9"
msgstr "Aussi mort que tout le monde sur Goddard. Alors les boissons sont pour moi---"

msgctxt "sm1/BRIEFING.001/packet/13/scene/2/record/8"
msgid "wc1:a9c95142407d26dc"
msgstr "---jusqu'a ce que nous soyons tous trop ivres pour y penser."

msgctxt "sm1/BRIEFING.001/packet/13/scene/3/record/0"
msgid "wc1:1f94ffce36e40055 $C"
msgstr "Bonjour, $C. J'ai pensé au Gwenhyvar..."

msgctxt "sm1/BRIEFING.001/packet/13/scene/3/record/1"
msgid "wc1:ea3eac8c20340299"
msgstr "Bossman n'arrête pas de dire que l'Exeter fantôme est réel."

msgctxt "sm1/BRIEFING.001/packet/13/scene/3/record/2"
msgid "wc1:c69cd6eefae0ff9b"
msgstr "Il y a beaucoup de vaisseaux qui ont effectué des missions et dont on n'a plus jamais entendu parler...."

msgctxt "sm1/BRIEFING.001/packet/13/scene/3/record/3"
msgid "wc1:26d6fe203777df2c"
msgstr "...sans vaisseau kilrathi dans la région."

msgctxt "sm1/BRIEFING.001/packet/13/scene/3/record/4"
msgid "wc1:b36d0bf8b62ed2ef"
msgstr "C'est pourquoi je pense que le Gwenhyvar est réel..."

msgctxt "sm1/BRIEFING.001/packet/13/scene/3/record/5"
msgid "wc1:25dfad17186f22db"
msgstr "...et il est là-haut, quelque part."

msgctxt "sm1/BRIEFING.001/packet/13/scene/3/record/6"
msgid "wc1:8d2272260a3add0f"
msgstr "Je pense que tu es fou, Boss."

msgctxt "sm1/BRIEFING.001/packet/13/scene/3/record/7"
msgid "wc1:6774e73924664513"
msgstr "Et toi t'es sain d'esprit, Maniac?"

msgctxt "sm1/BRIEFING.001/packet/13/scene/4/record/0"
msgid "wc1:b11747811ccd670a $C"
msgstr "Hey, $C.  Toujours en vie?"

msgctxt "sm1/BRIEFING.001/packet/13/scene/4/record/1"
msgid "wc1:cbf6ed45917df3b9"
msgstr "J'étais certain que tu allais mourir là-haut aujourd'hui."

msgctxt "sm1/BRIEFING.001/packet/13/scene/4/record/2"
msgid "wc1:2836cad553042efe"
msgstr "Nous allons tous mourir, tu sais. C'est juste une question de temps."

msgctxt "sm1/BRIEFING.001/packet/13/scene/4/record/3"
msgid "wc1:a7ab16e0d929d9f8"
msgstr "Mais je sais que je suis là pour quelque chose. Quelque chose de merveilleux."

msgctxt "sm1/BRIEFING.001/packet/13/scene/4/record/4"
msgid "wc1:239ec642bc4aa0e4"
msgstr "Tout le monde ici me taquine parce que je suis un pilote tête brûlée, et je n'ai pas peur de le dire."

msgctxt "sm1/BRIEFING.001/packet/13/scene/4/record/5"
msgid "wc1:c620d8e0fb1fb31d"
msgstr "Mais ils verront. Ils verront tous..."

msgctxt "sm1/BRIEFING.001/packet/13/scene/4/record/6"
msgid "wc1:78e45585b20e3a3b"
msgstr "...et ils se souviendront de MOI comme l'homme qui a détruit l'arme secrète kilrathi."

msgctxt "sm1/BRIEFING.001/packet/13/scene/4/record/7"
msgid "wc1:2c002bec96cca4d4"
msgstr "Est-ce que ce ne serait pas génial?"

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/0"
msgid "wc1:76835d30c234886b $T $D"
msgstr "Briefing de mission, $T, $D. Espace controlé par les Kilrathis, nom de code 'Jotunheim'."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/1"
msgid "wc1:6d70baf248c5c7f1"
msgstr "Pour commencer, plusieurs d'entre vous ont été réaffectés sur les Raptors."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/2"
msgid "wc1:32e96e5e72b7e49e"
msgstr "Et voici ce qui se passe maintenant...."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/3"
msgid "wc1:581fcda714e1ca86"
msgstr "La flotte que nous suivons a brusquement changé de cap vers un champ d'astéroïdes."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/4"
msgid "wc1:d17afae47feaeb36"
msgstr "Nous avons également reçu une communication codée du dernier vaisseau Reaver survivant."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/5"
msgid "wc1:af39b02dedfd5602"
msgstr "Nous les ramènerons à la maison et télèchargerons les données de leur journal de bord."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/6"
msgid "wc1:4bc70169d60f03ac"
msgstr "Votre mission sera de voler vers plusieurs points de navigation, de trouver le Drayman et de l'escorter jusqu'au Tigre.."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/7"
msgid "wc1:c76a2d4efede89ff"
msgstr "Affectations individuelles des escadrons..."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/8"
msgid "wc1:b0baa70dcd14a940 $C"
msgstr "$C et Spirit, vous serez l'escadron Beta."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/9"
msgid "wc1:2aea8168285ce0c2 $C"
msgstr "$C, vous serez l'escadron Beta."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/10"
msgid "wc1:7a7bf42640c609e7 $C"
msgstr "Spirit, essaie de garder $C hors des problèmes."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/11"
msgid "wc1:baf7bdd91570b500"
msgstr "Je ferai tout mon possible, Colonel."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/12"
msgid "wc1:241c27e3cfc72686 $C"
msgstr "$C, vérifiez ces trois points de navigation, puis revenez au Tigre. AVEC le Drayman, s'il vous plait."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/13"
msgid "wc1:ff4895828882a00f"
msgstr "Il peut y avoir une activité kilrathi à n'importe quel point de navigation... alors restez vigilant."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/14"
msgid "wc1:3b84f468bf796bf2"
msgstr "Le commandant explique les autres missions aux escadrons."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/15"
msgid "wc1:589aa20d0a2b98e0"
msgstr "C'est bon. Soyez prudent là-bas. Ne bâclez pas vos missions."

msgctxt "sm1/BRIEFING.001/packet/16/scene/0/record/16"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/1"
msgid "wc1:f1bac6b41eb04a0f $C"
msgstr "Bienvenue, $C. J'écoute votre rapport."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/2"
msgid "wc1:03e87a5b014446e3"
msgstr "Nous avons rencontré et abattu un Fralthi à Nav 1, monsieur. Je ne pouvais pas laisser ce genre de vaisseau près de nous."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/3"
msgid "wc1:09151ab01c5ed396"
msgstr "J'ai rencontré et abattu un Fralthi à Nav 1, monsieur. Je ne pouvais pas laisser ce genre de vaisseau près de nous."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/4"
msgid "wc1:1b9058f0bd811175"
msgstr "Nous avons rencontré un Fralthi, Colonel, et avons essayé de le détruire sans succés."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/5"
msgid "wc1:fdc8aa1b74a975cc"
msgstr "J'ai rencontré un Fralthi, Colonel, et j'ai essayé de le détruire sans succés."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/6"
msgid "wc1:465be05c3cdbb26a"
msgstr "Et nous avons rencontré le Drayman à Nav 3. Ils devraient s'amarrer à l'instant."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/7"
msgid "wc1:a10a64a7c3130677"
msgstr "Et j'ai rencontré le Drayman à Nav 3. Ils devraient s'amarrer à l'instant."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/8"
msgid "wc1:d848d96459447739"
msgstr "J'ai fait de mon mieux, monsieur... mais nous avons perdu le Drayman."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/9"
msgid "wc1:c27f729639cab026"
msgstr "J'ai fait de mon mieux, monsieur... mais j'ai perdu le Drayman."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/10"
msgid "wc1:93e8a58454bda60c $R"
msgstr "Savez-vous combien de soldats étaient sur ce Drayman, $R?"

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/11"
msgid "wc1:e4f48e36a3003d66"
msgstr "Après ce débriefing, je ne veux plus voir votre gueule pendant un moment."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/12"
msgid "wc1:1fab9ffa9840631e $K $C"
msgstr "Votre enregistreur de vol dit que vous en avez tué $K, $C."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/13"
msgid "wc1:947671ecb5934040"
msgstr "L'enregistreur dit que vous n'avez rien eu, zéro victime."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/14"
msgid "wc1:8678bfaf3f895857 $L"
msgstr "Spirit a $L kilrathis confirmés."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/15"
msgid "wc1:641f45c5feebe23b"
msgstr "Spirit n'a pas réussi à avoir de chat."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/16"
msgid "wc1:98cbbe334401fa75"
msgstr "Puis nous l'avons perdue, qu'ils soient tous maudits."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/17"
msgid "wc1:0038934f577cf459"
msgstr "Je n'aurais jamais du l'envoyer là-bas, sachant qu'elle pensait à son fiancé sur Epsilon..."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/18"
msgid "wc1:aa3c1eca48dc1204"
msgstr "...et non à la bataille."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/19"
msgid "wc1:dce17e2431371ebf $N"
msgstr "D'accord, $N, reposez-vous."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/20"
msgid "wc1:73f417ac4bc9553f"
msgstr "J'aurai besoin de vous voir plus tard, dans mon bureau."

msgctxt "sm1/BRIEFING.001/packet/16/scene/1/record/21"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/16/scene/2/record/0"
msgid "wc1:6d469f7f844fc770 $R $C"
msgstr "Salut, $R$C. Je vais te verser un bon verre."

msgctxt "sm1/BRIEFING.001/packet/16/scene/2/record/1"
msgid "wc1:1cba4a1e3b758ae4"
msgstr "On dirait que tu t'en sors bien."

msgctxt "sm1/BRIEFING.001/packet/16/scene/2/record/2"
msgid "wc1:338edb57b20b9342"
msgstr "Je n'arrête pas de penser, nous sommes tellement seuls ici."

msgctxt "sm1/BRIEFING.001/packet/16/scene/2/record/3"
msgid "wc1:092e4b6ce723e6d7"
msgstr "Le Griffe du Tigre pourrait être détruit et personne ne saurait ce qui s'est réellement passé."

msgctxt "sm1/BRIEFING.001/packet/16/scene/2/record/4"
msgid "wc1:b1b876d87d817f8c $C"
msgstr "Désolé, $C. Je suis fatigué, je n'ai pas beaucoup dormi ces derniers temps. Laisse-moi te servir ce verre."

msgctxt "sm1/BRIEFING.001/packet/16/scene/3/record/0"
msgid "wc1:aa8f7a12ac3a579d $C"
msgstr "Laisse-moi te dire, $C, j'ai un mauvais pressentiment à propos de cette campagne."

msgctxt "sm1/BRIEFING.001/packet/16/scene/3/record/1"
msgid "wc1:8c9664a1dcd10683"
msgstr "Un VRAI mauvais pressentiment."

msgctxt "sm1/BRIEFING.001/packet/16/scene/3/record/2"
msgid "wc1:d2e4c5bb3f96dc5f"
msgstr "Tout le monde devient de plus en plus tendu, plus nous avancons dans l'espace kilrathi."

msgctxt "sm1/BRIEFING.001/packet/16/scene/3/record/3"
msgid "wc1:6fdb30cd42aa15a5"
msgstr "Maniac n'est pas le seul à être sur la corde raide."

msgctxt "sm1/BRIEFING.001/packet/16/scene/3/record/4"
msgid "wc1:b4ec9967a1279cbe"
msgstr "Et je n'arrête pas d'entendre des rumeurs disant que c'est une mission suicide..."

msgctxt "sm1/BRIEFING.001/packet/16/scene/3/record/5"
msgid "wc1:b7825a16bfca3aea"
msgstr "... que nous ne sommes pas censés revenir."

msgctxt "sm1/BRIEFING.001/packet/16/scene/3/record/6"
msgid "wc1:04016747f64f9652"
msgstr "Penses-tu que ce soit vrai? Non, ça doit être faux."

msgctxt "sm1/BRIEFING.001/packet/16/scene/3/record/7"
msgid "wc1:a01d7d67faf43095"
msgstr "Le colonel ne nous ferait pas ca...."

msgctxt "sm1/BRIEFING.001/packet/16/scene/3/record/8"
msgid "wc1:02967f90d43215ba"
msgstr "...quoi que?"

msgctxt "sm1/BRIEFING.001/packet/16/scene/4/record/0"
msgid "wc1:74f38086a1a9b587 $C"
msgstr "Viens me rejoindre pour boire un verre, $C?"

msgctxt "sm1/BRIEFING.001/packet/16/scene/4/record/1"
msgid "wc1:2b56f18501ddd596"
msgstr "Je n'ai plus de nouvelles de la station Epsilon, ni de mon fiancé."

msgctxt "sm1/BRIEFING.001/packet/16/scene/4/record/2"
msgid "wc1:46ea8907a8512239"
msgstr "Mais je ne penserais pas à celà maintenant. Shotglass pense que nous pourrions voler dans les champs d'astéroïdes aujourd'hui."

msgctxt "sm1/BRIEFING.001/packet/16/scene/4/record/3"
msgid "wc1:f1d1e566c723aed7"
msgstr "J'espère qu'il a raison. Il y a quelque chose que je souhaite essayer."

msgctxt "sm1/BRIEFING.001/packet/16/scene/4/record/4"
msgid "wc1:ba5a6820f9488bc4"
msgstr "Tu as déjà vu Iceman dans un champ d'astéroïdes ? Non?"

msgctxt "sm1/BRIEFING.001/packet/16/scene/4/record/5"
msgid "wc1:87e3c0dabc9c829b"
msgstr "Il fait des choses incroyables."

msgctxt "sm1/BRIEFING.001/packet/16/scene/4/record/6"
msgid "wc1:8a1bdb7d41c15161"
msgstr "Si son bouclier avant est HS, il tourne son appareil..."

msgctxt "sm1/BRIEFING.001/packet/16/scene/4/record/7"
msgid "wc1:c099664f49781608"
msgstr "... et laisse son ennemi venir derrière lui."

msgctxt "sm1/BRIEFING.001/packet/16/scene/4/record/8"
msgid "wc1:0af7357e42dc276a"
msgstr "Il effectue des manoeuvres d'évitement, utilise ses propulseurs..."

msgctxt "sm1/BRIEFING.001/packet/16/scene/4/record/9"
msgid "wc1:7cfa77b9512b9f0e"
msgstr "... et met le cap sur un gros astéroïde."

msgctxt "sm1/BRIEFING.001/packet/16/scene/4/record/10"
msgid "wc1:ce3d1596bb206761"
msgstr "Au dernier moment, il vire de bord."

msgctxt "sm1/BRIEFING.001/packet/16/scene/4/record/11"
msgid "wc1:1b49f39c091c9147"
msgstr "Les Kilrathis se prennent l'astéroïde le plus souvent."

msgctxt "sm1/BRIEFING.001/packet/16/scene/4/record/12"
msgid "wc1:c75ab5f2596e858c"
msgstr "Bien sur, Iceman préfère le faire en Hornet ou Rapier, pas avec des Raptors."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/0"
msgid "wc1:04374cc5c2ec3630 $T $D"
msgstr "Briefing de mission, $T, $D. Espace controlé par les Kilrathis, nom de code 'Jotunheim'."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/1"
msgid "wc1:36e29f985276c356"
msgstr "Pilotes, on joue au chat et à la souris."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/2"
msgid "wc1:8b2c96cbbd43c683"
msgstr "Après avoir emprunté une piste lente dans les champs d'astéroïdes..."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/3"
msgid "wc1:71da80dbb4c61f92"
msgstr "... notre cible a maintenant atteint sa vitesse de croisière et a suivi une trajectoire rectiligne."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/4"
msgid "wc1:d64aa5f03e2825ff"
msgstr "Nous n'avons aucune raison de suivre cette tactique, à moins qu'ils ne nous mènent dans une embuscade."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/5"
msgid "wc1:1f155eef1ed988f7"
msgstr "Et nous allons les suivre, droit dans leur piège."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/6"
msgid "wc1:c2b307aa9d723731"
msgstr "Qu'allons nous faire, monsieur?"

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/7"
msgid "wc1:5c3962b775770d92"
msgstr "On va mordre à l'hameçon, pilotes, mais à nos conditions."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/8"
msgid "wc1:c59eaf133540bcd3"
msgstr "Nous allons lancer tous les escadrons de chasse..."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/9"
msgid "wc1:c3ef39cb90f68ec9"
msgstr "...sur différentes routes à travers les champs d'astéroïdes."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/10"
msgid "wc1:f2b6fa9b6c929e84"
msgstr "...L'intelligence pense que l'embuscade est à Nav 3..."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/11"
msgid "wc1:42af0bec80fde22a"
msgstr "Les escadrons voyageront via Nav 1 à travers les astéroïdes et Nav 2..."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/12"
msgid "wc1:2f691f5a9b249b87"
msgstr "Et allez à l'embuscade de Nav 3. Détruisez-les et revenez."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/13"
msgid "wc1:bdd2e7caeb7c49ed"
msgstr "Affectations d'escadrons. Le même que la dernière fois..."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/14"
msgid "wc1:1720d391986a3c4c"
msgstr "Le colonel énumère rapidement les missions, y compris la votre:"

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/15"
msgid "wc1:d9ec29ca96c35cfb $C"
msgstr "Escadron Alpha, $C et Spirit."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/16"
msgid "wc1:1ea9dacc575a0842 $C"
msgstr "$C, vous êtes tout seul cette fois."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/17"
msgid "wc1:0e3bad01b2ca3a17"
msgstr "Des questions? Qu'est-ce qu'il y a, Taggart?"

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/18"
msgid "wc1:88001bd613402397"
msgstr "Colonel, les autres pilotes et moi pensons que Maniac n'est pas apte au travail."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/19"
msgid "wc1:30276ca7ed6ef395"
msgstr "Maniac, Qu'est-ce que vous avez à dire à ce sujet?"

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/20"
msgid "wc1:ce234c5f94dc4c4c"
msgstr "Monsieur, si je ne peux pas voler, alors je ne suis rien. Je prefère être mort. S'il vous plait ne me punissez pas."

msgctxt "sm1/BRIEFING.001/packet/17/scene/0/record/21"
msgid "wc1:f0fe9179596cc1eb"
msgstr "Très bien, allez-y. Rompez."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/1"
msgid "wc1:46e39312eb2600dc $C"
msgstr "Ils analysent toujours les données de votre enregistreur de vol, $C. Mais j'aimerais entendre votre rapport maintenant."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/2"
msgid "wc1:f4346ea3f27e6ead"
msgstr "Un vaisseau de communication de classe Dorkir traversait Nav 1. Il est en miette, monsieur."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/3"
msgid "wc1:c3c29b0cd45f9f7b"
msgstr "Excellent! Cela va paralyser leurs rapports de renseignement."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/4"
msgid "wc1:334466a9a69dbe3a"
msgstr "Un vaisseau de classe Dorkir traversait Nav 1, monsieur, mais j'ai bien peur qu'il ne se soit échappé."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/5"
msgid "wc1:37f37f667891e939"
msgstr "Ensuite, nous avons jeté notre dévolu sur un Fralthi, monsieur, et l'avons abattu."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/6"
msgid "wc1:47116bccf01f737e"
msgstr "Ensuite, j'ai jeté mon dévolu sur un Fralthi, monsieur, et je l'ai abattu."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/7"
msgid "wc1:1e12bdd322df752f"
msgstr "Après nous ne pouvions pas faire exploser le Fralthi, Colonel."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/8"
msgid "wc1:a52d1eb94b068c00"
msgstr "Après je ne pouvais pas faire exploser le Fralthi, Colonel."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/9"
msgid "wc1:6966cacff382e09b $R"
msgstr "J'espère que les autres escadrons feront mieux que vous, $R."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/10"
msgid "wc1:f0ab1dd0fa104a00 $K $C"
msgstr "Vous avez $K ennemis, $C."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/11"
msgid "wc1:d4db1393aeb63ef2 $R"
msgstr "Votre enregistreur de vol ne montre aucun ennemi, $R."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/12"
msgid "wc1:9b3a2f70ff143138 $L"
msgstr "Spirit a $L Kilrathis."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/13"
msgid "wc1:3c93e63521143049"
msgstr "Spirit n'a eu aucun Kilrathi."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/14"
msgid "wc1:98cbbe334401fa75"
msgstr "Puis nous l'avons perdue, qu'ils soient tous maudits."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/15"
msgid "wc1:0038934f577cf459"
msgstr "Je n'aurais jamais du l'envoyer là-bas, sachant qu'elle pensait a son fiancé sur Epsilon..."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/16"
msgid "wc1:1919f221e3c94408"
msgstr "Et pas à la bataille."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/17"
msgid "wc1:a5182b65bc07f2d8"
msgstr "Très bien. Détendez-vous un moment, tous les deux."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/18"
msgid "wc1:4bf7b32dd22401b7"
msgstr "Très bien. Détendez-vous pendant un moment."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/19"
msgid "wc1:2cd80d81606e4657 $C"
msgstr "Et puis je veux vous voir dans mon bureau, $C."

msgctxt "sm1/BRIEFING.001/packet/17/scene/1/record/20"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/17/scene/2/record/0"
msgid "wc1:01205d3d42733bfd $C"
msgstr "Salut, $C. As-tu des infos?"

msgctxt "sm1/BRIEFING.001/packet/17/scene/2/record/1"
msgid "wc1:6a8e79d03054b9cb"
msgstr "Je suis assis ici depuis des heures et des heures....Je n'ai rien entendu."

msgctxt "sm1/BRIEFING.001/packet/17/scene/2/record/2"
msgid "wc1:ccf4840978c523cb"
msgstr "Juste à attendre. Ca commencé à me rendre un peu fou. Certains pilotes aussi."

msgctxt "sm1/BRIEFING.001/packet/17/scene/2/record/3"
msgid "wc1:cee5463c5c6ec260"
msgstr "Je n'arrête pas de dire aux pilotes de ne pas s'inquièter, le colonel sait ce qu'il fait..."

msgctxt "sm1/BRIEFING.001/packet/17/scene/2/record/4"
msgid "wc1:c4b64aefde4c8ea9"
msgstr "... mais j'espère qu'il le sait?"

msgctxt "sm1/BRIEFING.001/packet/17/scene/3/record/0"
msgid "wc1:8759e1d42a9db8db $C"
msgstr "Bonjour, $C. J'ai entendu dire que tu as eu beaucoup d'action aujourd'hui."

msgctxt "sm1/BRIEFING.001/packet/17/scene/3/record/1"
msgid "wc1:60a5dda10f724620"
msgstr "Les Kilrathis utilisent des tactiques très intelligentes contre nous. J'ai recalculé nos chances de survis pour cette mission."

msgctxt "sm1/BRIEFING.001/packet/17/scene/3/record/2"
msgid "wc1:50b82badfaba3b6b"
msgstr "J'aimerais que tu ne sois pas si admirative, gamine."

msgctxt "sm1/BRIEFING.001/packet/17/scene/3/record/3"
msgid "wc1:9cfe98d37e304ff9"
msgstr "Leur intelligence nous tue, un par un."

msgctxt "sm1/BRIEFING.001/packet/17/scene/3/record/4"
msgid "wc1:e5d357f0cea8e3fd"
msgstr "Nous sommes peut-être leurs ennemis, mais nous ne pouvons pas ignorer leurs forces."

msgctxt "sm1/BRIEFING.001/packet/17/scene/3/record/5"
msgid "wc1:810afcab42843f87"
msgstr "Ils connaissent cette zone de l'espace. Ils sont intelligents et tenaces."

msgctxt "sm1/BRIEFING.001/packet/17/scene/3/record/6"
msgid "wc1:40994703a78f6c65"
msgstr "Oui, mais plus nous sommes ici, mieux nous connaissons cette partie de l'espace."

msgctxt "sm1/BRIEFING.001/packet/17/scene/3/record/7"
msgid "wc1:4cc1a0e1c6785391"
msgstr "Et nous sommes aussi intelligents et tenaces."

msgctxt "sm1/BRIEFING.001/packet/17/scene/3/record/8"
msgid "wc1:76eeb56d36f8c1fb"
msgstr "Nous devenons comme eux. Comme des Kilrathis...."

msgctxt "sm1/BRIEFING.001/packet/17/scene/3/record/9"
msgid "wc1:57986e9be6b56214"
msgstr "Mais nous survivrons, Taggart, et c'est ce qui compte."

msgctxt "sm1/BRIEFING.001/packet/17/scene/3/record/10"
msgid "wc1:f777f1b464a0d051 $C"
msgstr "Mais nous survivrons, $C, et c'est ce qui compte."

msgctxt "sm1/BRIEFING.001/packet/17/scene/4/record/0"
msgid "wc1:d89bb4b5c2113ef9"
msgstr "Assieds-toi, mon garcon. As-tu entendu les dernières nouvelles de l'intelligence?"

msgctxt "sm1/BRIEFING.001/packet/17/scene/4/record/1"
msgid "wc1:6356be458be81bc8"
msgstr "Ils ont terminé leur analyse informatique de l'arme secrète kilrathi."

msgctxt "sm1/BRIEFING.001/packet/17/scene/4/record/2"
msgid "wc1:2fe07f5895cd5945"
msgstr "Il n'y a rien que nous puissions faire pour dévier ce maudit blaster d'énergie---"

msgctxt "sm1/BRIEFING.001/packet/17/scene/4/record/3"
msgid "wc1:528724361b7041d8"
msgstr "---une fois qu'ils l'ont dirigé vers une planète, mais---"

msgctxt "sm1/BRIEFING.001/packet/17/scene/4/record/4"
msgid "wc1:0366fd46bd88d7c1"
msgstr "---nous n'avons pas besoin de nous soucier contre nos vaisseaux."

msgctxt "sm1/BRIEFING.001/packet/17/scene/4/record/5"
msgid "wc1:5a335c6d53466069"
msgstr "L'intelligence dit que l'arme serait inutile contre des chasseurs ou vaisseau spatial comme le Tigre."

msgctxt "sm1/BRIEFING.001/packet/17/scene/4/record/6"
msgid "wc1:3833860f4a7a7846"
msgstr "Nous serions hors de portée avant que les chats aient fini de le cibler."

msgctxt "sm1/BRIEFING.001/packet/17/scene/4/record/7"
msgid "wc1:119d68b0f3e4efd3"
msgstr "C'est un peu rassurant, n'est-ce pas?"

msgctxt "sm1/BRIEFING.001/packet/17/scene/4/record/8"
msgid "wc1:513c1157bab63ebf"
msgstr "Les gars de l'intelligence sont impressionnants, la façon dont ils comprennent les choses sur leurs ordinateurs."

msgctxt "sm1/BRIEFING.001/packet/17/scene/4/record/9"
msgid "wc1:a3737b213068c8b8"
msgstr "Bien sur, leurs suppositions ne soient pas toujours correctes...."

msgctxt "sm1/BRIEFING.001/packet/17/scene/4/record/10"
msgid "wc1:d4619fa5d2ad467a"
msgstr "Comme la fois, ou ils ont dit que les nouveaux vaisseaux Dralthis n'auraient pas assez de carburant pour attaquer---"

msgctxt "sm1/BRIEFING.001/packet/17/scene/4/record/11"
msgid "wc1:d8066bf3c426c932"
msgstr "---le système Epsilon Prima. Nous avons perdu cinq pilotes à cause de cette erreur."

msgctxt "sm1/BRIEFING.001/packet/17/scene/4/record/12"
msgid "wc1:72c220d508576e45"
msgstr "L'intelligence est généralement très précise..."

msgctxt "sm1/BRIEFING.001/packet/17/scene/4/record/13"
msgid "wc1:1a544d7d0f3d94c8"
msgstr "...mais je ne parierais pas ma vie la-dessus, mon gars."

msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/0"
msgid "wc1:f79b618b9f8379a7 $T $D"
msgstr "Briefing de mission, $T, $D."

msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/1"
msgid "wc1:57722e999ede76d0"
msgstr "Silence, tout le monde. Nous avons une situation d'urgence ici."

msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/2"
msgid "wc1:eed4339289347e8f"
msgstr "Nous avons reçu un appel de détresse du Johann, un vaisseau de classe Exeter---"

msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/3"
msgid "wc1:c3aa6a3cb60eef0b"
msgstr "---qui a été attaqué par les Kilrathis il y a plusieurs heures."

msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/4"
msgid "wc1:8b07718a82b2735b"
msgstr "Ils ont derivé jusqu'en territoire kilrathi. J'ai besoin de quelqu'un pour les protéger pendant qu'ils terminent---"

msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/5"
msgid "wc1:644abf9ec75c7c70"
msgstr "---les réparations pour qu'ils puissent atteindre le Griffe du Tigre."

msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/6"
msgid "wc1:2e9d017f006c61ea"
msgstr "Malheureusement, j'ai aussi besoin de la plupart d'entre vous ici pour proteger le Tigre d'une possible embuscade."

#. wc1-re: restore campaign substitution tokens from the original record.
msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/7"
msgid "wc1:06a836feb0637faf $C"
msgstr "$C et moi pouvons nous occuper de cette mission, Colonel."

msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/8"
msgid "wc1:abadb4b430704b75"
msgstr "Je peux m'occuper de cette mission, Colonel."

msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/9"
msgid "wc1:67ea948e1280d7ad"
msgstr "Bon. Voici vos données de mission...."

msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/10"
msgid "wc1:b3ff2151483ce8fc"
msgstr "Vous allez immédiatement à Nav 1."

msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/11"
msgid "wc1:4c8c0885a210fcbe"
msgstr "Si le Johann a dépassé ce point, interceptez-le à Nav 2."

msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/12"
msgid "wc1:999ce96067000952"
msgstr "Défendez-les contre les Kilrathis dans la région pendant qu'ils réparent leur vaisseau...."

msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/13"
msgid "wc1:54c6b4631d069736"
msgstr "Et puis escortez-les jusqu'au Griffe du Tigre."

msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/14"
msgid "wc1:31d41690e95b1371"
msgstr "Le colonel affecte les autres escadrons sur différentes patrouilles."

msgctxt "sm1/BRIEFING.001/packet/18/scene/0/record/15"
msgid "wc1:1f3ef547124d7b7f"
msgstr "C'est tout. Pilotes, préparez-vous pour le lancement."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Mission Débriefing -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/1"
msgid "wc1:de0c7abed697195b $C"
msgstr "Je suis TRES curieux d'entendre votre rapport, $C. Ou est le Johann ? Pourquoi diable ne l'avez-vous pas ramené?"

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/2"
msgid "wc1:a69006d43705ffa9"
msgstr "On n'a pas pu aller au Johann, monsieur. Il y avait tout simplement trop de chasseurs kilrathis."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/3"
msgid "wc1:9cff4570de6104bc"
msgstr "Je n'ai pas pu aller au Johann, monsieur. Il y avait tout simplement trop de chasseurs kilrathis."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/4"
msgid "wc1:9189493b58c0b25d"
msgstr "Ce n'était pas le Johann qui nous attendait à Nav 2, monsieur. C'était le Gwenhyvar."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/5"
msgid "wc1:7fa9fdb83e86b643"
msgstr "Ce n'était pas le Johann qui m'attendait à Nav 2, monsieur. C'était le Gwenhyvar."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/6"
msgid "wc1:7d5ca934864f0c34 $N"
msgstr "Le Gwenhyvar ! Je n'aurais jamais imaginé que cette histoire soit vraie. Que s'est-il passé, $N?"

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/7"
msgid "wc1:f81bd95d18e6fe34"
msgstr "Il était réel, monsieur, et ils ont essayé de nous tuer. Mais c'est réglé maintenant."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/8"
msgid "wc1:14ad952fa04e9696"
msgstr "Il était réel, monsieur, et ils ont essayé de me tuer. Mais c'est réglé maintenant."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/9"
msgid "wc1:e47f167e5c998eac"
msgstr "Il est réel, monsieur, et ils ont essayé de nous tuer. Mais il s'est échappé... nous ne pouvions pas le détruire."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/10"
msgid "wc1:afe5dc4b52889be9"
msgstr "Il est réel, monsieur, et ils ont essayé de me tuer. Mais il s'est échappé... je n'ai pas pu le détruire."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/11"
msgid "wc1:1f8982a6c7ed0881 $K $C"
msgstr "Eh bien, voici les informations de votre enregistreur. Vous avez tué $K chats, $C."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/12"
msgid "wc1:a3d8f6cb225b6a8a $R"
msgstr "Vous n'avez pas réussi a tué de Kilrathi, $R."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/13"
msgid "wc1:9b3a2f70ff143138 $L"
msgstr "Spirit a $L Kilrathis."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/14"
msgid "wc1:3c93e63521143049"
msgstr "Spirit n'a pas eu de Kilrathi."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/15"
msgid "wc1:98cbbe334401fa75"
msgstr "Puis nous l'avons perdue, qu'ils soient tous maudits."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/16"
msgid "wc1:0038934f577cf459"
msgstr "Je n'aurais jamais du l'envoyer là-bas, sachant qu'elle pensait a son fiancé sur Epsilon..."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/17"
msgid "wc1:1919f221e3c94408"
msgstr "Et pas à la bataille."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/18"
msgid "wc1:50a6b23c6e4be760"
msgstr "Bien, prenez du repos."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/19"
msgid "wc1:1aca20f2b2dbb694 $C"
msgstr "J'ai besoin de vous voir dans mon bureau plus tard, $C."

msgctxt "sm1/BRIEFING.001/packet/18/scene/1/record/20"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/18/scene/2/record/0"
msgid "wc1:a25ac393dd100b8a $C"
msgstr "Hey, $C ! Le bar est fermé... le colonel a besoin de tous les pilotes au briefing, tout de suite."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/0"
msgid "wc1:59471d17b9f5c867 $T $D"
msgstr "Briefing de mission, $T, $D, quelque part dans l'espace kilrathi."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/1"
msgid "wc1:2e10ccc5a0adc39e"
msgstr "Pilotes, nous avons suivi notre cible jusqu'à ce système."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/2"
msgid "wc1:02e80b2c89957684"
msgstr "L'emplacement de la flotte kilrathi avec l'arme secrète reste inconnu, mais ils sont présents dans la région."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/3"
msgid "wc1:d676f7b170ee5e4a"
msgstr "La flotte va probablement appeler des renforts. Peut-être un Fralthi, avec escorte de destroyers."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/4"
msgid "wc1:c80dd67949309853"
msgstr "Deux Fralthis avec des vaisseaux lourds, savent ou nous sommes..."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/5"
msgid "wc1:f8b0a3341b1a6b8a"
msgstr "... et veulent réduire le Griffe du Tigre en miette."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/6"
msgid "wc1:d2764f69b8eb229d"
msgstr "Personnellement, je prefèrerais ne pas commander un vaisseau en miette."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/7"
msgid "wc1:a1625ee65713d45f"
msgstr "Nous allons donc devoir lancer une attaque contre eux, très bientôt."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/8"
msgid "wc1:15bb6a9cb12d1cc6"
msgstr "Nous ne savons pas exactement où ils se trouvent. Mais nous avons de bonnes données...."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/9"
msgid "wc1:a4fbcc3076b8305c"
msgstr "La flotte de frappe est composée de vaisseaux rapides et maniables, mais leur autonomie en carburant reste limitée."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/10"
msgid "wc1:0a17973778a4faab"
msgstr "Et qu'ils se dirigent probablement vers... vous savez où pilotes?"

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/11"
msgid "wc1:9dc0d6b9b1fe2a8e"
msgstr "Un depot de ravitaillement, monsieur?"

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/12"
msgid "wc1:f698c6f4c08c2cb7 $C"
msgstr "Oui et l'intelligence est d'accord avec nous, $C. C'est la que nous pensons que leur flotte se dirige."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/13"
msgid "wc1:9d1f032c238a09f0"
msgstr "Nous allons d'abord nous rendre au dépôt de ravitaillement pour le détruire."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/14"
msgid "wc1:9765c38f8ab72af1"
msgstr "Vous allez effectuer des missions de reconnaissance. Avec les informations que vous rapporterez..."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/15"
msgid "wc1:328a0cdd840cfd70"
msgstr "...nous devrions être en mesure de localiser le depôt d'approvisionnement."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/16"
msgid "wc1:340f0713fff42150"
msgstr "Voici la configuration. Assurez-vous d'aller sur chacun de ces points de navigation."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/17"
msgid "wc1:b76cd1283314c74b"
msgstr "Suivez simplement vos plans de vol de mission; engagez l'ennemi si vous les trouvez."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/18"
msgid "wc1:80d6676511a43212"
msgstr "Mais reculez devant une opposition écrasante. Nous avons plus besoin d'informations que de heros morts."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/19"
msgid "wc1:2dae3a86fab8efc6"
msgstr "Nous avons également des rapports non confirmés d'un grand vaisseau de type inconnu."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/20"
msgid "wc1:2c4794ae2dc414a9"
msgstr "Ce vaisseau sera enregistré comme cible bleue, jusqu'à ce que nous puissions mettre à jour vos ordinateurs de ciblage."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/21"
msgid "wc1:513055ebc19eaa4f"
msgstr "Mais c'est certainement l'un des leurs. Obtenez des informations avec la caméra, si vous le pouvez."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/22"
msgid "wc1:21972370741fd236"
msgstr "Vous écoutez le commandant expliquer la mission."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/23"
msgid "wc1:06174b86435d33dd $C $C"
msgstr "Escadron Psi sera $C et Paladin, avec $C comme chef."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/24"
msgid "wc1:834caa439697729c $C $R"
msgstr "Escadron Psi sera $C. Bonne chance, $R."

msgctxt "sm1/BRIEFING.001/packet/20/scene/0/record/25"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/1"
msgid "wc1:fe0d5cee5679d018 $C"
msgstr "Bien, $C. Votre rapport, s'il vous plait."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/2"
msgid "wc1:9d923c75c62ba5e4"
msgstr "Nous avons eu une rude bagarre à Nav 2, monsieur, mais nous avons trouvé un Ralari."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/3"
msgid "wc1:3f9a243bb278ee6e"
msgstr "J'ai eu un dur combat à Nav 2, monsieur, mais j'ai trouvé un Ralari."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/4"
msgid "wc1:14a693034aa4d440"
msgstr "Nous n'avons pas pu avoir le Ralari à Nav 2... Je recommande d'éviter cette zone."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/5"
msgid "wc1:e41eec5af32e40d9"
msgstr "Je n'ai pas pu avoir le Ralari à Nav 2... Je recommande d'éviter cette zone."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/6"
msgid "wc1:405c9c079b892e68"
msgstr "Et nous ne pouvions pas nous approcher suffisamment d'autres vaisseaux capitaux pour les cibler et enregistrer des données, monsieur."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/7"
msgid "wc1:f2784aa6b5d18283"
msgstr "Et je ne pouvais pas m'approcher suffisamment d'autres vaisseaux capitaux pour les cibler et enregistrer des données, monsieur."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/8"
msgid "wc1:29c5bfece5071422"
msgstr "A Nav 3, nous avons trouvé un autre vaisseau capital kilrathi ! Il est énorme et bien armé en plus."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/9"
msgid "wc1:f3d3e02079bceda1"
msgstr "A Nav 3, j'ai trouvé un autre vaisseau capital kilrathi ! Il est énorme, monsieur, bien armé en plus."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/10"
msgid "wc1:9f965dc48addf0de"
msgstr "Nous avons essayé de le détruire, mais avons été forcés de rompre et de revenir."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/11"
msgid "wc1:19410994c809022b"
msgstr "J'ai essayé de le détruire, mais j'ai été obligé de rompre et de revenir."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/12"
msgid "wc1:f6575406c33766a7 $R"
msgstr "Pas mal, $R."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/13"
msgid "wc1:70f5ab08fc011972"
msgstr "Cela devrait nous aider à retrouver ce dépôt de ravitaillement. Bon travail."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/14"
msgid "wc1:04379e1c1b424b81 $K"
msgstr "Et vos chiffres montrent que vous avez $K. Joli tir, fiston."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/15"
msgid "wc1:ce24fa81d3a3f96a $R"
msgstr "Les chiffres disent que vous êtes revenu sans aucune cible, $R."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/16"
msgid "wc1:4bc5ce40bfbffcf7"
msgstr "Peut-être avez-vous besoin de plus d'entrainement."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/17"
msgid "wc1:63a0d5cc42ae1cdd $L"
msgstr "Et Paladin a $L. Bon travail."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/18"
msgid "wc1:b71e9d8fa7f277f2"
msgstr "Paladin n'a rien. Travail baclé pour un si bon pilote."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/19"
msgid "wc1:abf334993ac60cb6"
msgstr "Désolé, monsieur. Je ne sais pas ce qui m'est arrivé là-bas."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/20"
msgid "wc1:2f1eb29d1d5e623c"
msgstr "Et il a été tué dans le combat. Merde... il était si près de prendre sa retraite."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/21"
msgid "wc1:ec676617be76ad91"
msgstr "Je voulais boire à sa fête de depart à la retraite... et voir quelqu'un sortir vivant de cette foutue guerre."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/22"
msgid "wc1:1c5f2a0ca681c54d"
msgstr "Nous allons maintenant obtenir les informations de vos caméras et voir ce que nous pouvons en apprendre."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/23"
msgid "wc1:609ac3fa80fff145 $C"
msgstr "Et $C, j'aurai besoin de vous voir dans mon bureau plus tard."

msgctxt "sm1/BRIEFING.001/packet/20/scene/1/record/24"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/20/scene/2/record/0"
msgid "wc1:8036c5ee5a57b182 $R"
msgstr "$R! Content de te voir."

msgctxt "sm1/BRIEFING.001/packet/20/scene/2/record/1"
msgid "wc1:a377fa810daa574c"
msgstr "Le Gwenhyvar. je n'avais jamais cru à cette vieille légende. jusqu'à maintenant."

msgctxt "sm1/BRIEFING.001/packet/20/scene/2/record/2"
msgid "wc1:d72d76a5302ff865"
msgstr "Quoi qu'il en soit, t'as entendu les dernières nouvelles? Grapevine dit que nous avons perdu de vue les vaisseaux ennemis."

msgctxt "sm1/BRIEFING.001/packet/20/scene/2/record/3"
msgid "wc1:f42f2c79cb28132d"
msgstr "Ils sont là-bas quelque part, et nous ne pouvons pas les trouver."

msgctxt "sm1/BRIEFING.001/packet/20/scene/2/record/4"
msgid "wc1:0f9a1c313552b13a"
msgstr "Nous avons fais tout ce chemin dans l'espace kilrathi, et avons perdu tant de gars..."

msgctxt "sm1/BRIEFING.001/packet/20/scene/2/record/5"
msgid "wc1:32f9b00a25cecd91"
msgstr "...et pourquoi? Pour faire demi-tour maintenant?"

msgctxt "sm1/BRIEFING.001/packet/20/scene/2/record/6"
msgid "wc1:9177931be01da224"
msgstr "Nous ferions mieux de trouver ces chats, de les tuer et de partir d'ici rapidement---"

msgctxt "sm1/BRIEFING.001/packet/20/scene/2/record/7"
msgid "wc1:ebe443832bfb0010"
msgstr "---ou nous allons mourrir pour rien comme mon cousin, et les colons de Goddard."

msgctxt "sm1/BRIEFING.001/packet/20/scene/3/record/0"
msgid "wc1:b35ff917013b211f"
msgstr "Bonjour, mon pote. T'as vu assez d'action?"

msgctxt "sm1/BRIEFING.001/packet/20/scene/3/record/1"
msgid "wc1:9da2b6eca594ddc7"
msgstr "Je disais à Shotglass que l'escadron Zeta a perdu quelques pilotes aujourd'hui."

msgctxt "sm1/BRIEFING.001/packet/20/scene/3/record/2"
msgid "wc1:dff1f5d1fafd8715"
msgstr "Je disais à Shotglass que l'escadron Zeta a perdu quelques pilotes aujourd'hui."

msgctxt "sm1/BRIEFING.001/packet/20/scene/3/record/3"
msgid "wc1:a857ac8741b14df9"
msgstr "L'un d'eux est devenu fou, il a volé droit sur un Fralthi---"

msgctxt "sm1/BRIEFING.001/packet/20/scene/3/record/4"
msgid "wc1:cd1433991810554d"
msgstr "Et s'est craché sur le vaisseau sans même bosseler le fuselage."

msgctxt "sm1/BRIEFING.001/packet/20/scene/3/record/5"
msgid "wc1:90e1acd0b9228bc5"
msgstr "Si nous continuons à perdre des pilotes, nous ne serons plus assez pour voler..."

msgctxt "sm1/BRIEFING.001/packet/20/scene/3/record/6"
msgid "wc1:593c8fed7d8a6c58"
msgstr "...et ce sera fini."

msgctxt "sm1/BRIEFING.001/packet/20/scene/3/record/7"
msgid "wc1:6cb2784a8e70bd1f"
msgstr "Et je disais à ce garçon..."

msgctxt "sm1/BRIEFING.001/packet/20/scene/3/record/8"
msgid "wc1:2ae0578cbbc225a9"
msgstr "Qu'il y a quelques pilotes dans notre PROPRE escadron qui ont besoin de nouvelles combinaisons."

msgctxt "sm1/BRIEFING.001/packet/20/scene/3/record/9"
msgid "wc1:d3acae16c3b4cd16"
msgstr "Avec des couilles en plus."

msgctxt "sm1/BRIEFING.001/packet/20/scene/4/record/0"
msgid "wc1:fbf25055578c1f31"
msgstr "C'est bon de te revoir, mon garçon."

msgctxt "sm1/BRIEFING.001/packet/20/scene/4/record/1"
msgid "wc1:d0b207f7450ddcc5"
msgstr "Ecoute, fais-moi une faveur, veux-tu?"

msgctxt "sm1/BRIEFING.001/packet/20/scene/4/record/2"
msgid "wc1:916e37a1b374cec4"
msgstr "Beaucoup de pilotes ont entendu dire que nous avons perdu la flotte kilrathi."

msgctxt "sm1/BRIEFING.001/packet/20/scene/4/record/3"
msgid "wc1:efa761ad89b8c6dc"
msgstr "Ils s'attendent a ce que nous fassions demi-tour et partons vers l'espace terrien."

msgctxt "sm1/BRIEFING.001/packet/20/scene/4/record/4"
msgid "wc1:44f5ffaec443be7b"
msgstr "Certains d'entre eux ont peur."

msgctxt "sm1/BRIEFING.001/packet/20/scene/4/record/5"
msgid "wc1:de178564cadcff39"
msgstr "D'autres pensent qu'on joue à la roulette russe."

msgctxt "sm1/BRIEFING.001/packet/20/scene/4/record/6"
msgid "wc1:70637dc6e1f3f924"
msgstr "Dis-leurs qu'ils sont fous."

msgctxt "sm1/BRIEFING.001/packet/20/scene/4/record/7"
msgid "wc1:59aa85823d0cf1b4"
msgstr "Le colonel Halcyon est un homme très rusé, le meilleur de la marine spatiale."

msgctxt "sm1/BRIEFING.001/packet/20/scene/4/record/8"
msgid "wc1:58a7c50b5f4a595b"
msgstr "Si quelqu'un peut trouver les Kilrathis, c'est bien lui."

msgctxt "sm1/BRIEFING.001/packet/20/scene/4/record/9"
msgid "wc1:d2b4fdfd475405da"
msgstr "Donc, si quelqu'un te demande, voici ce que tu dois lui dire:"

msgctxt "sm1/BRIEFING.001/packet/20/scene/4/record/10"
msgid "wc1:0d4ea6fb1f3d8546"
msgstr "Cette opération n'est pas terminée, et nous ne l'avons pas encore perdue."

msgctxt "sm1/BRIEFING.001/packet/21/scene/0/record/0"
msgid "wc1:f79b618b9f8379a7 $T $D"
msgstr "Briefing de mission, $T, $D."

msgctxt "sm1/BRIEFING.001/packet/21/scene/0/record/1"
msgid "wc1:950ef964af7beed3"
msgstr "Nous avons beaucoup à faire et seulement peu de temps, donc je vais être bref."

msgctxt "sm1/BRIEFING.001/packet/21/scene/0/record/2"
msgid "wc1:ca90fe1df4c7dd0d"
msgstr "D'abord, vous piloterez des Scimitars... les techniciens réparent les autres vaisseaux."

msgctxt "sm1/BRIEFING.001/packet/21/scene/0/record/3"
msgid "wc1:ed6d77172706c7b4"
msgstr "Et nous avons localisé le quadrant où se trouve le depôt de ravitaillement kilrathi. Votre mission est simple..."

msgctxt "sm1/BRIEFING.001/packet/21/scene/0/record/4"
msgid "wc1:4b9905ac230dadb2"
msgstr "Allez à Nav 1 et 2. Eliminez tous les vaisseaux de guerre kilrathis..."

msgctxt "sm1/BRIEFING.001/packet/21/scene/0/record/5"
msgid "wc1:05ff2cd5ffa489d6"
msgstr "Dirigez-vous ensuite vers le dépôt de Nav 3. Détruisez-le et revenez au Griffe du Tigre."

msgctxt "sm1/BRIEFING.001/packet/21/scene/0/record/6"
msgid "wc1:ccb03f15a32609a6"
msgstr "Mais faites attention. Vous pouvez parier vos vies que le dépôt sera bien gardé."

msgctxt "sm1/BRIEFING.001/packet/21/scene/0/record/7"
msgid "wc1:26f636a103b677c6"
msgstr "Affectations d'escadrons:"

msgctxt "sm1/BRIEFING.001/packet/21/scene/0/record/8"
msgid "wc1:683f778990acb303"
msgstr "Le commandant énumère les autres équipes d'escadron, puis s'adresse à vous:"

msgctxt "sm1/BRIEFING.001/packet/21/scene/0/record/9"
msgid "wc1:8cdffcad82e87320 $C"
msgstr "$C, vous et Paladin êtes à nouveau l'escadron Theta. "

msgctxt "sm1/BRIEFING.001/packet/21/scene/0/record/10"
msgid "wc1:0631fee47994f7be $C"
msgstr "$C, vous êtes l'escadron Theta. J'aurais souhaité que vous ayez Paladin avec vous pour celle-ci."

msgctxt "sm1/BRIEFING.001/packet/21/scene/0/record/11"
msgid "wc1:656eef64eb2c0502"
msgstr "Je volerai pour nous deux, monsieur."

msgctxt "sm1/BRIEFING.001/packet/21/scene/0/record/12"
msgid "wc1:987c4080e9cb985a"
msgstr "Preparez-vous pour un lancement immédiat. Rompez."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/1"
msgid "wc1:83f0683161968136"
msgstr "Votre rapport, escadron theta."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/3"
msgid "wc1:e7e9833d14115c66"
msgstr "Un Lumbari était à Nav 2. Ce tanker est en miette, monsieur."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/4"
msgid "wc1:fa281c0fe5ddadcb"
msgstr "Je n'ai pas pu m'approcher suffisamment du Lumbari à Nav 2... Je suis désolé, monsieur."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/5"
msgid "wc1:beb73aba74e4da7a"
msgstr "Et je ne pouvais pas détruire le dépôt de ravitaillement. Colonel, j'ai fait de mon mieux."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/6"
msgid "wc1:bd16572baecf1fe2"
msgstr "Et puis je me suis dirigé vers le dépôt de ravitaillement."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/7"
msgid "wc1:7a492c48277be089"
msgstr "C'était dur, monsieur. L'une des missions les plus difficiles que j'aie jamais éffectuées."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/8"
msgid "wc1:57b4983c7d24a2d9 $C"
msgstr "Assez de théâtre, $C... Que s'est-il passé?"

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/9"
msgid "wc1:f95784ee875a5c9e"
msgstr "Il est à la casse, monsieur."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/10"
msgid "wc1:00faaea39288d77a $R"
msgstr "Excellent, $R!  Je savais que vous ne nous laisserez pas tomber."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/11"
msgid "wc1:bda2f3b022f2b674 $K"
msgstr "Et vous avez butée $K de ces chats."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/12"
msgid "wc1:5a8c0d4f91e7e4e8 $R"
msgstr "Aucun mort kilrathi confirmé, $R. Vous êtes génèralement meilleur que ça."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/13"
msgid "wc1:a619d393f9c66691 $L"
msgstr "Paladin a $L kilrathis."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/14"
msgid "wc1:1da6704c29d4207d"
msgstr "Paladin a zéro."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/15"
msgid "wc1:8f5837fe4398237d"
msgstr "J'ai fait de mon mieux, monsieur. Les Kilrathis combattaient férocement là-bas."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/16"
msgid "wc1:20cdc1eb5bb26e67"
msgstr "Puis il a été tué dans le combat. Merde... il était si près de prendre sa retraite."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/17"
msgid "wc1:ec676617be76ad91"
msgstr "Je voulais boire à sa fête de départ à la retraite... et voir quelqu'un sortir vivant de cette foutue guerre."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/18"
msgid "wc1:b6a1785282150be4"
msgstr "Juste pour que vous sachiez... un autre escadron a détruit le dépôt de ravitaillement. Mais vous auriez dû le faire vous-même, monsieur."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/19"
msgid "wc1:13aff7e14ad665ed $C"
msgstr "$C, Je dois vous voir dans mon bureau plus tard."

msgctxt "sm1/BRIEFING.001/packet/21/scene/1/record/20"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/21/scene/2/record/0"
msgid "wc1:aeceb2b9296474cf $C"
msgstr "Salut, $C. Voici ta boisson."

msgctxt "sm1/BRIEFING.001/packet/21/scene/2/record/1"
msgid "wc1:1a27c5c6cf11b6a2"
msgstr "J'ai entendu dire que tout le monde avait eu une patrouille difficile."

msgctxt "sm1/BRIEFING.001/packet/21/scene/2/record/2"
msgid "wc1:2a2163c0ec018ab8"
msgstr "Mais Grapevine dit que toute cette activité kilrathi..."

msgctxt "sm1/BRIEFING.001/packet/21/scene/2/record/3"
msgid "wc1:27bd7c80bfe20831"
msgstr "... DOIT signifier qu'il y a une installation à proximité."

msgctxt "sm1/BRIEFING.001/packet/21/scene/2/record/4"
msgid "wc1:dbd7283ba89add85"
msgstr "Si ce n'est pas la station que nous recherchons..."

msgctxt "sm1/BRIEFING.001/packet/21/scene/2/record/5"
msgid "wc1:9f517384c918699d"
msgstr "... ce sera quelque chose d'autre que nous devrons réduire en poussière."

msgctxt "sm1/BRIEFING.001/packet/21/scene/2/record/6"
msgid "wc1:1faa8f1347b82c34 $C"
msgstr "Je veux que tu me tues ces boules de poils aujourd'hui, $C. Pour moi et Zach."

msgctxt "sm1/BRIEFING.001/packet/21/scene/3/record/0"
msgid "wc1:8b875c951b253a77 $C"
msgstr "Bonjour, $C. Prends un siège?"

msgctxt "sm1/BRIEFING.001/packet/21/scene/3/record/1"
msgid "wc1:bbfd0cad2f79069a"
msgstr "Je passais juste en revue les tactiques d'attaque des vaisseaux capitaux."

msgctxt "sm1/BRIEFING.001/packet/21/scene/3/record/2"
msgid "wc1:20522ced7ef92d76"
msgstr "Ralari, Fralthi ou starbase, c'est pareil."

msgctxt "sm1/BRIEFING.001/packet/21/scene/3/record/3"
msgid "wc1:0636a2792446dd2f"
msgstr "S'il y a des défenseurs, élimine-les en premier."

msgctxt "sm1/BRIEFING.001/packet/21/scene/3/record/4"
msgid "wc1:f28397fb341a29e0"
msgstr "Si possible, n'utilise que tes canons sur les défenseurs."

msgctxt "sm1/BRIEFING.001/packet/21/scene/3/record/5"
msgid "wc1:0c6684ce9d7c8dbe"
msgstr "Garde tes missiles pour la cible principale. Tu en auras besoin."

msgctxt "sm1/BRIEFING.001/packet/21/scene/3/record/6"
msgid "wc1:84370ae52ea55112"
msgstr "Essaye dans l'autre sens, et les défenseurs te dévoreront vivant."

msgctxt "sm1/BRIEFING.001/packet/21/scene/4/record/0"
msgid "wc1:d2c5785fa6918d33 $R $N"
msgstr "Bonjour, $R $N. Es-tu venu ici pour me remonter le moral?"

msgctxt "sm1/BRIEFING.001/packet/21/scene/4/record/1"
msgid "wc1:49bab55662f51388"
msgstr "Le colonel pense que je suis déprimée. Ce n'est pas ça."

msgctxt "sm1/BRIEFING.001/packet/21/scene/4/record/2"
msgid "wc1:788869d22d014b78"
msgstr "Nous vivons une époque incertaine. Et j'ai toujours su que la mort est à coté de nous."

msgctxt "sm1/BRIEFING.001/packet/21/scene/4/record/3"
msgid "wc1:2ee83af16b323a1d"
msgstr "Mais si nous détruisons la flotte kilrathi et leur arme secrète, je célèbrerais ça."

msgctxt "sm1/BRIEFING.001/packet/21/scene/4/record/4"
msgid "wc1:796456a9dc05d273"
msgstr "Je vais être ivre, crier fort et agir un peu comme maniac ou Hunter."

msgctxt "sm1/BRIEFING.001/packet/21/scene/4/record/5"
msgid "wc1:2ba08273c825a83e"
msgstr "Au moins une heure ou deux."

msgctxt "sm1/BRIEFING.001/packet/21/scene/4/record/6"
msgid "wc1:791bca14e21780f7"
msgstr "Ou peut-être pas. Si mon fiancé apprenait un tel comportement?"

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/0"
msgid "wc1:24c4a6c91882fc64 $T $D"
msgstr "Briefing de mission, $T, $D. Site du dépôt d'approvisionnement détruit."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/1"
msgid "wc1:a181e9325b193e8e"
msgstr "Hier, deux Killer Bees ont capturé un vaisseau courrier kilrathi, alors que nous attaquions le dépôt de ravitaillement."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/2"
msgid "wc1:95bd2c13a936a3d3"
msgstr "Nous avons maintenant un schéma, datant de moins de deux jours..."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/3"
msgid "wc1:ca3acca8e3cab8fd"
msgstr "... des missions de patrouille et d'attaque kilrathi dans le secteur Vega."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/4"
msgid "wc1:4e65de70536b5dde"
msgstr "Cela signifie que si nous parvenons a rentrer chez nous sains et saufs..."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/5"
msgid "wc1:71dcf50de373bbfe"
msgstr "... nous allons pouvoir vaincre ces chats dans le secteur Vega."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/6"
msgid "wc1:3b761a70e54efc5f"
msgstr "Une salve d'applaudissements et d'acclamations résonnent dans la salle de briefing."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/7"
msgid "wc1:6887d83161183957"
msgstr "L'autre nouvelle est que les Bees ont identifié le vaisseau kilrathi avec l'arme secrète..."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/8"
msgid "wc1:1613cf65f952fcb5"
msgstr "...un super-cuirassé, que nous avons nommé le Sivar."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/9"
msgid "wc1:2af30ab3c9447a59"
msgstr "C'est peut-être le même vaisseau qui a été aperçu par nos pilotes, non loin de notre propre position."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/10"
msgid "wc1:889538a53776d6a2"
msgstr "Ce vaisseau sera notre cible principale, pilotes. Nous allons l'attirer à cet endroit..."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/11"
msgid "wc1:5139fa62a816e16f"
msgstr "Et détruire l'arme secrète kilrathi."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/12"
msgid "wc1:d7c277a8663fbe8b"
msgstr "Mais maintenant, nous devons nous concentrer sur la mission d'aujourd'hui."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/13"
msgid "wc1:1f49f152312fc878"
msgstr "Le Griffe du Tigre est maintenant positionné là où se trouvait la station de dépôt."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/14"
msgid "wc1:598864a96331352f"
msgstr "Cela signifie que nous allons intercepter des vaisseaux sortant d'hypersaut."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/15"
msgid "wc1:15714f0278332a08"
msgstr "Beaucoup d'entre eux seront à court de carburant ou auront désespérement besoin de réparations."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/16"
msgid "wc1:17ffdf770999100f"
msgstr "Mais nous ne pouvons pas parier que tous les vaisseaux entrants seront faciles à détruire."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/17"
msgid "wc1:31d2b37fbd1c699e"
msgstr "Nous ne pouvons pas laisser l'un d'eux prévenir le Sivar de notre présence."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/18"
msgid "wc1:2e5c38d9d6560df6"
msgstr "Alors tirez pour tuer, pilotes. Ignorer TOUTES les communications radio des Kilrathis."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/19"
msgid "wc1:829da3ce65a1f738"
msgstr "Car ils peuvent envoyer une balise de détresse au Sivar..."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/20"
msgid "wc1:e9858fee25fb6082"
msgstr "... pendant qu'ils fassent semblant de négocier."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/21"
msgid "wc1:c7fdf7b59b232c08"
msgstr "Autre bonne nouvelle : vous avez été réaffectés sur des Rapiers pour cette mission."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/22"
msgid "wc1:1fc46eabcbcfd0e2"
msgstr "Il était temps..."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/23"
msgid "wc1:4f01e45786bec85c"
msgstr "Ces missions exigent l'emploi de nos meilleurs chasseurs stellaires, les plus récents."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/24"
msgid "wc1:5142c8615cec6435"
msgstr "Chaque escadron aura une affectation individuelle; Vous attendez votre tour."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/25"
msgid "wc1:5ebe44f1437c9d05"
msgstr "Le colonel affecte les autres escadrons."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/26"
msgid "wc1:9b48f29e0f353464 $C $C"
msgstr "Escadron Sigma pour $C et Iceman, avec $C comme chef."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/27"
msgid "wc1:a8235c4650e4186f $C"
msgstr "Escadron Sigma pour $C, vous serez seul."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/28"
msgid "wc1:17abc2bd711d6101"
msgstr "Vous exécuterez une mission de style comète."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/29"
msgid "wc1:24fbe3d1721ca97e"
msgstr "Déplacez-vous à 1500 klicks autour du Griffe du Tigre..."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/30"
msgid "wc1:e03c3f6461756f81"
msgstr "... si vous voyez des chats, attaquez et tuez-les."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/31"
msgid "wc1:1e846ef3dd569531"
msgstr "Lorsque vous êtes sûr que la zone est dégagée, dirigez-vous à Nav 1."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/32"
msgid "wc1:0b3ca1244833f1e2"
msgstr "Cette zone est l'un des points de saut le plus proche..."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/33"
msgid "wc1:2023fce9be6fd186"
msgstr "... et nous pouvons nous attendre à ce que des Kilrathis apparaissent ici."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/34"
msgid "wc1:45aa8c0e300a7b85"
msgstr "Allez ensuite sur Nav 2, débarrassez les bandits et dirigez-vous vers Nav 3."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/35"
msgid "wc1:84fa7c0fe1894190"
msgstr "Une fois que vous avez éliminé toutes les forces ennemies, retournez au Tigre."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/36"
msgid "wc1:0fe828e22a232350"
msgstr "Dès votre retour, Epsilon se lancera et se dirigera vers Nav 1."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/37"
msgid "wc1:1d9204cfaef12b60"
msgstr "En d'autres termes, nous faisons une rotation constante des escadrons."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/38"
msgid "wc1:ab5f4b2a47f9acfd"
msgstr "Jusqu'à ce que nous sachions d'où vient l'ennemi, ces points de navigation seront sous observation constante."

msgctxt "sm1/BRIEFING.001/packet/24/scene/0/record/39"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/1"
msgid "wc1:3599feaaf55ad4a7 $C"
msgstr "Bienvenue, $C. Votre rapport."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/2"
msgid "wc1:e3aaf89daae79a27 $C"
msgstr "Bienvenue, $C. Merde désolé pour Iceman. Dite-moi ce qui s'est passé."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/3"
msgid "wc1:ba958cf23126962a"
msgstr "Oui Monsieur. à Nav 1, j'ai vu une patrouille de Krant arriver, escortant une paire de tankers."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/4"
msgid "wc1:c7a4c49932ffda4b"
msgstr "De la façon dont ils se déplaçaient, je pense qu'ils manquaient de carburant..."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/5"
msgid "wc1:2ac2f46c0c1230e4"
msgstr "... car un escadron de ravitaillement venaient à leur secours."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/6"
msgid "wc1:aef81306f70a93fd"
msgstr "Les deux tankers sont détruits, colonel."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/8"
msgid "wc1:7c1fa50939309b65"
msgstr "J'ai été gravement endommagé, monsieur, et je n'ai eu aucun des tankers."

#. Reviewed against corrected SM1 record; offsets repaired by SDL data patch.
msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/9"
msgid "wc1:3710cad85fd462cf"
msgstr "Vous plaisantez ! Deux pétroliers mal défendus et vous revenez bredouille."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/10"
msgid "wc1:a2de5bd36ad035a7 $C"
msgstr "Je commence à m'inquièter de vos performances, $C."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/11"
msgid "wc1:704175da91e35b31"
msgstr "Ces boules de poils se sont battues comme le diable, monsieur, mais j'ai quand même eu un des Lumbaris."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/12"
msgid "wc1:a57938236dce9f4a"
msgstr "Un Ralari et son escorte de Grathas traversaient Nav 2."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/13"
msgid "wc1:d349c6d4089834d1"
msgstr "Ils venaient apparemment d'arriver dans ce système."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/14"
msgid "wc1:a5443ae342619d61"
msgstr "Le Ralari est à la casse, monsieur."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/15"
msgid "wc1:904281a24ef38d66"
msgstr "J'ai raté le Ralari, monsieur. Désolé."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/16"
msgid "wc1:9ac7279197f0b11f"
msgstr "Le vrai spectacle était à Nav 3. Un croiseur de classe Fralthi avec une escorte de Jalthis."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/17"
msgid "wc1:f321be57447d4745"
msgstr "Je suppose qu'ils repondaient à un appel de détresse de l'ancien dépôt."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/18"
msgid "wc1:25678e2a814ebb0f"
msgstr "Mais le Fralthi est en flamme."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/19"
msgid "wc1:a7101999a0f0f0d0"
msgstr "Je n'ai pas pu avoir le temps d'abattre le Fralthi. Il est toujours là."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/20"
msgid "wc1:b9a13c83a97492a3 $C"
msgstr "Merveilleux, $C. Je suis content que vous ayez contenu la nouvelle de notre présence."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/21"
msgid "wc1:9c174fcf8b17a0d9"
msgstr "Maintenant, la flotte va probablement continuer sa course actuelle. Bon travail."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/22"
msgid "wc1:efc282853bcf6655 $C"
msgstr "Cette mission est un échec total, $C. Il sont maintenant au courant de notre présence."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/23"
msgid "wc1:4b35217e65e71a25"
msgstr "Leur flotte risque de se dérouter vers un autre système. J'espère que vous êtes content...."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/24"
msgid "wc1:c4eb5efe5831b190"
msgstr "Parce que personnellement..."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/25"
msgid "wc1:a6bcdc73e2f3bd99"
msgstr "...Je suis sur le point de renvoyer votre cul à Proxima Centauri pour de bon!"

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/27"
msgid "wc1:0aa371070c2d8164"
msgstr "Pire encore, Iceman est perdu. Putain de honte."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/28"
msgid "wc1:b0e6142325fbb26d"
msgstr "Nous sommes si près du Sivar... et il ne le verra jamais."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/29"
msgid "wc1:d9a93572bce9d90e $K $C"
msgstr "Vous avez $K, $C."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/30"
msgid "wc1:9b8a88b976d94503"
msgstr "En tout cas, vous n'avez pas eu un seul vaisseau. Pourquoi est-ce que je continue à vous envoyez?"

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/31"
msgid "wc1:260651ea2632b94d $L"
msgstr "Iceman a eu $L. Bon travail."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/32"
msgid "wc1:ee71598f66062848"
msgstr "Iceman n'a rien eu."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/33"
msgid "wc1:b2e283882820a393 $C"
msgstr "Maintenant, avec Iceman mort... je vais devoir compter sur vous, $C, pour faire exploser ce foutu cuirassé."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/34"
msgid "wc1:2f0d906f16b9fcd0 $C"
msgstr "$C, plus tard, rejoignez-moi dans mon bureau."

msgctxt "sm1/BRIEFING.001/packet/24/scene/1/record/35"
msgid "wc1:89a10684b8d3bc69"
msgstr "Disposez!"

msgctxt "sm1/BRIEFING.001/packet/24/scene/2/record/0"
msgid "wc1:dbb9d378b9391d16"
msgstr "Vous les pilotes méritez vraiment une bonne bière!"

msgctxt "sm1/BRIEFING.001/packet/24/scene/2/record/1"
msgid "wc1:97f21eb2d7220612"
msgstr "Détruire cette station de ravitaillement était ce dont tout le monde avait besoin."

msgctxt "sm1/BRIEFING.001/packet/24/scene/2/record/2"
msgid "wc1:0d99a8749ee7db24"
msgstr "T'as remarqué? Il n'y a plus d'alerte..."

msgctxt "sm1/BRIEFING.001/packet/24/scene/2/record/3"
msgid "wc1:41e7cb90938fe42d"
msgstr "...on peut enfin souffler."

msgctxt "sm1/BRIEFING.001/packet/24/scene/2/record/4"
msgid "wc1:b4094b72d574b837"
msgstr "Je pense que nous étions tous a moitié morts jusqu'à ce que cette station brûle."

msgctxt "sm1/BRIEFING.001/packet/24/scene/2/record/5"
msgid "wc1:1efdce13808a47c8"
msgstr "Maintenant, les pilotes ont un espoir. J'espère que nous pourrons gagner."

msgctxt "sm1/BRIEFING.001/packet/24/scene/2/record/6"
msgid "wc1:606e83e8de72c1bd"
msgstr "C'est ce dont ont avaient besoin."

msgctxt "sm1/BRIEFING.001/packet/24/scene/3/record/0"
msgid "wc1:475663053f95ac24 $C"
msgstr "$C! Tout le monde mise sur lequel d'entre nous réussira à détruire le vaisseau de l'arme secrète kilrathi.?"

msgctxt "sm1/BRIEFING.001/packet/24/scene/3/record/1"
msgid "wc1:83bd87b545d74d00"
msgstr "Ce sera quelque chose sur notre dossier militaire."

msgctxt "sm1/BRIEFING.001/packet/24/scene/3/record/2"
msgid "wc1:ba48b117c29ac13e"
msgstr "le Griffe du Tigre est credité de la destruction..."

msgctxt "sm1/BRIEFING.001/packet/24/scene/3/record/3"
msgid "wc1:09c1a0a50c7589b1"
msgstr "... du vaisseau kilrathi qui a anéanti la colonie Goddard.'"

msgctxt "sm1/BRIEFING.001/packet/24/scene/3/record/4"
msgid "wc1:fe9f4782e920bcb7"
msgstr "J'espère que nos gars de l'intelligence auront une idée de l'endroit où il se trouve."

msgctxt "sm1/BRIEFING.001/packet/24/scene/3/record/5"
msgid "wc1:a1e167c425d6a0a8"
msgstr "Je détesterais que d'autres pilotes ..."

msgctxt "sm1/BRIEFING.001/packet/24/scene/3/record/6"
msgid "wc1:3852cd499ea122f9"
msgstr "... d'un autre vaisseau le fasse à notre place!"

msgctxt "sm1/BRIEFING.001/packet/24/scene/4/record/0"
msgid "wc1:01ea3cd270efdf86 $C"
msgstr "Assieds toi, $C."

msgctxt "sm1/BRIEFING.001/packet/24/scene/4/record/1"
msgid "wc1:0dc3836c503952b2"
msgstr "On est sur le fil du rasoir."

msgctxt "sm1/BRIEFING.001/packet/24/scene/4/record/2"
msgid "wc1:d01004b9bfe8e31d"
msgstr "La flotte ennemie se précipite vers nous. droit dans notre piège.."

msgctxt "sm1/BRIEFING.001/packet/24/scene/4/record/3"
msgid "wc1:10d882cfce9f87f0"
msgstr "Je veux ce vaisseau avec l'arme secrète, celle qui a détruit Goddard."

msgctxt "sm1/BRIEFING.001/packet/24/scene/4/record/4"
msgid "wc1:027ba1b198d2b207"
msgstr "Si nous sommes coéquipiers contre ce vaisseau..."

msgctxt "sm1/BRIEFING.001/packet/24/scene/4/record/5"
msgid "wc1:f930a3e0037a4e59"
msgstr "... ne te mets pas entre lui et moi."

msgctxt "sm1/BRIEFING.001/packet/24/scene/4/record/6"
msgid "wc1:21ca65e477129444"
msgstr "Ce vaisseau ira en enfer, quoi qu'il arrive."

msgctxt "sm1/BRIEFING.001/packet/24/scene/4/record/7"
msgid "wc1:16b0d0185e6ba363"
msgstr "Peu importe ce qui va arriver."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/0"
msgid "wc1:2b02e15642d4dc86 $T $D"
msgstr "Briefing de mission, $T, $D. Au plus profond de l'espace kilrathi."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/1"
msgid "wc1:d34a62b1988c7264"
msgstr "Nous avons de bonnes et de mauvaises nouvelles."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/2"
msgid "wc1:70c95c6f0521977a"
msgstr "La bonne nouvelle est que le Sivar est proche. Et il manque de carburant..."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/3"
msgid "wc1:c02682a480aae682"
msgstr "...parce que nous avons détruit tous les tankers dans cette zone."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/4"
msgid "wc1:c8f716d7a6859e0e"
msgstr "Nous savons donc qu'il doit être par ici. Mais nous ne savons pas exactement où."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/5"
msgid "wc1:42768b89311f7b65"
msgstr "Nous allons nous mettre en selle, reprendre le cours du Lumbari et trouver la flotte ennemie."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/6"
msgid "wc1:2360f614ae1ca1c1"
msgstr "Ils déménagent probablement; nous devrons les débusquer."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/7"
msgid "wc1:5174d7801c563638"
msgstr "Nous lançons donc tous les escadrons sur des trajectoires différentes."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/8"
msgid "wc1:a6be7ef445c51c9e $C"
msgstr "$C! Restez en alerte. Encore une fois, vous êtes avec Iceman, en tant qu'escadron Mu."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/9"
msgid "wc1:3394c331fd9b560e $C"
msgstr "$C! Restez en alerte. Encore une fois, vous êtes seul, en tant qu'escadron Mu..."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/10"
msgid "wc1:b9e73a1b7dec55b0"
msgstr "... Et je veux que vous volez comme si Iceman était avec vous."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/11"
msgid "wc1:a5a6e22fe103dc94"
msgstr "Pas d'erreurs, soyez sans pitié. C'est compris?"

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/12"
msgid "wc1:7775fb3ada98cbda"
msgstr "Compris, monsieur."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/13"
msgid "wc1:b339bb95c78689b4"
msgstr "Naviguez jusqu'à Nav 1. Si vous rencontrez un Kilrathi à votre arrivée..."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/14"
msgid "wc1:e658f5a923c4c82e"
msgstr "... débarrassez-vous en et continuez à Nav 2. Tuez tous les chats."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/15"
msgid "wc1:59883926f9c99bf3"
msgstr "Dirigez-vous ensuite à Nav 3. Débarrassez-vous de tous les vaisseaux ennemis et rentrez."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/16"
msgid "wc1:b8224988d296a9b8"
msgstr "Votre vol de retour doit se faire via Nav 1. De cette façon, vous éviterez complètement le champ de mines."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/17"
msgid "wc1:10a8d8af397dab8f"
msgstr "Si vous rencontrez le Sivar, allumez votre communicateur et faites-le nous savoir."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/18"
msgid "wc1:19cb3b57c1ac0db6"
msgstr "Des questions? Oui, Angel?"

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/19"
msgid "wc1:a63d7c5825a60ea6"
msgstr "Bonne chance mes amis et bon vol."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/20"
msgid "wc1:4a6d4923f284e905"
msgstr "Très bien, pilotes. A vos cockpits."

msgctxt "sm1/BRIEFING.001/packet/25/scene/0/record/21"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/1"
msgid "wc1:82a4c9c9cd343ebc $C"
msgstr "Bienvenue à la maison, $C. Ignorez le décompte des chasseurs, dites-moi si vous avez détruit des vaisseaux capitaux."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/2"
msgid "wc1:711c113dcdf3bdb0"
msgstr "Oui Monsieur. Nav 1 avait un tanker Lumbari chargé avec escorte de Dralthis."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/3"
msgid "wc1:0e355b895b201a62"
msgstr "Iceman et moi avons eu le Lumbari. Il devait se diriger vers le Sivar, et nous ne pouvions pas laisser passer ces provisions."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/4"
msgid "wc1:b5d055d810961025"
msgstr "J'ai détruit le Lumbari, monsieur. Il devait se diriger vers le Sivar, et je ne pouvais pas laisser passer ces provisions."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/5"
msgid "wc1:fbe4ed1217a803af"
msgstr "Le tanker s'est enfui, monsieur. J'ai enregistré sa route, cependant."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/6"
msgid "wc1:286e11a194354dec"
msgstr "O.K. On notera son parcours comme route possible vers le Sivar."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/7"
msgid "wc1:6863a7dc0b5074ce"
msgstr "Et Nav 2 est devenu chaud assez rapidement."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/8"
msgid "wc1:9476b4e69123e070"
msgstr "Il y avait un escadron de Jalthis - et un transport de classe Dorkir."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/9"
msgid "wc1:379959730fc1adcf"
msgstr "Le Dorkir était bien gardé... mais il est en poussière."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/10"
msgid "wc1:ace57546d06e7c01"
msgstr "Le Dorkir était trop bien gardé... Je n'ai pas pu l'abattre."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/11"
msgid "wc1:840f4fa90d5ef45e $R"
msgstr "Y avait-il d'autres vaisseaux là-bas, $R?"

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/12"
msgid "wc1:841eb324f1c90a59"
msgstr "Oui, il y avait un sacré comité d'accueil à Nav 3, Colonel."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/13"
msgid "wc1:e7dfda4f28de1b73"
msgstr "Krants et Grathas, même un escadron de Jalthis a proximité... le tout sous les canons d'une paire de Fralthis."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/14"
msgid "wc1:c9a3895250888f50"
msgstr "Impossible d'avoir les deux Fralthis, Colonel."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/15"
msgid "wc1:bb6eb76e4584b7d4"
msgstr "LES DEUX Fralthis sont grillés, Colonel."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/16"
msgid "wc1:b4ab943be23367b2"
msgstr "Sur le chemin du retour, j'ai trouvé d'autres vaisseaux kilrathis attendant à Nav 1..."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/17"
msgid "wc1:792b7b732470acc3"
msgstr "...un Ralari avec Gratha à proximité."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/18"
msgid "wc1:5fc1aa688cfe9230"
msgstr "Le Ralari est supprimé, monsieur."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/19"
msgid "wc1:f0038d419f7a7b17"
msgstr "J'ai dû laisser le Ralari, monsieur. Je n'ai pas pu l'avoir."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/21"
msgid "wc1:f0bdd39d861dacbb $K $C"
msgstr "L'enregistreur vous attribue un score de $K, $C."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/22"
msgid "wc1:ec6e7e0e96ee1099 $C"
msgstr "Vous êtes revenu sans victoire $C. Que diable faisiez-vous là-bas, monsieur?"

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/23"
msgid "wc1:a582588e7b6d7751 $L"
msgstr "Et Iceman a $L."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/24"
msgid "wc1:c06bb47bae40a947"
msgstr "Et Iceman n'a rien."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/25"
msgid "wc1:3d2e074313132c79"
msgstr "Et les chats l'ont tué... merde, je n'aurais jamais pensé que ça pourrait arriver."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/26"
msgid "wc1:49b8a53622d22f2a"
msgstr "Ice était le combattant parfait, il n'a jamais fait une seule erreur... jusqu'à maintenant."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/27"
msgid "wc1:b7921f61964b93cb $R"
msgstr "C'est tout, $R. Pourquoi ne pas aller prendre une douche?"

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/28"
msgid "wc1:6795fb77dd892181"
msgstr "Oh...et j'aurai besoin de vous voir dans mon bureau plus tard."

msgctxt "sm1/BRIEFING.001/packet/25/scene/1/record/29"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/25/scene/2/record/0"
msgid "wc1:e08b12b98364d2e3 $C"
msgstr "Le bar est fermé, $C. Interdiction de boire, ordre du colonel."

msgctxt "sm1/BRIEFING.001/packet/25/scene/2/record/1"
msgid "wc1:faedd304020e2820"
msgstr "Il veut que tout le monde soit sobre a 100%, même Paladin."

msgctxt "sm1/BRIEFING.001/packet/25/scene/2/record/2"
msgid "wc1:28ca99f7529fa2ce"
msgstr "Il veut que tout le monde soit sobre a 100%, alors je prends un jour de congé."

msgctxt "sm1/BRIEFING.001/packet/25/scene/2/record/3"
msgid "wc1:06a814d759e541a9"
msgstr "Je vais bientôt parti d'ici. A plus tard!"

msgctxt "sm1/BRIEFING.001/packet/26/scene/0/record/0"
msgid "wc1:6d736a047fd4fc7f $T $D"
msgstr "Briefing de mission, $T, $D. Système Valgard."

msgctxt "sm1/BRIEFING.001/packet/26/scene/0/record/1"
msgid "wc1:e0b44ee7c7765eb6"
msgstr "Ecoutez bien, pilotes, car nous n'avons pas beaucoup de temps."

msgctxt "sm1/BRIEFING.001/packet/26/scene/0/record/2"
msgid "wc1:81245619bbc4e1cf"
msgstr "Notre succès contre le dépôt de ravitaillement a laissé un grand nombre de vaisseaux kilrathis sans base d'attache."

msgctxt "sm1/BRIEFING.001/packet/26/scene/0/record/3"
msgid "wc1:79fa39194ead6a11"
msgstr "L'intelligence dit que ces vaisseaux se dirigent ici. Ils seront a court de carburant ... ils veulent essayer de prendre le griffe du tigre intact."

msgctxt "sm1/BRIEFING.001/packet/26/scene/0/record/4"
msgid "wc1:acca3056859ff05a"
msgstr "Pilotes, vous resterez près du Griffe du Tigre pour le défendre."

msgctxt "sm1/BRIEFING.001/packet/26/scene/0/record/5"
msgid "wc1:587cd80cd81ccde3"
msgstr "Des que ces vaisseaux seront détruits, atterrissez immédiatement. Nous partirons de cet endroit..."

msgctxt "sm1/BRIEFING.001/packet/26/scene/0/record/6"
msgid "wc1:7eb0c29641712b51"
msgstr "...avant que d'autres vaisseaux n'arrivent."

msgctxt "sm1/BRIEFING.001/packet/26/scene/0/record/7"
msgid "wc1:26f636a103b677c6"
msgstr "Affectations d'escadrons:"

msgctxt "sm1/BRIEFING.001/packet/26/scene/0/record/8"
msgid "wc1:683f778990acb303"
msgstr "Le commandant énumère les autres équipes d'escadron, puis s'adresse à vous:"

msgctxt "sm1/BRIEFING.001/packet/26/scene/0/record/9"
msgid "wc1:57e3f26990ec733a $C"
msgstr "$C, vous et Iceman êtes a nouveau l'escadron Mu. "

msgctxt "sm1/BRIEFING.001/packet/26/scene/0/record/10"
msgid "wc1:611f2b3a9bf7cdf2 $C"
msgstr "$C, vous êtes l'escadron Mu."

msgctxt "sm1/BRIEFING.001/packet/26/scene/0/record/11"
msgid "wc1:987c4080e9cb985a"
msgstr "Preparez-vous pour un lancement immédiat. Rompez."

msgctxt "sm1/BRIEFING.001/packet/26/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/26/scene/1/record/1"
msgid "wc1:c6bc6d0e7a83d21c"
msgstr "Content de vous revoir vivant."

msgctxt "sm1/BRIEFING.001/packet/26/scene/1/record/3"
msgid "wc1:79141ed264287aac $K $R"
msgstr "L'enregistreur montre que vous avez $K de ces chats, $R. Bon travail."

msgctxt "sm1/BRIEFING.001/packet/26/scene/1/record/4"
msgid "wc1:243c7d33c321f01e $R"
msgstr "Aucun mort Kilrathi confirmé, $R. Que faisiez-vous là-bas?"

msgctxt "sm1/BRIEFING.001/packet/26/scene/1/record/5"
msgid "wc1:9ba5cf66f0171c0c $L"
msgstr "Et Iceman a abattu $L Kilrathis."

msgctxt "sm1/BRIEFING.001/packet/26/scene/1/record/6"
msgid "wc1:10d88e315aa8fcdc"
msgstr "Et Iceman a zéro."

msgctxt "sm1/BRIEFING.001/packet/26/scene/1/record/7"
msgid "wc1:87215cd088b80d57"
msgstr "C'était un dur combat là-bas, colonel."

msgctxt "sm1/BRIEFING.001/packet/26/scene/1/record/8"
msgid "wc1:8437fa21597932e0"
msgstr "Et ces maudits chats l'ont tué. Ice était le pilote parfait, il n'a jamais fait d'erreur... jusqu'à aujourd'hui."

msgctxt "sm1/BRIEFING.001/packet/26/scene/1/record/9"
msgid "wc1:488e682f02219ef2 $C"
msgstr "Eh bien, vous feriez mieux de vous reposer pendant que vous le pouvez, $C."

msgctxt "sm1/BRIEFING.001/packet/26/scene/1/record/10"
msgid "wc1:823b57b71bd5c3eb"
msgstr "Et j'ai besoin de vous voir dans mon bureau plus tard."

msgctxt "sm1/BRIEFING.001/packet/26/scene/1/record/11"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Rompez."

msgctxt "sm1/BRIEFING.001/packet/26/scene/2/record/0"
msgid "wc1:51e69b08a7a297c6 $C"
msgstr "Hey, $C, content de voir que tu vas bien."

msgctxt "sm1/BRIEFING.001/packet/26/scene/2/record/1"
msgid "wc1:5b02a4ce69360989"
msgstr "Je n'arrête pas d'entendre que la situation est mauvaise et que ça empire..."

msgctxt "sm1/BRIEFING.001/packet/26/scene/2/record/2"
msgid "wc1:c129ff5eaf5f75a5"
msgstr "Je pense que le stress gagne tout le monde."

msgctxt "sm1/BRIEFING.001/packet/26/scene/2/record/3"
msgid "wc1:03ce2265d44a5769"
msgstr "J'ai vu beaucoup de pilotes en repos ici, plus ivres que des Polonais. Ils se battaient..."

msgctxt "sm1/BRIEFING.001/packet/26/scene/2/record/4"
msgid "wc1:a5d38e11eafebdbf"
msgstr "Deux techniciens et un pilote ont essayé de s'entre-tuer ici, il y a deux heures."

msgctxt "sm1/BRIEFING.001/packet/26/scene/2/record/5"
msgid "wc1:1abcec036d5ee5b0"
msgstr "Et certains deviennent fous, comme Maniac."

msgctxt "sm1/BRIEFING.001/packet/26/scene/2/record/6"
msgid "wc1:a2d3d274ece5749a"
msgstr "Je te le dis, si nous ne finissons pas ces Kilrathis et que nous ne quittons pas cet endroit..."

msgctxt "sm1/BRIEFING.001/packet/26/scene/2/record/7"
msgid "wc1:99250c17ce60627b"
msgstr "...nous allons finir par nous entre-tuer, et faire le travail des Kilrathis."

msgctxt "sm1/BRIEFING.001/packet/26/scene/3/record/0"
msgid "wc1:619ab0a8a27b992e $C"
msgstr "$C!  Je suis contente de voir que tu vas bien."

msgctxt "sm1/BRIEFING.001/packet/26/scene/3/record/1"
msgid "wc1:3515607ba1be08c7"
msgstr "J'avais entendue dire que tu avais été blessé lors de ta dernière mission."

msgctxt "sm1/BRIEFING.001/packet/26/scene/3/record/2"
msgid "wc1:e146411969074095"
msgstr "Il y a trop de ragots qui circulent sur ce vaisseau. Mon dieu, les histoires que j'ai entendues!"

msgctxt "sm1/BRIEFING.001/packet/26/scene/3/record/3"
msgid "wc1:5c57213ee89ec076"
msgstr "Pour ma part, je ne peux pas croire que ce soit une mission suicide."

msgctxt "sm1/BRIEFING.001/packet/26/scene/3/record/4"
msgid "wc1:eda5cf61dcd6668d"
msgstr "bientôt, nous terminerons cette mission et reprendrons nos fonctions dans le secteur Vega."

msgctxt "sm1/BRIEFING.001/packet/26/scene/4/record/0"
msgid "wc1:ca83cec33a28dfe7 $C"
msgstr "Bonjour, $C. Je suis perdue dans mes pensées."

msgctxt "sm1/BRIEFING.001/packet/26/scene/4/record/1"
msgid "wc1:788772ea239f0849"
msgstr "Mon fiancé... il a peut être été capturé, comme ces pauvres âmes à bord du Gwenhyvar?"

msgctxt "sm1/BRIEFING.001/packet/26/scene/4/record/2"
msgid "wc1:8374ebe2cf28b232"
msgstr "Capturé et forcé de trahir son propre peuple."

msgctxt "sm1/BRIEFING.001/packet/26/scene/4/record/3"
msgid "wc1:d736d87482710561"
msgstr "C'est un destin horrible."

msgctxt "sm1/BRIEFING.001/packet/26/scene/4/record/4"
msgid "wc1:23fd80e6fd06e6d7"
msgstr "Je vais te dire, si je devais être capturée..."

msgctxt "sm1/BRIEFING.001/packet/26/scene/4/record/5"
msgid "wc1:0e4061da11977f6c"
msgstr "...Je pense que je préfèrerais mourir."

msgctxt "sm1/BRIEFING.001/packet/26/scene/4/record/6"
msgid "wc1:24eb791c07aa30b1"
msgstr "Plutôt que le déshonneur et la honte, comme ce qui est arrivé a l'équipage du Gwenhyvar."

msgctxt "sm1/BRIEFING.001/packet/28/scene/0/record/0"
msgid "wc1:8513e7350ee4c8c9 $T $D"
msgstr "Briefing de mission, $T, $D. Secteur inconnu nommé 'Vigrid'."

msgctxt "sm1/BRIEFING.001/packet/28/scene/0/record/1"
msgid "wc1:2301471d8f94f6f8"
msgstr "Attention! Nous devons mettre tout le monde sur la piste de vol."

msgctxt "sm1/BRIEFING.001/packet/28/scene/0/record/2"
msgid "wc1:72ff30fcbd720952"
msgstr "Nos données tactiques ont identifié le Sivar... et les Kilrathis savent où nous sommes."

msgctxt "sm1/BRIEFING.001/packet/28/scene/0/record/3"
msgid "wc1:3a993bb33a05d2fa"
msgstr "Ils envoient une attaque massive contre le Griffe du Tigre."

msgctxt "sm1/BRIEFING.001/packet/28/scene/0/record/4"
msgid "wc1:81859c96f79439ca"
msgstr "Tout le monde sera sur le pont... et dans l'espace."

msgctxt "sm1/BRIEFING.001/packet/28/scene/0/record/5"
msgid "wc1:fc1782af1b3b4a27"
msgstr "Voici la configuration..."

msgctxt "sm1/BRIEFING.001/packet/28/scene/0/record/6"
msgid "wc1:ac75e4df1b2db2cd"
msgstr "Les capteurs montrent une grande force de frappe à Nav 1."

msgctxt "sm1/BRIEFING.001/packet/28/scene/0/record/7"
msgid "wc1:6d796eb8ff99bfa1"
msgstr "Notre hypothèse est qu'ils auront au moins un vaisseau lourd, avec plusieurs chasseurs."

msgctxt "sm1/BRIEFING.001/packet/28/scene/0/record/8"
msgid "wc1:6c7db51bf35f204c"
msgstr "Quoi qu'il y ait, il faut l'arrêter avant qu'il ne viennent sur notre position."

msgctxt "sm1/BRIEFING.001/packet/28/scene/0/record/9"
msgid "wc1:570ddea61882d3e4"
msgstr "Lorsque vous êtes sûr que la zone est dégagée, retournez au Tigre."

msgctxt "sm1/BRIEFING.001/packet/28/scene/0/record/10"
msgid "wc1:d043c45e572df34b $C"
msgstr "$C, vous devrez faire celle-ci seul. Je ne peux vous donner personne pour vous aider."

msgctxt "sm1/BRIEFING.001/packet/28/scene/0/record/11"
msgid "wc1:d48f84438f0c21db $C"
msgstr "$C et Knight, votre escadron sera Omicron."

msgctxt "sm1/BRIEFING.001/packet/28/scene/0/record/12"
msgid "wc1:3eac585f7d0b7b1b"
msgstr "Le colonel affecte tous les escadrons à d'autres points de saut, formant une boucle autour du Tigre."

msgctxt "sm1/BRIEFING.001/packet/28/scene/0/record/13"
msgid "wc1:5cbd75da59b89417"
msgstr "Des questions? D'accord, alors... restez vigilant et ne faite pas d'erreur. Rompez."

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/1"
msgid "wc1:45d55456ba95fa46 $C"
msgstr "Bienvenue, $C. Faites votre rapport et soyez bref."

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/2"
msgid "wc1:28704e708d7bee1f $C"
msgstr "Bienvenue, $C. J'ai sais pour Knight. Donnez-moi votre rapport, et soyez bref."

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/3"
msgid "wc1:720abf3d30c61c90"
msgstr "Oui Monsieur. J'ai été à Nav 1 pour engager la force de frappe."

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/4"
msgid "wc1:47343e37e6dd2f6f"
msgstr "Quand je suis arrivé, ça ne semblait pas si dangereux... juste un Ralari avec Jalthis."

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/5"
msgid "wc1:ba4469f463022b1e"
msgstr "J'aurais aimé qu'un autre escadron nous aide."

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/6"
msgid "wc1:cccb69b1b59870ec"
msgstr "Bon. Avez-vous détruit le Ralari ou pas?"

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/7"
msgid "wc1:38692ba723c17326"
msgstr "Oui, monsieur, je l'ai fait."

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/8"
msgid "wc1:da7b633048d4b6ef"
msgstr "Non, monsieur, je n'ai pas pu."

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/9"
msgid "wc1:183a1fb438552907"
msgstr "Je vois. Juste pour que vous sachiez, j'ai détourné Maniac l'escadron Beta pour corriger votre erreur."

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/10"
msgid "wc1:8320b0157633ba20 $C"
msgstr "Inutile de discuter des chasseurs, $C. Entre nos artilleurs et vous, ils sont tous détruits."

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/11"
msgid "wc1:b7a02d791be15829 $K"
msgstr "Pour info, vous avez eu $K chats."

#. wc1-re: restore campaign substitution tokens from the original record.
msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/12"
msgid "wc1:a199941ccbef0a20 $R"
msgstr "Vous n'avez rien eu, $R... aucune victoire."

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/13"
msgid "wc1:678d4ed4bc5e5b2c $L"
msgstr "Knight a $L."

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/14"
msgid "wc1:da46cb2d75cc30b3"
msgstr "Knight n'en a aucun ... c'est pas dans ses habitudes."

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/15"
msgid "wc1:bf06e867e9150213 $C"
msgstr "OK, $C, je veux vous voir dans mon bureau plus tard."

msgctxt "sm1/BRIEFING.001/packet/28/scene/1/record/16"
msgid "wc1:89a10684b8d3bc69"
msgstr "Rompez!"

msgctxt "sm1/BRIEFING.001/packet/28/scene/2/record/0"
msgid "wc1:e94552cb8e938567 $C"
msgstr "Tu as l'air de passer une bonne journée, $C."

msgctxt "sm1/BRIEFING.001/packet/28/scene/2/record/1"
msgid "wc1:e912834cac465f69"
msgstr "Sachant que le Sivar est là-bas, à court de ravitaillement... eh bien, ça aide."

msgctxt "sm1/BRIEFING.001/packet/28/scene/2/record/2"
msgid "wc1:570d8d5118208c61"
msgstr "Scuttlebutt dit que nous sommes sur le point de le détruire."

msgctxt "sm1/BRIEFING.001/packet/28/scene/2/record/3"
msgid "wc1:69231354bf6fe5c2"
msgstr "J'espère que nous aurons bientôt cette cible... pour Zach et Trisha."

msgctxt "sm1/BRIEFING.001/packet/28/scene/2/record/4"
msgid "wc1:96477864a2637f20 $C"
msgstr "Ah, mais l'attente est toujours la pire des choses $C."

msgctxt "sm1/BRIEFING.001/packet/28/scene/3/record/0"
msgid "wc1:5b444190482995f5 $C"
msgstr "Salut, $C. J'ai entendu dire que tu viens d'être affecté dans l'escadron Black Lion."

msgctxt "sm1/BRIEFING.001/packet/28/scene/3/record/1"
msgid "wc1:5bfb8aef4b5dd641"
msgstr "Ca veut dire que tu voleras avec moi. Soyons prudent là-bas, d'accord?"

msgctxt "sm1/BRIEFING.001/packet/28/scene/3/record/3"
msgid "wc1:e5feef9061b48506"
msgstr "Eh bien, j'espère juste que nous allons descendre ce cuirassé."

msgctxt "sm1/BRIEFING.001/packet/28/scene/3/record/4"
msgid "wc1:c85536e3b5e4fafb"
msgstr "Nous sommes en territoire ennemi, si loin de nos propres lignes..."

msgctxt "sm1/BRIEFING.001/packet/28/scene/3/record/5"
msgid "wc1:d010c02ba1438934"
msgstr "...et le Sivar n'est pas le seul à ne pas pouvoir se réapprovisionner."

msgctxt "sm1/BRIEFING.001/packet/28/scene/4/record/0"
msgid "wc1:c91f7876889d11a8"
msgstr "Bon travail là-bas contre les boules de poils, gamin."

msgctxt "sm1/BRIEFING.001/packet/28/scene/4/record/1"
msgid "wc1:ba82dda58f2704f5"
msgstr "Nous approchons de la fin maintenant."

msgctxt "sm1/BRIEFING.001/packet/28/scene/4/record/2"
msgid "wc1:6189a237421f15da"
msgstr "Rappele-toi les missiles. Ne les utilises pas trop vite, gamin."

msgctxt "sm1/BRIEFING.001/packet/28/scene/4/record/3"
msgid "wc1:c4c8ae900f29882b"
msgstr "Tes canons élimineront les plus petites cibles..."

msgctxt "sm1/BRIEFING.001/packet/28/scene/4/record/4"
msgid "wc1:6ddaff751580c56b"
msgstr "..mais rien de tel qu'un missile pour finir le travail."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/0"
msgid "wc1:8513e7350ee4c8c9 $T $D"
msgstr "Briefing de mission, $T, $D. Secteur inconnu nommé 'Vigrid'."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/1"
msgid "wc1:82ca21c85b0a892d"
msgstr "Tout le monde est present ? Bien."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/2"
msgid "wc1:fa84f82798045211"
msgstr "Nous sommes maintenant prets à détruire le Sivar."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/3"
msgid "wc1:8656ee7560c62a58"
msgstr "C'est la seule chance que nous aurons, alors faisons en sorte que ça ne rate pas."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/4"
msgid "wc1:c34be8c5d16016f2"
msgstr "J'ai eu du mal à décider quel pilote envoyer en premier..."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/5"
msgid "wc1:3b151b248ed324ca"
msgstr "...parce qu'il va y avoir la plus grande resistance."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/6"
msgid "wc1:e167eb348378aa65"
msgstr "Apres le lancement de notre première frappe, le Tigre se déplacera vers un nouveau point..."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/7"
msgid "wc1:55982b97c7ced48e"
msgstr "...où nous lancerons les escadrons restants."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/8"
msgid "wc1:0053a92b741a45a5"
msgstr "Avec un peu de chance, le Sivar ne s'attendra pas à une attaque sur deux secteurs."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/9"
msgid "wc1:ea3909eb411efe04"
msgstr "Tout au long de cette mission, le Sivar a été escorté par une flotte conséquente."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/10"
msgid "wc1:c4a8684747f7d616"
msgstr "Nous avons détruit cette flotte, vaisseau par vaisseau..."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/11"
msgid "wc1:b72ded2d1f7f05db"
msgstr "Mais nous ne pouvons pas être sûrs de les avoir tous eus. Alors soyez TRES prudent là-bas."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/12"
msgid "wc1:17e85c51a945b822"
msgstr "Maintenant, ecoutez. On a perdu beaucoup d'hommes, pendant cette opération..."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/13"
msgid "wc1:139fa2fafcf05a11"
msgstr "...Je ne veux plus en perdre. Sur cette mission---"

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/14"
msgid "wc1:2cd0df697825f016"
msgstr "Hunter, rien de personnel. Restez vivant."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/15"
msgid "wc1:c0ce7d34e1d58fa4"
msgstr "Si vous le dites, monsieur."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/16"
msgid "wc1:712602c101e778ab"
msgstr "Angel, envoyez-les en enfer... mais revenez sans égratignure."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/18"
msgid "wc1:5a7070160ffe61f6"
msgstr "Maniac, restez en vie. Je connais vos cauchemars---"

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/19"
msgid "wc1:c7b6894a0fe7d2ab"
msgstr "Mais, monsieur---"

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/20"
msgid "wc1:1e9b21c5c7fd5541"
msgstr "Ce ne sont que des rêves, gamin. Ce n'est pas réel. Et j'ai besoin de vous vivant, pour combattre à nouveau les chats. Compris?"

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/21"
msgid "wc1:5c217a68f6cb4df1"
msgstr "Oui Monsieur!"

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/22"
msgid "wc1:73fd021515704e5a"
msgstr "Bossman, restez prudent... mais ne soyez pas TROP prudent."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/23"
msgid "wc1:7a72977766b7be59"
msgstr "Aucun problème monsieur."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/24"
msgid "wc1:1fe998457becae8f"
msgstr "Knight, vous êtes un pro. Restez-le."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/25"
msgid "wc1:89aedb8b4415a806"
msgstr "J'y compte bien, monsieur."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/26"
msgid "wc1:88dbfa5ba90ccc47"
msgstr "Spirit, ne faites pas un sacrifice romantique---"

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/27"
msgid "wc1:2f7a73aa76ac1557"
msgstr "Non monsieur. Tout ce que je sacrifierai aujourd'hui portera de la fourrure et des moustaches."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/28"
msgid "wc1:8b29aad6a0c9eec9"
msgstr "Heureux de l'entendre."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/29"
msgid "wc1:27bc1cc18d5e2856"
msgstr "Paladin, piloter un bureau EST mieux que respirer le vide de l'espace. Faites-moi confiance, d'accord?"

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/30"
msgid "wc1:66cd0b79e428c8de"
msgstr "Etes-vous juste en train de dire ça pour pouvoir vous saoûler à ma fête de retraite, monsieur?"

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/31"
msgid "wc1:e9c74d183ad4bd9b"
msgstr "Iceman... uh... Continuez comme vous le faites toujours."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/32"
msgid "wc1:0734564a484ae3db"
msgstr "Oubliez les adieux, monsieur. Mettons nous en route."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/33"
msgid "wc1:abc8bdd90e027c9a $C"
msgstr "$C, pas d'acrobatie, rien d'extraordinaire. Faites le boulot et sortez de la vivant."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/34"
msgid "wc1:8936f123be384247"
msgstr "Compris, monsieur."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/35"
msgid "wc1:21195c120c99a44b"
msgstr "Vous savez que le commandant ---."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/36"
msgid "wc1:360c544be48df75b"
msgstr "---disait au revoir aux pilotes... juste au cas où."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/37"
msgid "wc1:f8354fdb7a1cf259 $C"
msgstr "$C! Vous faites à nouveau équipe avec Knight, en tant qu'escadron Omega."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/38"
msgid "wc1:dd4480959f05264c $C"
msgstr "$C! Vous êtes l'escadron Omega. Maintenant que nous avons perdu Knight..."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/39"
msgid "wc1:4ce7854c50089700"
msgstr "... Je compte sur vous pour reussir."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/40"
msgid "wc1:c1f23ad790b1991f"
msgstr "Je ne vous laisserai pas tomber, monsieur."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/41"
msgid "wc1:c1665aec30f664ee"
msgstr "Voici le scenario."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/42"
msgid "wc1:3641653463acc10d"
msgstr "Dirigez-vous d'abord à Nav 1. Essayez de détruire l'une des flottes de soutien restantes."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/43"
msgid "wc1:46b990ef8afcda3d"
msgstr "Ce n'est PAS votre objectif principal, par contre ... c'est le Sivar, à Nav 2."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/44"
msgid "wc1:b80a8c597ed6d8ad"
msgstr "Si vous êtes capable de détruire le Sivar, rentrez en post-combustion à la maison."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/45"
msgid "wc1:c80c51c652e0bce6"
msgstr "Rendez-vous avec le Tigre à Nav 3."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/46"
msgid "wc1:6c3af846ed69fe6a $C"
msgstr "Des questions? Non? Bonne chance, $C. Nous vous verrons à Nav 3."

msgctxt "sm1/BRIEFING.001/packet/29/scene/0/record/47"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/1"
msgid "wc1:b7f9a52d20060d84 $C"
msgstr "Nous avons votre score, $C. Toutes mes félicitations."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/2"
msgid "wc1:cc50aa2eb0c107e9"
msgstr "Personnellement, je savais que vous réussiriez."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/3"
msgid "wc1:9f424a49131e3a8e"
msgstr "Je veillerai a ce que le Haut Commandement de la Confédération vous récompense pour cela."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/4"
msgid "wc1:10bcf08e9ad57e18 $C"
msgstr "Pas de score, $C. Et le Sivar est sûr d'avoir des renforts et du ravitaillement."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/5"
msgid "wc1:5b0a15f846f296ff"
msgstr "Et vous revenez sans rien."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/6"
msgid "wc1:119a1cf27ab45e2f"
msgstr "Apres tout ce temps, tous ces pilotes morts... on s'enfuit."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/7"
msgid "wc1:6d59f6a07a4d39a8"
msgstr "Que devons-nous ajouter au rapport?"

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/8"
msgid "wc1:99ed79466ea77d1f"
msgstr "Pas grand-chose, monsieur."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/9"
msgid "wc1:75b52c41484a5327"
msgstr "Le Sivar avait une forte escorte de chasseurs. Je suppose que les plus gros vaisseaux..."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/10"
msgid "wc1:de3897e7159f552b"
msgstr "... ont déjà quitté le système."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/11"
msgid "wc1:8734f5340dd2ca1d"
msgstr "Peut-être pensaient-ils qu'ils pourraient intercepter le Griffe du Tigre et empêcher notre frappe."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/12"
msgid "wc1:44cc819d9af34036"
msgstr "Comme le Fralthi à Nav 1... ce vaisseau est en miette, monsieur."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/13"
msgid "wc1:7365ea307b8d432f"
msgstr "Mais le Sivar avait un escadron de Krant, Jalthi et Gratha."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/14"
msgid "wc1:408d59522400be3b $K $C"
msgstr "L'enregistreur montre que vous avez $K chats, $C."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/15"
msgid "wc1:157a5cc22d07c666 $C"
msgstr "L'enregistreur n'indique rien, $C."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/16"
msgid "wc1:dc5c837e7a0ebd2b $L"
msgstr "Et Knight a $L."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/17"
msgid "wc1:0e859754d05c33ed"
msgstr "Et Knight n'a rien."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/18"
msgid "wc1:ced9ef714f8826ae"
msgstr "Khumalo est mort dans cette bataille..."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/19"
msgid "wc1:598d942618a7672c"
msgstr "Cet homme va me manquer."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/20"
msgid "wc1:109dab8f8e8227c8"
msgstr "Oui Monsieur. J'ai réussi à détruire le Sivar..."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/21"
msgid "wc1:6d0c527b5514cb4a"
msgstr "Comparé à ça... rien d'autre n'a d'importance, n'est-ce pas?"

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/22"
msgid "wc1:c2834803f6cc1798 $C"
msgstr "Bon sang, $C. Vous avez porté un coup fatal à leurs plans de conquête de l'humanité."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/23"
msgid "wc1:f72f978728a9448f"
msgstr "Oui, monsieur ... j'aurais juste aimé pouvoir stopper le Sivar."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/24"
msgid "wc1:7805394390c359fd $C"
msgstr "Aucun autre escadron n'a pu l'abattre non plus, $C."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/25"
msgid "wc1:c7d964db5281c838"
msgstr "Cette operation a été dure et douloureuse. Nous avons perdu trop d'amis et alliés."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/26"
msgid "wc1:7a9ea5cf97067635"
msgstr "Il est maintenant temps de rentrer à la maison."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/27"
msgid "wc1:7c417715b475b55c $C"
msgstr "J'aurai besoin de vous voir dans mon bureau plus tard, $C."

msgctxt "sm1/BRIEFING.001/packet/29/scene/1/record/28"
msgid "wc1:4f8a04322472b29c"
msgstr "Mais pour l'instant... Disposez."

msgctxt "sm1/BRIEFING.001/packet/29/scene/2/record/0"
msgid "wc1:8f860f4423670b40 $C"
msgstr "Salut, $C ! Dépêche-toi et rends-toi au Briefing."

msgctxt "sm1/BRIEFING.001/packet/29/scene/2/record/1"
msgid "wc1:279afb194b5cb8cc"
msgstr "Il est temps de terminer cette croisière, que ce soit dans un sens ou dans l'autre."

msgctxt "sm1/BRIEFING.001/packet/29/scene/2/record/2"
msgid "wc1:a1f90a65d011d0ca $R $N"
msgstr "Bonne chance a toi, $R $N!"

msgctxt "sm1/BRIEFING.001/packet/29/scene/3/record/0"
msgid "wc1:73b26844406d8c38 $C"
msgstr "Bonjour, $C. Je suis content de parler à quelqu'un d'autre que nos cinglés de pilotes."

msgctxt "sm1/BRIEFING.001/packet/29/scene/3/record/1"
msgid "wc1:ae6760f7340caa13"
msgstr "J'ecris une lettre pour chez moi... juste au cas ou on ne reviendrait pas."

msgctxt "sm1/BRIEFING.001/packet/29/scene/3/record/2"
msgid "wc1:5a88fa5ae12d47af $C"
msgstr "As-tu vu les derniers holopics de ma famille, $C?"

msgctxt "sm1/BRIEFING.001/packet/29/scene/3/record/3"
msgid "wc1:0b189bad671ec407"
msgstr "Non, Boss...je n'ai pas vu ca."

msgctxt "sm1/BRIEFING.001/packet/29/scene/3/record/4"
msgid "wc1:f30da9e881760cda"
msgstr "J'aimerais te les montrer plus tard. ils me manquent beaucoup."

msgctxt "sm1/BRIEFING.001/packet/29/scene/3/record/5"
msgid "wc1:c4a69faafc356760"
msgstr "J'espere que cette mission se terminera bientôt, afin que nous puissions retourner à Vega."

msgctxt "sm1/BRIEFING.001/packet/29/scene/4/record/0"
msgid "wc1:6f7bd886f35fa6fd $C"
msgstr "Salut, $C. Je suis sûr que je volerai bientôt contre le Sivar."

msgctxt "sm1/BRIEFING.001/packet/29/scene/4/record/1"
msgid "wc1:09b4a59202c5d3b5"
msgstr "Au cas ou je ne réussirais pas... tu devras exploser ce vaisseau pour moi."

msgctxt "sm1/BRIEFING.001/packet/29/scene/4/record/2"
msgid "wc1:3143fdf4bde45d50"
msgstr "Je sais que je serai le seul à le faire. Comme dans mon rêve..."

msgctxt "sm1/BRIEFING.001/packet/29/scene/4/record/3"
msgid "wc1:745ce4463f6234dc $C"
msgstr "Mais si je meurs, c'est à toi de le faire, $C."

msgctxt "sm1/BRIEFING.001/packet/29/scene/4/record/4"
msgid "wc1:e837256fe2dce9d7"
msgstr "Utilise tes missiles d'abord. Frappe-les à toute vitesse."

msgctxt "sm1/BRIEFING.001/packet/29/scene/4/record/5"
msgid "wc1:f4ab47a0658a3d7e"
msgstr "J'dis ca juste au cas où?"

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/0"
msgid "wc1:ed8695e6bbcc9752 $T $D"
msgstr "Briefing de mission, $T, $D. Retraite du territoire kilrathi"

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/1"
msgid "wc1:4c40383bf62a3e50"
msgstr "Silence tout le monde. Ecoutez et Ecoutez bien."

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/2"
msgid "wc1:eef6bf5775ae87da"
msgstr "Comme vous le savez, notre échec contre les Kilrathis..."

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/3"
msgid "wc1:fdfe1d5190888d38"
msgstr "...nécessite notre retraite de leur espace."

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/4"
msgid "wc1:29c363805e8049e9"
msgstr "Nous supposons que les Kilrathis vont nous poursuivre et tenter de nous détruire."

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/5"
msgid "wc1:d58a6d7c5cb76c74"
msgstr "Le scénario le plus probable implique une frappe contre le Tigre près de la frontière."

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/6"
msgid "wc1:0513f87bbdd747e0"
msgstr "Celà leur donne le temps pour se préparer à notre arrivée."

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/7"
msgid "wc1:dc1046f464085837"
msgstr "Si nous pouvons éliminer leurs éclaireurs, nous pourrions éviter leurs principales forces de représailles."

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/8"
msgid "wc1:886b924ef6667974"
msgstr "OK, voici vos affectations."

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/9"
msgid "wc1:38053d1f3c47dfda"
msgstr "Vous volerez vers chacun de ces trois points de navigation."

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/10"
msgid "wc1:bcb4f1766c0a3426"
msgstr "...dans le but de déruire tout Kilrathi que vous rencontrez."

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/11"
msgid "wc1:fba7f8b286a78e9b"
msgstr "Rappelez-vous, c'est notre seul plan pour nous en sortir vivants."

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/12"
msgid "wc1:f05440b6586df974"
msgstr "Vous attendez qu'on vous appelle."

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/13"
msgid "wc1:b05b715bd9c7d956 $C $C"
msgstr "Escadron Iota sera $C et Maniac, $C en tant que chef."

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/14"
msgid "wc1:1d08310b8ad74a7f $C"
msgstr "Escadron Iota sera $C. Vous volerez seul cette fois."

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/15"
msgid "wc1:b64067dd531a0777"
msgstr "C'est tout. Restez vivants, les gars."

msgctxt "sm1/BRIEFING.001/packet/32/scene/0/record/16"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Debriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/1"
msgid "wc1:212e964447ae2462 $C"
msgstr "D'accord, $C. J'écoute."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/2"
msgid "wc1:20287ee31d1fa80d"
msgstr "Oui Monsieur. La route vers Nav 1 s'est déroulée sans incident..."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/3"
msgid "wc1:7dd2896d987a14b1"
msgstr "...mais une fois arrivé, il y avait un escadron de Krants escortant un Fralthi, se dirigeant vers le Tigre."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/4"
msgid "wc1:50b4f91c008771e5"
msgstr "De toute évidence, vous êtes revenu... comment avez-vous fait?"

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/5"
msgid "wc1:c7405fd6ace355ee"
msgstr "J'ai détruit le Fralthi, monsieur."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/7"
msgid "wc1:d9a9bcc14e1282ca"
msgstr "J'ai combattu aussi fort que j'ai pu, colonel, mais je n'ai pas eu le Fralthi."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/8"
msgid "wc1:3e1e1dd401f3230d"
msgstr "J'ai fait autant de dégats que j'ai pu aux chasseurs avant de rompre."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/9"
msgid "wc1:0eda49e0586eefca"
msgstr "A Nav 2, il y avait des Dralthis. j'en ai compté dix au moins."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/10"
msgid "wc1:6fe5a1bc03eb280f"
msgstr "J'en ai tué autant que j'ai pu, puis je suis parti."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/11"
msgid "wc1:5fe1844dab4c6120 $C"
msgstr "Compris, $C. Continuez."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/12"
msgid "wc1:310a495646c046d5"
msgstr "Oui Monsieur. Je suis allé à Nav 3 ensuite..."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/13"
msgid "wc1:76d9bd4d1520f0ad"
msgstr "...et quand je suis arrivé, il y avait deux Ralaris avec des Grathas en patrouille."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/14"
msgid "wc1:436b6801056b89c5"
msgstr "Le premier Ralari n'a pas été trop difficile a éliminer, monsieur."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/15"
msgid "wc1:37c825aa4341bb31"
msgstr "Un putain de Gratha m'a empêché de détruire le premier destroyer, monsieur."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/16"
msgid "wc1:50eded41750b5539"
msgstr "Et le deuxieme Ralari est en poussière, monsieur. Aucun problème."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/17"
msgid "wc1:53ebd877609ea01e"
msgstr "Je n'ai pas eu le deuxieme Ralari, colonel. Il est toujours opérationnel."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/18"
msgid "wc1:c0d16986a1b178d8 $C"
msgstr "OK, $C. J'enverrai un autre escadron finir ce que vous avez manqué."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/19"
msgid "wc1:e41465508b53c2b5 $K"
msgstr "Les scores pour vous sont les suivants : $K..."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/20"
msgid "wc1:e2112fb76e5baebf $C"
msgstr "Les scores pour vous sont les suivants : Aucune victime, $C..."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/21"
msgid "wc1:e6ec19f241628c19 $L"
msgstr "...et Maniac a $L."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/22"
msgid "wc1:fb89c81640f464b5"
msgstr "...et Maniac n'a rien. je suis surpris."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/23"
msgid "wc1:5db22149f4dfa66f $R"
msgstr "Et Marshall... j'avais de l'espoir pour ce gamin. Au moins vous êtes encore en vie, $R."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/24"
msgid "wc1:13aff7e14ad665ed $C"
msgstr "$C, Je dois vous voir dans mon bureau plus tard."

msgctxt "sm1/BRIEFING.001/packet/32/scene/1/record/25"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Disposez."

msgctxt "sm1/BRIEFING.001/packet/32/scene/2/record/0"
msgid "wc1:8414e457d8dcf67b $C"
msgstr "$C! Comment ça va?"

msgctxt "sm1/BRIEFING.001/packet/32/scene/2/record/1"
msgid "wc1:c362d32a09866fd3"
msgstr "Je n'arrive pas à croire qu'on se tire. Nous n'avons pas fini notre travail."

msgctxt "sm1/BRIEFING.001/packet/32/scene/2/record/2"
msgid "wc1:e344ddd76701ed08"
msgstr "On a laissé les gens de Goddard mourir pour rien. RIEN!"

msgctxt "sm1/BRIEFING.001/packet/32/scene/2/record/3"
msgid "wc1:cc048e0e7a6d7987"
msgstr "Le vieux Halcyon ferait mieux de ne pas passer par ici... Je lui dirais de..."

msgctxt "sm1/BRIEFING.001/packet/32/scene/2/record/4"
msgid "wc1:4712357edabecb0f"
msgstr "...oh, a quoi ca sert ? Nous avons tout fait pour gagner."

msgctxt "sm1/BRIEFING.001/packet/32/scene/2/record/5"
msgid "wc1:95a6f1c607678b2f"
msgstr "Je déteste perdre contre ces sacs à puces."

msgctxt "sm1/BRIEFING.001/packet/32/scene/3/record/0"
msgid "wc1:7f9eaf71cff7c35b $C"
msgstr "Bonjour, $C. Je suis très contrariée par notre défaite."

msgctxt "sm1/BRIEFING.001/packet/32/scene/3/record/1"
msgid "wc1:706246c18ff0e98e"
msgstr "Jusqu'a présent, nous étions vainqueur..."

msgctxt "sm1/BRIEFING.001/packet/32/scene/3/record/2"
msgid "wc1:e70107b08767f79b"
msgstr "...Et maintenant nous courons comme des enfants effrayés."

msgctxt "sm1/BRIEFING.001/packet/32/scene/3/record/3"
msgid "wc1:65497dd3cbb8bafe"
msgstr "J'ai parlé avec le colonel de nos chances de survivre à notre repli."

msgctxt "sm1/BRIEFING.001/packet/32/scene/3/record/4"
msgid "wc1:29d9debbd359fa18"
msgstr "Et les chances ne nous sont pas favorables. Mon Dieu, je ne me suis jamais sentie aussi impuissante."

msgctxt "sm1/BRIEFING.001/packet/32/scene/3/record/5"
msgid "wc1:29a910227841c300"
msgstr "J'aurais souhaité en faire plus."

msgctxt "sm1/BRIEFING.001/packet/32/scene/4/record/0"
msgid "wc1:6c4361485953b1e6 $C"
msgstr "Bonjour, $C. Tu veux me rejoindre?"

msgctxt "sm1/BRIEFING.001/packet/32/scene/4/record/1"
msgid "wc1:8b608cdd8e0ef442"
msgstr "J'essaie de consoler Jeanette, mais elle est déçue."

msgctxt "sm1/BRIEFING.001/packet/32/scene/4/record/2"
msgid "wc1:718205ecb9ec1491"
msgstr "Partout où je vais, on ne parle que d'échec et de défaite."

msgctxt "sm1/BRIEFING.001/packet/32/scene/4/record/3"
msgid "wc1:5bef8b93a1f1f215"
msgstr "Nous n'avons pas encore perdu la guerre, seule cette opération a échoué."

msgctxt "sm1/BRIEFING.001/packet/32/scene/4/record/4"
msgid "wc1:99a9aad14a40d2f1"
msgstr "Je ne peux pas croire que nous courbons la tête devant les Kilrathis."

msgctxt "sm1/BRIEFING.001/packet/32/scene/4/record/5"
msgid "wc1:1e19c321d3f3e4c0 $C"
msgstr "Garde ça dans ton coeur, $C. Cela te donnera de la force."

msgctxt "sm1/BRIEFING.001/packet/33/scene/0/record/0"
msgid "wc1:bdc4b669c30f1c5f $T $D"
msgstr "Briefing de mission, $T, $D. Près de la frontière kilrathi/terrienne."

msgctxt "sm1/BRIEFING.001/packet/33/scene/0/record/1"
msgid "wc1:03cbfeb3b732aa4c"
msgstr "Nous sommes en alerte."

msgctxt "sm1/BRIEFING.001/packet/33/scene/0/record/2"
msgid "wc1:b2f45e2add632590"
msgstr "Notre retraite de l'autre cote de la frontière ne se fera pas comme nous l'esperions."

msgctxt "sm1/BRIEFING.001/packet/33/scene/0/record/3"
msgid "wc1:8f3dcab1e34e4b48"
msgstr "Nous suivons déjà plusieurs vaisseaux entrants venant de plusieurs vecteurs."

msgctxt "sm1/BRIEFING.001/packet/33/scene/0/record/4"
msgid "wc1:41c03d5841e94c0a"
msgstr "Chacun d'eux pourrait nous détruire."

msgctxt "sm1/BRIEFING.001/packet/33/scene/0/record/5"
msgid "wc1:24a7e03df04de60a"
msgstr "Vous serez tous en mission, un escadron après l'autre pour les arrêter."

msgctxt "sm1/BRIEFING.001/packet/33/scene/0/record/6"
msgid "wc1:0db6b3a8c6cc8566"
msgstr "Il n'y a que deux façons de proceder, les gars..."

msgctxt "sm1/BRIEFING.001/packet/33/scene/0/record/7"
msgid "wc1:fd63bc1cf4c9f40f"
msgstr "...soit le Tigre survit, soit nous serons perdu."

msgctxt "sm1/BRIEFING.001/packet/33/scene/0/record/8"
msgid "wc1:13a8b0193e3573f4"
msgstr "Si nous survivons, nous sauterons le plus vite possible pour le secteur Vega."

msgctxt "sm1/BRIEFING.001/packet/33/scene/0/record/9"
msgid "wc1:73b125aabf2a94c7"
msgstr "Des questions?"

msgctxt "sm1/BRIEFING.001/packet/33/scene/0/record/10"
msgid "wc1:5d13d90b682b2992"
msgstr "Non? Bien, affectation d'escadron."

msgctxt "sm1/BRIEFING.001/packet/33/scene/0/record/11"
msgid "wc1:105862731767402f $N $N"
msgstr "$N et Marshall seront l'ecadron Upsilon, $N est toujours le chef."

msgctxt "sm1/BRIEFING.001/packet/33/scene/0/record/12"
msgid "wc1:90a9dbe4bd88b9df $N"
msgstr "$N, vous êtes l'escadron Upsilon. Je ne peux pas vous donner d'ailier."

msgctxt "sm1/BRIEFING.001/packet/33/scene/0/record/13"
msgid "wc1:1b866618d94d59fd"
msgstr "Les autres escadrons sont affectées rapidement."

msgctxt "sm1/BRIEFING.001/packet/33/scene/0/record/14"
msgid "wc1:94cf4cd01ce9f0d5"
msgstr "C'est tout. Preparez-vous au lancement. Rompez."

msgctxt "sm1/BRIEFING.001/packet/33/scene/1/record/0"
msgid "wc1:3a35f781b4c155d0 $T $D"
msgstr "Débriefing de la mission -- $T, $D."

msgctxt "sm1/BRIEFING.001/packet/33/scene/1/record/1"
msgid "wc1:9c855c8129ce0489"
msgstr "Bienvenue, messieurs."

msgctxt "sm1/BRIEFING.001/packet/33/scene/1/record/2"
msgid "wc1:e731a95530d91c0f $C"
msgstr "Bienvenue, $C."

msgctxt "sm1/BRIEFING.001/packet/33/scene/1/record/3"
msgid "wc1:263043b7edfca7a7"
msgstr "Je dois me rendre au pont pour le saut ... renseignez-moi rapidement sur vos victimes."

msgctxt "sm1/BRIEFING.001/packet/33/scene/1/record/4"
msgid "wc1:f926ea64569ca0cd $K"
msgstr "Oui, colonel. j'ai tué $K."

msgctxt "sm1/BRIEFING.001/packet/33/scene/1/record/5"
msgid "wc1:a5a7422eee58cdad"
msgstr "Oui, colonel. Je n'ai rien tué, monsieur."

msgctxt "sm1/BRIEFING.001/packet/33/scene/1/record/6"
msgid "wc1:a18b2028c9182fa1 $C"
msgstr "Voila pourquoi nous fuyons, $C. Votre incapacité à tuer."

msgctxt "sm1/BRIEFING.001/packet/33/scene/1/record/7"
msgid "wc1:421fd4e9be2b46c9 $L"
msgstr "Maniac a $L."

msgctxt "sm1/BRIEFING.001/packet/33/scene/1/record/8"
msgid "wc1:b816f1824de7989e"
msgstr "Maniac a zéro."

msgctxt "sm1/BRIEFING.001/packet/33/scene/1/record/9"
msgid "wc1:1660245eff57778b $R"
msgstr "Et Marshall... j'avais de l'espoir pour ce gamin. Je suis content que vous ayez survecu, $R."

msgctxt "sm1/BRIEFING.001/packet/33/scene/1/record/10"
msgid "wc1:13aff7e14ad665ed $C"
msgstr "$C, Je dois vous voir dans mon bureau plus tard."

msgctxt "sm1/BRIEFING.001/packet/33/scene/1/record/11"
msgid "wc1:89a10f84b8d3cbb4"
msgstr "Rompez."

msgctxt "sm1/BRIEFING.001/packet/33/scene/2/record/0"
msgid "wc1:fb96b85626f68a35 $C"
msgstr "$C! Que fait-tu ici? Nous sommes en alerte code rouge!"

