msgctxt "LauncherWindow"
msgid "FM Towns: English/Japanese text."
msgstr "FM Towns: texto en inglés/japonés."

#: src/sdl/slint/launcher.slint:47
msgctxt "LauncherWindow"
msgid "Sega CD voices"
msgstr "Voces de Sega CD"

#: src/sdl/slint/launcher.slint:49
msgctxt "LauncherWindow"
msgid "Select game data…"
msgstr "Selecciona los datos del juego…"

#: src/sdl/slint/launcher.slint:49
msgctxt "LauncherWindow"
msgid "No game data found — add a path"
msgstr "No se encontraron datos — añade una carpeta"

#: src/sdl/slint/launcher.slint:52
msgctxt "LauncherWindow"
msgid "SWC Mac demo"
msgstr "Demo de SWC para Mac"

#: src/sdl/slint/launcher.slint:57
msgctxt "LauncherWindow"
msgid "Choose a Wing Commander directory."
msgstr "Elige una carpeta de Wing Commander."

#: src/sdl/slint/launcher.slint:58
msgctxt "LauncherWindow"
msgid "The directory path is too long."
msgstr "La ruta de la carpeta es demasiado larga."

#: src/sdl/slint/launcher.slint:59
msgctxt "LauncherWindow"
msgid "The selected path is not a directory."
msgstr "La ruta seleccionada no es una carpeta."

#: src/sdl/slint/launcher.slint:60
msgctxt "LauncherWindow"
msgid "SWC needs CMFs/{}."
msgstr "SWC necesita CMFs/{}."

#: src/sdl/slint/launcher.slint:61
msgctxt "LauncherWindow"
msgid "Invalid SWC archive: {}."
msgstr "Archivo de SWC no válido: {}."

#: src/sdl/slint/launcher.slint:62
msgctxt "LauncherWindow"
msgid "SWC resources missing: keep the demo application with its resource fork (a MacBinary copy also works) or add SuperWingCommanderDemo.rsrc."
msgstr "Faltan recursos de SWC: conserva la aplicación de la demo con su archivo de recursos (también sirve una copia MacBinary) o añade SuperWingCommanderDemo.rsrc."

#: src/sdl/slint/launcher.slint:63
msgctxt "LauncherWindow"
msgid "Choose a WC1 directory containing GAMEDAT or the SWC demo directory containing CMFs."
msgstr "Elige una carpeta de WC1 que contenga GAMEDAT o una carpeta de la demo de SWC que contenga CMFs."

#: src/sdl/slint/launcher.slint:64
msgctxt "LauncherWindow"
msgid "GAMEDAT/MODULE.000 is missing. Select a WC1 installation."
msgstr "Falta GAMEDAT/MODULE.000. Selecciona una instalación de WC1."

#: src/sdl/slint/launcher.slint:65
msgctxt "LauncherWindow"
msgid "GAMEDAT/MODULE.000 is unreadable or too small to identify."
msgstr "GAMEDAT/MODULE.000 no se puede leer o es demasiado pequeño para identificarlo."

#: src/sdl/slint/launcher.slint:66
msgctxt "LauncherWindow"
msgid "GAMEDAT/{} is missing or unreadable."
msgstr "GAMEDAT/{} no existe o no se puede leer."

#: src/sdl/slint/launcher.slint:67
msgctxt "LauncherWindow"
msgid "Kilrathi Saga data needs a sibling STREAMS directory."
msgstr "Los datos de Kilrathi Saga necesitan una carpeta STREAMS junto a GAMEDAT."

#: src/sdl/slint/launcher.slint:68
msgctxt "LauncherWindow"
msgid "STREAMS/{} is missing or unreadable."
msgstr "STREAMS/{} no existe o no se puede leer."

#: src/sdl/slint/launcher.slint:70
msgctxt "LauncherWindow"
msgid "The folder picker failed"
msgstr "Falló el selector de carpetas"

#: src/sdl/slint/launcher.slint:71
msgctxt "LauncherWindow"
msgid "The folder picker could not be initialized"
msgstr "No se pudo iniciar el selector de carpetas"

#: src/sdl/slint/launcher.slint:72
msgctxt "LauncherWindow"
msgid "Cannot resolve the game directory"
msgstr "No se pudo resolver la ruta del juego"

#: src/sdl/slint/launcher.slint:73
msgctxt "LauncherWindow"
msgid "Cannot open the game directory"
msgstr "No se pudo abrir la carpeta del juego"

#: src/sdl/slint/launcher.slint:105
msgctxt "LauncherWindow"
msgid "Game installation"
msgstr "Instalación del juego"

#: src/sdl/slint/launcher.slint:127
msgctxt "LauncherWindow"
msgid "Add path…"
msgstr "Añadir carpeta…"

#: src/sdl/slint/launcher.slint:138
msgctxt "LauncherWindow"
msgid "Language"
msgstr "Idioma"

#: src/sdl/slint/launcher.slint:176
msgctxt "LauncherWindow"
msgid "Graphics"
msgstr "Gráficos"

#: src/sdl/slint/launcher.slint:185
msgctxt "LauncherWindow"
msgid "Start in fullscreen"
msgstr "Pantalla completa al iniciar"

#: src/sdl/slint/launcher.slint:191
msgctxt "LauncherWindow"
msgid "Enhanced OpenGL"
msgstr "OpenGL mejorado"

#: src/sdl/slint/launcher.slint:197
msgctxt "LauncherWindow"
msgid "EGA dithering (WC1 only)"
msgstr "Tramado EGA (solo WC1)"

#: src/sdl/slint/launcher.slint:197
msgctxt "LauncherWindow"
msgid "EGA 16-colour dithering"
msgstr "Tramado EGA de 16 colores"

#: src/sdl/slint/launcher.slint:205
msgctxt "LauncherWindow"
msgid "Gameplay"
msgstr "Juego"

#: src/sdl/slint/launcher.slint:214
msgctxt "LauncherWindow"
msgid "Autosave (WC1 only)"
msgstr "Autoguardado (solo WC1)"

#: src/sdl/slint/launcher.slint:214
msgctxt "LauncherWindow"
msgid "Autosave (slot 8)"
msgstr "Autoguardado (casilla 8)"

#: src/sdl/slint/launcher.slint:221
msgctxt "LauncherWindow"
msgid "Cockpitless view"
msgstr "Vista sin cabina"

#: src/sdl/slint/launcher.slint:227
msgctxt "LauncherWindow"
msgid "Cheat mode"
msgstr "Trucos"

#: src/sdl/slint/launcher.slint:232
msgctxt "LauncherWindow"
msgid "Invulnerability and no collisions"
msgstr "Invulnerabilidad y sin colisiones"

#: src/sdl/slint/launcher.slint:244
msgctxt "LauncherWindow"
msgid "Joystick"
msgstr "Mando"

#: src/sdl/slint/launcher.slint:253
msgctxt "LauncherWindow"
msgid "Control mode"
msgstr "Modo de control"

#: src/sdl/slint/launcher.slint:263
msgctxt "LauncherWindow"
msgid "Original — two axes / two buttons"
msgstr "Original — 2 ejes / 2 botones"

#: src/sdl/slint/launcher.slint:264
msgctxt "LauncherWindow"
msgid "WCAT — four buttons / two axes"
msgstr "WCAT — 4 botones / 2 ejes"

#: src/sdl/slint/launcher.slint:265
msgctxt "LauncherWindow"
msgid "WCAT — four buttons / four axes"
msgstr "WCAT — 4 botones / 4 ejes"

#: src/sdl/slint/launcher.slint:275
msgctxt "LauncherWindow"
msgid "Axis layout"
msgstr "Asignación de ejes"

#: src/sdl/slint/launcher.slint:286
msgctxt "LauncherWindow"
msgid "Twin-stick roll"
msgstr "Doble palanca: alabeo"

#: src/sdl/slint/launcher.slint:287
msgctxt "LauncherWindow"
msgid "Twin-stick yaw"
msgstr "Doble palanca: guiñada"

#: src/sdl/slint/launcher.slint:288
msgctxt "LauncherWindow"
msgid "HOTAS yaw"
msgstr "HOTAS: guiñada"

#: src/sdl/slint/launcher.slint:289
msgctxt "LauncherWindow"
msgid "HOTAS roll"
msgstr "HOTAS: alabeo"

#: src/sdl/slint/launcher.slint:290
msgctxt "LauncherWindow"
msgid "Linear throttle"
msgstr "Acelerador lineal"

#: src/sdl/slint/launcher.slint:291
msgctxt "LauncherWindow"
msgid "Rudder yaw"
msgstr "Timón: guiñada"

#: src/sdl/slint/launcher.slint:292
msgctxt "LauncherWindow"
msgid "Rudder roll"
msgstr "Timón: alabeo"

#: src/sdl/slint/launcher.slint:302
msgctxt "LauncherWindow"
msgid "Rumble"
msgstr "Vibración"

#: src/sdl/slint/launcher.slint:321
msgctxt "LauncherWindow"
msgid "Mouse/arrows: steer · Right-drag: roll/throttle"
msgstr "Ratón/flechas: dirección · Arrastre derecho: alabeo/acelerador"

#: src/sdl/slint/launcher.slint:321
msgctxt "LauncherWindow"
msgid "Close this window to cancel."
msgstr "Cierra esta ventana para cancelar."

#: src/sdl/slint/launcher.slint:329
msgctxt "LauncherWindow"
msgid "Cancel"
msgstr "Cancelar"

#: src/sdl/slint/launcher.slint:336
msgctxt "LauncherWindow"
msgid "Start game"
msgstr "Iniciar juego"
