#: src/sdl/slint/controls.slint:591
msgctxt "ControlsWindow"
msgid "SWC has no keys for the left stick's click or for D-pad up, down and right."
msgstr "SWC no tiene teclas para pulsar la palanca izquierda ni para arriba, abajo y derecha en la cruceta."

#: src/sdl/slint/controls.slint:592
msgctxt "ControlsWindow"
msgid "In menus, A selects, B and Back go back, X presses Space and the D-pad moves."
msgstr "En los menús, A selecciona, B y Back vuelven, X pulsa Espacio y la cruceta mueve."

#: src/sdl/slint/controls.slint:596
msgctxt "ControlsWindow"
msgid "In the communications display, the D-pad's up and down choose, right sends and left closes."
msgstr "En la pantalla de comunicaciones, arriba y abajo en la cruceta eligen, derecha envía e izquierda cierra."

#: src/sdl/slint/controls.slint:597
msgctxt "ControlsWindow"
msgid "Y answers Yes in prompts. Game controllers leave LT and RT unused."
msgstr "Y responde Sí en las preguntas. Los mandos no usan LT ni RT."

