#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/12/record/4"
msgid "wc1:d654d9333d32df54"
msgstr "¡Socorro, ayuda por favor!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/12/record/5"
msgid "wc1:2cd6f7e6f1651eb6"
msgstr "¡He derribado un caza enemigo!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/12/record/6"
msgid "wc1:cf5360964ed54b2f $R $N"
msgstr "Me alegro de tenerle con nosotros, $R $N."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/12/record/7"
msgid "wc1:27621f6ff8b6856c $C"
msgstr "Siga luchando, $C, ¡para mí se ha terminado!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/12/record/8"
msgid "wc1:504f95e45ec2f088 $C"
msgstr "$C, tiene permiso para aterrizar."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/12/record/9"
msgid "wc1:22e9ff73ab041fae $C"
msgstr "Negativo, $C. No aterrice."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/12/record/10"
msgid "wc1:63399c33ee4c5ea9"
msgstr "¡Cuidado, soy yo!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/0"
msgid "wc1:ec4b552fe4f39460"
msgstr "¡Muere, escoria simia!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/1"
msgid "wc1:7774b3d10e026ebe"
msgstr "¡No sobrevivirás a este combate!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/2"
msgid "wc1:505fd1102c40a863"
msgstr "¿Esto es lo mejor que pueden ofrecer los monos?"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/3"
msgid "wc1:fd386d54098a6965"
msgstr "Luchas como un gatito recién nacido."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/4"
msgid "wc1:4db446447ec45caf"
msgstr "¡Me daré un festín con tus entrañas!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/5"
msgid "wc1:f2b21b1c0960640e"
msgstr "El destino adecuado para un cobarde."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/6"
msgid "wc1:ce5e621b9af8fae6"
msgstr "¡Ah! ¡Así que el niño simio puede luchar!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/7"
msgid "wc1:2bf80d1d205dbc16"
msgstr "¡Mi prole me vengará!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/8"
msgid "wc1:bc73ab47aabd4ec2"
msgstr "¡Los tuyos pronto serán nuestros esclavos!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/13/record/9"
msgid "wc1:583059077153030c"
msgstr "¡Ya volveremos a luchar!"
