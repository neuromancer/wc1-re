#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/0/record/0"
msgid "wc1:8cd491d512773aa1"
msgstr "Es un honor obedecer."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/0/record/1"
msgid "wc1:10942846bb7b4ca5"
msgstr "No puedo hacer eso, amigo mío."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/0/record/2"
msgid "wc1:3b8ddb25744f1359 $C"
msgstr "¡$C, naves enemigas delante!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/0/record/3"
msgid "wc1:037866e19a9f6e41 $R"
msgstr "¡Listo para atacar, $R!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/0/record/4"
msgid "wc1:8e4d1c71a6353a1b"
msgstr "¡Eh, necesito su ayuda!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/0/record/5"
msgid "wc1:e4933259801e0a9c"
msgstr "¡He conseguido matar a uno!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/0/record/6"
msgid "wc1:9876e307b6aeb3b1 $N"
msgstr "¡Un disparo excelente, $N!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/0/record/7"
msgid "wc1:0b65dee424e6b077"
msgstr "Adiós, amigo mío. Me esperan mis antepasados..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/0/record/8"
msgid "wc1:52a3dd064d254382"
msgstr "¡Debemos irnos ya o no sobreviviremos a este combate!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/0/record/9"
msgid "wc1:0d86bfdb829aa096"
msgstr "No puedo seguir con el combate. Buena suerte, amigo mío."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/0/record/10"
msgid "wc1:5d404b8724fd2b25"
msgstr "¡Vaya con cuidado, amigo mío!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/1/record/0"
msgid "wc1:aecc30dae30d1321"
msgstr "¡No se preocupe, compañero!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/1/record/1"
msgid "wc1:0f59e394c586fc31 $C"
msgstr "¡No puedo hacer eso ahora, $C!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/1/record/2"
msgid "wc1:fe8487160ec1f59a $C"
msgstr "¡$C! ¡Naves enemigas delante!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/1/record/3"
msgid "wc1:81326d3ee8f339d2 $C"
msgstr "¡Acabemos con esos gatos, $C!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/1/record/4"
msgid "wc1:b3c6a6d886811a0e $C"
msgstr "¡$C, tengo problemas! ¡Echeme una mano!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/1/record/5"
msgid "wc1:4dbe2edcec7bd7e2"
msgstr "¡He acabado con él!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/1/record/6"
msgid "wc1:c4b50e5909da7f4f"
msgstr "¡Buena puntería, as!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/1/record/7"
msgid "wc1:47f81b3c2ccfd6f8 $C"
msgstr "¡$C, me han dado! Todo se vuelve blanco... no veo nada..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/1/record/8"
msgid "wc1:cd9ae37a8e57cda1"
msgstr "¡Comandante, son muy duros para nosotros! ¡Salgamos de aquí!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/1/record/9"
msgid "wc1:1ff7dd753f1cac25 $C"
msgstr "No puedo recibir muchos más daños, $C, vuelvo a la base."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/1/record/10"
msgid "wc1:b10459fc861afa3c"
msgstr "¡Vigile con su objetivo, compañero!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/2/record/0"
msgid "wc1:bccc69ac7559c213"
msgstr "¡Ya lo tiene, Maestro!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/2/record/1"
msgid "wc1:45cdc205baa36779"
msgstr "No puedo hacer eso, Maestro."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/2/record/2"
msgid "wc1:4d4e2356b360eaee $C"
msgstr "¡Vayamos a por esos gatos, $C!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/2/record/3"
msgid "wc1:c01d0a410bddafcc $R"
msgstr "Le estoy esperando, $R."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/2/record/4"
msgid "wc1:41e804bb99ba47ab $C"
msgstr "¡$C, pierdo energía! ¡Ayúdeme!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/2/record/5"
msgid "wc1:1befd83a94ccb0fa"
msgstr "¡Aquí tienes tu billete, peludo!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/2/record/6"
msgid "wc1:cb8f6529c8180a05"
msgstr "¡No está mal, Maestro!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/2/record/7"
msgid "wc1:162d0557bd75be65 $R"
msgstr "¡Arde mi cabina... no puedo eyectar... $R!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/2/record/8"
msgid "wc1:c722686a6257f672 $C"
msgstr "¡Es la hora de terminar esto y volver a casa, $C!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/2/record/9"
msgid "wc1:e283571a83544a84"
msgstr "Lo siento, Maestro, tendrá que ir solo esta vez."

#. Reviewed locally: translate the original sentence and preserve its tokens.
#. Original field capacity: 79 encoded bytes before NUL.
#. Campaign substitution tokens differ; review before use
msgctxt "sm2/COMMSM2.DAT/speaker/2/record/10"
msgid "wc1:d5e5014123ca1e69 $C"
msgstr "¡Cuidado, $C!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/3/record/0"
msgid "wc1:b5826d95fbc03f19"
msgstr "Procedo."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/3/record/1"
msgid "wc1:446c8159aa56af95"
msgstr "No puedo cumplir esa orden."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/3/record/2"
msgid "wc1:07fe5a96a60b8ae2"
msgstr "Naves enemigas avistadas."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/3/record/3"
msgid "wc1:f63f86e8d445f686"
msgstr "Listo para atacar."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/3/record/4"
msgid "wc1:fabbb1658927a1dd"
msgstr "¡Solicito asistencia!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/3/record/5"
msgid "wc1:f8220c81106988e6"
msgstr "Esto es por lo de Vega 9, bastardos."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/3/record/6"
msgid "wc1:4bae01305e208ca2"
msgstr "Bien."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/3/record/7"
msgid "wc1:8c21facfc7d0d070"
msgstr "Vengad mi planeta, porque yo no puedo..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/3/record/8"
msgid "wc1:8ff53b191906efdf $R"
msgstr "¡$R, no hay probabilidades de ganar!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/3/record/9"
msgid "wc1:3ca4e739c237ba40 $C"
msgstr "Demasiados daños, $C... vuelvo a la Garra de Trigre."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/3/record/10"
msgid "wc1:0de5eb662324ea71 $R"
msgstr "¡Vigile su objetivo, $R!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/0"
msgid "wc1:f9f691552aef6308 $C"
msgstr "¡Oui, $C!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/1"
msgid "wc1:c2c5e15b4ccf16ec"
msgstr "Non, amigo mío. No puedo"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/2"
msgid "wc1:042c29839d51917d $C"
msgstr "¡Enemigo avistado, $C!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/3"
msgid "wc1:af93af2a2a2cf76e"
msgstr "¿Vamos a por ellos, amigo mío?"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/4"
msgid "wc1:cdaeaea268ae05fc $C"
msgstr "¡Ayúdeme, $C!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/5"
msgid "wc1:4ad573740719b234"
msgstr "¡Caza enemigo destruido!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/6"
msgid "wc1:6fa666865b5c19c8"
msgstr "¡Excelente, amigo mío!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/7"
msgid "wc1:adff40f21d9075cf $C $R"
msgstr "¡$C! Pierdo los controles... ¡$R, AYUDEME!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/8"
msgid "wc1:fb466533c0ffdfd2 $N"
msgstr "¡$N, tenemos que retirarnos!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/9"
msgid "wc1:505e562cc3b971ba $C"
msgstr "Tengo que volver ya al portanaves, $C."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/4/record/10"
msgid "wc1:cbb0480a92a5eccb $C"
msgstr "¡$C! ¡Vaya con cuidado, amigo mío!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/0"
msgid "wc1:6cb804d0e138c8e2 $N"
msgstr "Afirmativo, $N. Aunque seguramente no importe mucho..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/1"
msgid "wc1:e7caffad241bf6a2 $N"
msgstr "Negativo, $N."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/2"
msgid "wc1:f3fcc609e1fd5eeb $R"
msgstr "Naves enemigas delante, $R. Estamos en un lío..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/3"
msgid "wc1:e8b68c1d3316f8b0"
msgstr "Probablemente no sobreviva a esto..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/4"
msgid "wc1:f192d8989bd8e144 $C"
msgstr "$C, seguramente moriré en unos pocos segundos..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/5"
msgid "wc1:25cd7158ba68d5c2"
msgstr "¡Nave derribada! Pero seguramente perderemos este combate..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/6"
msgid "wc1:469d0db4c63f1316 $C"
msgstr "¡Buen disparo, $C! Tal vez incluso sobrevivamos..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/7"
msgid "wc1:8f7c0b7a386f8e63"
msgstr "Sabía que esto tenía ocurriría algún día..."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/8"
msgid "wc1:278453f4633237ea"
msgstr "Sabe que acabaremos muriendo si nos quedamos aquí, ¿no?"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/9"
msgid "wc1:06fae539c9cf260e $C"
msgstr "Adiós, $C. Espero que sobreviva a este combate."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/5/record/10"
msgid "wc1:78cb4b67da29bb00"
msgstr "Odio cuando hace eso."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/0"
msgid "wc1:d30af8eef0f22370"
msgstr "¿Qué?"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/1"
msgid "wc1:d30af8eef0f22370"
msgstr "¿Qué?"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/2"
msgid "wc1:950589424c7591bc"
msgstr "¡Velocidad de embestida!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/3"
msgid "wc1:d93667e4c9cff0df"
msgstr "¡Vaya a por ellos, cobarde!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/4"
msgid "wc1:df18153e006093d6 $C"
msgstr "¡Estoy en un lío, $C!  ¡Venga echando leches!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/5"
msgid "wc1:862592ddc935f272"
msgstr "¡Mire qué fuegos artificiales!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/6"
msgid "wc1:5e55200c88932832"
msgstr "¡Me ha robado el derribo, bastardo!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/7"
msgid "wc1:203576b7d92cb4e6"
msgstr "¡No! ¡No quiero morir"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/8"
msgid "wc1:21e9ee4f840ed1aa"
msgstr "¡Salgamos de aquí, hombre!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/9"
msgid "wc1:7bed4a7965dd0ce5"
msgstr "¡He acabado! ¡Me marcho de aquí!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/6/record/10"
msgid "wc1:21834a75d101e1cb"
msgstr "¡Te mataré, bastardo!"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/0"
msgid "wc1:b81f8f96e6195585 $R"
msgstr "Afirmativo, $R."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/1"
msgid "wc1:e7f3ffad243efbb6 $R"
msgstr "Negativo, $R."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/2"
msgid "wc1:68ec3963871bc85e $R"
msgstr "Enemigo delante, $R."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/3"
msgid "wc1:210c5af338b9d004"
msgstr "¿Permiso para romper la formación y atacar, Señor?"

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/4"
msgid "wc1:2b057016a9c17288 $C"
msgstr "$C, ayúdeme, por favor."

#. Original field capacity: 79 encoded bytes before NUL.
msgctxt "sm2/COMMSM2.DAT/speaker/7/record/5"
msgid "wc1:63997f7307048607 $C"
msgstr "Uno menos, $C."

#. Original field capacity: 79 encoded bytes before NUL.
