import {
    Button,
    CheckBox,
    ComboBox,
    GroupBox,
    Palette,
    VerticalBox
} from "std-widgets.slint";

export { ControlsWindow, PadControl } from "controls.slint";

export enum LauncherMessage {
    choose-directory, path-too-long, not-directory, missing-swc-file,
    invalid-swc-archive, missing-swc-resources, choose-data-directory,
    missing-module, unreadable-module, missing-game-file, needs-streams,
    missing-stream-file, picker-failed, picker-init-failed,
    cannot-resolve-directory, cannot-open-directory, dos, kilrathi-saga, mac-demo, mac-retail, fm-towns
}

export component LauncherWindow inherits Window {
    title: "Wing Commander";
    preferred-width: 760px;
    preferred-height: 660px;
    min-width: 640px;
    background: Palette.background;

    in property <image> title-artwork;
    in-out property <string> game-directory;
    in property <[string]> installations;
    in property <bool> has-installations;
    in-out property <int> installation-index;
    in-out property <bool> start-fullscreen;
    in-out property <bool> autosave;
    in-out property <int> language-index;
    in property <bool> towns-data: false;
    out property <[string]> language-choices: root.towns-data
        ? ["English", "Español", "Japanese (FM Towns)", "Français"]
        : ["English", "Español", "Français"];
    in-out property <bool> enhanced-renderer;
    in-out property <bool> ega-dither;
    in-out property <bool> cockpitless-view;
    in-out property <bool> cheat-mode;
    in-out property <bool> joystick-rumble;
    in-out property <int> joystick-mode-index;
    in-out property <int> joystick-axes-index;

    in property <bool> path-valid: false;
    in property <bool> picker-error: false;
    in property <bool> swc-demo: false;
    in property <bool> sm1-data: false;
    in property <bool> sm2-data: false;
    in property <bool> swc-credits: false;
    in property <LauncherMessage> status;
    in property <string> status-detail;
    out property <string> status-text: message-text(root.status, root.status-detail);
    out property <string> voice-label: @tr("Sega CD voices");
    out property <string> installation-prompt: root.has-installations
        ? @tr("Select game data…") : @tr("No game data found — add a path");
    // The controller bindings window covers WC1's DOS and Kilrathi Saga data.
    out property <bool> controls-available: root.path-valid
        && (root.status == LauncherMessage.dos || root.status == LauncherMessage.kilrathi-saga);

    public pure function edition-text(edition: LauncherMessage) -> string {
        if edition == LauncherMessage.fm-towns { return "FM Towns"; }
        if edition == LauncherMessage.mac-demo { return @tr("SWC Mac demo"); }
        if edition == LauncherMessage.mac-retail { return @tr("SWC Mac"); }
        return edition == LauncherMessage.dos ? "DOS" : "Kilrathi Saga";
    }

    public pure function message-text(message: LauncherMessage, detail: string) -> string {
        if message == LauncherMessage.fm-towns { return @tr("FM Towns: English/Japanese text."); }
        if message == LauncherMessage.choose-directory { return @tr("Choose a Wing Commander directory."); }
        if message == LauncherMessage.path-too-long { return @tr("The directory path is too long."); }
        if message == LauncherMessage.not-directory { return @tr("The selected path is not a directory."); }
        if message == LauncherMessage.missing-swc-file { return @tr("SWC needs CMFs/{}.", detail); }
        if message == LauncherMessage.invalid-swc-archive { return @tr("Invalid SWC archive: {}.", detail); }
        if message == LauncherMessage.missing-swc-resources { return @tr("SWC resources missing: keep the application with its resource fork (a MacBinary copy also works) beside the CMFs directory."); }
        if message == LauncherMessage.choose-data-directory { return @tr("Choose a WC1 directory containing GAMEDAT or an SWC directory containing CMFs."); }
        if message == LauncherMessage.missing-module { return @tr("GAMEDAT/MODULE.000 is missing. Select a WC1 installation."); }
        if message == LauncherMessage.unreadable-module { return @tr("GAMEDAT/MODULE.000 is unreadable or too small to identify."); }
        if message == LauncherMessage.missing-game-file { return @tr("GAMEDAT/{} is missing or unreadable.", detail); }
        if message == LauncherMessage.needs-streams { return @tr("Kilrathi Saga data needs a sibling STREAMS directory."); }
        if message == LauncherMessage.missing-stream-file { return @tr("STREAMS/{} is missing or unreadable.", detail); }
        // OS-provided details retain the system language.
        if message == LauncherMessage.picker-failed { return @tr("The folder picker failed") + (detail == "" ? "" : ": " + detail); }
        if message == LauncherMessage.picker-init-failed { return @tr("The folder picker could not be initialized") + (detail == "" ? "" : ": " + detail); }
        if message == LauncherMessage.cannot-resolve-directory { return @tr("Cannot resolve the game directory") + (detail == "" ? "" : ": " + detail); }
        if message == LauncherMessage.cannot-open-directory { return @tr("Cannot open the game directory") + (detail == "" ? "" : ": " + detail); }
        return "";
    }

    callback browse-requested();
    callback installation-selected(int);
    callback language-selected(int);
    callback launch-requested(int, bool);
    callback credits-requested();
    callback cancel-requested();
    callback controls-requested();
    // The selectors the controls window follows while it is open.
    callback controls-layout-changed();

    changed joystick-mode-index => {
        root.controls-layout-changed();
    }
    changed joystick-axes-index => {
        root.controls-layout-changed();
    }

    VerticalBox {
        padding: 18px;
        spacing: 12px;

        Rectangle {
            height: 88px;
            vertical-stretch: 0;
            background: #000018;
            border-radius: 6px;

            Image {
                x: 12px;
                y: 7px;
                width: parent.width - 24px;
                height: parent.height - 14px;
                source: root.title-artwork;
                image-fit: contain;
                image-rendering: pixelated;
            }
        }

        GroupBox {
            title: @tr("Game installation");
            vertical-stretch: 0;

            VerticalLayout {
                spacing: 8px;
                alignment: start;

                HorizontalLayout {
                    spacing: 8px;
                    height: 34px;

                    ComboBox {
                        horizontal-stretch: 1;
                        enabled: root.has-installations;
                        model: root.installations;
                        current-index <=> root.installation-index;
                        selected(_) => {
                            root.installation-selected(self.current-index);
                        }
                    }

                    Button {
                        text: @tr("Add path…");
                        clicked => {
                            root.browse-requested();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    height: 34px;
                    Text {
                        text: @tr("Language");
                        vertical-alignment: center;
                    }
                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.language-choices;
                        current-index: !root.towns-data && root.language-index == 3 ? 2 : root.language-index;
                        selected(_) => {
                            root.language-selected(!root.towns-data && self.current-index == 2 ? 3 : self.current-index);
                        }
                    }
                }

                if root.picker-error || !root.path-valid : HorizontalLayout {
                    spacing: 8px;
                    vertical-stretch: 0;

                    Text {
                        text: root.picker-error ? "!" : "●";
                        color: root.picker-error ? #b3261e : #b45f06;
                        font-size: 14px;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.status-text;
                        color: root.picker-error ? #b3261e : #b45f06;
                        wrap: word-wrap;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 18px;
            vertical-stretch: 0;

            GroupBox {
                title: @tr("Graphics");
                horizontal-stretch: 1;

                VerticalLayout {
                    spacing: 8px;
                    alignment: start;

                    CheckBox {
                        height: 26px;
                        text: @tr("Start in fullscreen");
                        checked <=> root.start-fullscreen;
                    }

                    CheckBox {
                        height: 26px;
                        text: @tr("Enhanced OpenGL");
                        checked <=> root.enhanced-renderer;
                    }

                    CheckBox {
                        height: 26px;
                        text: root.swc-demo ? @tr("EGA dithering (WC1 only)") : @tr("EGA 16-colour dithering");
                        enabled: !root.swc-demo;
                        checked <=> root.ega-dither;
                    }
                }
            }

            GroupBox {
                title: @tr("Gameplay");
                horizontal-stretch: 1;

                VerticalLayout {
                    spacing: 8px;
                    alignment: start;

                    CheckBox {
                        height: 26px;
                        text: @tr("Autosave (slot 8)");
                        checked <=> root.autosave;
                    }

                    CheckBox {
                        height: 26px;
                        text: @tr("Cockpitless view");
                        checked <=> root.cockpitless-view;
                    }

                    CheckBox {
                        height: 26px;
                        text: @tr("Cheat mode");
                        checked <=> root.cheat-mode;
                    }

                    Text {
                        text: @tr("Invulnerability and no collisions");
                        color: Palette.foreground;
                        opacity: 0.65;
                        font-size: 12px;
                        wrap: word-wrap;
                        vertical-stretch: 0;
                    }
                }
            }
        }

        GroupBox {
            title: @tr("Joystick");
            vertical-stretch: 0;

            GridLayout {
                spacing: 10px;

                Row {

                    Text {
                        text: @tr("Control mode");
                        vertical-alignment: center;
                        min-width: 105px;
                        color: Palette.foreground;
                    }

                    ComboBox {
                        height: 34px;
                        horizontal-stretch: 1;
                        model: [
                            @tr("Original — two axes / two buttons"),
                            @tr("WCAT — four buttons / two axes"),
                            @tr("WCAT — four buttons / four axes")
                        ];
                        current-index <=> root.joystick-mode-index;
                    }

                }

                Row {

                    Text {
                        text: @tr("Axis layout");
                        vertical-alignment: center;
                        min-width: 105px;
                        color: Palette.foreground;
                    }

                    ComboBox {
                        height: 34px;
                        horizontal-stretch: 1;
                        enabled: root.joystick-mode-index == 2;
                        model: [
                            @tr("Twin-stick roll"),
                            @tr("Twin-stick yaw"),
                            @tr("HOTAS yaw"),
                            @tr("HOTAS roll"),
                            @tr("Linear throttle"),
                            @tr("Rudder yaw"),
                            @tr("Rudder roll")
                        ];
                        current-index <=> root.joystick-axes-index;
                    }
                }

                HorizontalLayout {
                    row: 2;
                    col: 1;
                    spacing: 8px;

                    CheckBox {
                        height: 26px;
                        text: @tr("Rumble");
                        checked <=> root.joystick-rumble;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        text: @tr("Show controls…");
                        enabled: root.controls-available;
                        clicked => {
                            root.controls-requested();
                        }
                    }
                }
            }
        }

        // Resizing gives extra space to this gap, not to the controls above.
        Rectangle {
            min-height: 0px;
            vertical-stretch: 1;
        }

        if root.path-valid && (root.sm1-data || root.sm2-data): HorizontalLayout {
            spacing: 8px;
            height: 34px;
            vertical-stretch: 0;

            Rectangle { horizontal-stretch: 1; }

            if root.path-valid && root.sm1-data: Button {
                text: @tr("Transfer pilot to SM1…");
                clicked => { root.launch-requested(1, true); }
            }

            if root.path-valid && root.sm2-data: Button {
                text: @tr("Transfer pilot to SM2…");
                clicked => { root.launch-requested(2, true); }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            height: 34px;
            vertical-stretch: 0;

            Text {
                horizontal-stretch: 1;
                text: root.swc-demo ? @tr("Mouse/arrows: steer · Right-drag: roll/throttle") : @tr("Close this window to cancel.");
                wrap: word-wrap;
                color: Palette.foreground;
                opacity: 0.65;
                vertical-alignment: center;
            }

            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel-requested();
                }
            }

            Button {
                text: root.swc-demo ? @tr("Start SWC") : @tr("Start WC1");
                enabled: root.path-valid;
                primary: true;
                clicked => {
                    root.launch-requested(0, false);
                }
            }

            if root.path-valid && root.sm1-data: Button {
                text: @tr("Start SM1");
                clicked => {
                    root.launch-requested(1, false);
                }
            }

            if root.path-valid && root.sm2-data: Button {
                text: @tr("Start SM2");
                clicked => {
                    root.launch-requested(2, false);
                }
            }

            if root.path-valid && root.swc-demo && root.swc-credits: Button {
                text: @tr("Credits");
                clicked => {
                    root.credits-requested();
                }
            }
        }
    }
}
