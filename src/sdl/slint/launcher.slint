import {
    Button,
    CheckBox,
    ComboBox,
    GroupBox,
    Palette,
    VerticalBox
} from "std-widgets.slint";

export component LauncherWindow inherits Window {
    title: "Wing Commander";
    preferred-width: 760px;
    preferred-height: 620px;
    min-width: 640px;
    min-height: 520px;
    background: Palette.background;

    in property <image> title-artwork;
    in-out property <string> game-directory;
    in property <[string]> installations;
    in property <bool> has-installations;
    in-out property <int> installation-index;
    in-out property <bool> start-fullscreen;
    in-out property <bool> autosave;
    in-out property <bool> enhanced-renderer;
    in-out property <bool> ega-dither;
    in-out property <bool> cockpitless-view;
    in-out property <bool> cheat-mode;
    in-out property <bool> joystick-rumble;
    in-out property <int> joystick-mode-index;
    in-out property <int> joystick-axes-index;

    in property <bool> path-valid: false;
    in property <bool> picker-error: false;
    in property <bool> swc-demo: false;
    in property <string> status-text: "Choose a Wing Commander directory.";

    callback browse-requested();
    callback installation-selected(int);
    callback launch-requested();
    callback cancel-requested();

    VerticalBox {
        padding: 18px;
        spacing: 12px;

        Rectangle {
            height: 88px;
            vertical-stretch: 0;
            background: #000018;
            border-radius: 6px;

            Image {
                x: 12px;
                y: 7px;
                width: parent.width - 24px;
                height: parent.height - 14px;
                source: root.title-artwork;
                image-fit: contain;
                image-rendering: pixelated;
            }
        }

        GroupBox {
            title: "Game installation";
            vertical-stretch: 0;

            VerticalLayout {
                spacing: 8px;
                alignment: start;

                HorizontalLayout {
                    spacing: 8px;
                    height: 34px;

                    ComboBox {
                        horizontal-stretch: 1;
                        enabled: root.has-installations;
                        model: root.installations;
                        current-index <=> root.installation-index;
                        selected(_) => {
                            root.installation-selected(self.current-index);
                        }
                    }

                    Button {
                        text: "Add path…";
                        clicked => {
                            root.browse-requested();
                        }
                    }
                }

                if root.picker-error || !root.path-valid : HorizontalLayout {
                    spacing: 8px;
                    vertical-stretch: 0;

                    Text {
                        text: root.picker-error ? "!" : "●";
                        color: root.picker-error ? #b3261e : #b45f06;
                        font-size: 14px;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.status-text;
                        color: root.picker-error ? #b3261e : #b45f06;
                        wrap: word-wrap;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 18px;
            vertical-stretch: 0;

            GroupBox {
                title: "Graphics";
                horizontal-stretch: 1;

                VerticalLayout {
                    spacing: 8px;
                    alignment: start;

                    CheckBox {
                        height: 26px;
                        text: "Start in fullscreen";
                        checked <=> root.start-fullscreen;
                    }

                    CheckBox {
                        height: 26px;
                        text: "Enhanced OpenGL";
                        checked <=> root.enhanced-renderer;
                    }

                    CheckBox {
                        height: 26px;
                        text: root.swc-demo ? "EGA dithering (WC1 only)" : "EGA 16-colour dithering";
                        enabled: !root.swc-demo;
                        checked <=> root.ega-dither;
                    }
                }
            }

            GroupBox {
                title: "Gameplay";
                horizontal-stretch: 1;

                VerticalLayout {
                    spacing: 8px;
                    alignment: start;

                    CheckBox {
                        height: 26px;
                        text: root.swc-demo ? "Autosave (WC1 only)" : "Autosave (slot 8)";
                        enabled: !root.swc-demo;
                        checked <=> root.autosave;
                    }

                    CheckBox {
                        height: 26px;
                        text: "Cockpitless view";
                        checked <=> root.cockpitless-view;
                    }

                    CheckBox {
                        height: 26px;
                        text: "Cheat mode";
                        checked <=> root.cheat-mode;
                    }

                    Text {
                        text: "Invulnerability and no collisions";
                        color: Palette.foreground;
                        opacity: 0.65;
                        font-size: 12px;
                        wrap: word-wrap;
                        vertical-stretch: 0;
                    }
                }
            }
        }

        GroupBox {
            title: "Joystick";
            vertical-stretch: 0;

            GridLayout {
                spacing: 10px;

                Row {

                    Text {
                        text: "Control mode";
                        vertical-alignment: center;
                        width: 105px;
                        color: Palette.foreground;
                    }

                    ComboBox {
                        height: 34px;
                        horizontal-stretch: 1;
                        model: [
                            "Original — two axes / two buttons",
                            "WCAT — four buttons / two axes",
                            "WCAT — four buttons / four axes"
                        ];
                        current-index <=> root.joystick-mode-index;
                    }

                }

                Row {

                    Text {
                        text: "Axis layout";
                        vertical-alignment: center;
                        width: 105px;
                        color: Palette.foreground;
                    }

                    ComboBox {
                        height: 34px;
                        horizontal-stretch: 1;
                        enabled: root.joystick-mode-index == 2;
                        model: [
                            "Twin-stick roll",
                            "Twin-stick yaw",
                            "HOTAS yaw",
                            "HOTAS roll",
                            "Linear throttle",
                            "Rudder yaw",
                            "Rudder roll"
                        ];
                        current-index <=> root.joystick-axes-index;
                    }
                }

                CheckBox {
                    row: 2;
                    col: 1;
                    height: 26px;
                    text: "Rumble";
                    checked <=> root.joystick-rumble;
                }
            }
        }

        // Resizing gives extra space to this gap, not to the controls above.
        Rectangle {
            min-height: 0px;
            vertical-stretch: 1;
        }

        HorizontalLayout {
            spacing: 8px;
            height: 34px;
            vertical-stretch: 0;

            Text {
                horizontal-stretch: 1;
                text: root.swc-demo ? "Mouse/arrows: steer · Right-drag: roll/throttle" : "Close this window to cancel.";
                color: Palette.foreground;
                opacity: 0.65;
                vertical-alignment: center;
            }

            Button {
                text: "Cancel";
                clicked => {
                    root.cancel-requested();
                }
            }

            Button {
                text: "Start game";
                enabled: root.path-valid;
                primary: true;
                clicked => {
                    root.launch-requested();
                }
            }
        }
    }
}
