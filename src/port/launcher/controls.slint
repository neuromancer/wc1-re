// Flight bindings for the game controller, drawn in the style of SC
// Controller's binding display with its CC0 artwork (third_party/sc-controller),
// and for the keyboard and mouse, as a table that names each key in text so
// that any key can appear in it. It covers WC1's DOS and Kilrathi Saga data,
// whose keys and mouse can be rebound, and its game controller too in the
// Custom mode, and the SWC Mac data.
import { Button, CheckBox, ComboBox, ListView, Palette, ScrollView } from "std-widgets.slint";
import { SteamDeckView } from "steamdeck.slint";
import { Connector } from "control_connector.slint";

export enum PadControl {
    left-trigger, left-shoulder, left-stick, left-stick-click,
    dpad-up, dpad-down, dpad-left, dpad-right,
    right-trigger, right-shoulder, y, x, b, a, right-stick, right-stick-click,
    back, start,
    // The sticks' axes, bound one by one in the Custom mode.
    left-stick-x, left-stick-y, right-stick-x, right-stick-y
}

struct PadRow {
    control: PadControl,
    glyph: image,
    caption: string,
}

// The joystick the Joystick tab shows, as the launcher reads it live.
export struct PadDevice {
    connected: bool,
    // SDL maps it as a game controller, which the tab draws as one.
    mapped: bool,
    // It calls itself a joystick (src/port/launcher/launcher_axes.cpp).
    joystick: bool,
    name: string,
    buttons: int,
    hats: int,
    axes: int,
}

// A tooltip: an optional heading over a short explanation, both wrapped to
// a column narrow enough to show beside the element it explains.
component Hint inherits Rectangle {
    in property <string> title;
    in property <string> text;
    property <length> column: min(280px, max(heading.preferred-width, body.preferred-width));

    width: root.column + 18px;
    height: body.y + body.height + 6px;
    background: Palette.alternate-background;
    border-color: Palette.border;
    border-width: 1px;
    border-radius: 4px;
    drop-shadow-blur: 6px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #00000040;

    heading := Text {
        x: 9px;
        y: 6px;
        width: root.column;
        height: root.title == "" ? 0px : self.preferred-height;
        text: root.title;
        wrap: word-wrap;
        font-size: 12px;
        font-weight: 700;
        color: Palette.alternate-foreground;
    }

    body := Text {
        x: 9px;
        y: heading.y + heading.height + (root.title == "" ? 0px : 3px);
        width: root.column;
        height: self.preferred-height;
        text: root.text;
        wrap: word-wrap;
        font-size: 12px;
        color: Palette.alternate-foreground;
    }
}

// One labelled box: rows of glyph and action, joined to the drawing by a
// horizontal then a vertical line ending in a dot. A row lights up while its
// control is held. Every row reports the pointer resting on it, with where it
// is in the window, for a tooltip; editable rows can also be clicked to
// change them.
component BindingBox inherits Rectangle {
    in property <[PadRow]> rows;
    in property <string> title;
    in property <bool> editable;
    // Where the connector leaves the box; the middle unless set.
    in property <length> line-y: self.y + self.height / 2;
    pure callback binding(PadControl) -> string;
    pure callback held(PadControl) -> bool;
    callback row-clicked(PadRow);
    callback row-hovered(control: PadControl, hovered: bool, x: length, y: length, height: length);

    width: 236px;
    height: 24px + self.rows.length * 22px;
    background: Palette.alternate-background;
    border-color: Palette.border;
    border-width: 1px;
    border-radius: 6px;

    Text {
        x: 10px;
        y: 4px;
        text: root.title;
        font-size: 11px;
        font-weight: 700;
        color: Palette.alternate-foreground;
        opacity: 0.7;
    }

    for row[index] in root.rows: Rectangle {
        x: 4px;
        y: 20px + index * 22px;
        width: root.width - 8px;
        height: 22px;
        border-radius: 4px;
        background: root.held(row.control) ? Palette.accent-background.with-alpha(0.35)
            : root.editable && choose.has-hover ? Palette.accent-background.with-alpha(0.15) : transparent;

        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 7px;

            Image {
                width: 20px;
                height: 20px;
                source: row.glyph;
                image-fit: contain;
            }

            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: (row.caption == "" ? "" : row.caption + ": ")
                    + (root.binding(row.control) == "" ? "—" : root.binding(row.control));
                color: Palette.alternate-foreground;
                opacity: root.binding(row.control) == "" ? 0.45 : 1;
                font-size: 12px;
                overflow: elide;
            }
        }

        choose := TouchArea {
            mouse-cursor: root.editable ? MouseCursor.pointer : MouseCursor.default;
            clicked => {
                if root.editable {
                    root.row-clicked(row);
                }
            }
            changed has-hover => {
                root.row-hovered(row.control, self.has-hover, self.absolute-position.x,
                    self.absolute-position.y, self.height);
            }
        }
    }
}

// A choice in the binding chooser, which reports the pointer resting on it
// for a tooltip on what it does, and a heading above a group of them.
component ChoiceRow inherits Rectangle {
    in property <string> label;
    in property <string> help;
    in property <bool> selected;
    callback clicked();
    callback hovered(hovered: bool, x: length, y: length, height: length);

    height: 26px;
    border-radius: 4px;
    background: root.selected ? Palette.accent-background.with-alpha(0.25)
        : touch.has-hover ? Palette.accent-background.with-alpha(0.12) : transparent;

    Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        text: root.label;
        font-size: 13px;
        color: Palette.foreground;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
        changed has-hover => {
            root.hovered(self.has-hover, self.absolute-position.x, self.absolute-position.y, self.height);
        }
    }
}

// A raw joystick's axis position, -1 to 1, as a bar from the middle.
component AxisBar inherits Rectangle {
    in property <float> value;

    width: 52px;
    height: 10px;
    border-radius: 3px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.control-background;

    Rectangle {
        x: root.value < 0 ? (root.width / 2) * (1 + max(-1, root.value)) : root.width / 2;
        y: 1px;
        width: (root.width / 2) * min(1, abs(root.value));
        height: parent.height - 2px;
        border-radius: 2px;
        background: Palette.accent-background;
    }

    Rectangle {
        x: root.width / 2;
        width: 1px;
        height: parent.height;
        background: Palette.border;
    }
}

// One of a raw joystick's inputs: its number or glyph, an axis's live bar
// and name, and what it does. It lights up while held and reports the
// pointer as the drawing's rows do.
component PadInputRow inherits Rectangle {
    // The number, right-aligned in a column of its own.
    in property <string> label;
    in property <image> glyph;
    in property <string> name;
    in property <string> binding;
    in property <bool> held;
    in property <bool> editable;
    // An axis shows its position.
    in property <bool> bar;
    in property <float> value;
    callback clicked();
    callback hovered(hovered: bool, x: length, y: length, height: length);

    height: 22px;
    border-radius: 4px;
    background: root.held ? Palette.accent-background.with-alpha(0.35)
        : root.editable && touch.has-hover ? Palette.accent-background.with-alpha(0.15) : transparent;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 6px;

        if root.label != "": Text {
            min-width: 15px;
            horizontal-alignment: right;
            vertical-alignment: center;
            text: root.label;
            font-size: 12px;
            font-weight: 600;
            color: Palette.alternate-foreground;
        }

        if root.glyph.width > 0: Image {
            width: 18px;
            height: 18px;
            source: root.glyph;
            image-fit: contain;
        }

        if root.bar: VerticalLayout {
            alignment: center;

            AxisBar {
                value: root.value;
            }
        }

        if root.name != "": Text {
            vertical-alignment: center;
            text: root.name;
            font-size: 12px;
            font-weight: 600;
            color: Palette.alternate-foreground;
        }

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: root.binding == "" ? "—" : root.binding;
            opacity: root.binding == "" ? 0.45 : 1;
            font-size: 12px;
            color: Palette.alternate-foreground;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.editable ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if root.editable {
                root.clicked();
            }
        }
        changed has-hover => {
            root.hovered(self.has-hover, self.absolute-position.x, self.absolute-position.y, self.height);
        }
    }
}

// A titled group of a raw joystick's inputs, styled as the drawing's boxes.
component PadPanel inherits Rectangle {
    in property <string> title;

    background: Palette.alternate-background;
    border-color: Palette.border;
    border-width: 1px;
    border-radius: 6px;

    VerticalLayout {
        padding: 4px;
        padding-top: 2px;
        spacing: 0px;

        HorizontalLayout {
            padding-left: 6px;
            height: 18px;

            Text {
                vertical-alignment: center;
                text: root.title;
                font-size: 11px;
                font-weight: 700;
                color: Palette.alternate-foreground;
                opacity: 0.7;
            }
        }

        @children
    }
}

component ChoiceHeading inherits Text {
    height: 28px;
    vertical-alignment: bottom;
    font-size: 12px;
    font-weight: 700;
    color: Palette.foreground;
    opacity: 0.7;
}

// One way to give a game input: inputs used together (joiner "+"), a range
// of keys (joiner "–") or a single input, with a hint on how to use it.
// Inputs are names, not pictures, so any key can be shown: a typed character
// such as "e" or "ñ", or a name such as "up", "ctrl" or "mouse-left" (see
// ControlsView.input-label). A fixed binding cannot be changed: mouse
// movement, which steers, or Escape, which also closes menus.
export struct InputBinding {
    inputs: [string],
    joiner: string,
    hint: string,
    fixed: bool,
}

// A row of the keyboard and mouse table: a section heading, or a game input,
// how to use it, and its original bindings. The id names the input in the
// launcher settings and in src/port/input/keymap.c. A fixed row cannot be changed; a
// mouse-only row takes only mouse buttons; limit caps its bindings (0 uses
// ControlsView.max-bindings).
export struct InputRow {
    id: string,
    section: string,
    action: string,
    hint: string,
    fixed: bool,
    mouse-only: bool,
    limit: int,
    bindings: [InputBinding],
}

// A key, drawn as a keycap with a thicker lower edge, or a mouse action,
// drawn as a pill.
component KeyCap inherits Rectangle {
    in property <string> label;
    in property <bool> mouse;

    min-width: 26px;
    height: 26px;
    border-radius: root.mouse ? 13px : 5px;
    background: Palette.border;

    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - (root.mouse ? 2px : 3px);
        border-radius: root.mouse ? 12px : 4px;
        background: Palette.control-background;
    }

    HorizontalLayout {
        padding-left: root.mouse ? 11px : 8px;
        padding-right: root.mouse ? 11px : 8px;

        Text {
            text: root.label;
            vertical-alignment: center;
            horizontal-alignment: center;
            font-size: 12px;
            font-weight: 600;
            color: Palette.control-foreground;
        }
    }
}

// The bindings in a launcher tab: the game controller's drawn around the pad
// (page 0, under the joystick settings), or the keyboard and mouse's in a
// table (page 1). Both fit the tab, whose size sets the boxes' width and the
// pad's scale.
export component ControlsView inherits Rectangle {
    min-width: root.page == 0 ? 640px : 560px;
    min-height: root.page == 0
        ? (root.deck-view ? max(360px, deck-diagram.min-height + notes-text.preferred-height + 8px) : 360px)
        : 300px;

    // The launcher's joystick settings: 0 original, 1 WCAT four buttons and
    // two axes, 2 WCAT four buttons and four axes, 3 custom, 4 Steam Deck;
    // axis layouts 0-6.
    in property <int> joystick-mode;
    in property <int> joystick-axes;
    in property <int> joystick-source;
    // The Custom and Steam Deck modes apply to WC1; SWC keeps the four-axis
    // layout in both.
    property <bool> custom: root.joystick-mode == 3 && root.game == 0;
    property <bool> deck-view: root.game == 0 &&
        (root.joystick-mode == 4 || (root.custom && root.joystick-source == 2));
    property <int> layout-mode: root.joystick-mode >= 3 ? 2 : root.joystick-mode;
    // The Custom mode's bindings, one code per control in the order of
    // src/port/input/pad_bindings.h (A, B, X, Y, LB, RB, LT, RT, Back, Start, the
    // stick clicks, the D-pad and the sticks' axes, then another joystick's
    // buttons, its two hats' directions and its axes): the index of a
    // keyboard-rows action, -1 for none, -2 to cycle the views, -3 to roll
    // and change speed while held, and for an axis function, -10 less twice
    // its number (pitch, yaw, roll, speed, throttle), less one more when
    // reversed. The launcher turns them into the settings' names.
    in property <[int]> pad-codes;
    // The joystick shown, read live while the tab shows: a mapped game
    // controller is drawn as one, and any other lists its buttons, hats and
    // axes by number, as src/port/input/pad_bindings.h binds them. Each control
    // held now in that numbering, and a raw joystick's axes, -1 to 1, with
    // what each is (AxisKind in launcher_axes.h, 0 when unknown).
    in property <PadDevice> pad-device;
    in property <[bool]> pad-held;
    in property <[float]> pad-axis-values;
    in property <[int]> pad-axis-kinds;
    // The two joysticks the game reads, "" for a free slot; the tab shows
    // pad-slot's.
    in property <[string]> pad-devices;
    in-out property <int> pad-slot;
    callback pad-slot-chosen(int);
    property <bool> raw-view: root.custom && root.joystick-source != 0
        ? root.joystick-source == 3 : root.pad-device.connected && !root.pad-device.mapped;
    // The raw joystick's buttons, numbered down two columns, or three past
    // sixteen.
    property <int> shown-buttons: root.pad-device.connected ? min(root.pad-device.buttons, 32) : 32;
    property <int> shown-hats: root.pad-device.connected ? min(root.pad-device.hats, 2) : 2;
    property <int> shown-axes: root.pad-device.connected ? min(root.pad-device.axes, 8) : 8;
    property <int> button-columns: root.shown-buttons > 16 ? 3 : 2;
    property <int> button-rows: Math.ceil(root.shown-buttons / root.button-columns);
    property <int> pad-device-count: (root.pad-devices.length > 0 && root.pad-devices[0] != "" ? 1 : 0)
        + (root.pad-devices.length > 1 && root.pad-devices[1] != "" ? 1 : 0);
    callback pad-code-changed(control: int, code: int);
    callback pad-reset();
    // The control whose binding is being chosen (-1 when none), as the
    // chooser shows it.
    out property <int> choose-control: -1;
    property <string> choose-title;
    changed joystick-source => { root.choose-control = -1; root.hide-tip(); }
    property <image> choose-glyph;
    property <bool> choose-reversed;
    // 0 shows the game controller, 1 the keyboard and mouse.
    in property <int> page;
    // macOS toggles full screen with Command-Return rather than Alt-Enter.
    in property <bool> apple-keys;
    // 0 shows WC1 (DOS and Kilrathi Saga data), 1 SWC (Mac data).
    in property <int> game;
    // The Mac menus' shortcuts use Command; SWC uses Control elsewhere.
    property <string> menu-key: root.apple-keys ? "meta" : "ctrl";

    // WC1 flight keys (src/main.c: HandleSpaceFlightControls and
    // process_player_input) and mouse (player_input), one game input per row.
    // The arrows steer like a stick: up pitches the nose down. The wheel is this
    // port's.
    out property <[InputRow]> keyboard-rows: [
        { section: @tr("Flight") },
        { id: "pitch-down", action: @tr("Pitch down"), bindings: [{ inputs: ["up"] }] },
        { id: "pitch-up", action: @tr("Pitch up"), bindings: [{ inputs: ["down"] }] },
        { id: "yaw-left", action: @tr("Yaw left"), bindings: [{ inputs: ["left"] }] },
        { id: "yaw-right", action: @tr("Yaw right"), bindings: [{ inputs: ["right"] }] },
        { id: "pitch-down-yaw-left", action: @tr("Pitch down and yaw left"), bindings: [{ inputs: ["home"] }] },
        { id: "pitch-down-yaw-right", action: @tr("Pitch down and yaw right"), bindings: [{ inputs: ["page-up"] }] },
        { id: "pitch-up-yaw-left", action: @tr("Pitch up and yaw left"), bindings: [{ inputs: ["end"] }] },
        { id: "pitch-up-yaw-right", action: @tr("Pitch up and yaw right"), bindings: [{ inputs: ["page-down"] }] },
        { id: "roll-left", action: @tr("Roll left"), bindings: [{ inputs: [","] }, { inputs: ["insert"] }] },
        { id: "roll-right", action: @tr("Roll right"), bindings: [{ inputs: ["."] }, { inputs: ["delete"] }] },
        { id: "full-turn-rate", action: @tr("Full turn rate"), hint: @tr("hold with a turn key"), bindings: [{ inputs: ["shift"] }] },
        { id: "speed-up", action: @tr("Speed up"), bindings: [{ inputs: ["+"] }, { inputs: ["wheel-up"] }] },
        { id: "slow-down", action: @tr("Slow down"), bindings: [{ inputs: ["-"] }, { inputs: ["wheel-down"] }] },
        { id: "full-speed", action: @tr("Full speed"), bindings: [{ inputs: ["\\"] }] },
        { id: "stop", action: @tr("Stop"), bindings: [{ inputs: ["backspace"] }] },
        { id: "afterburner", action: @tr("Afterburner"), hint: @tr("hold"), bindings: [{ inputs: ["tab"] }] },
        { section: @tr("Weapons") },
        { id: "fire-guns", action: @tr("Fire guns"), bindings: [{ inputs: ["space"] }] },
        { id: "fire-missile", action: @tr("Fire missile or drop mine"), bindings: [{ inputs: ["enter"] }] },
        { id: "next-gun", action: @tr("Weapons display, next gun"), bindings: [{ inputs: ["g"] }] },
        { id: "next-missile", action: @tr("Weapons display, next missile"), bindings: [{ inputs: ["w"] }] },
        // The game's own mouse code: the guns button fires and, with the
        // afterburner button, fires a missile; the afterburner button lights
        // it on a double-click and rolls and changes speed while dragged. The
        // launcher fills in the missile and roll rows from the two buttons.
        { section: @tr("Mouse") },
        { id: "mouse-guns", action: @tr("Fire guns"), mouse-only: true, limit: 1, bindings: [{ inputs: ["mouse-left"] }] },
        { id: "mouse-afterburner", action: @tr("Afterburner"), hint: @tr("double-click and hold"), mouse-only: true, limit: 1,
          bindings: [{ inputs: ["mouse-right"] }] },
        { id: "mouse-missile", action: @tr("Fire missile or drop mine"), hint: @tr("both buttons"), fixed: true,
          bindings: [{ inputs: ["mouse-left", "mouse-right"], joiner: "+", fixed: true }] },
        { id: "mouse-roll", action: @tr("Roll and change speed"), hint: @tr("hold and move"), fixed: true,
          bindings: [{ inputs: ["mouse-right", "mouse-move"], joiner: "+", fixed: true }] },
        { section: @tr("Cockpit") },
        { id: "next-target", action: @tr("Target display, next target"), bindings: [{ inputs: ["t"] }] },
        { id: "lock-target", action: @tr("Lock target"), bindings: [{ inputs: ["l"] }] },
        { id: "damage-display", action: @tr("Damage display"), bindings: [{ inputs: ["d"] }] },
        { id: "navigation", action: @tr("Navigation display, then map"), bindings: [{ inputs: ["n"] }] },
        { id: "autopilot", action: @tr("Autopilot"), bindings: [{ inputs: ["a"] }] },
        { id: "eject", action: @tr("Eject"), bindings: [{ inputs: ["ctrl", "e"], joiner: "+" }] },
        { section: @tr("Wingman") },
        { id: "communications", action: @tr("Communications"), bindings: [{ inputs: ["c"] }] },
        { id: "choose-message", action: @tr("Choose a message"), fixed: true, bindings: [{ inputs: ["1", "9"], joiner: "–", fixed: true }] },
        { id: "break-and-attack", action: @tr("Break and attack"), bindings: [{ inputs: ["b"] }] },
        { id: "form-on-wing", action: @tr("Form on my wing"), bindings: [{ inputs: ["h"] }] },
        { section: @tr("Views") },
        { id: "front-view", action: @tr("Front view; again: cockpit on/off"), bindings: [{ inputs: ["f1"] }] },
        { id: "left-view", action: @tr("Left view"), bindings: [{ inputs: ["f2"] }] },
        { id: "right-view", action: @tr("Right view"), bindings: [{ inputs: ["f3"] }] },
        { id: "rear-view", action: @tr("Rear view"), bindings: [{ inputs: ["f4"] }] },
        { id: "chase-view", action: @tr("Chase view"), bindings: [{ inputs: ["f5"] }] },
        { id: "battle-view", action: @tr("Battle view"), bindings: [{ inputs: ["f6"] }] },
        { id: "tactical-view", action: @tr("Tactical view, with a target"), bindings: [{ inputs: ["f7"] }] },
        { id: "missile-camera", action: @tr("Missile camera on/off"), bindings: [{ inputs: ["f8"] }] },
        { id: "other-ships", action: @tr("Other ships"), bindings: [{ inputs: ["f9"] }] },
        { section: @tr("Game") },
        { id: "pause", action: @tr("Pause"), bindings: [{ inputs: ["p"] }, { inputs: ["escape"], fixed: true }] },
        { id: "message-speed", action: @tr("Message speed"), bindings: [{ inputs: ["m"] }] },
        { id: "comm-videos", action: @tr("Comm videos on/off"), bindings: [{ inputs: ["v"] }] },
        { id: "music", action: @tr("Music on/off"), bindings: [{ inputs: ["ctrl", "m"], joiner: "+" }] },
        { id: "sound", action: @tr("Sound on/off"), bindings: [{ inputs: ["ctrl", "s"], joiner: "+" }] },
        { id: "full-screen", action: @tr("Full screen"), bindings: [
            { inputs: [root.apple-keys ? "meta" : "alt", "enter"], joiner: "+" }
        ] }
    ];
    // SWC's keys: the Mac demo's (src/port/swc/swc_flight.c, swc_nav.c and
    // swc_options.c), rebindable like WC1's (src/port/input/keymap_actions.h). The
    // in-flight computer's keys and the menus' shortcuts stay as they are.
    out property <[InputRow]> swc-rows: [
        { section: @tr("Flight") },
        { id: "swc-pitch-down", action: @tr("Pitch down"), bindings: [{ inputs: ["up"] }, { inputs: ["i"] }] },
        { id: "swc-pitch-up", action: @tr("Pitch up"), bindings: [{ inputs: ["down"] }, { inputs: ["k"] }] },
        { id: "swc-yaw-left", action: @tr("Yaw left"), bindings: [{ inputs: ["left"] }, { inputs: ["j"] }] },
        { id: "swc-yaw-right", action: @tr("Yaw right"), bindings: [{ inputs: ["right"] }, { inputs: ["l"] }] },
        { id: "swc-pitch-down-yaw-left", action: @tr("Pitch down and yaw left"), bindings: [{ inputs: ["7"] }] },
        { id: "swc-pitch-down-yaw-right", action: @tr("Pitch down and yaw right"), bindings: [{ inputs: ["9"] }] },
        { id: "swc-pitch-up-yaw-left", action: @tr("Pitch up and yaw left"), bindings: [{ inputs: ["1"] }] },
        { id: "swc-pitch-up-yaw-right", action: @tr("Pitch up and yaw right"), bindings: [{ inputs: ["3"] }] },
        { id: "swc-roll-left", action: @tr("Roll left"), bindings: [{ inputs: [","] }, { inputs: ["<"] }] },
        { id: "swc-roll-right", action: @tr("Roll right"), bindings: [{ inputs: ["."] }, { inputs: [">"] }] },
        { id: "swc-speed-up", action: @tr("Speed up"), bindings: [{ inputs: ["+"] }, { inputs: ["wheel-up"] }] },
        { id: "swc-slow-down", action: @tr("Slow down"), bindings: [{ inputs: ["-"] }, { inputs: ["wheel-down"] }] },
        { id: "swc-afterburner", action: @tr("Afterburner"), hint: @tr("hold"), bindings: [{ inputs: ["tab"] }] },
        { section: @tr("Weapons") },
        { id: "swc-fire-guns", action: @tr("Fire guns"), bindings: [{ inputs: ["space"] }] },
        { id: "swc-fire-missile", action: @tr("Fire missile or drop mine"), bindings: [{ inputs: ["enter"] }] },
        { id: "swc-next-gun", action: @tr("Next gun"), bindings: [{ inputs: ["g"] }] },
        { id: "swc-next-missile", action: @tr("Next missile"), bindings: [{ inputs: ["w"] }] },
        { id: "swc-next-target", action: @tr("Next target"), bindings: [{ inputs: ["t"] }] },
        { section: @tr("Mouse") },
        { id: "swc-mouse-guns", action: @tr("Fire guns"), mouse-only: true, limit: 1, bindings: [{ inputs: ["mouse-left"] }] },
        { id: "swc-mouse-afterburner", action: @tr("Afterburner"), hint: @tr("double-click and hold"), mouse-only: true, limit: 1,
          bindings: [{ inputs: ["mouse-right"] }] },
        { id: "swc-mouse-missile", action: @tr("Fire missile or drop mine"), hint: @tr("both buttons"), fixed: true,
          bindings: [{ inputs: ["mouse-left", "mouse-right"], joiner: "+", fixed: true }] },
        { id: "swc-mouse-roll", action: @tr("Roll and change speed"), hint: @tr("hold and move"), fixed: true,
          bindings: [{ inputs: ["mouse-right", "mouse-move"], joiner: "+", fixed: true }] },
        { section: @tr("Cockpit") },
        { id: "swc-autopilot", action: @tr("Autopilot"), hint: @tr("not in the simulator"), bindings: [{ inputs: ["a"] }] },
        { id: "swc-computer", action: @tr("In-flight computer"), bindings: [{ inputs: ["c"] }] },
        { section: @tr("Messages") },
        { id: "swc-break-and-attack", action: @tr("Break and attack"), bindings: [{ inputs: ["b"] }] },
        { id: "swc-request-landing", action: @tr("Request landing, or form on my wing"), bindings: [{ inputs: ["r"] }] },
        { id: "swc-help", action: @tr("Help me out here"), bindings: [{ inputs: ["h"] }] },
        { id: "swc-taunt", action: @tr("Taunt the targeted enemy"), bindings: [{ inputs: ["e"] }] },
        { section: @tr("Views") },
        { id: "swc-cockpit-view", action: @tr("Cockpit view"), bindings: [{ inputs: ["f1"] }] },
        { id: "swc-battle-view", action: @tr("Battle view; again: cockpit"), bindings: [{ inputs: ["f2"] }] },
        { id: "swc-chase-view", action: @tr("Chase view; again: cockpit"), bindings: [{ inputs: ["f3"] }] },
        { id: "swc-cockpitless", action: @tr("Cockpit on/off"), hint: @tr("this port"), bindings: [{ inputs: ["ctrl", "f1"], joiner: "+" }] },
        { section: @tr("Game") },
        { id: "swc-pause", action: @tr("Pause"), bindings: [{ inputs: [root.menu-key, "p"], joiner: "+" }, { inputs: ["escape"], fixed: true }] },
        { id: "swc-music", action: @tr("Music on/off"), bindings: [{ inputs: [root.menu-key, "u"], joiner: "+" }] },
        { id: "swc-sound", action: @tr("Sound on/off"), bindings: [{ inputs: [root.menu-key, "n"], joiner: "+" }] },
        { id: "swc-text", action: @tr("Text on/off"), bindings: [{ inputs: [root.menu-key, "b"], joiner: "+" }] },
        { id: "swc-volume", action: @tr("Volume"), bindings: [{ inputs: [root.menu-key, "v"], joiner: "+" }] },
        { id: "full-screen", action: @tr("Full screen"), bindings: [{ inputs: [root.apple-keys ? "meta" : "alt", "enter"], joiner: "+" }] },
        { section: @tr("Menu shortcuts") },
        { action: @tr("Next gun"), fixed: true, bindings: [{ inputs: [root.menu-key, "g"], joiner: "+", fixed: true }] },
        { action: @tr("Next missile"), fixed: true, bindings: [{ inputs: [root.menu-key, "w"], joiner: "+", fixed: true }] },
        { action: @tr("Next target"), fixed: true, bindings: [{ inputs: [root.menu-key, "t"], joiner: "+", fixed: true }] },
        { action: @tr("Autopilot"), fixed: true, bindings: [{ inputs: [root.menu-key, "a"], joiner: "+", fixed: true }] },
        { action: @tr("Speed up"), fixed: true, bindings: [{ inputs: [root.menu-key, "="], joiner: "+", fixed: true }] },
        { action: @tr("Slow down"), fixed: true, bindings: [{ inputs: [root.menu-key, "-"], joiner: "+", fixed: true }] },
        { action: @tr("Cockpit view"), fixed: true, bindings: [{ inputs: [root.menu-key, "y"], joiner: "+", fixed: true }] },
        { action: @tr("Battle view; again: cockpit"), fixed: true, bindings: [{ inputs: [root.menu-key, "d"], joiner: "+", fixed: true }] },
        { action: @tr("Chase view; again: cockpit"), fixed: true, bindings: [{ inputs: [root.menu-key, "f"], joiner: "+", fixed: true }] },
        { section: @tr("In-flight computer") },
        { action: @tr("Previous or next page"), fixed: true, bindings: [{ inputs: ["up"], fixed: true }, { inputs: ["down"], fixed: true }] },
        { action: @tr("Previous or next choice"), fixed: true, bindings: [{ inputs: ["left"], fixed: true }, { inputs: ["right"], fixed: true }] },
        { action: @tr("Next gun or missile"), fixed: true, bindings: [{ inputs: ["right"], fixed: true }, { inputs: ["tab"], fixed: true }] },
        { action: @tr("Select"), fixed: true, bindings: [{ inputs: ["enter"], fixed: true }, { inputs: ["mouse-left"], fixed: true }] },
        { action: @tr("Close, or back to the recipients"), fixed: true, bindings: [
            { inputs: ["escape"], fixed: true }, { inputs: ["space"], fixed: true },
            { inputs: [root.menu-key, "."], joiner: "+", fixed: true }
        ] },
        { action: @tr("Close"), fixed: true, bindings: [{ inputs: ["c"], fixed: true }] }
    ];
    // The current bindings, row by row: WC1's and SWC's. The launcher fills
    // these with copies of the rows' bindings and the saved changes, applies
    // the changes asked for below (to the shown game's), and hands the changed
    // rows to the game when it starts.
    in-out property <[[InputBinding]]> keyboard-bindings;
    in-out property <[[InputBinding]]> swc-bindings;
    // Replace a row's binding, or add one when slot is the row's binding count.
    callback binding-changed(row: int, slot: int, binding: InputBinding);
    callback binding-removed(row: int, slot: int);
    callback bindings-reset();
    // Each game input takes two bindings at most.
    out property <int> max-bindings: 2;
    // The binding being changed: its row (-1 when none) and slot.
    out property <int> capture-row: -1;
    property <int> capture-slot;
    property <bool> capture-replaces;
    // A modifier pressed while capturing, bound alone if released first.
    property <string> capture-modifier;
    // The row being changed takes only mouse buttons.
    property <bool> capture-mouse-only;

    // Names a keyboard or mouse input for the table.
    pure function input-label(input: string) -> string {
        if input == "up" { return "↑"; }
        if input == "down" { return "↓"; }
        if input == "left" { return "←"; }
        if input == "right" { return "→"; }
        if input == "home" { return @tr("Home"); }
        if input == "end" { return @tr("End"); }
        if input == "page-up" { return @tr("PgUp"); }
        if input == "page-down" { return @tr("PgDn"); }
        if input == "insert" { return @tr("Ins"); }
        if input == "delete" { return @tr("Del"); }
        if input == "backspace" { return @tr("Backspace"); }
        if input == "tab" { return @tr("Tab"); }
        if input == "space" { return @tr("Space"); }
        if input == "enter" { return @tr("Enter"); }
        if input == "escape" { return @tr("Esc"); }
        if input == "shift" { return @tr("Shift"); }
        if input == "ctrl" { return @tr("Ctrl"); }
        if input == "alt" { return @tr("Alt"); }
        if input == "alt-gr" { return "AltGr"; }
        if input == "meta" { return root.apple-keys ? "⌘" : "Win"; }
        if input == "caps-lock" { return @tr("Caps Lock"); }
        if input == "scroll-lock" { return @tr("Scroll Lock"); }
        if input == "pause" { return @tr("Pause"); }
        if input == "print-screen" { return @tr("Print Screen"); }
        if input == "menu" { return @tr("Menu"); }
        if input == "-" { return "−"; }
        if input == "mouse-move" { return @tr("Mouse movement"); }
        if input == "mouse-left" { return @tr("Left mouse button"); }
        if input == "mouse-right" { return @tr("Right mouse button"); }
        if input == "mouse-middle" { return @tr("Middle mouse button"); }
        if input == "mouse-back" { return @tr("Mouse button 4"); }
        if input == "mouse-forward" { return @tr("Mouse button 5"); }
        if input == "wheel-up" { return @tr("Mouse wheel up"); }
        if input == "wheel-down" { return @tr("Mouse wheel down"); }
        return input.to-uppercase();
    }

    pure function is-mouse(input: string) -> bool {
        return input.starts-with("mouse-") || input.starts-with("wheel-");
    }

    // The input name of a key event's text. Slint reports macOS's Command key
    // as Control and its Control key as Meta; swap them back.
    pure function key-input(text: string) -> string {
        if text == Key.UpArrow { return "up"; }
        if text == Key.DownArrow { return "down"; }
        if text == Key.LeftArrow { return "left"; }
        if text == Key.RightArrow { return "right"; }
        if text == Key.Home { return "home"; }
        if text == Key.End { return "end"; }
        if text == Key.PageUp { return "page-up"; }
        if text == Key.PageDown { return "page-down"; }
        if text == Key.Insert { return "insert"; }
        if text == Key.Delete { return "delete"; }
        if text == Key.Backspace { return "backspace"; }
        if text == Key.Tab || text == Key.Backtab { return "tab"; }
        if text == Key.Space { return "space"; }
        if text == Key.Return { return "enter"; }
        if text == Key.Escape { return "escape"; }
        if text == Key.Shift || text == Key.ShiftR { return "shift"; }
        if text == Key.Control || text == Key.ControlR { return root.apple-keys ? "meta" : "ctrl"; }
        if text == Key.Meta || text == Key.MetaR { return root.apple-keys ? "ctrl" : "meta"; }
        if text == Key.Alt { return "alt"; }
        if text == Key.AltGr { return "alt-gr"; }
        if text == Key.CapsLock { return "caps-lock"; }
        if text == Key.ScrollLock { return "scroll-lock"; }
        if text == Key.Pause { return "pause"; }
        if text == Key.SysReq { return "print-screen"; }
        if text == Key.Menu { return "menu"; }
        if text == Key.F1 { return "f1"; }
        if text == Key.F2 { return "f2"; }
        if text == Key.F3 { return "f3"; }
        if text == Key.F4 { return "f4"; }
        if text == Key.F5 { return "f5"; }
        if text == Key.F6 { return "f6"; }
        if text == Key.F7 { return "f7"; }
        if text == Key.F8 { return "f8"; }
        if text == Key.F9 { return "f9"; }
        if text == Key.F10 { return "f10"; }
        if text == Key.F11 { return "f11"; }
        if text == Key.F12 { return "f12"; }
        return text.to-lowercase();
    }

    pure function is-modifier(input: string) -> bool {
        return input == "shift" || input == "ctrl" || input == "alt" || input == "alt-gr" || input == "meta";
    }

    // The one modifier held with a key, if any. Shift counts only with named
    // keys and letters: it already chose a symbol such as "+".
    pure function held-modifier(modifiers: KeyboardModifiers, input: string) -> string {
        if modifiers.control && !root.is-modifier(input) { return root.apple-keys ? "meta" : "ctrl"; }
        if modifiers.meta && !root.is-modifier(input) { return root.apple-keys ? "ctrl" : "meta"; }
        if modifiers.alt && !root.is-modifier(input) { return "alt"; }
        if modifiers.shift && !root.is-modifier(input)
                && (input.character-count > 1 || input.to-uppercase() != input) {
            return "shift";
        }
        return "";
    }

    function start-capture(row: int, slot: int, replaces: bool) {
        root.capture-slot = slot;
        root.capture-replaces = replaces;
        root.capture-modifier = "";
        root.capture-mouse-only = (root.game == 1 ? root.swc-rows : root.keyboard-rows)[row].mouse-only;
        root.capture-row = row;
    }

    function finish-capture(binding: InputBinding) {
        root.binding-changed(root.capture-row, root.capture-slot, binding);
        root.capture-row = -1;
    }

    function capture-key(modifiers: KeyboardModifiers, input: string) {
        if root.held-modifier(modifiers, input) == "" {
            root.finish-capture({ inputs: [input] });
        } else {
            root.finish-capture({ inputs: [root.held-modifier(modifiers, input), input], joiner: "+" });
        }
    }

    // Where the table's binding column starts.
    property <length> input-column: max(240px, min(380px, area.width * 0.46));
    // How far the table is scrolled (negative, as the list's viewport-y). It
    // outlasts switching pages, and starts over for another game.
    in-out property <length> table-scroll;
    changed game => {
        root.table-scroll = 0px;
        root.hide-tip();
    }

    // SC Controller's x360.svg is 446x345; its hidden AREA_* rectangles give
    // the anchors below, in drawing units, scaled into the drawing's area.
    // The side boxes take what a 300px pad leaves, 196px to 236px each; the
    // Back and Start boxes sit above the pad.
    property <length> box-width: max(196px, min(236px, (area.width - 300px) / 2 - 10px));
    property <length> top-band: 52px;
    property <float> scale: max(0.5, min(1.2, min((area.width - 2 * (root.box-width + 14px)) / 446px,
        (area.height - root.top-band) / 345px)));
    property <length> pad-x: (area.width - 446px * root.scale) / 2;
    property <length> pad-y: root.top-band;
    // Each column of boxes starts beside the pad's top and spreads over the
    // height left; both columns hold 272px of boxes, or 294px with the Custom
    // mode's row for each of a stick's axes.
    property <length> column-y: root.pad-y - 16px;
    property <length> column-height: root.custom ? 294px : 272px;
    property <length> box-gap: max(4px, min(44px, (area.height - root.column-y - root.column-height) / 3));
    property <length> centre-box-width: max(110px, min(150px, 223px * root.scale - 10px));
    property <brush> ink: Palette.foreground.with-alpha(0.55);

    pure function at-x(drawing-x: float) -> length {
        return root.pad-x + drawing-x * 1px * root.scale;
    }

    pure function at-y(drawing-y: float) -> length {
        return root.pad-y + drawing-y * 1px * root.scale;
    }

    // The Custom mode's controls in the order of src/port/input/pad_bindings.h.
    pure function control-index(control: PadControl) -> int {
        if control == PadControl.a { return 0; }
        if control == PadControl.b { return 1; }
        if control == PadControl.x { return 2; }
        if control == PadControl.y { return 3; }
        if control == PadControl.left-shoulder { return 4; }
        if control == PadControl.right-shoulder { return 5; }
        if control == PadControl.left-trigger { return 6; }
        if control == PadControl.right-trigger { return 7; }
        if control == PadControl.back { return 8; }
        if control == PadControl.start { return 9; }
        if control == PadControl.left-stick-click { return 10; }
        if control == PadControl.right-stick-click { return 11; }
        if control == PadControl.dpad-up { return 12; }
        if control == PadControl.dpad-down { return 13; }
        if control == PadControl.dpad-left { return 14; }
        if control == PadControl.dpad-right { return 15; }
        if control == PadControl.left-stick-x { return 16; }
        if control == PadControl.left-stick-y { return 17; }
        if control == PadControl.right-stick-x { return 18; }
        if control == PadControl.right-stick-y { return 19; }
        return -1;
    }

    // An axis function in the chooser: a stick's, or for a trigger, which
    // way pressing it turns or changes speed.
    pure function axis-choice-label(code: int, trigger: bool) -> string {
        if trigger {
            if code == -10 { return @tr("Pitch down"); }
            if code == -11 { return @tr("Pitch up"); }
            if code == -12 { return @tr("Yaw right"); }
            if code == -13 { return @tr("Yaw left"); }
            if code == -14 { return @tr("Roll right"); }
            if code == -15 { return @tr("Roll left"); }
            if code == -16 { return @tr("Speed up"); }
            if code == -17 { return @tr("Slow down"); }
        }
        if code >= -11 { return @tr("Pitch"); }
        if code >= -13 { return @tr("Yaw"); }
        if code >= -15 { return @tr("Roll"); }
        if code >= -17 { return @tr("Speed"); }
        return @tr("Throttle position");
    }

    // An axis function's code without its reversal.
    pure function axis-base(code: int) -> int {
        return code + Math.mod(-10 - code, 2);
    }

    pure function code-reversed(code: int) -> bool {
        return code <= -10 && code != root.axis-base(code);
    }

    // A Custom binding as the boxes show it.
    pure function code-label(code: int, control: int) -> string {
        if code >= 0 { return root.keyboard-rows[code].action.to-lowercase(); }
        if code == -2 { return @tr("cycle views"); }
        if code == -3 { return @tr("hold to roll and change speed"); }
        if code > -10 || code < -19 { return ""; }
        if control == 6 || control == 7 {
            return @tr("{} (analog)", root.axis-choice-label(code, true).to-lowercase());
        }
        return root.code-reversed(code)
            ? @tr("{}, reversed", root.axis-choice-label(code, false).to-lowercase())
            : root.axis-choice-label(code, false).to-lowercase();
    }

    // A keyboard and mouse row's inputs as the table shows them now, or as
    // they were originally until the launcher fills in the table.
    pure function current-bindings(index: int) -> [InputBinding] {
        return root.keyboard-bindings.length > index ? root.keyboard-bindings[index] : root.keyboard-rows[index].bindings;
    }

    pure function binding-text(binding: InputBinding) -> string {
        if binding.inputs.length == 0 { return ""; }
        if binding.inputs.length == 1 { return root.input-label(binding.inputs[0]); }
        return root.input-label(binding.inputs[0]) + " " + binding.joiner + " " + root.input-label(binding.inputs[1]);
    }

    pure function keys-text(index: int) -> string {
        if root.current-bindings(index).length == 0 { return "—"; }
        if root.current-bindings(index).length == 1 { return root.binding-text(root.current-bindings(index)[0]); }
        return root.binding-text(root.current-bindings(index)[0]) + " / " + root.binding-text(root.current-bindings(index)[1]);
    }

    // How a button works a flight key's action (src/port/input/joystick.c): the
    // guns, the afterburner, steering and speed while it is held, the rest
    // once per press.
    pure function action-behaviour(id: string) -> string {
        if id == "fire-guns" { return @tr("Fires while held."); }
        if id == "afterburner" { return @tr("Burns while held."); }
        if id == "full-turn-rate" { return @tr("Turns at the full rate while held, with a turn button or key."); }
        if id == "speed-up" || id == "slow-down" { return @tr("Changes speed while held."); }
        if id.starts-with("pitch-") || id.starts-with("yaw-") || id.starts-with("roll-") { return @tr("Steers while held."); }
        return @tr("Once per press.");
    }

    // What a stick's axis function does, by the way the stick moves.
    pure function stick-help(code: int, horizontal: bool) -> string {
        if code == -10 {
            return horizontal ? @tr("Right dives and left climbs.") : @tr("Up dives and down climbs, as with the original joystick.");
        }
        if code == -12 {
            return horizontal ? @tr("Right turns right and left turns left.") : @tr("Up turns right and down turns left.");
        }
        if code == -14 {
            return horizontal ? @tr("Right rolls right and left rolls left.") : @tr("Up rolls right and down rolls left.");
        }
        if code == -16 {
            return horizontal ? @tr("Right speeds up and left slows down, faster the further it goes.")
                : @tr("Up speeds up and down slows down, faster the further it goes.");
        }
        return horizontal ? @tr("Sets the speed like a throttle lever: fully right is full speed and fully left stops.")
            : @tr("Sets the speed like a throttle lever: fully up is full speed and fully down stops.");
    }

    // What a Custom binding does on a control, for the chooser's tooltips.
    pure function choice-help(code: int, control: int) -> string {
        if code >= 0 {
            return root.action-behaviour(root.keyboard-rows[code].id) + " "
                + @tr("Keyboard and mouse: {}.", root.keys-text(code));
        }
        if code == -1 { return @tr("The input does nothing in flight."); }
        if code == -2 { return @tr("Steps through the front, left, right, rear and chase views."); }
        if code == -3 {
            return @tr("While held, what yaws rolls instead and what pitches changes speed, as the original joystick's second button does.");
        }
        if control == 6 || control == 7 {
            if code > -18 { return @tr("{}, faster the further the trigger is pressed.", root.axis-choice-label(code, true)); }
            return @tr("Sets the speed like a throttle lever: fully pressed is full speed and released stops.")
                + (root.code-reversed(code) ? " " + @tr("Reversed: the other way round.") : "");
        }
        return root.stick-help(root.axis-base(code), root.axis-horizontal(control))
            + (root.code-reversed(code) ? " " + @tr("Reversed: the other way round.") : "");
    }

    // Outside the Custom mode a row of WC1's drawing has a tooltip on how to
    // rebind it. In the Custom mode the pointer shows that rows are clicked
    // to change them, and SWC keeps its layout.
    property <string> rebind-hint: !root.custom && root.game == 0
        ? @tr("To rebind it, choose Custom in Control mode.") : "";

    // The tooltip owner of a row of the drawing.
    pure function row-tip-owner(control: PadControl) -> int {
        if control == PadControl.left-stick { return 20; }
        if control == PadControl.right-stick { return 21; }
        return root.control-index(control);
    }

    // The keyboard and mouse table's rows that a button can take: the game
    // inputs that are neither fixed, the mouse's own, nor full screen, and
    // the headings of their sections.
    pure function choosable(row: InputRow) -> bool {
        return row.id != "" && !row.fixed && !row.mouse-only && row.id != "full-screen";
    }

    pure function heading-choosable(index: int) -> bool {
        return root.keyboard-rows[index].section != "" && index + 1 < root.keyboard-rows.length
            && root.choosable(root.keyboard-rows[index + 1]);
    }

    property <bool> choose-trigger: root.choose-control == 6 || root.choose-control == 7;
    property <bool> choose-stick: (root.choose-control >= 16 && root.choose-control < 20) || root.choose-control >= 60;
    property <int> choose-current: root.choose-control >= 0 ? root.pad-codes[root.choose-control] : -1;

    function choose(row: PadRow, title: string) {
        root.choose-glyph = row.glyph;
        root.choose-title = row.caption == "" ? title : title + ", " + row.caption;
        root.choose-control = root.control-index(row.control);
        root.choose-reversed = root.code-reversed(root.pad-codes[root.choose-control]);
    }

    function pick(code: int) {
        root.pad-code-changed(root.choose-control, code);
        root.choose-control = -1;
    }

    // The chooser for a control by number (pad_bindings.h), as the drawing's
    // rows or a raw joystick's list name it.
    function choose-index(control: int) {
        root.choose-glyph = root.control-glyph(control);
        root.choose-title = root.control-title(control);
        root.choose-control = control;
        root.choose-reversed = root.code-reversed(root.pad-codes[control]);
    }

    // A control pressed on the joystick: in the Custom mode it opens its
    // chooser, unless one is open.
    public function press-control(control: int) {
        if root.custom && root.choose-control < 0 && root.page == 0
            && (root.raw-view ? control >= 20 : control < 20) {
            root.choose-index(control);
        }
    }

    // The first of each pair of a joystick's axes grows to the right, the
    // second upwards (pad_bindings.h).
    pure function axis-horizontal(control: int) -> bool {
        return control == 16 || control == 18 || (control >= 60 && Math.mod(control - 60, 2) == 0);
    }

    // What a raw joystick's axis is, as the platform says.
    pure function axis-kind-name(kind: int) -> string {
        if kind == 1 { return @tr("X axis"); }
        if kind == 2 { return @tr("Y axis"); }
        if kind == 3 { return @tr("Z axis"); }
        if kind == 4 { return @tr("X rotation"); }
        if kind == 5 { return @tr("Y rotation"); }
        if kind == 6 { return @tr("Z rotation"); }
        if kind == 7 { return @tr("Slider"); }
        if kind == 8 { return @tr("Dial"); }
        if kind == 9 { return @tr("Wheel"); }
        if kind == 10 { return @tr("Rudder"); }
        if kind == 11 { return @tr("Throttle"); }
        if kind == 12 { return @tr("Accelerator"); }
        if kind == 13 { return @tr("Brake"); }
        return "";
    }

    pure function gamepad-control(index: int) -> PadControl {
        if index == 0 { return PadControl.a; }
        if index == 1 { return PadControl.b; }
        if index == 2 { return PadControl.x; }
        if index == 3 { return PadControl.y; }
        if index == 4 { return PadControl.left-shoulder; }
        if index == 5 { return PadControl.right-shoulder; }
        if index == 6 { return PadControl.left-trigger; }
        if index == 7 { return PadControl.right-trigger; }
        if index == 8 { return PadControl.back; }
        if index == 9 { return PadControl.start; }
        if index == 10 { return PadControl.left-stick-click; }
        if index == 11 { return PadControl.right-stick-click; }
        if index == 12 { return PadControl.dpad-up; }
        if index == 13 { return PadControl.dpad-down; }
        if index == 14 { return PadControl.dpad-left; }
        if index == 15 { return PadControl.dpad-right; }
        if index == 16 { return PadControl.left-stick-x; }
        if index == 17 { return PadControl.left-stick-y; }
        if index == 18 { return PadControl.right-stick-x; }
        return PadControl.right-stick-y;
    }

    // How the chooser names a control.
    pure function control-title(control: int) -> string {
        if control >= 60 {
            return root.axis-kind-name(root.pad-axis-kinds[control - 60]) == "" ? @tr("Axis {}", control - 59)
                : @tr("Axis {}", control - 59) + " · " + root.axis-kind-name(root.pad-axis-kinds[control - 60]);
        }
        if control >= 52 { return @tr("Hat {}", control >= 56 ? 2 : 1); }
        if control >= 20 { return @tr("Button {}", control - 19); }
        if control == 10 { return @tr("Left stick") + ", " + @tr("click"); }
        if control == 11 { return @tr("Right stick") + ", " + @tr("click"); }
        if control >= 12 && control <= 15 { return @tr("D-pad"); }
        if control == 16 { return @tr("Left stick") + ", " + @tr("left and right"); }
        if control == 17 { return @tr("Left stick") + ", " + @tr("up and down"); }
        if control == 18 { return @tr("Right stick") + ", " + @tr("left and right"); }
        if control == 19 { return @tr("Right stick") + ", " + @tr("up and down"); }
        if control == 0 { return "A"; }
        if control == 1 { return "B"; }
        if control == 2 { return "X"; }
        if control == 3 { return "Y"; }
        if control == 4 { return root.deck-view ? "L1" : "LB"; }
        if control == 5 { return root.deck-view ? "R1" : "RB"; }
        if control == 6 { return root.deck-view ? "L2" : "LT"; }
        if control == 7 { return root.deck-view ? "R2" : "RT"; }
        if control == 8 { return root.deck-view ? @tr("View") : "Back"; }
        return root.deck-view ? @tr("Menu") : "Start";
    }

    pure function control-glyph(control: int) -> image {
        if control >= 60 || (control >= 10 && control <= 11) || (control >= 16 && control < 20) {
            return @image-url("../../../third_party/sc-controller/images/STICK.svg");
        }
        if control >= 20 && control < 52 { return @image-url(""); }
        if (control >= 52 && Math.mod(control - 52, 4) == 0) || control == 12 {
            return @image-url("../../../third_party/sc-controller/images/DPAD_UP.svg");
        }
        if (control >= 52 && Math.mod(control - 52, 4) == 1) || control == 13 {
            return @image-url("../../../third_party/sc-controller/images/DPAD_DOWN.svg");
        }
        if (control >= 52 && Math.mod(control - 52, 4) == 2) || control == 14 {
            return @image-url("../../../third_party/sc-controller/images/DPAD_LEFT.svg");
        }
        if control >= 52 || control == 15 {
            return @image-url("../../../third_party/sc-controller/images/DPAD_RIGHT.svg");
        }
        if control == 0 { return @image-url("../../../third_party/sc-controller/images/button-images/A.svg"); }
        if control == 1 { return @image-url("../../../third_party/sc-controller/images/button-images/B.svg"); }
        if control == 2 { return @image-url("../../../third_party/sc-controller/images/button-images/X.svg"); }
        if control == 3 { return @image-url("../../../third_party/sc-controller/images/button-images/Y.svg"); }
        if control == 4 { return @image-url("../../../third_party/sc-controller/images/button-images/LB.svg"); }
        if control == 5 { return @image-url("../../../third_party/sc-controller/images/button-images/RB.svg"); }
        if control == 6 { return @image-url("../../../third_party/sc-controller/images/button-images/LT.svg"); }
        if control == 7 { return @image-url("../../../third_party/sc-controller/images/button-images/RT.svg"); }
        if control == 8 { return @image-url("../../../third_party/sc-controller/images/button-images/BACK.svg"); }
        return @image-url("../../../third_party/sc-controller/images/button-images/START.svg");
    }

    // A raw joystick's axis in the fixed layouts: the first two steer as
    // the game's stick, and the four-axis layouts read the third and fourth
    // as src/port/input/joystick.c's axis layouts do.
    pure function raw-axis-fixed-label(axis: int) -> string {
        if axis == 0 {
            return root.layout-mode == 2 && (root.joystick-axes == 1 || root.joystick-axes == 2 || root.joystick-axes == 5)
                ? @tr("roll") : @tr("yaw");
        }
        if axis == 1 { return @tr("Pitch").to-lowercase(); }
        if root.layout-mode != 2 { return ""; }
        if axis == 2 {
            if root.joystick-axes == 0 || root.joystick-axes == 3 || root.joystick-axes == 6 { return @tr("roll"); }
            return root.joystick-axes == 4 ? @tr("throttle position") : @tr("yaw");
        }
        if axis == 3 {
            if root.joystick-axes <= 1 { return @tr("Speed").to-lowercase(); }
            return root.joystick-axes <= 3 ? @tr("throttle position") : "";
        }
        return "";
    }

    // A raw joystick's input as the fixed layouts read it: its first sixteen
    // buttons as the gamepad's, where the seventh and eighth press N and A,
    // and its first hat as the D-pad.
    pure function raw-fixed-label(control: int) -> string {
        if control >= 60 { return root.raw-axis-fixed-label(control - 60); }
        if control >= 56 { return ""; }
        if control >= 52 { return root.pad-binding(root.gamepad-control(control - 40)); }
        if control - 20 >= 16 { return ""; }
        if control - 20 == 6 {
            return root.layout-mode == 0 || root.game == 1 ? "" : @tr("navigation display");
        }
        if control - 20 == 7 { return root.layout-mode == 0 ? "" : @tr("autopilot"); }
        return root.pad-binding(root.gamepad-control(control - 20));
    }

    pure function raw-label(control: int) -> string {
        return root.custom ? root.code-label(root.pad-codes[control], control) : root.raw-fixed-label(control);
    }

    // Whether a row of the drawing's control is held; a stick's row in the
    // fixed layouts counts either axis.
    pure function control-held(control: PadControl) -> bool {
        if control == PadControl.left-stick { return root.pad-held[16] || root.pad-held[17]; }
        if control == PadControl.right-stick { return root.pad-held[18] || root.pad-held[19]; }
        return root.pad-held[root.control-index(control)];
    }

    // The tooltip on what a binding or a choice does. Slint's Tooltip is not
    // kept within the window and would run past it beside the right-hand
    // boxes, so this one shows below the element under the pointer, or above
    // it near the bottom, within the view. Each element passes a distinct
    // owner so that leaving one does not hide the next one's tooltip.
    property <string> tip-title;
    property <string> tip-text;
    property <length> tip-left;
    property <length> tip-top;
    property <length> tip-bottom;
    property <int> tip-owner: -1;
    property <bool> tip-shown;

    tip-timer := Timer {
        interval: 600ms;
        running: false;
        triggered => {
            self.stop();
            root.tip-shown = true;
        }
    }

    function hide-tip() {
        tip-timer.stop();
        root.tip-shown = false;
        root.tip-owner = -1;
    }

    // x, y and height place the element in the window.
    function hover-tip(owner: int, hovered: bool, title: string, text: string, x: length, y: length,
                       height: length) {
        if !hovered {
            if root.tip-owner == owner {
                root.hide-tip();
            }
            return;
        }
        root.tip-owner = owner;
        root.tip-title = title;
        root.tip-text = text;
        root.tip-left = x - root.absolute-position.x;
        root.tip-top = y - root.absolute-position.y;
        root.tip-bottom = root.tip-top + height;
        root.tip-shown = false;
        // restart() only restarts a running timer.
        if tip-timer.running {
            tip-timer.restart();
        } else {
            tip-timer.start();
        }
    }

    // Opening or closing the chooser removes the elements whose tooltips may
    // be pending, and other settings change what the drawing's rows do.
    changed choose-control => {
        root.hide-tip();
    }
    changed joystick-mode => {
        root.choose-control = -1;
        root.hide-tip();
    }
    changed joystick-axes => {
        root.hide-tip();
    }

    // WC1 flight bindings (src/port/input/joystick.c). An empty string is unbound.
    public pure function wc1-binding(control: PadControl) -> string {
        if root.custom {
            return root.code-label(root.pad-codes[root.control-index(control)], root.control-index(control));
        }
        if control == PadControl.left-stick {
            if root.layout-mode == 2 && (root.joystick-axes == 1 || root.joystick-axes == 2
                    || root.joystick-axes == 5) {
                return @tr("roll and pitch");
            }
            return @tr("pitch and yaw");
        }
        // RT stands in for A and LT for B in flight (src/port/input/joystick.c).
        if control == PadControl.a || control == PadControl.right-trigger { return @tr("fire guns"); }
        if control == PadControl.back { return @tr("cycle views"); }
        if control == PadControl.start { return @tr("pause"); }
        if root.layout-mode == 0 {
            if control == PadControl.b || control == PadControl.left-trigger {
                return @tr("hold to roll and change speed");
            }
            return "";
        }
        if control == PadControl.b || control == PadControl.left-trigger { return @tr("fire missile"); }
        if control == PadControl.x { return @tr("afterburner"); }
        if control == PadControl.y {
            return root.layout-mode == 1 ? @tr("hold to roll and change speed") : @tr("cycle targets");
        }
        if control == PadControl.left-shoulder { return @tr("cycle guns"); }
        if control == PadControl.right-shoulder { return @tr("cycle missiles"); }
        if control == PadControl.left-stick-click { return @tr("navigation display"); }
        if control == PadControl.right-stick-click { return @tr("autopilot"); }
        if control == PadControl.dpad-up { return @tr("full speed"); }
        if control == PadControl.dpad-down { return @tr("stop"); }
        if control == PadControl.dpad-left { return @tr("communications"); }
        if control == PadControl.dpad-right { return @tr("lock target"); }
        if control == PadControl.right-stick && root.layout-mode == 2 {
            if root.joystick-axes == 0 { return @tr("roll, speed"); }
            if root.joystick-axes == 1 { return @tr("yaw, speed"); }
            if root.joystick-axes == 2 { return @tr("yaw, throttle position"); }
            if root.joystick-axes == 3 { return @tr("roll, throttle position"); }
            if root.joystick-axes == 4 { return @tr("throttle position"); }
            if root.joystick-axes == 5 { return @tr("yaw"); }
            if root.joystick-axes == 6 { return @tr("roll"); }
        }
        return "";
    }

    // SWC reads the game controller through WC1's code (src/port/input/joystick.c,
    // SdlTranslateSwcJoystickEvent) but keeps the Mac demo's keys, so the
    // buttons that send keys only WC1 binds do nothing in flight.
    public pure function swc-binding(control: PadControl) -> string {
        if control == PadControl.dpad-up || control == PadControl.dpad-down
                || control == PadControl.dpad-right || control == PadControl.left-stick-click {
            return "";
        }
        if control == PadControl.dpad-left {
            return root.layout-mode == 0 ? "" : @tr("in-flight computer");
        }
        return root.wc1-binding(control);
    }

    public pure function pad-binding(control: PadControl) -> string {
        return root.game == 1 ? root.swc-binding(control) : root.wc1-binding(control);
    }

    // Another joystick's buttons stand in for the gamepad's by number
    // (src/port/input/joystick.c): 1 for A, 2 for B, 3 for X, 4 for Y, 9 for Back
    // and 11 for the left stick's click, and its first hat for the D-pad.
    public pure function notes() -> string {
        if root.game == 1 {
            return (root.layout-mode == 0
                    ? (root.raw-view
                        ? @tr("Original joystick: buttons 1 and 2 together fire a missile; double-click button 2 and hold it for the afterburner.")
                        : @tr("Original joystick: A and B together fire a missile; double-click B and hold it for the afterburner."))
                    : root.raw-view ? @tr("SWC has no keys for button 11 or for hat 1's up, down and right.")
                    : @tr("SWC has no keys for the left stick's click or for D-pad up, down and right."))
                + " " + (root.raw-view
                    ? @tr("In menus, button 1 selects, buttons 2 and 9 go back, button 3 presses Space and hat 1 moves.")
                    : @tr("In menus, A selects, B and Back go back, X presses Space and the D-pad moves."))
                + (root.joystick-mode == 3 ? " " + @tr("SWC keeps the WCAT four-axis layout in the Custom mode.")
                    : root.joystick-mode == 4 ? " " + @tr("SWC keeps the WCAT four-axis layout in the Steam Deck mode.") : "");
        }
        if root.deck-view {
            return (root.custom && root.pad-device.connected && !root.pad-device.mapped
                    ? @tr("This device has no gamepad mapping. Choose Joystick to bind its numbered inputs.") + " " : "")
                + (root.custom ? @tr("Click a binding or press its control to change it. Rear buttons mirror the D-pad.") + " " : "")
                + @tr("Steam Input: assign L4 to ↑, L5 to ↓, R4 to ← and R5 to →. In communications, ↑/↓ choose, → sends and ← closes. L3/R3 are stick clicks. Y answers Yes; View is Escape outside flight.");
        }
        return (root.custom && !root.raw-view && root.pad-device.connected && !root.pad-device.mapped
                ? @tr("This device has no gamepad mapping. Choose Joystick to bind its numbered inputs.") + " " : "")
            + (root.custom ? @tr("Press an input on the controller, or click it, to change it; changes apply when the game starts.") + " " : "")
            + (root.joystick-mode == 0
                ? (root.raw-view
                    ? @tr("Original joystick: buttons 1 and 2 together fire a missile; double-click button 2 and hold it for the afterburner.")
                    : @tr("Original joystick: A and B together fire a missile; double-click B and hold it for the afterburner."))
                : root.raw-view ? @tr("In the communications display, hat 1's up and down choose, right sends and left closes.")
                : @tr("In the communications display, the D-pad's up and down choose, right sends and left closes."))
            + " " + (root.raw-view ? @tr("Button 4 answers Yes in prompts; button 9 is Escape outside flight.")
                : @tr("Y answers Yes in prompts; Back is Escape outside flight."));
    }

    VerticalLayout {
        spacing: 8px;

        if root.page == 1: HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 0;

            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: @tr("In flight. Click a key or button to change it, or + to add one; changes apply when the game starts.");
                wrap: word-wrap;
                font-size: 12px;
                color: Palette.foreground;
                opacity: 0.7;
            }

            Button {
                text: @tr("Restore defaults");
                clicked => {
                    root.bindings-reset();
                }
            }
        }

        area := Rectangle {
            vertical-stretch: 1;

            deck-diagram := SteamDeckView {
                visible: root.page == 0 && root.deck-view;
                width: 100%;
                height: 100%;
                held: root.pad-held;
                editable: root.custom;
                control-clicked(control, title) => {
                    if root.custom {
                        root.choose-index(control);
                        root.choose-title = title;
                    }
                }
                binding(control) => { return root.code-label(root.pad-codes[control], control); }
            }

            if root.page == 0 && !root.raw-view && !root.deck-view: Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;

                // The controller shown, or a choice of the two the game reads.
                if root.pad-device-count > 1: ComboBox {
                    x: 0px;
                    y: 0px;
                    width: max(120px, min(200px, area.width / 2 - root.centre-box-width - 18px));
                    model: root.pad-devices;
                    current-index <=> root.pad-slot;
                    selected => {
                        root.pad-slot-chosen(self.current-index);
                    }
                }

                if root.pad-device-count == 1: Text {
                    x: 2px;
                    y: 6px;
                    width: max(120px, min(200px, area.width / 2 - root.centre-box-width - 18px));
                    text: root.pad-device.connected ? root.pad-device.name : @tr("Joystick — not connected");
                    font-size: 11px;
                    color: Palette.foreground;
                    opacity: 0.7;
                    overflow: elide;
                }

                Image {
                    x: root.pad-x;
                    y: root.pad-y;
                    width: 446px * root.scale;
                    height: 345px * root.scale;
                    source: @image-url("../../../third_party/sc-controller/images/controller-images/x360.svg");
                }

                // Face buttons and Back/Start sit on the drawing's AREA_* rectangles.
                for glyph in [
                    { x: 319.0, y: 127.8, w: 25.0, h: 25.0, image: @image-url("../../../third_party/sc-controller/images/button-images/A.svg") },
                    { x: 349.0, y: 98.5, w: 25.0, h: 25.0, image: @image-url("../../../third_party/sc-controller/images/button-images/B.svg") },
                    { x: 289.9, y: 98.5, w: 25.0, h: 25.0, image: @image-url("../../../third_party/sc-controller/images/button-images/X.svg") },
                    { x: 319.0, y: 69.4, w: 25.0, h: 25.0, image: @image-url("../../../third_party/sc-controller/images/button-images/Y.svg") },
                    { x: 172.9, y: 103.6, w: 27.9, h: 23.9, image: @image-url("../../../third_party/sc-controller/images/button-images/BACK.svg") },
                    { x: 243.1, y: 103.6, w: 27.9, h: 23.9, image: @image-url("../../../third_party/sc-controller/images/button-images/START.svg") }
                ]: Image {
                    x: root.at-x(glyph.x);
                    y: root.at-y(glyph.y);
                    width: glyph.w * 1px * root.scale;
                    height: glyph.h * 1px * root.scale;
                    source: glyph.image;
                    image-fit: contain;
                }

                // Connectors first, so the boxes cover their starting ends.
                Connector { from-x: lt.x + lt.width; from-y: lt.line-y; to-x: root.at-x(97.9); to-y: root.at-y(35); ink: root.ink; }
                Connector { from-x: lb.x + lb.width; from-y: lb.line-y; to-x: root.at-x(75); to-y: root.at-y(52); ink: root.ink; }
                Connector { from-x: ls.x + ls.width; from-y: ls.line-y; to-x: root.at-x(84.6); to-y: root.at-y(111.3); ink: root.ink; }
                Connector { from-x: dp.x + dp.width; from-y: dp.line-y; to-x: root.at-x(140); to-y: root.at-y(180); ink: root.ink; }
                Connector { from-x: rt.x; from-y: rt.line-y; to-x: root.at-x(346.7); to-y: root.at-y(35); ink: root.ink; }
                Connector { from-x: rb.x; from-y: rb.line-y; to-x: root.at-x(370); to-y: root.at-y(52); ink: root.ink; }
                Connector { from-x: fb.x; from-y: fb.line-y; to-x: root.at-x(374); to-y: root.at-y(111); ink: root.ink; }
                Connector { from-x: rs.x; from-y: rs.line-y; to-x: root.at-x(309.7); to-y: root.at-y(180); ink: root.ink; }
                Connector { from-x: root.at-x(186.8); from-y: bk.y + bk.height; to-x: root.at-x(186.8); to-y: root.at-y(115.5); ink: root.ink; }
                Connector { from-x: root.at-x(257.0); from-y: st.y + st.height; to-x: root.at-x(257.0); to-y: root.at-y(115.5); ink: root.ink; }

                lt := BindingBox {
                    x: 0px;
                    y: root.column-y;
                    width: root.box-width;
                    title: "LT";
                    editable: root.custom;
                    rows: [{ control: PadControl.left-trigger, glyph: @image-url("../../../third_party/sc-controller/images/button-images/LT.svg") }];
                    binding(c) => { return root.pad-binding(c); }
                    held(c) => { return root.control-held(c); }
                    row-hovered(c, on, x, y, h) => {
                        root.hover-tip(root.row-tip-owner(c), on && root.rebind-hint != "", "", root.rebind-hint, x, y, h);
                    }
                    row-clicked(row) => { root.choose(row, self.title); }
                }

                lb := BindingBox {
                    x: 0px;
                    y: lt.y + lt.height + root.box-gap;
                    width: root.box-width;
                    title: "LB";
                    editable: root.custom;
                    rows: [{ control: PadControl.left-shoulder, glyph: @image-url("../../../third_party/sc-controller/images/button-images/LB.svg") }];
                    binding(c) => { return root.pad-binding(c); }
                    held(c) => { return root.control-held(c); }
                    row-hovered(c, on, x, y, h) => {
                        root.hover-tip(root.row-tip-owner(c), on && root.rebind-hint != "", "", root.rebind-hint, x, y, h);
                    }
                    row-clicked(row) => { root.choose(row, self.title); }
                }

                // In the Custom mode each of a stick's axes has a row.
                ls := BindingBox {
                    x: 0px;
                    y: lb.y + lb.height + root.box-gap;
                    width: root.box-width;
                    title: @tr("Left stick");
                    editable: root.custom;
                    rows: root.custom ? [
                        { control: PadControl.left-stick-x, glyph: @image-url("../../../third_party/sc-controller/images/STICK.svg"), caption: @tr("left and right") },
                        { control: PadControl.left-stick-y, glyph: @image-url("../../../third_party/sc-controller/images/STICK.svg"), caption: @tr("up and down") },
                        { control: PadControl.left-stick-click, glyph: @image-url("../../../third_party/sc-controller/images/STICK.svg"), caption: @tr("click") }
                    ] : [
                        { control: PadControl.left-stick, glyph: @image-url("../../../third_party/sc-controller/images/STICK.svg"), caption: @tr("move") },
                        { control: PadControl.left-stick-click, glyph: @image-url("../../../third_party/sc-controller/images/STICK.svg"), caption: @tr("click") }
                    ];
                    binding(c) => { return root.pad-binding(c); }
                    held(c) => { return root.control-held(c); }
                    row-hovered(c, on, x, y, h) => {
                        root.hover-tip(root.row-tip-owner(c), on && root.rebind-hint != "", "", root.rebind-hint, x, y, h);
                    }
                    row-clicked(row) => { root.choose(row, self.title); }
                }

                dp := BindingBox {
                    x: 0px;
                    y: ls.y + ls.height + root.box-gap;
                    width: root.box-width;
                    title: @tr("D-pad");
                    editable: root.custom;
                    rows: [
                        { control: PadControl.dpad-up, glyph: @image-url("../../../third_party/sc-controller/images/DPAD_UP.svg") },
                        { control: PadControl.dpad-down, glyph: @image-url("../../../third_party/sc-controller/images/DPAD_DOWN.svg") },
                        { control: PadControl.dpad-left, glyph: @image-url("../../../third_party/sc-controller/images/DPAD_LEFT.svg") },
                        { control: PadControl.dpad-right, glyph: @image-url("../../../third_party/sc-controller/images/DPAD_RIGHT.svg") }
                    ];
                    binding(c) => { return root.pad-binding(c); }
                    held(c) => { return root.control-held(c); }
                    row-hovered(c, on, x, y, h) => {
                        root.hover-tip(root.row-tip-owner(c), on && root.rebind-hint != "", "", root.rebind-hint, x, y, h);
                    }
                    row-clicked(row) => { root.choose(row, self.title); }
                }

                rt := BindingBox {
                    x: area.width - self.width;
                    y: root.column-y;
                    width: root.box-width;
                    title: "RT";
                    editable: root.custom;
                    rows: [{ control: PadControl.right-trigger, glyph: @image-url("../../../third_party/sc-controller/images/button-images/RT.svg") }];
                    binding(c) => { return root.pad-binding(c); }
                    held(c) => { return root.control-held(c); }
                    row-hovered(c, on, x, y, h) => {
                        root.hover-tip(root.row-tip-owner(c), on && root.rebind-hint != "", "", root.rebind-hint, x, y, h);
                    }
                    row-clicked(row) => { root.choose(row, self.title); }
                }

                rb := BindingBox {
                    x: area.width - self.width;
                    y: rt.y + rt.height + root.box-gap;
                    width: root.box-width;
                    title: "RB";
                    editable: root.custom;
                    rows: [{ control: PadControl.right-shoulder, glyph: @image-url("../../../third_party/sc-controller/images/button-images/RB.svg") }];
                    binding(c) => { return root.pad-binding(c); }
                    held(c) => { return root.control-held(c); }
                    row-hovered(c, on, x, y, h) => {
                        root.hover-tip(root.row-tip-owner(c), on && root.rebind-hint != "", "", root.rebind-hint, x, y, h);
                    }
                    row-clicked(row) => { root.choose(row, self.title); }
                }

                fb := BindingBox {
                    x: area.width - self.width;
                    y: rb.y + rb.height + root.box-gap;
                    width: root.box-width;
                    title: @tr("Buttons");
                    editable: root.custom;
                    line-y: root.at-y(111);
                    rows: [
                        { control: PadControl.y, glyph: @image-url("../../../third_party/sc-controller/images/button-images/Y.svg") },
                        { control: PadControl.x, glyph: @image-url("../../../third_party/sc-controller/images/button-images/X.svg") },
                        { control: PadControl.b, glyph: @image-url("../../../third_party/sc-controller/images/button-images/B.svg") },
                        { control: PadControl.a, glyph: @image-url("../../../third_party/sc-controller/images/button-images/A.svg") }
                    ];
                    binding(c) => { return root.pad-binding(c); }
                    held(c) => { return root.control-held(c); }
                    row-hovered(c, on, x, y, h) => {
                        root.hover-tip(root.row-tip-owner(c), on && root.rebind-hint != "", "", root.rebind-hint, x, y, h);
                    }
                    row-clicked(row) => {
                        root.choose(row, row.control == PadControl.y ? "Y" : row.control == PadControl.x ? "X"
                            : row.control == PadControl.b ? "B" : "A");
                    }
                }

                rs := BindingBox {
                    x: area.width - self.width;
                    y: fb.y + fb.height + root.box-gap;
                    width: root.box-width;
                    title: @tr("Right stick");
                    editable: root.custom;
                    rows: root.custom ? [
                        { control: PadControl.right-stick-x, glyph: @image-url("../../../third_party/sc-controller/images/STICK.svg"), caption: @tr("left and right") },
                        { control: PadControl.right-stick-y, glyph: @image-url("../../../third_party/sc-controller/images/STICK.svg"), caption: @tr("up and down") },
                        { control: PadControl.right-stick-click, glyph: @image-url("../../../third_party/sc-controller/images/STICK.svg"), caption: @tr("click") }
                    ] : [
                        { control: PadControl.right-stick, glyph: @image-url("../../../third_party/sc-controller/images/STICK.svg"), caption: @tr("move") },
                        { control: PadControl.right-stick-click, glyph: @image-url("../../../third_party/sc-controller/images/STICK.svg"), caption: @tr("click") }
                    ];
                    binding(c) => { return root.pad-binding(c); }
                    held(c) => { return root.control-held(c); }
                    row-hovered(c, on, x, y, h) => {
                        root.hover-tip(root.row-tip-owner(c), on && root.rebind-hint != "", "", root.rebind-hint, x, y, h);
                    }
                    row-clicked(row) => { root.choose(row, self.title); }
                }

                bk := BindingBox {
                    x: area.width / 2 - 6px - self.width;
                    y: 0px;
                    width: root.centre-box-width;
                    title: "Back";
                    editable: root.custom;
                    rows: [{ control: PadControl.back, glyph: @image-url("../../../third_party/sc-controller/images/button-images/BACK.svg") }];
                    binding(c) => { return root.pad-binding(c); }
                    held(c) => { return root.control-held(c); }
                    row-hovered(c, on, x, y, h) => {
                        root.hover-tip(root.row-tip-owner(c), on && root.rebind-hint != "", "", root.rebind-hint, x, y, h);
                    }
                    row-clicked(row) => { root.choose(row, self.title); }
                }

                st := BindingBox {
                    x: area.width / 2 + 6px;
                    y: 0px;
                    width: root.centre-box-width;
                    title: "Start";
                    editable: root.custom;
                    rows: [{ control: PadControl.start, glyph: @image-url("../../../third_party/sc-controller/images/button-images/START.svg") }];
                    binding(c) => { return root.pad-binding(c); }
                    held(c) => { return root.control-held(c); }
                    row-hovered(c, on, x, y, h) => {
                        root.hover-tip(root.row-tip-owner(c), on && root.rebind-hint != "", "", root.rebind-hint, x, y, h);
                    }
                    row-clicked(row) => { root.choose(row, self.title); }
                }
            }

            // Another joystick's axes, hats and buttons by number, each lit
            // while held and each axis with its position.
            if root.page == 0 && root.raw-view && !root.deck-view: VerticalLayout {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                spacing: 8px;

                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 10px;

                    Image {
                        width: 40px;
                        height: 40px;
                        source: root.pad-device.joystick || root.joystick-source == 3 ? @image-url("generic-joystick.svg")
                            : @image-url("generic-gamepad.svg");
                        colorize: Palette.foreground;
                        image-fit: contain;
                    }

                    // With two joysticks the name chooses between them.
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;

                        if root.pad-device-count > 1: HorizontalLayout {
                            alignment: start;

                            ComboBox {
                                min-width: 160px;
                                model: root.pad-devices;
                                current-index <=> root.pad-slot;
                                selected => {
                                    root.pad-slot-chosen(self.current-index);
                                }
                            }
                        }

                        if root.pad-device-count <= 1: Text {
                            text: root.pad-device.connected ? root.pad-device.name : @tr("Joystick — not connected");
                            font-size: 14px;
                            font-weight: 700;
                            color: Palette.foreground;
                            overflow: elide;
                        }

                        Text {
                            text: !root.pad-device.connected ? @tr("Connect a joystick to see its inputs, or edit bindings offline.")
                                : (root.pad-device.joystick ? @tr("Joystick") : @tr("Game controller"))
                                + " · " + @tr("{n} button" | "{n} buttons" % root.pad-device.buttons)
                                + " · " + @tr("{n} hat" | "{n} hats" % root.pad-device.hats)
                                + " · " + @tr("{n} axis" | "{n} axes" % root.pad-device.axes);
                            font-size: 12px;
                            color: Palette.foreground;
                            opacity: 0.7;
                            overflow: elide;
                        }
                    }
                }

                inputs := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, columns.preferred-height);

                    columns := HorizontalLayout {
                        x: 0px;
                        y: 0px;
                        width: inputs.content-width;
                        height: inputs.content-height;
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            alignment: start;

                            if root.shown-axes > 0: PadPanel {
                                title: @tr("Axes");

                                for axis-index in root.shown-axes: PadInputRow {
                                    label: "" + (axis-index + 1);
                                    name: root.axis-kind-name(root.pad-axis-kinds[axis-index]);
                                    bar: true;
                                    value: root.pad-axis-values[axis-index];
                                    binding: root.raw-label(60 + axis-index);
                                    editable: root.custom;
                                    clicked => {
                                        root.choose-index(60 + axis-index);
                                    }
                                    hovered(on, x, y, h) => {
                                        root.hover-tip(1060 + axis-index, on && root.rebind-hint != "", "",
                                            root.rebind-hint, x, y, h);
                                    }
                                }
                            }

                            for hat in root.shown-hats: PadPanel {
                                title: @tr("Hat {}", hat + 1);

                                for direction in 4: PadInputRow {
                                    property <int> control: 52 + hat * 4 + direction;

                                    glyph: root.control-glyph(self.control);
                                    held: root.pad-held[self.control];
                                    binding: root.raw-label(self.control);
                                    editable: root.custom;
                                    clicked => {
                                        root.choose-index(self.control);
                                    }
                                    hovered(on, x, y, h) => {
                                        root.hover-tip(1000 + self.control, on && root.rebind-hint != "", "",
                                            root.rebind-hint, x, y, h);
                                    }
                                }
                            }
                        }

                        // Numbered down each column, so that a column's
                        // rows line up.
                        if root.shown-buttons > 0: VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: start;

                            PadPanel {
                                title: @tr("Buttons");

                                HorizontalLayout {
                                    spacing: 4px;

                                    for column in root.button-columns: VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: start;

                                        for row-index in min(root.button-rows,
                                            root.shown-buttons - column * root.button-rows): PadInputRow {
                                            property <int> button: column * root.button-rows + row-index;

                                            label: "" + (self.button + 1);
                                            held: root.pad-held[20 + self.button];
                                            binding: root.raw-label(20 + self.button);
                                            editable: root.custom;
                                            clicked => {
                                                root.choose-index(20 + self.button);
                                            }
                                            hovered(on, x, y, h) => {
                                                root.hover-tip(1020 + self.button, on && root.rebind-hint != "", "",
                                                    root.rebind-hint, x, y, h);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // The keyboard and mouse table: game inputs on the left, the keys and
            // mouse actions bound to them on the right.
            if root.page == 1: VerticalLayout {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                spacing: 6px;

                Rectangle {
                    vertical-stretch: 1;
                    background: Palette.alternate-background;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: 6px;
                    clip: true;

                    Text {
                        x: 14px;
                        y: 0px;
                        height: 32px;
                        vertical-alignment: center;
                        text: @tr("Game input");
                        font-size: 12px;
                        font-weight: 700;
                        color: Palette.alternate-foreground;
                        opacity: 0.7;
                    }

                    Text {
                        x: root.input-column;
                        y: 0px;
                        height: 32px;
                        vertical-alignment: center;
                        text: @tr("Key or mouse");
                        font-size: 12px;
                        font-weight: 700;
                        color: Palette.alternate-foreground;
                        opacity: 0.7;
                    }

                    Rectangle {
                        x: 0px;
                        y: 32px;
                        width: 100%;
                        height: 1px;
                        background: Palette.border;
                    }

                    ListView {
                        x: 0px;
                        y: 33px;
                        width: 100%;
                        height: parent.height - 34px;
                        viewport-y <=> root.table-scroll;

                        for row[index] in (root.game == 1 ? root.swc-rows : root.keyboard-rows): line := Rectangle {
                            // The row's current bindings, or its original ones before
                            // the launcher supplies a copy.
                            property <[InputBinding]> current: root.game == 1
                                ? (root.swc-bindings.length > index ? root.swc-bindings[index] : row.bindings)
                                : (root.keyboard-bindings.length > index ? root.keyboard-bindings[index] : row.bindings);

                            height: 40px;
                            background: row.section != "" ? Palette.background : transparent;

                            if row.section != "": Text {
                                x: 14px;
                                y: 0px;
                                height: 40px;
                                vertical-alignment: center;
                                text: row.section;
                                font-size: 13px;
                                font-weight: 700;
                                color: Palette.foreground;
                            }

                            if row.section == "": HorizontalLayout {
                                x: 14px;
                                y: 0px;
                                width: root.input-column - 28px;
                                height: 40px;
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    vertical-alignment: center;
                                    text: row.action;
                                    font-size: 13px;
                                    color: Palette.alternate-foreground;
                                    overflow: elide;
                                }

                                if row.hint != "": Text {
                                    vertical-alignment: center;
                                    text: row.hint;
                                    font-size: 12px;
                                    color: Palette.alternate-foreground;
                                    opacity: 0.6;
                                }
                            }

                            if row.section == "": HorizontalLayout {
                                x: root.input-column;
                                y: 5px;
                                width: parent.width - root.input-column - 14px;
                                height: 30px;
                                spacing: 7px;
                                alignment: start;

                                for binding[slot] in line.current: HorizontalLayout {
                                    spacing: 7px;

                                    if slot > 0: Text {
                                        text: "/";
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        color: Palette.alternate-foreground;
                                        opacity: 0.6;
                                    }

                                    // Clicking a binding changes it.
                                    Rectangle {
                                        border-radius: 6px;
                                        border-width: choose.has-hover ? 1px : 0px;
                                        border-color: Palette.accent-background;
                                        background: choose.has-hover ? Palette.accent-background.with-alpha(0.12) : transparent;

                                        HorizontalLayout {
                                            padding: 2px;
                                            spacing: 5px;

                                            for input[part] in binding.inputs: HorizontalLayout {
                                                spacing: 5px;

                                                if part > 0 && binding.joiner != "": Text {
                                                    text: binding.joiner;
                                                    vertical-alignment: center;
                                                    font-size: 13px;
                                                    color: Palette.alternate-foreground;
                                                }

                                                KeyCap {
                                                    label: root.input-label(input);
                                                    mouse: root.is-mouse(input);
                                                }
                                            }

                                            if binding.hint != "": Text {
                                                text: binding.hint;
                                                vertical-alignment: center;
                                                font-size: 12px;
                                                color: Palette.alternate-foreground;
                                                opacity: 0.7;
                                            }
                                        }

                                        choose := TouchArea {
                                            enabled: !row.fixed && !binding.fixed;
                                            mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                                            clicked => {
                                                root.start-capture(index, slot, true);
                                            }
                                        }
                                    }
                                }

                                if line.current.length == 0: Text {
                                    text: "—";
                                    vertical-alignment: center;
                                    color: Palette.alternate-foreground;
                                    opacity: 0.45;
                                }

                                // Adds another binding, up to the row's limit.
                                if !row.fixed
                                        && line.current.length < (row.limit > 0 ? row.limit : root.max-bindings): Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 13px;
                                    border-width: 1px;
                                    border-color: add.has-hover ? Palette.accent-background : Palette.border;
                                    background: add.has-hover ? Palette.accent-background.with-alpha(0.12) : transparent;

                                    Text {
                                        text: "+";
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                        font-size: 14px;
                                        color: Palette.alternate-foreground;
                                    }

                                    add := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            root.start-capture(index, line.current.length, false);
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                y: parent.height - 1px;
                                width: 100%;
                                height: 1px;
                                background: Palette.border;
                                opacity: 0.6;
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 8px;

            notes-text := Text {
                horizontal-stretch: 1;
                text: root.page == 0
                    ? root.notes()
                    : root.game == 1
                    ? @tr("The digit keys 8, 2, 4 and 6 and the keypad steer too; keypad . rolls right, + and − change speed and Enter fires a missile. Two inputs at most per action; the menus' shortcuts and the in-flight computer's keys cannot be changed.")
                    : @tr("The keypad works too: 8, 2, 4 and 6 act as the arrows, 7, 9, 1 and 3 as the diagonals, 0 and . roll, 5 stops turning, * is the afterburner and + and − change speed. This port adds Escape to pause and the mouse wheel for speed. Two inputs at most per action; Escape cannot be changed.");
                wrap: word-wrap;
                font-size: 12px;
                color: Palette.foreground;
                opacity: 0.75;
            }

            // The Custom mode's bindings start over from the WCAT four-axis
            // layout's, with the axis layout chosen last.
            if root.page == 0 && root.custom: VerticalLayout {
                alignment: center;

                Button {
                    text: @tr("Restore defaults");
                    clicked => {
                        root.pad-reset();
                    }
                }
            }
        }
    }

    // Chooses one of the Custom mode's bindings: an action for a button, an
    // axis function for a stick's axis, and either for a trigger. Escape,
    // Cancel or a click outside the panel leaves it as it was.
    if root.page == 0 && root.choose-control >= 0: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #00000060;

        TouchArea {
            clicked => {
                root.choose-control = -1;
            }
        }

        FocusScope {
            x: (parent.width - self.width) / 2;
            y: 8px;
            width: min(440px, parent.width - 16px);
            height: parent.height - 16px;
            init => {
                self.focus();
            }

            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.choose-control = -1;
                    return accept;
                }
                reject
            }

            Rectangle {
                background: Palette.background;
                border-color: Palette.border;
                border-width: 1px;
                border-radius: 8px;

                // Swallow clicks on the panel so they do not cancel.
                TouchArea { }

                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;

                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;

                        // A raw joystick's buttons go by number alone.
                        if root.choose-glyph.width > 0: Image {
                            width: 22px;
                            height: 22px;
                            source: root.choose-glyph;
                            image-fit: contain;
                        }

                        Text {
                            horizontal-stretch: 1;
                            height: 22px;
                            vertical-alignment: center;
                            text: root.choose-title;
                            font-size: 15px;
                            font-weight: 700;
                            color: Palette.foreground;
                            overflow: elide;
                        }
                    }

                    // Reversing an axis applies at once to its function.
                    if root.choose-stick: CheckBox {
                        text: @tr("Reversed");
                        checked <=> root.choose-reversed;
                        toggled => {
                            if root.choose-current <= -10 {
                                root.pad-code-changed(root.choose-control,
                                    root.axis-base(root.choose-current) - (self.checked ? 1 : 0));
                            }
                        }
                    }

                    list := ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, choices.preferred-height);

                        choices := VerticalLayout {
                            x: 0px;
                            y: 0px;
                            width: list.content-width;
                            height: list.content-height;
                            alignment: start;

                            ChoiceRow {
                                label: @tr("None");
                                help: root.choice-help(-1, root.choose-control);
                                selected: root.choose-current == -1;
                                hovered(on, x, y, h) => {
                                    root.hover-tip(100, on, "", self.help, x, y, h);
                                }
                                clicked => {
                                    root.pick(-1);
                                }
                            }

                            for code in [-10, -12, -14, -16, -18]: ChoiceRow {
                                visible: root.choose-stick;
                                height: root.choose-stick ? 26px : 0px;
                                label: root.axis-choice-label(code, false);
                                help: root.choice-help(code - (root.choose-reversed ? 1 : 0), root.choose-control);
                                hovered(on, x, y, h) => {
                                    root.hover-tip(110 - code, on, "", self.help, x, y, h);
                                }
                                selected: root.choose-current <= -10 && root.axis-base(root.choose-current) == code;
                                clicked => {
                                    root.pick(code - (root.choose-reversed ? 1 : 0));
                                }
                            }

                            if !root.choose-stick: ChoiceRow {
                                label: @tr("Cycle views");
                                help: root.choice-help(-2, root.choose-control);
                                hovered(on, x, y, h) => {
                                    root.hover-tip(102, on, "", self.help, x, y, h);
                                }
                                selected: root.choose-current == -2;
                                clicked => {
                                    root.pick(-2);
                                }
                            }

                            if !root.choose-stick: ChoiceRow {
                                label: @tr("Hold to roll and change speed");
                                help: root.choice-help(-3, root.choose-control);
                                hovered(on, x, y, h) => {
                                    root.hover-tip(103, on, "", self.help, x, y, h);
                                }
                                selected: root.choose-current == -3;
                                clicked => {
                                    root.pick(-3);
                                }
                            }

                            if root.choose-trigger: ChoiceHeading {
                                text: @tr("Analog");
                            }

                            for code in [-10, -11, -12, -13, -14, -15, -16, -17]: ChoiceRow {
                                visible: root.choose-trigger;
                                height: root.choose-trigger ? 26px : 0px;
                                label: root.axis-choice-label(code, true);
                                help: root.choice-help(code, root.choose-control);
                                hovered(on, x, y, h) => {
                                    root.hover-tip(130 - code, on, "", self.help, x, y, h);
                                }
                                selected: root.choose-current == code;
                                clicked => {
                                    root.pick(code);
                                }
                            }

                            for row[index] in root.keyboard-rows: VerticalLayout {
                                if !root.choose-stick && root.heading-choosable(index): ChoiceHeading {
                                    text: row.section;
                                }

                                if !root.choose-stick && root.choosable(row): ChoiceRow {
                                    label: row.action;
                                    help: root.choice-help(index, root.choose-control);
                                    hovered(on, x, y, h) => {
                                        root.hover-tip(200 + index, on, "", self.help, x, y, h);
                                    }
                                    selected: root.choose-current == index;
                                    clicked => {
                                        root.pick(index);
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        vertical-stretch: 0;
                        alignment: end;

                        Button {
                            text: @tr("Cancel");
                            clicked => {
                                root.choose-control = -1;
                            }
                        }
                    }
                }
            }
        }
    }

    // Captures the next key (with at most one modifier), mouse button or
    // wheel step for the binding being changed; a mouse-only row takes
    // only buttons. Escape or a click outside the box cancels.
    if root.page == 1 && root.capture-row >= 0: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #00000060;

        TouchArea {
            clicked => {
                root.capture-row = -1;
            }
        }

        capture := FocusScope {
            x: (parent.width - 480px) / 2;
            y: (parent.height - 230px) / 2;
            width: 480px;
            height: 230px;
            init => {
                self.focus();
            }

            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.capture-row = -1;
                    return accept;
                }
                if root.capture-mouse-only {
                    return accept;
                }
                if root.is-modifier(root.key-input(event.text)) {
                    root.capture-modifier = root.key-input(event.text);
                    return accept;
                }
                root.capture-key(event.modifiers, root.key-input(event.text));
                accept
            }

            key-released(event) => {
                if !root.capture-mouse-only && root.capture-modifier != ""
                        && root.key-input(event.text) == root.capture-modifier {
                    root.finish-capture({ inputs: [root.capture-modifier] });
                }
                accept
            }

            Rectangle {
                background: Palette.background;
                border-color: Palette.border;
                border-width: 1px;
                border-radius: 8px;

                // Swallow clicks on the panel so they do not cancel.
                TouchArea { }

                Text {
                    x: 20px;
                    y: 16px;
                    text: @tr("Change binding");
                    font-size: 16px;
                    font-weight: 700;
                    color: Palette.foreground;
                }

                Text {
                    x: 20px;
                    y: 42px;
                    width: parent.width - 40px;
                    text: (root.game == 1 ? root.swc-rows : root.keyboard-rows)[root.capture-row].action;
                    font-size: 13px;
                    color: Palette.foreground;
                    opacity: 0.75;
                    overflow: elide;
                }

                Rectangle {
                    x: 20px;
                    y: 70px;
                    width: parent.width - 40px;
                    height: 90px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Palette.accent-background;
                    background: Palette.accent-background.with-alpha(0.08);

                    Text {
                        width: parent.width - 24px;
                        text: root.capture-mouse-only
                            ? @tr("Click a mouse button in this box. Esc cancels.")
                            : @tr("Press a key, or click or scroll in this box with the mouse. Esc cancels.");
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: 13px;
                        color: Palette.foreground;
                    }

                    TouchArea {
                        pointer-event(event) => {
                            if event.kind != PointerEventKind.down {
                                return;
                            }
                            if event.button == PointerEventButton.left {
                                root.finish-capture({ inputs: ["mouse-left"] });
                            } else if event.button == PointerEventButton.right {
                                root.finish-capture({ inputs: ["mouse-right"] });
                            } else if event.button == PointerEventButton.middle {
                                root.finish-capture({ inputs: ["mouse-middle"] });
                            } else if event.button == PointerEventButton.back {
                                root.finish-capture({ inputs: ["mouse-back"] });
                            } else if event.button == PointerEventButton.forward {
                                root.finish-capture({ inputs: ["mouse-forward"] });
                            }
                        }

                        scroll-event(event) => {
                            if root.capture-mouse-only {
                                return accept;
                            }
                            if event.delta-y > 0 {
                                root.finish-capture({ inputs: ["wheel-up"] });
                            } else if event.delta-y < 0 {
                                root.finish-capture({ inputs: ["wheel-down"] });
                            }
                            accept
                        }
                    }
                }

                HorizontalLayout {
                    x: 20px;
                    y: parent.height - 52px;
                    width: parent.width - 40px;
                    height: 32px;
                    spacing: 8px;
                    alignment: end;

                    if root.capture-replaces: Button {
                        text: @tr("Remove");
                        clicked => {
                            root.binding-removed(root.capture-row, root.capture-slot);
                            root.capture-row = -1;
                        }
                    }

                    Button {
                        text: @tr("Cancel");
                        clicked => {
                            root.capture-row = -1;
                        }
                    }
                }
            }
        }
    }

    // Over everything else, below the element it explains or above it.
    if root.tip-shown: Hint {
        x: max(4px, min(root.tip-left + 16px, root.width - self.width - 4px));
        y: root.tip-bottom + 4px + self.height <= root.height ? root.tip-bottom + 4px
            : max(4px, root.tip-top - 4px - self.height);
        title: root.tip-title;
        text: root.tip-text;
    }
}
