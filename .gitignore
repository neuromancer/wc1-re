# Build artifacts
out/
out-modern/
dist/
compilers/msvc41/
compilers/.msvc41-*/
3rdparty/msvc4.1.tar.gz
3rdparty/msvc420-support.tar.gz
*.obj
*.asm
*.map
*.stdout

# Executables
*.EXE
*.exe

# wibo binary
wibo

# binary-comp is installed with pip; ignore an optional local development checkout.
/binary-comp

# Ghidra export (large; regenerate from the WC project)
code-full/

# Original binary and game data (never vendored).  The whole tree, not just
# data/full/: disc images land directly in data/ and one of them is 605 MB.
data/

# Third-party SDK libs the user must supply
3rdparty/dx/lib/*.lib
3rdparty/dx/include/*
3rdparty/msvcrt40.dll

# DREAMM runtime (downloaded on demand by `make dreamm`)
.dreamm/

# Python
__pycache__/
*.py[codz]
*$py.class

.DS_Store
